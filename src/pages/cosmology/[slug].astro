---
// src/pages/cosmology/[slug].astro · 0927 V1
// V1: studies whose frontmatter sets home: "/cosmology". Same posts collection,
// same layout, same slug as the blog; only the address differs (see
// src/lib/post-href.js). Old /blog addresses 301 here via netlify.toml.
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => p.data.home === '/cosmology');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BlogLayout post={post}>
  <Content />
</BlogLayout>
