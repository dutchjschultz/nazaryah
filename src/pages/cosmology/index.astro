---
// src/pages/cosmology/index.astro · 0928 V9
// V9: VIEWS (behaviour and colour only; no copy change). On load only the
// introduction, the two-way box and the Enoch side card ("Beyond the Canon")
// show. Read in Order, Enter by Scripture and Enoch each open one view and
// close the others (src/lib/cards-client.ts). Read in Order shows the band row
// heading and seven band buttons (ViewPicker); a band appears only when its
// button is chosen. Enoch shows its introduction and six card buttons the same
// way. Links: #band-N, #enoch-N, and every existing anchor. Reading cards are
// now light blue (#DCE6F2) with navy text and the gold top edge.
// V8: the Enoch panel (Enoch Section 0928): a third main card, "Enoch", opens
// a panel (#enoch) holding the introduction, six cards that open in place,
// and the closing quotations. Styles here for its quotations (.sq), small
// subheads (.sc-sub), introduction and closing. Same palette.
// V7: styles for "Two Ways to Read This Section" (in the study body, under the
// introduction): Enter by Scripture opens the verse panel (#verse-index, closed
// until asked for), Read in Order jumps to the band row (#open-the-account).
// V6: the verse index is no longer the last card. It is a panel of its own
// (components/cosmology/VerseIndexPanel.astro), placed by the study body
// directly under the introduction; this page supplies the component to the
// body. A small link at the foot jumps back up to it (#verse-index). The
// section-sources list and the split notes moved into VerseIndexPanel.
// V5: comments only — the permanent-anchor rule and the work owed if the
// section ever splits (see the notes above SECTION_SOURCES). No change in output.
// V4: one page with anchors, built so a later split is not blocked. The verse
// index takes the section's pages as a list of sources; today that list is
// this page alone. If a reading (a Band 4 witness, or Band 7) later becomes a
// page of its own, add it to SECTION_SOURCES and its index links follow it.
// V3: section furniture (Cosmology Section Furniture 0927): the band-row
// heading (in the study body, above the bands), the verse index card's title,
// deck, blurb and note (count line still generated), the closing Scripture
// block (Isaiah 40:26), and the page meta — title tag here; meta and Open
// Graph description/title in the study's frontmatter.
// V2: REBUILT as a section in the Foreign Fire pattern (Cosmology Section
// Rebuild 0927). /cosmology IS the page now — the study whose frontmatter sets
// route: "/cosmology" (the-heavens-and-the-earth.mdx; slug and associations
// unchanged, no blog category). Header furniture in Foreign Fire's order:
// eyebrow, title, deck, Scripture block, introduction. Then seven band cards
// that open in place (BandCard) holding reading cards (StudyCard), then the
// page's own verse index (PageVerseIndex), which links only to readings here.
// Its own palette (night sky and starlight), not the blog theme. No blog
// breadcrumb, category, site-wide index link or per-page verse block.
// The old /blog and /cosmology/the-heavens-and-the-earth addresses 301 here.
// V1: a section front listing the study and the cosmology-north cluster.
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerseIndexPanel from '../../components/cosmology/VerseIndexPanel.astro';
import ViewPicker from '../../components/cosmology/ViewPicker.astro';
import { getCollection, render } from 'astro:content';

const [post] = await getCollection('posts', (p) => p.data.route === '/cosmology' && p.data.draft !== true);
if (!post) throw new Error('[cosmology] no published study carries route: "/cosmology"');
const { Content } = await render(post);
const { title, deck, description, epigraph, ogTitle, ogDescription } = post.data;

const TITLE_TAG = 'Cosmology — What Scripture Says Was Made';
---

<BaseLayout title={TITLE_TAG} description={description} ogTitle={ogTitle} ogDescription={ogDescription}>
  <div class="cz" data-pagefind-body>
    <section class="cz-hero">
      <p class="cz-label">&#8213; What Yahuah Made &#8213;</p>
      <h1 class="cz-title">{title}</h1>
      {deck && <p class="cz-sub">{deck}</p>}
    </section>

    {epigraph && (
      <section class="cz-epigraph-section">
        <blockquote class="cz-epigraph">
          <p>&ldquo;{epigraph.text}&rdquo;</p>
          <cite>&mdash; {epigraph.ref}</cite>
        </blockquote>
      </section>
    )}

    <div class="cz-main">
      <Content components={{ VerseIndexPanel, ViewPicker }} />
    </div>

    <section class="cz-footer-quote">
      <p class="cz-quote-text">&ldquo;Lift up your eyes on high, and behold who hath created these things, that bringeth out their host by number: he calleth them all by names by the greatness of his might, for that he is strong in power; not one faileth.&rdquo;</p>
      <p class="cz-quote-ref">&mdash; Isaiah 40:26</p>
    </section>

    <p class="cz-back"><a href="#verse-index">&uarr; Every verse on this page</a></p>
  </div>
</BaseLayout>

<style is:global>
  /* cz- : the Cosmology section. is:global because the band and reading cards
     render from the study body and get their state from a script; everything
     is scoped under .cz. The palette is set once here as variables. */
  .cz {
    --band-bg: #0b1526;
    --band-border: #1d2e4a;
    --band-accent: #c9a85c;
    --band-count: #7f9bc8;
    --band-title: #eef2fa;
    --band-deck: #a9c0e2;
    --band-text: #c3cddd;
    --band-link: #9cc0f0;
    --cz-reading-bg: #0f1b31;
    --cz-reading-border: #24385a;
    --cz-reading-accent: #4f7fc0;
    background: linear-gradient(180deg, #04070f 0%, #0a1322 22%, #070d19 100%);
    color: var(--band-text);
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    min-height: 80vh;
    padding-bottom: 4rem;
  }

  /* ── Header ── */
  .cz-hero {
    text-align: center;
    padding: 5rem 1.5rem 3.5rem;
    border-bottom: 1px solid #16233a;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(79, 127, 192, 0.28), transparent 70%),
      linear-gradient(180deg, #04070f 0%, #0a1322 100%);
  }
  .cz-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--band-count);
    margin: 0 0 0.75rem;
  }
  .cz-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--band-title);
    margin: 0 0 1rem;
    text-shadow: 0 0 30px rgba(120, 160, 220, 0.25);
  }
  .cz-sub {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-style: italic;
    line-height: 1.6;
    color: var(--band-deck);
    max-width: 620px;
    margin: 0 auto;
  }
  .cz-epigraph-section { padding: 3rem 1.5rem 1rem; max-width: 780px; margin: 0 auto; }
  .cz-epigraph {
    margin: 0;
    padding: 1.5rem 1.75rem;
    border-left: 3px solid var(--band-accent);
    border-radius: 0 4px 4px 0;
    background: rgba(18, 32, 56, 0.55);
  }
  .cz-epigraph p { font-style: italic; font-size: 1.1rem; line-height: 1.8; color: #d6e0f0; margin: 0 0 0.75rem; }
  .cz-epigraph cite {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-style: normal;
    color: var(--band-count);
  }

  /* ── Body ── */
  .cz-main { max-width: 64rem; margin: 0 auto; padding: 0 1.5rem; }
  .cz-intro { max-width: 780px; margin: 0 auto; padding: 2rem 0 3rem; font-size: 1.1rem; line-height: 1.85; color: #cfd8e6; }
  .cz-intro p { margin: 0 0 1.4rem; }
  .cz-intro p:last-child { margin-bottom: 0; }

  /* ── Over the band row ── */
  .cz-row-head { text-align: center; padding: 1rem 0 2.25rem; border-top: 1px solid #16233a; }
  .cz-row-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--band-count);
    margin: 2.5rem 0 0.75rem;
  }
  .cz-row-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    color: var(--band-title);
    margin: 0 0 0.5rem;
  }
  .cz-row-sub { font-size: 1rem; font-style: italic; color: var(--band-deck); max-width: 36rem; margin: 0 auto; }

  /* ── Closing Scripture block ── */
  .cz-footer-quote { max-width: 720px; margin: 3.5rem auto 0; padding: 3rem 1.5rem 0; text-align: center; border-top: 1px solid #16233a; }
  .cz-quote-text { font-style: italic; font-size: 1.15rem; line-height: 1.8; color: #d6e0f0; margin: 0 0 0.75rem; }
  .cz-quote-ref {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--band-count);
    margin: 0;
  }

  .cz-back { text-align: center; margin: 2rem 0 0; font-size: 0.9rem; }
  .cz-back a { color: var(--band-count); text-decoration: none; letter-spacing: 0.02em; }
  .cz-back a:hover { color: var(--band-link); text-decoration: underline; }

  /* ── Two Ways to Read This Section ── */
  .cz-ways { padding: 0 0 2.5rem; scroll-margin-top: 7.5rem; }
  .cz-ways-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
    font-weight: 600;
    text-align: center;
    color: var(--band-title);
    margin: 0 0 1.25rem;
  }
  .cz-ways-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1.25rem; }
  .cz-way {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem 1.5rem;
    background: var(--band-bg);
    border: 1px solid var(--band-border);
    border-top: 3px solid var(--band-accent);
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .cz-way:hover { background: #0f1c33; transform: translateY(-2px); }
  .cz-way:focus-visible { outline: 2px solid var(--band-accent); outline-offset: 3px; }
  .cz-way-title { font-family: 'Cinzel', serif; font-size: 1.15rem; font-weight: 700; color: var(--band-title); }
  .cz-way-title::after { content: ' →'; color: var(--band-accent); }
  .cz-way-line { font-size: 1rem; line-height: 1.6; color: var(--band-text); }
  .cz-row-head { scroll-margin-top: 7.5rem; }

  /* ── Enoch panel: introduction, quotations, subheads, closing ── */
  .enoch-intro { max-width: 46rem; font-size: 1.05rem; line-height: 1.8; color: var(--band-text); margin: 0 0 1.75rem; }
  .enoch-intro p { margin: 0 0 1.1rem; }
  .enoch-intro a, .cz .sc a { color: var(--band-link); }
  .enoch-head {
    font-family: 'Cinzel', serif;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--band-title);
    margin: 1.75rem 0 0.6rem;
  }
  .enoch-intro .enoch-head:first-child { margin-top: 0; }
  .cz .sq {
    margin: 0.9rem 0 1.1rem 1rem;
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 2px solid var(--band-accent);
  }
  .cz .sq p { font-style: italic; font-size: 1rem; line-height: 1.7; color: #d6e0f0; margin: 0 0 0.3rem; }
  .cz .sq cite {
    font-style: normal;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--band-count);
  }
  .cz .sc-sub {
    font-family: 'Cinzel', serif;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--band-accent);
    margin: 1.4rem 0 0.4rem;
  }
  .enoch-closing { max-width: 46rem; margin: 1.75rem auto 0; }
  .enoch-closing .sq { margin-left: 0; }

  /* ── The verse index panel, full width under the introduction ── */
  .cz .pvi { margin: 0 0 1rem; }

  /* ── Views: what the script hides (nothing is hidden without it) ── */
  .cz .view-hidden, .cz .pick-hidden { display: none !important; }
  .cz .cz-way[aria-current='true'] { border-color: var(--band-accent); background: #0f1c33; }

  /* ── Beyond the Canon: the Enoch side card, one card wide, centred ── */
  .cz-beyond { padding: 0 0 2.75rem; text-align: center; }
  .cz-beyond-title {
    font-family: 'Cinzel', serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--band-count);
    margin: 0 0 1rem;
  }
  .cz-beyond-card { max-width: calc((100% - 1.25rem) / 2); min-width: min(100%, 18rem); margin: 0 auto; text-align: left; }
  .cz-beyond-card .cz-way { height: 100%; }
  @media (max-width: 640px) { .cz-beyond-card { max-width: 100%; } }

  /* ── Read in Order: a picked band shows whole — heading, deck, note, readings ── */
  .cz-order { scroll-margin-top: 7.5rem; }
  .cz .band-static > .band-head { cursor: default; }
  .cz .band-static .band-count,
  .cz .band-static .band-blurb { display: none; }
  .cz .band-static > .band-body { display: block; }

  /* ── Reading cards (bands and Enoch): light blue, navy, gold top edge ── */
  .cz .sc[data-sc] {
    background: #DCE6F2;
    border-color: #b9c8dd;
    border-top: 3px solid var(--band-accent);
    color: #1F3864;
    scroll-margin-top: 7.5rem;
  }
  .cz .sc[data-sc] h3 {
    font-family: 'Cinzel', serif;
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1F3864;
    margin: 0 0 0.35rem;
    scroll-margin-top: 7.5rem;
  }
  .cz .sc[data-sc] p { font-size: 1rem; line-height: 1.75; color: #1F3864; }
  .cz .sc[data-sc] em, .cz .sc[data-sc] .sc-deck, .cz .sc[data-sc] .sc-deck em { color: #2E4A7D; font-style: italic; }
  .cz .sc[data-sc] a { color: #1F3864; text-decoration: underline; }
  .cz .sc[data-sc] .sc-label { color: #1F3864; }
  .cz .sc[data-sc] .sc-verses,
  .cz .sc[data-sc] .sc-source { border-top-color: rgba(31, 56, 100, 0.22); color: #1F3864; }
  .cz .sc[data-sc] .sc-toggle::after { color: #1F3864; }
  .cz .sc[data-sc] .sc-sub { color: #1F3864; }
  .cz .sc[data-sc] .sq { border-left-color: var(--band-accent); }
  .cz .sc[data-sc] .sq p { color: #1F3864; }
  .cz .sc[data-sc] .sq cite { color: #2E4A7D; }
  .cz .scg { margin: 1.25rem 0 0.5rem; }
</style>
