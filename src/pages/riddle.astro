---
// src/pages/riddle.astro · 1017 V4
// V4 (Etsy Commandment One 1017 V1): /riddle keeps its URL and renders the NEWEST
// riddle (riddles[0] in src/data/riddles.js) through src/components/Riddle.astro,
// so the homepage corner card and Why the Names Matter's "Try the riddle" link
// need no edit. Canonical points at that riddle's own page, /riddle/<slug>/.
// The riddle that lived here (One Name, One Father) moved, unchanged, to
// src/data/riddles.js and /riddle/one-name-one-father/.
// V3 (Corner Cards Spec 1014 V4): in 1 Corinthians 8:6, "God" carries [Elohim] and
// "Lord" carries [Master], so the two titles read as two different ranks.
// V2 (Corner Cards Spec 1014 V3): the challenge under the tiles is "Read all three.
// Lay them side by side. What must be true?" — nothing before the answer names or
// hints at it (the old question line and the meta description did).
// V1 (Homepage Corner Cards Spec 1014 V1, Part 2): A Riddle for the Logical Mind.
import BaseLayout from '../layouts/BaseLayout.astro';
import Riddle from '../components/Riddle.astro';
import { newestRiddle } from '../data/riddles.js';
---

<BaseLayout
  title="A Riddle for the Logical Mind — Nazaryah"
  description="Three verses. One logical answer. Read all three, lay them side by side — what must be true?"
  canonical={`/riddle/${newestRiddle.slug}/`}
>
  <Riddle riddle={newestRiddle} />
</BaseLayout>
