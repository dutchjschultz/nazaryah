---
// src/pages/watchmans-desk/[slug].astro · 0804 V5
// V5: an entry may carry a supplied `ogImage` (a pre-made card in /public/og);
// when present it becomes og:image/twitter:image, else BaseLayout auto-resolves.
// Added `.wl-quote-block` — an indented italic block for quoted phrases (no rule).
// A reader page for EVERY entry, regardless of kind (weekly-letter, field-brief,
// open-letter) — route generation is NOT keyed to kind, so no strip link can
// 404. Card metadata (title, deck, status, date) comes from the data file; full
// text comes from the watchmans-desk content collection when a .md file exists,
// otherwise the entry's `body` paragraph renders as the page content. Open
// letters render divider-free; letter bodies use disc bullets (no diamonds).
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { entries, STATUSES } from '../../data/watchmans-desk.js';

export async function getStaticPaths() {
  const fulltext = await getCollection('watchmans-desk');
  const bySlug = new Map(fulltext.map((f) => [f.slug, f]));
  const paths = entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, full: bySlug.get(entry.slug) ?? null },
  }));
  // Every entry must resolve to a page that renders something — its .md file, or
  // its body paragraph as a fallback. Fail the build naming the offending slug
  // rather than shipping an empty page or a dead strip link.
  for (const { props } of paths) {
    const { entry, full } = props;
    if (!full && !(entry.body && entry.body.trim()))
      throw new Error(`watchmans-desk: "${entry.slug}" resolves to no page content (no .md file and no body)`);
  }
  return paths;
}

const { entry, full } = Astro.props;
const { kind, status, date, title, deck, description, ogImage } = entry;
const Content = full ? (await full.render()).Content : null;
// A supplied pre-made card (filename in /public/og) overrides the auto-generated
// per-page card; absolute-resolved in BaseLayout.
const ogImagePath = ogImage ? `/og/${ogImage}` : undefined;

const chrome =
  kind === 'open-letter' ? 'An Open Letter'
  : kind === 'field-brief' ? 'A Field Brief'
  : "The Watchman's Letter";
const masthead = `${chrome} · ${STATUSES[status].label} ${date}`;
---

<BaseLayout title={`${title} — The Watchman's Desk | Nazaryah`} description={description ?? deck} article={true} ogImage={ogImagePath}>
  <article class={kind === 'open-letter' ? 'wl wl-open' : 'wl'}>
    <header class="wl-head">
      <p class="wl-masthead">{masthead}</p>
      <h1 class="wl-title">{title}</h1>
      <p class="wl-deck">{deck}</p>
    </header>

    <div class="wl-body">
      {Content ? <Content /> : (
        <p class="wl-pending">The full text is on its way. In the meantime, here is where it begins:</p>
      )}
      {!Content && <p>{entry.body}</p>}
    </div>

    <p class="wl-back"><a href="/watchmans-desk">&larr; The Watchman's Desk</a></p>
  </article>
</BaseLayout>

<style>
  .wl { max-width: 40rem; margin: 0 auto; padding: clamp(2.5rem, 6vw, 4.5rem) 1.4rem 4rem; font-family: Georgia, 'Times New Roman', serif; color: #241d13; }

  .wl-head { text-align: center; margin-bottom: 2.6rem; }
  .wl-masthead { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: #1f3864; margin: 0 0 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(31, 56, 100, 0.25); font-weight: 600; }
  .wl-title { font-size: clamp(2rem, 1.4rem + 3vw, 3rem); line-height: 1.1; color: #1f3864; margin: 0 0 0.7rem; font-weight: 700; text-wrap: balance; }
  .wl-deck { font-style: italic; font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem); color: #5c5142; margin: 0; line-height: 1.5; }

  .wl-body { font-size: 1.09rem; line-height: 1.8; }
  .wl-body :global(p) { margin: 0 0 1.3rem; }
  .wl-pending { font-style: italic; color: #7a6a52; }

  /* Standard disc bullets — scripture stays inline in the list item, never a
     blockquote. Navy marker ties the list to the navy section headers. */
  .wl-body :global(ul) { list-style: disc; margin: 1.3rem 0; padding-left: 1.5rem; }
  .wl-body :global(li) { margin: 0.5rem 0; padding-left: 0.2rem; }
  .wl-body :global(li)::marker { color: #1f3864; }

  .wl-body :global(h2) { font-size: 1.35rem; color: #1f3864; font-weight: 700; line-height: 1.25; margin: 2.6rem 0 1rem; }
  .wl-body :global(blockquote) { margin: 1.7rem 0; padding: 0.2rem 0 0.2rem 1.4rem; border-left: 3px solid #1f3864; font-style: italic; color: #3a3428; line-height: 1.65; }
  .wl-body :global(blockquote p) { margin: 0; }
  /* Indented italic block for quoted phrases — NO left rule (distinct from a scripture blockquote). */
  .wl-body :global(.wl-quote-block) { margin: 1.7rem 0; padding-left: 1.6rem; font-style: italic; color: #3a3428; line-height: 1.8; }
  .wl-body :global(.wl-closing) { margin: 2.8rem 0 0; padding-top: 1.8rem; border-top: 1px solid rgba(31, 56, 100, 0.25); text-align: center; font-style: italic; font-size: clamp(1.3rem, 1.1rem + 1vw, 1.7rem); line-height: 1.4; color: #1f3864; }

  .wl-back { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(31,56,100,0.2); }
  .wl-back a { color: #6b3010; text-decoration: none; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .wl-back a:hover { color: #3a1a04; }

  /* Open letters run divider-free — whitespace and the navy headers do the work. */
  .wl-open .wl-masthead { border-bottom: none; padding-bottom: 0; }
  .wl-open .wl-back { border-top: none; padding-top: 0; margin-top: 3.5rem; }
</style>
