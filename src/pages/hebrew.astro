---
// hebrew.astro · 1010 V2
// V2: The Letters Moses Wrote — the Trail of the Letters strip under the hero
// (modelled on the Historic Trail band on /trinity; styles copied here as htl-*,
// the Trinity page is untouched), an eighth card placed first in Choose Your
// Path, and two Not Just Letters sentences that taught Kabbalah replaced.
import HebrewLayout from '../layouts/HebrewLayout.astro';

const STUDY = '/hebrew/letters-moses-wrote/';
const TRAIL = [
  { label: 'Sinai', date: 'c. 1850 BC', id: 'sinai' },
  { label: 'Canaan', date: 'c. 1700 BC', id: 'canaan' },
  { label: 'Kings', date: 'c. 1000 BC', id: 'kings' },
  { label: 'Babylon', date: '586 BC', id: 'babylon' },
  { label: 'Scrolls', date: '250 BC', id: 'scrolls' },
  { label: 'Samaria', date: 'late BC', id: 'samaritan' },
  { label: 'Masoretes', date: 'AD 600', id: 'masoretes' },
];

const sections = [
  {
    href: STUDY,
    title: 'The Letters Moses Wrote',
    modern: 'א',
    paleo: '𐤀',
    blurb: 'From the Sinai to Babylon, the four scripts Scripture passed through, and why the square letters are not Kabbalah.',
  },
  {
    href: '/hebrew/alphabet',
    title: 'Alphabet',
    modern: 'א',
    paleo: '𐤀',
    blurb: 'The 22 letters of the aleph-bet — each one a word, a picture, a story.',
  },
  {
    href: '/hebrew/words',
    title: 'Word Pictures',
    modern: 'אמת',
    paleo: '𐤀𐤌𐤕',
    blurb: 'Compound words broken down letter by letter — the images behind the vocabulary.',
  },
  {
    href: '/hebrew/psalm-119',
    title: 'Psalm 119',
    modern: 'תהילים',
    paleo: '𐤕𐤄𐤋𐤉𐤌',
    blurb: 'The great alphabetic psalm — 22 sonnets of 8 verses, one per Hebrew letter.',
  },
  {
    href: '/hebrew/names',
    title: 'Sacred Names',
    modern: 'יהוה',
    paleo: '𐤉𐤄𐤅𐤄',
    blurb: 'The correct pronunciation of Yahuwah and Yahushua, letter by letter.',
  },
  {
    href: '/hebrew/waw',
    title: 'The Case for U',
    modern: 'ו',
    paleo: '𐤅',
    blurb: 'Why the Hebrew Waw was always a U — never a V, never a W. The evidence is overwhelming.',
  },
  {
    href: '/hebrew/messiah-letters',
    title: 'Messiah in the Letters',
    modern: 'ישוע',
    paleo: '𐤉𐤔𐤅𐤏',
    blurb: 'Yahushua hidden in every letter of the aleph-bet — from Aleph to Taw, He is there.',
  },
  {
    href: '/hebrew/aleph-tav',
    title: 'The Aleph-Tav',
    modern: 'את',
    paleo: '𐤀𐤕',
    blurb: 'The untranslated sign found over 7,000 times in Scripture — and the One who claimed it as His name.',
  },
];
---

<HebrewLayout
  title="Hebrew — Nazaryah"
  description="The Hebrew language encodes more than sound. Each letter is a picture, each word a story. Explore the alphabet, word pictures, Psalm 119, and the sacred names."
>
  <section class="hl-hero">
    <p class="hl-label">&#8213; The Living Language &#8213;</p>
    <h1 class="hl-title">The Hebrew Tongue</h1>
    <p class="hl-sub">
      Every letter is a word. Every word is a picture. Every picture tells a story that was ancient before parchment existed.
    </p>
  </section>

  <!-- ── THE TRAIL OF THE LETTERS ── -->
  <section class="htl-band">
    <h2 class="htl-title">The Trail of the Letters</h2>
    <p class="htl-sub">From the Sinai to the square script, 1850 BC to AD 1000</p>
    <div class="htl-strip" role="list" aria-label="Stations on the trail of the letters">
      {TRAIL.map((st) => (
        <a class="htl-station" role="listitem" href={`${STUDY}#${st.id}`}>
          <span class="htl-dot" aria-hidden="true"></span>
          <span class="htl-label">{st.label}</span>
          <span class="htl-date">{st.date}</span>
        </a>
      ))}
    </div>
    <p class="htl-desc">The letters printed in a Hebrew Bible today are not the letters Moses wrote. Follow the trail from the turquoise mines of the Sinai to the scribes who added the vowels.</p>
    <a href={STUDY} class="htl-read">Read the Study <span class="htl-arrow">&#8594;</span></a>
  </section>

  <section class="hl-section">
    <div class="hub-intro">
      <h2 class="hl-section-title">Not Just Letters</h2>
      <p>
        In English, the letter <em>A</em> is simply a sound — a marker that holds a place in a word. It carries no meaning on its own.
        The Hebrew alphabet is a different creature entirely.
      </p>
      <p>
        Each of the twenty-two letters of the Hebrew aleph-bet began as a <strong>picture</strong> — a concrete image drawn from the ancient world.
        Aleph was an ox head. Bet was a tent or house. Gimel was a camel. These were not arbitrary symbols; they were the objects of
        everyday life encoded with theological weight.
      </p>
      <p>
        A Hebrew speaker — ancient or modern — does not just <em>hear</em> a word. They see it. Every word carries embedded within it
        the pictographic story of each letter it contains. This is why the Hebrew Bible rewards slow reading: the surface meaning, the picture behind each letter, and the acrostic patterns of the Psalms all sit within the same text.
      </p>
      <p>
        The pictures behind the letters are real history, carved by Semitic workers in the Sinai long before Israel had a king. They help a reader
        remember the letters and see the world the alphabet came from. The meaning of any word is still settled by how Scripture uses it, from Genesis forward.
      </p>
    </div>
  </section>

  <section class="hl-section hl-center">
    <h2 class="hl-section-title">Choose Your Path</h2>
    <p class="hl-section-sub">Eight ways to enter the language of Scripture.</p>

    <div class="hub-grid">
      {sections.map((s) => (
        <a href={s.href} class="hub-card">
          <div class={`hub-scripts${[...s.modern].length > 3 ? ' hub-scripts--long' : ''}`}>
            <span class="hub-modern">{s.modern}</span>
            <span class="hub-paleo">{s.paleo}</span>
          </div>
          <div class="hub-title">{s.title}</div>
          <p class="hub-blurb">{s.blurb}</p>
          <span class="hub-enter">Enter &#8594;</span>
        </a>
      ))}
    </div>
  </section>
</HebrewLayout>

<style>
  /* ── THE TRAIL OF THE LETTERS — copied from the Historic Trail band on
     /trinity (.tl-band / .tl-trail / .tl-strip), renamed htl-* ── */
  .htl-band {
    padding: 2.75rem 1.5rem;
    border-bottom: 1px solid #2e1f0d;
    text-align: center;
    background: rgba(10, 6, 2, 0.3);
  }
  .htl-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.35rem, 2.8vw, 1.8rem);
    font-weight: 600;
    color: #f0e0bf;
    text-align: center;
    margin: 0 0 1.75rem;
  }
  .htl-sub {
    font-style: italic;
    color: #c4a46b;
    font-size: 1.05rem;
    margin: -1.1rem 0 2rem;
  }
  .htl-strip {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto 2rem;
    padding: 0 0.5rem 0.5rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .htl-strip::before {
    content: "";
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    top: 6px;
    height: 1px;
    background: #5a4526;
  }
  .htl-station {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    min-width: 4.5rem;
    text-decoration: none;
  }
  .htl-label {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #c9b489;
    transition: color 0.2s;
  }
  .htl-date {
    margin-top: -0.45rem;
    font-size: 0.82rem;
    font-style: italic;
    color: #8a7350;
  }
  .htl-dot {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #160f07;
    border: 1px solid #8a6028;
    transition: border-color 0.2s, background 0.2s;
  }
  .htl-station:hover .htl-label { color: #f0e0bf; }
  .htl-station:hover .htl-dot { border-color: #c4a46b; background: #2a1d0c; }
  .htl-station:focus-visible { outline: 2px solid #c4a46b; outline-offset: 4px; border-radius: 4px; }
  .htl-desc {
    max-width: 640px;
    margin: 0 auto 1.25rem;
    color: #c4ad84;
    font-size: 1.05rem;
    line-height: 1.7;
  }
  .htl-read {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a6028;
    text-decoration: none;
  }
  .htl-read:hover { color: #c4a46b; }
  .htl-arrow { display: inline-block; transition: transform 0.2s ease; }
  .htl-read:hover .htl-arrow { transform: translateX(4px); }
  @media (max-width: 620px) {
    .htl-band { padding: 2.5rem 1rem; }
    .htl-strip { justify-content: flex-start; gap: 1.25rem; }
    .htl-strip::before { right: auto; width: calc(7 * 5.75rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .htl-arrow { transition: none; }
  }

  .hub-intro {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #d9c9a8;
  }
  .hub-intro p { margin-bottom: 1.25rem; }
  .hub-intro em { color: #c4a46b; font-style: italic; }
  .hub-intro strong { color: #e8d5a8; }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .hub-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding: 2rem 1.5rem;
    background: linear-gradient(160deg, #211608 0%, #1a1007 100%);
    border: 2px solid #8a5a2a;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.25s ease;
    position: relative;
  }
  .hub-card:hover {
    border-color: #c4a46b;
    background: linear-gradient(160deg, #2a1d0c 0%, #1e1309 100%);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.55), inset 0 1px 0 rgba(196,164,107,0.12);
  }
  .hub-scripts {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
  }
  .hub-modern {
    font-size: 3rem;
    color: #e8c97a;
    line-height: 1;
    text-shadow: 0 0 22px rgba(232,201,122,0.3);
    text-align: left;
  }
  .hub-paleo {
    font-size: 2.6rem;
    color: #b88540;
    line-height: 1;
    text-align: right;
  }
  .hub-scripts--long .hub-modern {
    font-size: 2.2rem;
  }
  .hub-scripts--long .hub-paleo {
    font-size: 1.9rem;
  }
  .hub-title {
    font-family: 'Cinzel', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #f0e0bf;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .hub-blurb {
    font-size: 0.95rem;
    color: #c4ad84;
    line-height: 1.6;
    text-align: center;
    margin: 0;
    font-style: italic;
  }
  .hub-enter {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2px;
    color: #8a6028;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }
  .hub-card:hover .hub-enter { color: #c4a46b; }
</style>
