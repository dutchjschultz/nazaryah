---
// src/pages/watchmans-desk.astro · 0809 V5
// V5: the desk index renders EVERY entry (sortedEntries), newest first by
// sortDate — the full back catalog, so the newest letters and the law chips are
// never hidden. Added data-driven LAW filter chips: one chip per distinct `law`
// value present, built from the data (never hand-maintained, same pattern as the
// Worth-the-Hour topic chips) and filtering the stream by data-law at render.
// Entries with no `law` yet appear only under "All".
import BaseLayout from '../layouts/BaseLayout.astro';
import WatchmanCard from '../components/WatchmanCard.astro';
import { sortedEntries } from '../data/watchmans-desk.js';

// Law chips build themselves from the `law` values present. A new law string
// makes its own chip automatically; reuse an existing string character for
// character to file a letter under it.
const laws = [...new Set(sortedEntries.map((e) => e.law).filter(Boolean))];
---

<BaseLayout
  title="The Watchman's Desk — Nazaryah"
  description="The Watchman's Desk — weekly letters, field briefs, and open letters. One stream, newest first, the week read through Scripture."
>
  <div class="wd-wrap">

    <section class="wd-masthead">
      <p class="wd-eyebrow">&#8213; Field Notes From the Wall &#8213;</p>
      <h1 class="wd-title">The Watchman's Desk</h1>
      <p class="wd-sub">Letters and field briefs — one stream, newest first, the week read through the text.</p>
      <div class="wd-stripes" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </section>

    <section class="wd-grid-section">
      {laws.length > 0 && (
        <div class="wd-filters" role="group" aria-label="Filter letters by Torah principle">
          <button type="button" class="wd-chip is-active" data-law="all">All</button>
          {laws.map((l) => (
            <button type="button" class="wd-chip" data-law={l}>{l}</button>
          ))}
        </div>
      )}
      <div class="wd-stream">
        {sortedEntries.map((entry) => (
          <div class="wd-card" data-law={entry.law ?? ''}>
            <WatchmanCard entry={entry} variant="archive" />
          </div>
        ))}
      </div>

      <div class="wd-foot">
        <p>
          <strong>&#9733; Watchman &#9733;</strong><br>
          "But if the watchman see the sword come, and blow not the trumpet, and the people be not warned…" — Ezekiel 33:6
        </p>
      </div>
    </section>

  </div>
</BaseLayout>

<script>
  // Law-chip filter — scoped to the desk section. Toggling a chip shows only the
  // cards whose data-law matches; "all" shows everything. Hidden cards leave no
  // gap (the flex column skips display:none items).
  document.querySelectorAll('.wd-grid-section').forEach((section) => {
    const chips = section.querySelectorAll('.wd-chip');
    const cards = section.querySelectorAll('.wd-card');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const law = chip.dataset.law;
        chips.forEach((c) => c.classList.toggle('is-active', c === chip));
        cards.forEach((card) => {
          card.hidden = !(law === 'all' || card.dataset.law === law);
        });
      });
    });
  });
</script>

<style>
  .wd-wrap {
    --navy: #0a1d3a; --red: #b8232a; --cream: #f5f1e6; --ink-soft: #3a3a3a;
    background: var(--cream); color: #1a1a1a; font-family: Georgia, 'Times New Roman', serif; min-height: 80vh;
  }

  .wd-masthead {
    text-align: center; padding: 4.5rem 1.5rem 3rem;
    border-top: 6px solid var(--red); border-bottom: 1px solid var(--navy);
    background: repeating-linear-gradient(0deg, transparent, transparent 32px, rgba(0,0,0,0.022) 32px, rgba(0,0,0,0.022) 33px), var(--cream);
    position: relative;
  }
  .wd-masthead::before, .wd-masthead::after { content: '★'; color: var(--red); font-size: 24px; position: absolute; top: 28px; opacity: 0.7; }
  .wd-masthead::before { left: 40px; }
  .wd-masthead::after { right: 40px; }
  .wd-eyebrow { font-family: 'Cinzel', 'Playfair Display', Georgia, serif; font-size: 10px; letter-spacing: 0.4em; color: var(--red); text-transform: uppercase; margin: 0 0 1rem 0; font-weight: 700; }
  .wd-title { font-family: 'Playfair Display', 'Cinzel', Georgia, serif; font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 900; color: #061230; letter-spacing: -0.01em; line-height: 1.05; margin: 0 0 0.85rem 0; font-style: italic; }
  .wd-sub { font-style: italic; font-size: clamp(1rem, 1.8vw, 1.2rem); color: var(--ink-soft); max-width: 640px; margin: 0 auto; line-height: 1.55; }
  .wd-stripes { display: flex; justify-content: center; gap: 3px; margin-top: 24px; }
  .wd-stripes span { display: block; width: 22px; height: 3px; }
  .wd-stripes span:nth-child(odd) { background: var(--red); }
  .wd-stripes span:nth-child(even) { background: var(--navy); }

  .wd-grid-section { padding: 3.5rem 1.5rem 4rem; }

  /* Law filter chips — data-driven, cream/navy to match the desk masthead. */
  .wd-filters { max-width: 780px; margin: 0 auto 2rem; display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .wd-chip {
    font-family: 'Cinzel', Georgia, serif; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--navy); background: transparent; border: 1px solid rgba(10,29,58,0.35);
    border-radius: 999px; padding: 0.42rem 0.95rem; cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .wd-chip:hover, .wd-chip:focus-visible { border-color: var(--navy); background: rgba(10,29,58,0.06); outline: none; }
  .wd-chip.is-active { background: var(--navy); color: var(--cream); border-color: var(--navy); }

  .wd-stream { display: flex; flex-direction: column; gap: 1.6rem; max-width: 780px; margin: 0 auto; }
  .wd-card { display: block; }

  .wd-foot { max-width: 680px; margin: 3rem auto 0; text-align: center; padding: 1.75rem 1.5rem; border-top: 1px solid var(--navy); font-style: italic; color: var(--ink-soft); font-size: 0.95rem; line-height: 1.7; }
  .wd-foot strong { color: #061230; font-style: normal; letter-spacing: 0.15em; text-transform: uppercase; font-size: 0.72rem; font-weight: 700; }

  @media (max-width: 640px) { .wd-masthead::before, .wd-masthead::after { display: none; } }
</style>
