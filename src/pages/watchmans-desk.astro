---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// The Watchman's Desk — the archive of weekly letters. Every letter, newest
// first, one stream. (The old news-brief collection, watchmans-report, is
// retired to draft: true; its files are preserved but no longer render here.)
const letters = (await getCollection('watchmans-desk', (l) => l.data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="The Watchman's Desk — Nazaryah"
  description="The Watchman's Letter — a weekly reading of the week's noise through Scripture. Every letter, newest first."
>
  <div class="wd-wrap">

    <!-- MASTHEAD -->
    <section class="wd-masthead">
      <p class="wd-eyebrow">&#8213; Field Notes From the Wall &#8213;</p>
      <h1 class="wd-title">The Watchman's Desk</h1>
      <p class="wd-sub">The Watchman's Letter — one week at a time, read through the text. Every letter, newest first.</p>
      <div class="wd-stripes" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </section>

    <!-- LETTERS — one stream, newest first -->
    <section class="wd-grid-section">
      {letters.length === 0 ? (
        <p class="wd-empty">The first letter is on its way.</p>
      ) : (
        <div class="wd-stream">
          {letters.map((letter) => (
            <a class="wd-letter" href={`/watchmans-desk/${letter.slug}`}>
              <div class="wd-tag">
                <span>{letter.data.issue}</span>
                <span class="wd-star">★</span>
              </div>
              <div class="wd-letter-body">
                <h2 class="wd-letter-title">{letter.data.title}</h2>
                <p class="wd-letter-deck">{letter.data.deck}</p>
                <span class="wd-read">Read the letter &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      )}

      <div class="wd-foot">
        <p>
          <strong>&#9733; Watchman &#9733;</strong><br>
          "But if the watchman see the sword come, and blow not the trumpet, and the people be not warned…" — Ezekiel 33:6
        </p>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .wd-wrap {
    --ink: #1a1a1a;
    --ink-soft: #3a3a3a;
    --navy: #0a1d3a;
    --navy-deep: #061230;
    --red: #b8232a;
    --cream: #f5f1e6;
    --gold: #c9a961;

    background: var(--cream);
    color: var(--ink);
    font-family: Georgia, 'Times New Roman', serif;
    min-height: 80vh;
  }

  /* MASTHEAD */
  .wd-masthead {
    text-align: center;
    padding: 4.5rem 1.5rem 3rem;
    border-top: 6px solid var(--red);
    border-bottom: 1px solid var(--navy);
    background:
      repeating-linear-gradient(0deg, transparent, transparent 32px, rgba(0,0,0,0.022) 32px, rgba(0,0,0,0.022) 33px),
      var(--cream);
    position: relative;
  }
  .wd-masthead::before, .wd-masthead::after {
    content: '★';
    color: var(--red);
    font-size: 24px;
    position: absolute;
    top: 28px;
    opacity: 0.7;
  }
  .wd-masthead::before { left: 40px; }
  .wd-masthead::after { right: 40px; }

  .wd-eyebrow {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
    font-size: 10px;
    letter-spacing: 0.4em;
    color: var(--red);
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    font-weight: 700;
  }
  .wd-title {
    font-family: 'Playfair Display', 'Cinzel', Georgia, serif;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    color: var(--navy-deep);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 0 0 0.85rem 0;
    font-style: italic;
  }
  .wd-sub {
    font-style: italic;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--ink-soft);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.55;
  }
  .wd-stripes { display: flex; justify-content: center; gap: 3px; margin-top: 24px; }
  .wd-stripes span { display: block; width: 22px; height: 3px; }
  .wd-stripes span:nth-child(odd) { background: var(--red); }
  .wd-stripes span:nth-child(even) { background: var(--navy); }

  /* STREAM — the letters, newest first */
  .wd-grid-section { padding: 3.5rem 1.5rem 4rem; }
  .wd-stream {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 760px;
    margin: 0 auto;
  }
  .wd-empty {
    max-width: 760px; margin: 0 auto; text-align: center;
    font-style: italic; color: var(--ink-soft);
  }

  .wd-letter {
    display: block;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--navy);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(10,29,58,0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .wd-letter:hover { transform: translateY(-3px); box-shadow: 0 10px 26px rgba(10,29,58,0.2); }

  .wd-tag {
    background: var(--navy-deep);
    color: var(--cream);
    padding: 10px 22px;
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wd-star { font-size: 0.9rem; color: var(--gold); }

  .wd-letter-body { padding: 1.6rem 1.75rem 1.7rem; }
  .wd-letter-title {
    font-family: 'Playfair Display', 'Cinzel', Georgia, serif;
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    font-weight: 800;
    color: var(--navy-deep);
    line-height: 1.15;
    margin: 0 0 0.7rem 0;
  }
  .wd-letter-deck {
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 1.2rem 0;
  }
  .wd-read {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
    font-size: 0.74rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--red);
  }
  .wd-letter:hover .wd-read { color: var(--navy-deep); }

  /* FOOT */
  .wd-foot {
    max-width: 680px;
    margin: 3rem auto 0;
    text-align: center;
    padding: 1.75rem 1.5rem;
    border-top: 1px solid var(--navy);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .wd-foot strong {
    color: var(--navy-deep);
    font-style: normal;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.72rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .wd-masthead::before, .wd-masthead::after { display: none; }
    .wd-letter-body { padding: 1.4rem 1.25rem; }
  }
</style>
