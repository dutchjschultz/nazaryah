---
// src/pages/trinity/trinity-problems.astro · 1014 V1
// V1 (Trinity Problems Etsy Block 1014 V1): the Trinity Problems lexicon — the
// verses a three-person God cannot account for, grouped under twenty problems.
// Data: src/data/trinity-problems.js (problems + entries). Every number on the
// page (tally, count line, closing count) is computed from that file.
// Both views are rendered here at build time; the control bar only shows and
// hides what is already on the page (no nodes are created at runtime), so the
// scoped styles cover everything. The last view/problem is remembered per
// visitor in localStorage when it is available; the page works without it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { problems, entries } from '../../data/trinity-problems.js';

const byId = new Map(problems.map((p) => [p.id, p]));
const badP = entries.filter((e) => !byId.has(e.p)).map((e) => e.n);
if (badP.length) throw new Error(`trinity-problems.js: entries with unknown problem id: ${badP.join(', ')}`);

const entryCount = entries.length;
const passageCount = new Set(entries.map((e) => e.ref)).size;
const problemCount = problems.length;
const fmt = (n) => n.toLocaleString('en-US');

const NUMBER_WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen', 'seventeen', 'eighteen', 'nineteen', 'twenty'];
const problemWord = NUMBER_WORDS[problemCount] ?? String(problemCount);

// By problem: problems in id order, each with its entries in lexicon order; a
// part heading rides on the first problem of each part.
const groups = [...problems]
  .sort((a, b) => a.id - b.id)
  .map((p, i, all) => ({
    ...p,
    partHead: i === 0 || all[i - 1].part !== p.part ? p.part : null,
    items: entries.filter((e) => e.p === p.id).sort((a, b) => a.n - b.n),
  }));

// By verse: one running index in Bible order (sortKey, then n).
const cmpKey = (a, b) => {
  for (let i = 0; i < 3; i++) if (a.sortKey[i] !== b.sortKey[i]) return a.sortKey[i] - b.sortKey[i];
  return a.n - b.n;
};
const byVerse = [...entries].sort(cmpKey);

const title = 'Trinity Problems';
const subtitle = 'Verses for the Trinitarian to Explain';
---

<BaseLayout
  title={`${title} — Nazaryah`}
  description="The verses a three-person God cannot account for, gathered under twenty problems: Yahushua's own God, the Father as the one God, the Son given everything, and the Old Testament witness."
>
  <div class="tp-page">
    <div class="tp-wrap">

      <header class="tp-head">
        <a href="/trinity" class="tp-back">&#8592; Back to Trinity</a>
        <p class="tp-eyebrow">A Lexicon</p>
        <h1 class="tp-title">{title}</h1>
        <p class="tp-sub tr-sub">{subtitle}</p>
        <p class="tp-tally">{fmt(entryCount)} entries · {fmt(passageCount)} passages · {problemCount} problems</p>
      </header>

      <section class="tp-intro">
        <p>The Trinitarian routinely hands the non-Trinitarian a short list of proof texts and asks for an explanation. This lexicon reverses the exchange. It gathers the passages a three-person God cannot account for without strain, special pleading, or a creed written centuries after the apostles.</p>
        <p>The verses are grouped under twenty problems:</p>
        <ul>
          <li>The first nine are the original problems.</li>
          <li>Eight more are drawn from the Apostolic writings.</li>
          <li>The last three hold the Old Testament witness. These are kept to direct statements only: Yahuah speaking of Himself, and plain promises of the Messiah to come. No entry rests on a disputed reading.</li>
        </ul>
        <p>Each problem opens with a paragraph stating it. Under every verse, the issue it raises for the Trinity is set out on its own line.</p>
        <p>The list can be read by problem, or as one running index in Bible order. A reference can be found by typing it in the search box.</p>
        <p class="tp-note">Scripture is quoted from the KJV with the names restored. Yahuah stands only where the New Testament quotes an Old Testament verse bearing the Name. Where <em>kurios</em> (G2962) refers to Yahushua, it is rendered “Master,” its plain sense, the same word Sarah used of Abraham (1 Peter 3:6). Quotations are kept to the phrase that carries the point; each verse should be read in its place.</p>
      </section>

      <div class="tp-bar" data-tp-bar>
        <div class="tp-seg" role="group" aria-label="View">
          <button type="button" data-tp-view="problem" aria-pressed="true">By problem</button>
          <button type="button" data-tp-view="verse" aria-pressed="false">By verse</button>
        </div>
        <label class="tp-visually-hidden" for="tp-problem">Problem</label>
        <select id="tp-problem" data-tp-problem>
          <option value="all">All {problemWord} problems</option>
          {groups.map((p) => <option value={String(p.id)}>{p.id}. {p.title}</option>)}
        </select>
        <label class="tp-visually-hidden" for="tp-search">Find a verse</label>
        <input id="tp-search" type="search" placeholder="Find a verse, e.g. John 17" autocomplete="off" data-tp-search />
        <p class="tp-count" aria-live="polite" data-tp-count>{fmt(entryCount)} entries</p>
      </div>

      <!-- BY PROBLEM -->
      <div class="tp-view" data-tp-panel="problem">
        {groups.map((p) => (
          <>
            {p.partHead && <h2 class="tp-part" data-tp-part>{p.partHead}</h2>}
            <section class="tp-problem" data-tp-group={String(p.id)} id={`problem-${p.id}`}>
              <p class="tp-pnum">Problem {p.id}</p>
              <h3 class="tp-ptitle">{p.title}</h3>
              <div class="tp-ptext"><b>The problem</b>{p.text}</div>
              <ol class="tp-list">
                {p.items.map((e) => (
                  <li class="tp-entry" data-tp-entry data-ref={e.ref}>
                    <span class="tp-no">No. {e.n}</span>
                    <div class="tp-body">
                      <p class="tp-ref">{e.ref}</p>
                      <p class="tp-verse">{e.verse}</p>
                    </div>
                    <p class="tp-issue"><b>The issue</b>{e.issue}</p>
                  </li>
                ))}
              </ol>
            </section>
          </>
        ))}
      </div>

      <!-- BY VERSE -->
      <div class="tp-view" data-tp-panel="verse" hidden>
        <ol class="tp-list">
          {byVerse.map((e) => (
            <li class="tp-entry" data-tp-entry data-ref={e.ref} data-p={String(e.p)}>
              <span class="tp-no">No. {e.n}</span>
              <div class="tp-body">
                <p class="tp-ref">{e.ref}<span class="tp-tag">Problem {e.p} · {byId.get(e.p).title}</span></p>
                <p class="tp-verse">{e.verse}</p>
              </div>
              <p class="tp-issue"><b>The issue</b>{e.issue}</p>
            </li>
          ))}
        </ol>
      </div>

      <p class="tp-empty" data-tp-empty hidden>No entry matches that reference.</p>

      <section class="tp-closing">
        <h2>Their Three Verses, Answered</h2>
        <p>Three verses are raised against every list like this one. Each is answered by the verses standing beside it.</p>

        <h3>John 1:1 — “The Word was God”</h3>
        <p>The Word is God’s own word, belonging to Him the way a man’s word belongs to the man. It was “with God” and it was God’s: His expression, His plan, His speech. It is not a second person standing beside Him. The Old Testament speaks the same way: “By the word of Yahuah were the heavens made” (Psalm 33:6). In verse 14 that word “was made flesh,” and the flesh it became is the Son. The Father’s word took on a body; the Father did not become two.</p>

        <h3>Hebrews 1:8 — “Unto the Son he saith, Thy throne, O God”</h3>
        <p>The mix-up is “he saith.” The Greek is <em>pros</em>, and one verse earlier the KJV renders the same construction “of the angels he saith” (Hebrews 1:7). Read the same way, verse 8 is said of the Son, and the words come from Psalm 45:6, a wedding song for a king of David’s line. The next verse settles it: “God, even thy God, hath anointed thee with the oil of gladness above thy fellows” (Hebrews 1:9). The one spoken of has a God over Him, is anointed by that God, and has fellows.</p>

        <h3>John 20:28 — “My Master and my God”</h3>
        <p>Thomas saw the Father revealed through the Son. Yahushua had already told the disciples, “he that hath seen me hath seen the Father” (John 14:9). Three verses before Thomas speaks, Yahushua names His own God: “I ascend unto my Father, and your Father; and to my God, and your God” (John 20:17). Three verses after, John gives the purpose of the whole book: “that ye might believe that Yahushua is the Messiah, the Son of God” (John 20:31).</p>

        <h2>The Count</h2>
        <p>{fmt(entryCount)} entries and {fmt(passageCount)} distinct passages stand in this lexicon, and the list is not exhausted. Every one of them names God as one, names the Father as that God, and names Yahushua as His Son, His sent one, His anointed man. Not one names a third person seated, greeted, prayed to, or worshiped.</p>
        <p class="tp-last">The record ends where it began. In the last chapter of Scripture there is one throne, and it is “the throne of God and of the Lamb” (Revelation 22:1, 3). Two are named on it; the servants serve Him and see His face (Revelation 22:4). At the end of all things the third person is nowhere on the throne, and the Trinitarian must explain why.</p>
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  const KEY = 'trinity-problems:view';
  const store = {
    get() { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; } },
    set(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch { /* memory unavailable — fine */ } },
  };

  const bar = document.querySelector('[data-tp-bar]');
  const viewBtns = [...document.querySelectorAll('[data-tp-view]')];
  const select = document.querySelector('[data-tp-problem]');
  const search = document.querySelector('[data-tp-search]');
  const countEl = document.querySelector('[data-tp-count]');
  const empty = document.querySelector('[data-tp-empty]');
  const panels = Object.fromEntries([...document.querySelectorAll('[data-tp-panel]')].map((el) => [el.dataset.tpPanel, el]));

  // Keep the bar clear of the site's sticky header.
  const header = document.querySelector('.site-header');
  const fitBar = () => bar.style.setProperty('--tp-top', `${header ? header.getBoundingClientRect().height : 0}px`);
  fitBar();
  window.addEventListener('resize', fitBar);

  const saved = store.get() || {};
  let state = {
    view: saved.view === 'verse' ? 'verse' : 'problem',
    problem: [...select.options].some((o) => o.value === saved.problem) ? saved.problem : 'all',
    q: '',
  };

  // A reference matches when the query sits at a word start, and a query ending
  // in a number cannot run on into a longer one ("John 1" is not "John 10").
  const matcher = (q) => {
    const t = q.trim().toLowerCase().replace(/\s+/g, ' ');
    if (!t) return () => true;
    const esc = t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const re = new RegExp(`(^|\\s)${esc}${/\d$/.test(t) ? '(?!\\d)' : ''}`);
    return (ref) => re.test(ref.toLowerCase());
  };

  function render() {
    const match = matcher(state.q);
    const all = state.problem === 'all';
    for (const b of viewBtns) b.setAttribute('aria-pressed', String(b.dataset.tpView === state.view));
    for (const [k, el] of Object.entries(panels)) el.hidden = k !== state.view;

    let shown = 0;
    if (state.view === 'problem') {
      for (const g of panels.problem.querySelectorAll('[data-tp-group]')) {
        let n = 0;
        const inProblem = all || g.dataset.tpGroup === state.problem;
        for (const li of g.querySelectorAll('[data-tp-entry]')) {
          const on = inProblem && match(li.dataset.ref);
          li.hidden = !on;
          if (on) n++;
        }
        g.hidden = n === 0;
        shown += n;
      }
      for (const h of panels.problem.querySelectorAll('[data-tp-part]')) {
        // A part heading shows only under "All", and only when one of its problems shows.
        let sib = h.nextElementSibling, any = false;
        while (sib && !sib.matches('[data-tp-part]')) { if (!sib.hidden) any = true; sib = sib.nextElementSibling; }
        h.hidden = !all || !any;
      }
    } else {
      for (const li of panels.verse.querySelectorAll('[data-tp-entry]')) {
        const on = (all || li.dataset.p === state.problem) && match(li.dataset.ref);
        li.hidden = !on;
        if (on) shown++;
      }
    }
    countEl.textContent = `${shown.toLocaleString('en-US')} ${shown === 1 ? 'entry' : 'entries'}`;
    empty.hidden = shown > 0;
    store.set({ view: state.view, problem: state.problem });
  }

  for (const b of viewBtns) b.addEventListener('click', () => { state.view = b.dataset.tpView; render(); });
  select.value = state.problem;
  select.addEventListener('change', () => { state.problem = select.value; render(); });
  search.addEventListener('input', () => { state.q = search.value; render(); });
  render();
</script>

<style>
  .tp-page {
    --tp-bg: #f2ead9; --tp-paper: #f8f2e4; --tp-ink: #2b2117; --tp-muted: #6f5f4a;
    --tp-rule: #d9c8a6; --tp-gold: #7f601c; --tp-on-gold: #f8f2e4;
    --tp-display: 'Cormorant Garamond', Georgia, serif; --tp-body: 'EB Garamond', Garamond, Georgia, serif;
    background: var(--tp-bg); color: var(--tp-ink); font-family: var(--tp-body); font-size: 18px; line-height: 1.6;
    padding: 0 16px;
  }
  :global(html.dark) .tp-page {
    --tp-bg: #15110c; --tp-paper: #1d1812; --tp-ink: #ece2cc; --tp-muted: #a8977a;
    --tp-rule: #3b3123; --tp-gold: #d2a849; --tp-on-gold: #15110c;
  }
  .tp-wrap { max-width: 46rem; margin: 0 auto; padding: 2.5rem 0 4rem; }

  .tp-head { text-align: center; display: grid; gap: 0.4rem; padding-bottom: 1.6rem; border-bottom: 1px solid var(--tp-rule); }
  .tp-back { justify-self: start; font-family: var(--tp-display); font-size: 0.95rem; color: var(--tp-muted); text-decoration: none; margin-bottom: 0.8rem; }
  .tp-back:hover { color: var(--tp-gold); }
  .tp-eyebrow { font-family: var(--tp-display); letter-spacing: 0.18em; text-transform: uppercase; font-size: 0.8rem; color: var(--tp-gold); font-weight: 600; margin: 0; }
  .tp-title { font-family: var(--tp-display); font-weight: 700; font-size: clamp(2.4rem, 7vw, 3.6rem); line-height: 1.05; margin: 0; text-wrap: balance; color: var(--tp-ink); }
  .tp-sub { font-family: var(--tp-display); font-style: italic; font-size: 1.35rem; color: var(--tp-muted); margin: 0; }
  .tp-tally { font-variant-numeric: tabular-nums; color: var(--tp-muted); font-size: 0.95rem; margin: 0; }

  .tp-intro { display: grid; gap: 1rem; padding: 1.6rem 0; }
  .tp-intro p, .tp-intro ul { margin: 0; }
  .tp-intro ul { padding-left: 1.3rem; display: grid; gap: 0.3rem; }
  .tp-note { font-size: 0.95rem; color: var(--tp-muted); border-left: 2px solid var(--tp-gold); padding-left: 0.9rem; }

  .tp-bar {
    position: sticky; top: var(--tp-top, 0px); z-index: 20; background: var(--tp-bg);
    border-top: 1px solid var(--tp-rule); border-bottom: 1px solid var(--tp-rule);
    padding: 0.7rem 0; display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center;
  }
  .tp-seg { display: inline-flex; border: 1px solid var(--tp-rule); border-radius: 999px; overflow: hidden; }
  .tp-seg button { font: inherit; font-size: 0.92rem; background: transparent; color: var(--tp-ink); border: 0; padding: 0.35rem 0.9rem; cursor: pointer; }
  .tp-seg button[aria-pressed='true'] { background: var(--tp-gold); color: var(--tp-on-gold); }
  .tp-bar select, .tp-bar input { font: inherit; font-size: 0.92rem; color: var(--tp-ink); background: var(--tp-paper); border: 1px solid var(--tp-rule); border-radius: 6px; padding: 0.35rem 0.6rem; min-width: 0; }
  .tp-bar select { max-width: 100%; flex: 1 1 14rem; }
  .tp-bar input { flex: 1 1 9rem; }
  .tp-bar button:focus-visible, .tp-bar select:focus-visible, .tp-bar input:focus-visible { outline: 2px solid var(--tp-gold); outline-offset: 2px; }
  .tp-count { font-variant-numeric: tabular-nums; color: var(--tp-muted); font-size: 0.88rem; margin: 0 0 0 auto; }
  .tp-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .tp-part { font-family: var(--tp-display); text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.85rem; color: var(--tp-gold); margin: 2.6rem 0 0; font-weight: 600; }
  .tp-problem { padding-top: 1.4rem; }
  .tp-pnum { font-family: var(--tp-display); color: var(--tp-gold); font-size: 1rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; margin: 0; }
  .tp-ptitle { font-family: var(--tp-display); font-size: 1.75rem; line-height: 1.15; margin: 0.1rem 0 0.6rem; text-wrap: balance; color: var(--tp-ink); }
  .tp-ptext { background: var(--tp-paper); border: 1px solid var(--tp-rule); border-radius: 4px; padding: 0.9rem 1.1rem; margin: 0 0 0.8rem; }
  .tp-ptext b, .tp-issue b { font-family: var(--tp-display); letter-spacing: 0.12em; text-transform: uppercase; color: var(--tp-gold); font-weight: 700; }
  .tp-ptext b { display: block; font-size: 0.8rem; margin-bottom: 0.2rem; }

  .tp-list { list-style: none; margin: 0; padding: 0; }
  .tp-entry { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr); gap: 0.2rem 0.6rem; padding: 0.9rem 0; border-bottom: 1px solid var(--tp-rule); }
  .tp-no { font-variant-numeric: tabular-nums; color: var(--tp-muted); font-size: 0.85rem; padding-top: 0.15rem; }
  .tp-body { min-width: 0; }
  .tp-ref { font-family: var(--tp-display); font-weight: 700; font-size: 1.15rem; letter-spacing: 0.02em; margin: 0; }
  .tp-tag { display: block; font-family: var(--tp-body); font-weight: 400; font-size: 0.82rem; letter-spacing: 0; color: var(--tp-gold); }
  .tp-verse { margin: 0.15rem 0 0; }
  .tp-issue { grid-column: 2; margin: 0.45rem 0 0; padding-left: 0.8rem; border-left: 2px solid var(--tp-gold); font-size: 0.96rem; }
  .tp-issue b { font-size: 0.72rem; margin-right: 0.4rem; }
  .tp-empty { color: var(--tp-muted); padding: 2rem 0; text-align: center; margin: 0; }

  .tp-closing { margin-top: 3rem; border-top: 1px solid var(--tp-rule); padding-top: 1.4rem; display: grid; gap: 1rem; }
  .tp-closing h2 { font-family: var(--tp-display); font-size: 1.9rem; margin: 0; color: var(--tp-ink); }
  .tp-closing h3 { font-family: var(--tp-display); font-size: 1.3rem; margin: 0.6rem 0 0; color: var(--tp-ink); }
  .tp-closing p { margin: 0; }
  .tp-last { font-style: italic; }

  [hidden] { display: none !important; }
  @media (max-width: 520px) {
    .tp-entry { grid-template-columns: 2.6rem minmax(0, 1fr); }
    .tp-count { margin-left: 0; width: 100%; }
  }
</style>
