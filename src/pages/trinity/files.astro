---
// src/pages/trinity/files.astro · 1005 V1
// V1: the five-across card grid of written studies is retired. The page now
// carries every proof text, written and coming, as one numbered list built on
// the /parables pattern (TrinityFilesTracker, data in src/data/trinity-files.js).
// The rating sentence is gone from the intro: the star ratings went with the
// move to the Study Paper format.
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrinityFilesTracker from '../../components/TrinityFilesTracker.jsx';
import { getCollection } from 'astro:content';
import { trinityFiles } from '../../data/trinity-files.js';

// Build guard: a written entry whose slug has no live post would ship a 404,
// and a live Trinity File missing from the list would be invisible here.
const live = new Set((await getCollection('posts', ({ data }) =>
  data.draft !== true && data.category === 'The Trinity Files'
)).map((p) => p.slug));
const listed = new Set(trinityFiles.filter((f) => f.slug).map((f) => f.slug));
const dead = [...listed].filter((s) => !live.has(s));
const unlisted = [...live].filter((s) => !listed.has(s));
if (dead.length) throw new Error(`trinity-files.js: no live post for ${dead.join(', ')}`);
if (unlisted.length) throw new Error(`trinity-files.js: live Trinity File not on the list: ${unlisted.join(', ')}`);
---

<BaseLayout
  title="Trinity Files — Nazaryah"
  description="Every verse trinitarians use to defend their doctrine — examined, dismantled, and returned to its original context. One verse at a time, one file at a time."
>
  <div class="tr-wrap">

    <!-- ── HERO ── -->
    <section class="tr-hero">
      <a href="/trinity" class="tr-back">&#8592; Back to Trinity</a>
      <p class="tr-label">&#8213; One Verse at a Time &#8213;</p>
      <h1 class="tr-title">Trinity Files</h1>
      <p class="tr-sub">
        Every verse trinitarians use to defend their doctrine — examined, dismantled, and returned to its original context. If the case is as strong as they claim, it should be able to survive scrutiny.
      </p>
    </section>

    <!-- ── INTRO ── -->
    <section class="tr-section">
      <div class="tr-prose">
        <p>
          Trinitarian theology rests on a small collection of proof texts — verses that, on the surface, appear to call Yahushua "God" or to demonstrate a plurality within the divine nature. These same verses are repeated across centuries of sermons, creeds, and apologetics. Almost none of them survive close examination.
        </p>
        <p>
          Each file here takes one of those verses and walks through it carefully: the original language, the manuscript evidence, the context the verse sits in, and what the text actually says once the doctrinal lens is removed.
        </p>
      </div>
    </section>

    <!-- ── FOUNDATIONS DOORWAY ── -->
    <a class="fdoor" href="/foundations">
      <div class="fdoor-intro">
        <p class="fdoor-eyebrow">&#8213; The Foundations &#8213;</p>
        <p class="fdoor-desc">A handful of arguments turn up in study after study. Rather than re-explain them in every file, each is set down once here, in full — the deeper reading the verse studies point back to.</p>
      </div>
      <span class="fdoor-open">Open the Foundations&nbsp;<span class="arrow">&rarr;</span></span>
    </a>

    <!-- ── EVERY PROOF TEXT ── -->
    <section class="tr-posts-section" id="files" aria-label="Every proof text, in order">
      <h2 class="tf-heading">Every Proof Text, in Order.</h2>
      <p class="tf-intro">Every verse offered in defense of the Trinity, numbered in canonical order. Written files open; the rest are on the way.</p>
      <div class="tf-index" data-pagefind-ignore>
        <TrinityFilesTracker client:load />
      </div>
    </section>

    <!-- ── QUOTE ── -->
    <section class="tr-footer-quote">
      <p class="tr-quote-text">"Test everything; hold fast what is good."</p>
      <p class="tr-quote-ref">— 1 Thessalonians 5:21</p>
    </section>

  </div>
</BaseLayout>

<style>
  .tr-wrap {
    background: linear-gradient(180deg, #0e0904 0%, #1a1208 20%, #160f07 100%);
    color: #f0e0bf;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    min-height: 80vh;
  }

  .tr-hero {
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    border-bottom: 1px solid #4a3218;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(150, 90, 40, 0.18), transparent 70%),
      linear-gradient(180deg, #0a0602 0%, #1a1208 100%);
    position: relative;
  }

  .tr-back {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #8a6028;
    text-decoration: none;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }
  .tr-back:hover { color: #c4a46b; }

  .tr-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    color: #8a6028;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .tr-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: #f0e0bf;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .tr-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #c4a46b;
    font-style: italic;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tr-section {
    padding: 3rem 1.5rem;
    border-bottom: 1px solid #2e1f0d;
  }

  /* ── Foundations doorway ── */
  .fdoor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: center;
    max-width: 980px;
    margin: 10px auto 42px;
    padding: 26px 1.5rem;
    border-top: 1px solid #3a2510;
    border-bottom: 1px solid #3a2510;
    text-decoration: none;
    color: inherit;
  }

  .fdoor-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #8a6028;
    margin: 0 0 10px;
  }

  .fdoor-desc {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.55;
    color: #c4a46b;
    margin: 0;
    max-width: 52ch;
  }

  .fdoor-open {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: #8a6028;
    white-space: nowrap;
    position: relative;
    padding-bottom: 6px;
    transition: color 0.3s ease;
  }
  .fdoor-open::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: rgba(138, 96, 40, 0.45);
    transition: background 0.3s ease;
  }
  .fdoor-open .arrow {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .fdoor:hover .fdoor-open { color: #f0e0bf; }
  .fdoor:hover .fdoor-open::after { background: #8a6028; }
  .fdoor:hover .fdoor-open .arrow { transform: translateX(7px); }
  .fdoor:focus-visible { outline: 2px solid #8a6028; outline-offset: 4px; }

  @media (max-width: 680px) {
    .fdoor { grid-template-columns: 1fr; gap: 20px; padding: 24px 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fdoor-open, .fdoor-open::after, .fdoor-open .arrow { transition: none; }
  }

  .tr-prose {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #dcc99a;
  }
  .tr-prose p { margin-bottom: 1.2rem; }

  .tr-posts-section {
    padding: 1rem 1.5rem 3.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  .tr-footer-quote {
    text-align: center;
    padding: 3rem 1.5rem;
    border-top: 1px solid #2e1f0d;
  }

  .tr-quote-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #c4a46b;
    font-style: italic;
    max-width: 600px;
    margin: 0 auto 0.5rem;
    line-height: 1.6;
  }

  .tr-quote-ref {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #7a5520;
    text-transform: uppercase;
  }
</style>

<style is:global>
  /* The list is a React island, so its rules must be global; the `tf-` prefix
     keeps them on this page. Cloned from the pt- timeline on /parables, in the
     dark palette only — this page is dark in both site themes. */
  .tf-heading {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: #f0e0bf;
    text-align: center;
    margin: 0 0 0.75rem;
  }
  .tf-intro {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic; font-size: 1.1rem; line-height: 1.6;
    text-align: center; max-width: 40rem; margin: 0 auto 1.8rem;
    color: #c4a46b; text-wrap: pretty;
  }
  .tf-index { max-width: 48rem; margin: 0 auto; }

  /* ── SECTION CHIPS ── */
  .tf-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; }
  .tf-tab {
    flex: 1 1 auto;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(186, 117, 23, 0.35);
    background: rgba(30, 18, 8, 0.7);
    color: #c9b489;
    cursor: pointer;
    white-space: nowrap;
  }
  .tf-tab:hover { border-color: #8a6028; }
  .tf-tab-on, .tf-tab-on:hover { background: #8a6028; border-color: #8a6028; color: #f0e0bf; }

  /* ── SEARCH ── */
  .tf-searchrow { display: flex; gap: 0.5rem; margin-bottom: 0.6rem; }
  .tf-search {
    flex: 1;
    min-width: 0;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 1.05rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(186, 117, 23, 0.35);
    background: rgba(30, 18, 8, 0.7);
    color: #ded0b4;
  }
  .tf-search::placeholder { color: #8a7857; }
  .tf-search:focus { outline: none; border-color: #ba7517; }
  .tf-clear {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0 1rem;
    border: 1px solid rgba(186, 117, 23, 0.35);
    background: rgba(30, 18, 8, 0.7);
    color: #ba7517;
    cursor: pointer;
  }
  .tf-clear:hover { border-color: #8a6028; }

  .tf-count {
    font-family: 'Cinzel', Georgia, serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 1.75rem;
    color: #ba7517;
  }
  .tf-empty {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 1.05rem;
    color: #c9b489;
  }

  /* ── THE LIST ── one rule down the left, a numbered node per verse. A coming
     file is the bare, muted node; a written one wears the card. */
  .tf-list { list-style: none; margin: 0; padding: 0 0 0 2.5rem; position: relative; }
  .tf-list::before {
    content: "";
    position: absolute;
    left: 0.85rem; top: 0.5rem; bottom: 0.5rem;
    width: 1px;
    background: #5a4526;
  }
  .tf-node { position: relative; margin-bottom: 1.5rem; }
  .tf-num {
    position: absolute;
    left: -2.5rem; top: 0;
    width: 1.7rem; height: 1.7rem;
    line-height: 1.65rem;
    text-align: center;
    border-radius: 50%;
    border: 1px solid #5a4526;
    background: #160f07;
    color: #8a7857;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 0.66rem;
  }
  .tf-ref {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-variant: small-caps;
    font-size: 1.2rem;
    line-height: 1.2;
    color: #a8967a;
  }
  .tf-claim {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.45;
    margin-top: 0.15rem;
    color: #8a7857;
  }
  .tf-coming {
    display: inline-block;
    margin-top: 0.45rem;
    font-family: 'Cinzel', Georgia, serif;
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border: 1px solid #5a4526;
    color: #8a7857;
  }

  /* A written file — deeper ground, a gold spine, an arrow that moves. */
  .tf-done .tf-card {
    display: block;
    padding: 0.9rem 1.15rem;
    margin-left: -0.35rem;
    background: rgba(50, 30, 10, 0.7);
    border: 1px solid #3a2410;
    border-left: 3px solid #8a6028;
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .tf-done .tf-card:hover { border-color: #8a6028; }
  .tf-done .tf-num {
    top: 0.75rem;
    left: -2.15rem;
    background: #8a6028;
    border-color: #8a6028;
    color: #f0e0bf;
  }
  .tf-done .tf-ref { color: #c4a46b; font-size: 1.1rem; }
  .tf-title {
    font-family: 'Cinzel', serif;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 0.2rem;
    color: #f0e0bf;
  }
  .tf-deck {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.45;
    margin-top: 0.3rem;
    color: #b09060;
  }
  .tf-link {
    margin-top: 0.6rem;
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #ba7517;
  }
  .tf-arrow { display: inline-block; transition: transform 200ms ease; }
  .tf-done .tf-card:hover .tf-arrow { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) { .tf-arrow { transition: none; } }

  @media (max-width: 620px) {
    .tf-tab { font-size: 0.7rem; letter-spacing: 0.05em; padding: 0.55rem 0.6rem; }
    .tf-list { padding-left: 2.25rem; }
    .tf-num { left: -2.25rem; }
    .tf-done .tf-num { left: -1.9rem; }
    .tf-title { font-size: 1.08rem; }
  }
</style>
