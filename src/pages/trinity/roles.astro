---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ChapterCards from '../../components/ChapterCards.astro';
import { chapterMetaBySlug } from '../../data/books.js';

// Selection + order come from the posts' series/seriesOrder frontmatter — NOT the
// blog category, NOT publish date. Canonical card titles/topics come from the
// Books-page Contents master (books.js); the blurb is the study's own description.
const chapters = (await getCollection('posts', (p) => p.data.series === 'Five Titles, One Christ'))
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  .map((p) => {
    const meta = chapterMetaBySlug[p.slug] ?? {};
    return { num: p.data.seriesOrder, title: meta.title, topic: meta.topic, desc: p.data.description, href: `/blog/${p.slug}` };
  });
---

<BaseLayout
  title="Five Titles, One Christ — Nazaryah"
  description="Scripture never presents three. It presents two — one who sends, and one who is sent. Five titles the church gave to the wrong one, read back into their covenant context."
>
  <div class="tr-wrap">

    <!-- ── HERO ── -->
    <section class="tr-hero">
      <a href="/trinity" class="tr-back">&#8592; Back to Trinity</a>
      <p class="tr-label">&#8213; Five Titles, Two Figures &#8213;</p>
      <h1 class="tr-title">Five Titles, One Christ</h1>
      <p class="tr-sub">
        Scripture never presents three. It presents two — one who sends, and one who is sent. From the first pages of Torah to the last pages of Revelation, this pattern does not break.
      </p>
    </section>

    <!-- ── INTRO ── -->
    <section class="tr-section">
      <div class="tr-prose">
        <p>
          The Trinity doctrine collapses a clear covenant structure into a philosophical abstraction. But the text is not abstract. It is relational, directional, and deeply consistent. The Father gives a command — the Son carries it out. The Father sends — the Son goes. The Father glorifies — the Son receives the glory.
        </p>
        <p>
          These studies examine those roles directly: what the titles actually mean, where they come from in Hebrew Scripture, and what happens when they are placed back into their original covenant context rather than read through the lens of Nicaea.
        </p>
      </div>
    </section>

    <!-- ── CHAPTER CARDS (master order I → V) ── -->
    <ChapterCards chapters={chapters} />

    <!-- ── QUOTE ── -->
    <section class="tr-footer-quote">
      <p class="tr-quote-text">"For I have come down from heaven, not to do my own will, but the will of him who sent me."</p>
      <p class="tr-quote-ref">— John 6:38</p>
    </section>

  </div>
</BaseLayout>

<style>
  .tr-wrap {
    background: linear-gradient(180deg, #0e0904 0%, #1a1208 20%, #160f07 100%);
    color: #f0e0bf;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    min-height: 80vh;
  }

  .tr-hero {
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    border-bottom: 1px solid #4a3218;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(150, 90, 40, 0.18), transparent 70%),
      linear-gradient(180deg, #0a0602 0%, #1a1208 100%);
    position: relative;
  }

  .tr-back {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #8a6028;
    text-decoration: none;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }
  .tr-back:hover { color: #c4a46b; }

  .tr-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    color: #8a6028;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .tr-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: #f0e0bf;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .tr-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #c4a46b;
    font-style: italic;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tr-section {
    padding: 3rem 1.5rem;
    border-bottom: 1px solid #2e1f0d;
  }

  .tr-prose {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #dcc99a;
  }
  .tr-prose p { margin-bottom: 1.2rem; }

  .tr-footer-quote {
    text-align: center;
    padding: 3rem 1.5rem;
    border-top: 1px solid #2e1f0d;
  }

  .tr-quote-text {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #c4a46b;
    font-style: italic;
    max-width: 600px;
    margin: 0 auto 0.5rem;
    line-height: 1.6;
  }

  .tr-quote-ref {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #7a5520;
    text-transform: uppercase;
  }
</style>
