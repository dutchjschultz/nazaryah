---
// src/pages/riddles.astro · 1021 V5
// V5 (Etsy Riddles Board 1021 V2): the dropdown was too small and crowded the
// counter's rules, so it moves to the top-right of the page header, level with
// the "Riddles" title and flush with the column's right edge; on a phone it sits
// centered under the subtitle. It is a real button now — "All Riddles", a gold
// count badge (the riddle total, so it climbs on its own) and a chevron, 0.9rem,
// 44px tall, a gold border. The panel opens right under it, down and to the left
// (full column width on a phone; ≤760px, where the corner would crowd the title). The counter row is back to ◀ Riddle n of N ▶
// alone, centered between its rules.
// V4 (Etsy Riddles Board 1021 V1): the long "All riddles" list under the board is
// gone — the page ends on the riddle (and, once open, its Why It Matters study).
// In its place, "All riddles ▾" in the counter row: a <details> dropdown (works
// with JavaScript off), right end of the row on desktop, centered under the
// counter on a phone. Its panel floats over the board: one numbered row per
// riddle, oldest first, titles only, the one on the board gold with ●. Picking
// a row switches the board (same as the old list), then closes the dropdown; Esc
// or a click outside also closes it. Without JavaScript each row links to
// /riddle/<slug>/ (or /riddles?n=<number> for a page riddle).
// V3 (Etsy Riddles Board 1018 V2): a `kind: 'page'` riddle (Who Is "the Lord"?)
// shows the counter, its title, its teaser and, in place of the tiles, one
// burgundy pill (the "Need a nudge?" style) — its `cta` → its `href`. Its list
// line works like any other; with JavaScript off it links to /riddles?n=<number>
// (a page riddle has no /riddle/<slug>/ page).
// V2 (Etsy Riddles Board 1018 V1): ONE BOARD — one riddle at a time. It opens on
// the newest riddle; /riddles?n=<number> opens a given one. The counter row
// (◀ Riddle 2 of 2 ▶) steps by `number`, disabled at each end (no wrap), and
// writes ?n= to the address without a reload. Under it: the riddle's title and
// teaser, then the full four-step reveal (src/components/Riddle.astro, board
// mode). A riddle's open/closed state resets when the board leaves it. Under the
// board, "All riddles" — a plain numbered list, oldest first, title + teaser, the
// one on the board in gold. With JavaScript off only the newest riddle shows and
// each list title opens that riddle's own page (/riddle/<slug>/).
// The V1 card grid and its styles are gone.
// V1 (1017): an index of parchment cards.
import BaseLayout from '../layouts/BaseLayout.astro';
import Riddle from '../components/Riddle.astro';
import { riddlesByNumber, newestRiddle, isPage } from '../data/riddles.js';

const total = riddlesByNumber.length;
---

<BaseLayout
  title="Riddles — Nazaryah"
  description="Three verses. One logical answer. Every riddle for the logical mind, one at a time."
>
  <div class="rx-page">
    <div class="rx-wrap">
      <header class="rx-head">
        <h1 class="rx-title">Riddles</h1>
        <p class="rx-sub">Three verses. One logical answer.</p>
        <details class="rx-jump" id="rx-jump">
          <summary aria-label="All riddles, choose one"><span class="rx-jump-label">All Riddles</span> <span class="rx-badge" aria-hidden="true">{total}</span> <span class="rx-caret" aria-hidden="true"></span></summary>
          <ol class="rx-jump-list">
            {riddlesByNumber.map((r) => (
              <li>
                <a href={isPage(r) ? `/riddles?n=${r.number}` : `/riddle/${r.slug}/`} data-n={r.number}
                   class:list={['rx-row', { 'is-current': r.number === newestRiddle.number }]}
                   aria-current={r.number === newestRiddle.number ? 'true' : undefined}>
                  <span class="rx-row-n"><span class="rx-dot" aria-hidden="true">&#9679;</span>{r.number}.</span>
                  <span class="rx-row-t">{r.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      </header>

      <section class="rx-board" id="rx-board" aria-label="Riddle board">
        <nav class="rx-counter" aria-label="Step through the riddles">
          <button type="button" class="rx-arrow" id="rx-prev" aria-label="Previous riddle" disabled={newestRiddle.number === 1}>&#9664;</button>
          <span class="rx-count" aria-live="polite">Riddle <b id="rx-n">{newestRiddle.number}</b> of {total}</span>
          <button type="button" class="rx-arrow" id="rx-next" aria-label="Next riddle" disabled={newestRiddle.number === total}>&#9654;</button>
        </nav>

        {riddlesByNumber.map((r) => (
          <div class="rx-slide" data-n={r.number} hidden={r.number !== newestRiddle.number}>
            {isPage(r) ? (
              <div class="rx-pageriddle">
                <p class="rx-eyebrow">{r.title}</p>
                <p class="rx-lead">{r.teaser}</p>
                <a class="rx-pill" href={r.href}>{r.cta} <span aria-hidden="true">&rarr;</span></a>
              </div>
            ) : (
              <Riddle riddle={r} board />
            )}
          </div>
        ))}
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.rx-slide'));
  const nums = slides.map((s) => Number(s.dataset.n));
  const first = Math.min(...nums), last = Math.max(...nums);
  const prev = document.getElementById('rx-prev') as HTMLButtonElement;
  const next = document.getElementById('rx-next') as HTMLButtonElement;
  const nOut = document.getElementById('rx-n')!;
  const board = document.getElementById('rx-board')!;
  const jump = document.getElementById('rx-jump') as HTMLDetailsElement;
  const rows = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rx-row'));
  let current = Number(slides.find((s) => !s.hidden)?.dataset.n || last);

  // Close every tile, nudge and answer inside a slide.
  function reset(slide: HTMLElement) {
    slide.querySelectorAll<HTMLElement>('[data-rd-toggle]').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
      const target = document.getElementById(btn.getAttribute('aria-controls') || '');
      if (target) target.hidden = true;
    });
  }

  function show(n: number, updateUrl: boolean) {
    if (!nums.includes(n)) return;
    slides.forEach((s) => {
      const on = Number(s.dataset.n) === n;
      if (!on && !s.hidden) reset(s);
      s.hidden = !on;
    });
    current = n;
    nOut.textContent = String(n);
    prev.disabled = n <= first;
    next.disabled = n >= last;
    rows.forEach((a) => {
      const on = Number(a.dataset.n) === n;
      a.classList.toggle('is-current', on);
      if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
    });
    if (updateUrl) {
      const url = new URL(location.href);
      url.searchParams.set('n', String(n));
      history.replaceState(null, '', url);
    }
  }

  prev.addEventListener('click', () => show(current - 1, true));
  next.addEventListener('click', () => show(current + 1, true));
  rows.forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(Number(a.dataset.n), true);
      jump.open = false;
      board.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
  // The dropdown closes on Esc (focus back to its summary) or a click outside it.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && jump.open) {
      jump.open = false;
      jump.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (jump.open && !jump.contains(e.target as Node)) jump.open = false;
  });

  const asked = Number(new URLSearchParams(location.search).get('n'));
  if (nums.includes(asked)) show(asked, false);
</script>

<style>
  /* The riddle page's palette (src/components/Riddle.astro). */
  .rx-page {
    --rd-bg: #f2ead9; --rd-paper: #f8f2e4; --rd-ink: #2b2117; --rd-muted: #6f5f4a; --rd-rule: #d9c8a6;
    --rd-gold: #7f601c; --rd-burgundy: #7a1e2b; --rd-on-burgundy: #fbf3e2;
    background: var(--rd-bg); color: var(--rd-ink); padding: 0 16px;
    font-family: 'EB Garamond', Garamond, Georgia, serif; font-size: 18px; line-height: 1.6;
  }
  :global(html.dark) .rx-page {
    --rd-bg: #15110c; --rd-paper: #1d1812; --rd-ink: #ece2cc; --rd-muted: #a8977a; --rd-rule: #3b3123;
    --rd-gold: #d2a849; --rd-burgundy: #8a2533; --rd-on-burgundy: #fbf3e2;
  }
  .rx-wrap { max-width: 42rem; margin: 0 auto; padding: 3rem 0 4.5rem; }
  .rx-head { position: relative; text-align: center; margin-bottom: 1.8rem; }
  .rx-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(2rem, 6vw, 2.9rem); line-height: 1.1; margin: 0 0 0.6rem; color: var(--rd-ink); }
  .rx-sub { font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif; font-style: italic; font-size: 1.25rem; color: var(--rd-muted); margin: 0; }

  .rx-board { scroll-margin-top: 9rem; }
  .rx-counter { display: flex; align-items: center; justify-content: center; gap: 1rem; margin: 0 0 1.4rem; padding: 0.6rem 0; border-top: 1px solid var(--rd-rule); border-bottom: 1px solid var(--rd-rule); }
  .rx-count { font-family: 'Cinzel', serif; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--rd-ink); }
  .rx-count b { color: var(--rd-gold); }
  .rx-arrow {
    font: inherit; font-size: 0.85rem; line-height: 1; width: 2.4rem; height: 2.4rem; border-radius: 999px; cursor: pointer;
    background: var(--rd-paper); color: var(--rd-gold); border: 1px solid var(--rd-rule);
  }
  .rx-arrow:hover:not(:disabled) { border-color: var(--rd-gold); }
  .rx-arrow:focus-visible { outline: 2px solid var(--rd-gold); outline-offset: 3px; }
  .rx-arrow:disabled { opacity: 0.35; cursor: default; }
  .rx-slide[hidden] { display: none; }

  /* A page riddle on the board — title, teaser and one pill, matching the
     Riddle component's eyebrow, teaser and "Need a nudge?" button. */
  .rx-pageriddle { text-align: center; padding: 0 0 1rem; }
  .rx-eyebrow { font-family: 'Cinzel', serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--rd-gold); margin: 0 0 0.7rem; }
  .rx-lead { font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif; font-style: italic; font-size: 1.15rem; line-height: 1.5; color: var(--rd-muted); max-width: 34rem; margin: 0.2rem auto 2rem; text-wrap: pretty; }
  .rx-pill {
    display: inline-block; border-radius: 999px; padding: 0.55rem 1.4rem; text-decoration: none;
    font-family: 'Cinzel', serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    background: var(--rd-burgundy); color: var(--rd-on-burgundy); border: 1px solid var(--rd-burgundy);
  }
  .rx-pill:hover { filter: brightness(1.12); }
  .rx-pill:focus-visible { outline: 2px solid var(--rd-gold); outline-offset: 3px; }

  /* "All Riddles (N) ▾" — the jump dropdown, top-right of the header (V5). */
  .rx-jump { position: absolute; top: 0.15rem; right: 0; z-index: 30; text-align: left; }
  .rx-jump summary {
    list-style: none; cursor: pointer; box-sizing: border-box; min-height: 44px;
    display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.6rem 1.3rem;
    font-family: 'Cinzel', serif; font-size: 0.9rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1;
    color: var(--rd-ink); background: var(--rd-paper); border: 1.5px solid var(--rd-gold); border-radius: 999px; white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .rx-jump summary::-webkit-details-marker { display: none; }
  .rx-jump summary:hover, .rx-jump summary:focus-visible, .rx-jump[open] summary {
    background: rgba(127, 96, 28, 0.10); border-color: color-mix(in srgb, var(--rd-gold) 75%, #000);
  }
  :global(html.dark) .rx-jump summary:hover, :global(html.dark) .rx-jump summary:focus-visible, :global(html.dark) .rx-jump[open] summary {
    background: rgba(210, 168, 73, 0.14); border-color: #e7c36e;
  }
  .rx-jump summary:focus-visible { outline: 2px solid var(--rd-gold); outline-offset: 3px; }
  .rx-badge {
    display: inline-grid; place-items: center; min-width: 1.6rem; height: 1.6rem; padding: 0 0.3rem; box-sizing: border-box;
    border-radius: 999px; background: var(--rd-gold); color: var(--rd-paper);
    font-size: 0.75rem; letter-spacing: 0; font-variant-numeric: tabular-nums;
  }
  .rx-caret { font-size: 0.8rem; color: var(--rd-gold); }
  .rx-caret::before { content: '\25BE'; }
  .rx-jump[open] .rx-caret::before { content: '\25B4'; }
  .rx-jump-list {
    position: absolute; top: calc(100% + 0.5rem); right: 0; z-index: 40;
    width: 22rem; max-width: calc(100vw - 32px); max-height: 65vh; overflow-y: auto; overscroll-behavior: contain;
    margin: 0; padding: 0.35rem 0; list-style: none;
    background: var(--rd-paper); border: 1px solid var(--rd-rule); border-radius: 8px;
    box-shadow: 0 12px 32px rgba(43, 33, 23, 0.18), 0 2px 6px rgba(43, 33, 23, 0.1);
  }
  :global(html.dark) .rx-jump-list { box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55), 0 2px 6px rgba(0, 0, 0, 0.4); }
  .rx-jump-list li + li { border-top: 1px solid var(--rd-rule); }
  .rx-row { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.6rem; align-items: baseline; padding: 0.55rem 0.9rem; text-decoration: none; }
  .rx-row:hover, .rx-row:focus-visible { background: color-mix(in srgb, var(--rd-gold) 10%, transparent); outline: none; }
  .rx-row-n { font-family: 'Cinzel', serif; font-size: 0.82rem; font-weight: 700; color: var(--rd-gold); text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rx-dot { font-size: 0.5rem; margin-right: 0.3rem; vertical-align: 0.15em; visibility: hidden; }
  .rx-row-t { font-family: 'Playfair Display', Georgia, serif; font-size: 1rem; line-height: 1.3; color: var(--rd-ink); }
  .rx-row.is-current .rx-row-t { color: var(--rd-gold); }
  .rx-row.is-current .rx-dot { visibility: visible; }

  /* Phone and narrow tablet: centered under the subtitle; the panel takes the
     column's width. 760px, not 640: below about 730px the corner button would
     run into the centered "Riddles" title. */
  @media (max-width: 760px) {
    .rx-jump { position: static; margin-top: 1.1rem; text-align: center; }
    .rx-jump-list { top: calc(100% + 0.5rem); left: 0; right: 0; width: auto; max-width: none; text-align: left; }
  }
</style>
