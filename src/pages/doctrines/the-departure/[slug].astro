---
// src/pages/doctrines/the-departure/[slug].astro · 0804 V1
// One info page per Departure doctrine (carried-over hover body). The Old Paths
// counterpart link is derived from the same pair object in DoctrineInfo.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DoctrineInfo from '../../../components/DoctrineInfo.astro';
import { doctrines } from '../../../data/doctrines.data.js';

export function getStaticPaths() {
  return doctrines.map((pair) => ({ params: { slug: pair.departure.slug }, props: { pair } }));
}
const { pair } = Astro.props;
const e = pair.departure;
---

<BaseLayout title={`${e.title} — The Departure | Nazaryah`} description={e.deck}>
  <DoctrineInfo side="departure" pair={pair} />
</BaseLayout>
