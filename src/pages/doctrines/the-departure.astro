---
// src/pages/doctrines/the-departure.astro · 1009 V4
// V4: each card's bottom line now names its Old Paths partner — "→ THE NAME
// THAT ENDURES" and so on, from the pair's oldPaths.title (small caps via
// .doctrine-tag). The Old Paths cards carry the Departure title the same way,
// so every card names its partner. departure.tag stays in the data and still
// shows under the deck on the Departure page itself.
// V3: the doctrine grid carries borrowed="departure" — the Words Your Bible
// Borrowed intro above the cards and a dropdown under each doctrine card
// (DoctrineGrid V3).
// V2: the fixed count is out of the H1, the meta title and the meta description
// (og:image alt derives from the title, so it follows). Cards now carry the
// recognition tag.
// V1: The Departure master grid — the former /doctrines "Ten Doctrines the
// Church Got Wrong" page, moved here. Hover panels removed; each card is now a
// link to its info page. Driven by src/data/doctrines.data.js.
import BaseLayout from '../../layouts/BaseLayout.astro';
import DoctrineGrid from '../../components/DoctrineGrid.astro';
import { doctrines } from '../../data/doctrines.data.js';

const cards = doctrines.map((d) => ({
  n: d.n,
  title: d.departure.title,
  deck: d.departure.deck,
  // The card's bottom line names its Old Paths partner (V4).
  tag: `→ ${d.oldPaths.title}`,
  href: `/doctrines/the-departure/${d.departure.slug}`,
  slug: d.departure.slug,
}));
---

<BaseLayout
  title="The Departure — Doctrines the Church Got Wrong | Nazaryah"
  description="The doctrines the Church got wrong — and why it matters. Sacred names, Torah dismissal, the Trinity, immortal soul, hell, and more examined from Scripture."
>
  <DoctrineGrid
    eyebrow="The Departure"
    title="Doctrines the Church Got Wrong"
    subtitle="— and why it matters"
    cards={cards}
    borrowed="departure"
  >
    <a class="td-crosslink" href="/doctrines/old-paths">
      What Scripture holds — <strong>The Old Paths</strong> <span aria-hidden="true">&rarr;</span>
    </a>
    <a href="/blog" class="btn btn-stone px-8 py-3">Explore the Studies</a>
  </DoctrineGrid>
</BaseLayout>

<style>
  .td-crosslink {
    display: inline-block; padding: 1rem 1.6rem;
    background: linear-gradient(180deg, rgba(186,117,23,0.08), rgba(186,117,23,0.03));
    border: 1px solid rgba(186,117,23,0.4); border-left: 4px solid #BA7517; border-radius: 10px;
    font-family: var(--font-display); font-size: 0.95rem; letter-spacing: 0.04em;
    color: #d8b06a; text-decoration: none; transition: background 0.2s, border-color 0.2s;
  }
  .td-crosslink:hover { background: rgba(186,117,23,0.14); border-color: #BA7517; }
  .td-crosslink strong { color: #e8e2d4; font-weight: 700; }
</style>
