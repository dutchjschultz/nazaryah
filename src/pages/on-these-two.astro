---
// on-these-two 0810 V5.astro
// V5. Chain joints rebuilt: forged rings with a highlight pass, alternating tilt down the ladder,
// colour deepening toward the saying, and a broken open link as the final joint before the lie.
// V4 notes below still apply. The page ground is the site parchment, not black. Every element on it
// is now dark brown. Only the cards and the modal stay dark with cream type. Tile states reversed:
// inactive is parchment with brown lettering, active is the dark card. Root lines matched on both
// sides in one brown. The joint between rungs is now a drawn interlocking chain link.
// Layout import: site has no Layout.astro; BaseLayout takes { title, description }.
// Only this import path changed — the <Layout title description> call is untouched.
import Layout from '../layouts/BaseLayout.astro';
import { links } from '../data/on-these-two/links.data.js';
import { chains, hinges, categories } from '../data/on-these-two/chains.data.js';
import { filings, unfiledLinks } from '../lib/chain-filings.js';

// Build-time writing queue: every link with no study filed against it yet.
// Prints once during `astro build` (and on dev start). It is the writing queue.
const _unfiled = unfiledLinks(links);
console.log(
  `\n[On These Two] unfiled links — ${_unfiled.length}/${Object.keys(links).length} have no study filed:`
);
for (const _id of _unfiled) console.log('  •', _id);
if (_unfiled.length === 0) console.log('  (every link has at least one study filed)');

const payload = {
  hinges,
  categories,
  chains: chains.map((c) => ({
    id: c.id,
    saying: c.saying,
    hinge: c.hinge,
    category: c.category,
    spokenBy: c.spokenBy,
    aliases: c.aliases || [],
    linkIds: c.links,
    links: c.links.map((id) => {
      const l = links[id];
      if (!l) throw new Error(`On These Two: chain "${c.id}" references unknown link id "${id}"`);
      return {
        id,
        title: l.title,
        line: l.line,
        witnesses: l.witnesses || [],
        records: l.records || [],
        finding: l.finding || null,
        filings: filings[id] || [],
      };
    }),
    verdict: {
      witnesses: c.verdict?.witnesses || [],
      records: c.verdict?.records || [],
      finding: c.verdict?.finding || null,
      filings: [],
    },
  })),
};

const counts = {};
for (const h of hinges) counts[h.id] = chains.filter((c) => c.hinge === h.id).length;
---

<Layout title="On These Two" description="Every lie hangs on one of two hinges. Walk the chain down to what people say out loud.">
  <section class="ot">

    <header class="ot-mast">
      <p class="ot-over">On these two</p>
      <h1>Every Lie Hangs on One of Two Hinges</h1>
      <div class="ot-diamond" aria-hidden="true"><span></span><i></i><span></span></div>
      <p class="ot-lede">Pick a hinge. Walk the chain down. The last link is what people say out loud.</p>
    </header>

    <div class="ot-hinges">
      {hinges.map((h) => (
        <button class={`ot-tile ot-tile-${h.id}`} data-hinge={h.id} type="button" aria-pressed="false">
          <span class="ot-tile-name">{h.name}</span>
          <span class="ot-tile-line">{h.line}</span>
          <span class="ot-tile-count">{counts[h.id]} chains</span>
        </button>
      ))}
    </div>

    <svg class="ot-band" viewBox="0 0 800 130" preserveAspectRatio="none" aria-hidden="true">
      <g class="ot-root">
        <path d="M200 0 V28" />
        <path d="M200 28 C200 64 96 64 66 130" />
        <path d="M200 28 C200 72 168 80 150 130" />
        <path d="M200 28 C200 72 232 80 250 130" />
        <path d="M200 28 C200 64 304 64 334 130" />
        <path d="M600 0 V28" />
        <path d="M600 28 C600 64 496 64 466 130" />
        <path d="M600 28 C600 72 568 80 550 130" />
        <path d="M600 28 C600 72 632 80 650 130" />
        <path d="M600 28 C600 64 704 64 734 130" />
      </g>
    </svg>

    <div class="ot-filters">
      <label class="ot-field">
        <span>Hinge</span>
        <select id="ot-hinge">
          <option value="all">All</option>
          {hinges.map((h) => <option value={h.id}>{h.name}</option>)}
        </select>
      </label>
      <label class="ot-field">
        <span>Category</span>
        <select id="ot-cat">
          <option value="all">All</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
    </div>

    <div id="ot-chain" class="ot-chain" aria-live="polite"></div>

    <div class="ot-picker">
      <label class="ot-field ot-grow">
        <span>Saying</span>
        <select id="ot-pick"></select>
      </label>
      <div class="ot-count"><strong id="ot-total">0</strong><span>total</span></div>
      <label class="ot-field ot-grow">
        <span>Search</span>
        <input id="ot-q" type="search" placeholder="grace, saturn, colossians" autocomplete="off" />
      </label>
      <button id="ot-search" class="ot-searchbtn" type="button">Search</button>
    </div>

  </section>

  <div id="ot-modal" class="ot-modal" role="dialog" aria-modal="true" aria-labelledby="ot-modal-title" hidden>
    <div class="ot-scrim" data-close></div>
    <div class="ot-panel">
      <button class="ot-x" type="button" data-close aria-label="Close">&times;</button>
      <div id="ot-modal-body"></div>
      <div class="ot-foot">
        <button class="ot-step" type="button" data-step="-1">&larr; Previous</button>
        <span id="ot-modal-pos" class="ot-pos"></span>
        <button class="ot-step" type="button" data-step="1">Next &rarr;</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="ot-data" set:html={JSON.stringify(payload)}></script>

  <script>
    const DATA = JSON.parse(document.getElementById('ot-data').textContent);
    const elHinge = document.getElementById('ot-hinge');
    const elCat = document.getElementById('ot-cat');
    const elPick = document.getElementById('ot-pick');
    const elQ = document.getElementById('ot-q');
    const elTotal = document.getElementById('ot-total');
    const elChain = document.getElementById('ot-chain');
    const elModal = document.getElementById('ot-modal');
    const elBody = document.getElementById('ot-modal-body');
    const elPos = document.getElementById('ot-modal-pos');

    const order = DATA.chains.map((c) => c.id);
    for (let i = order.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [order[i], order[j]] = [order[j], order[i]];
    }

    const shared = {};
    DATA.chains.forEach((c) => c.linkIds.forEach((id) => { shared[id] = (shared[id] || 0) + 1; }));

    let current = null;
    let openIndex = -1;
    let lastFocus = null;

    const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));

    // A drawn chain link. Two rings, the upper one repainted over the lower so it reads as interlocked.
    // A forged chain link: vertical ring, horizontal ring, vertical ring. The perpendicular middle
    // ring is what makes it read as chain rather than a stack of ovals. Each ring is stroked twice,
    // a heavy dark pass then a thin light pass offset up and left, which gives it round metal.
    const V_TOP = 'M23 3 a7 7 0 0 0 -7 7 v13 a7 7 0 0 0 14 0 v-13 a7 7 0 0 0 -7 -7 z';
    const H_MID = 'M13 27 a6.5 6.5 0 0 0 0 13 h20 a6.5 6.5 0 0 0 0 -13 z';
    const V_BOT = 'M23 37 a7 7 0 0 0 -7 7 v13 a7 7 0 0 0 14 0 v-13 a7 7 0 0 0 -7 -7 z';
    // The middle ring, snapped. Two open halves pulling away from each other.
    const H_LEFT = 'M22 27 h-9 a6.5 6.5 0 0 0 0 13 h11';
    const H_RIGHT = 'M24 27 h9 a6.5 6.5 0 0 1 0 13 h-11';

    const JOINT = `<svg class="ot-joint-svg" viewBox="0 0 46 68" aria-hidden="true">
      <path class="ot-ring" d="${V_TOP}" />
      <path class="ot-ring" d="${H_MID}" />
      <path class="ot-ring" d="${V_BOT}" />
      <g class="ot-shine">
        <path d="${V_TOP}" /><path d="${H_MID}" /><path d="${V_BOT}" />
      </g>
    </svg>`;

    const JOINT_BROKEN = `<svg class="ot-joint-svg ot-joint-svg-broken" viewBox="0 0 46 68" aria-hidden="true">
      <path class="ot-ring" d="${V_TOP}" />
      <path class="ot-ring ot-snap" transform="translate(-4 0)" d="${H_LEFT}" />
      <path class="ot-ring ot-snap" transform="translate(5 1)" d="${H_RIGHT}" />
      <path class="ot-ring" transform="translate(1 4)" d="${V_BOT}" />
      <g class="ot-shine">
        <path d="${V_TOP}" />
        <path class="ot-snap" transform="translate(-4 0)" d="${H_LEFT}" />
        <path class="ot-snap" transform="translate(5 1)" d="${H_RIGHT}" />
        <path transform="translate(1 4)" d="${V_BOT}" />
      </g>
    </svg>`;

    function matches(c) {
      if (elHinge.value !== 'all' && c.hinge !== elHinge.value) return false;
      if (elCat.value !== 'all' && c.category !== elCat.value) return false;
      const q = elQ.value.trim().toLowerCase();
      if (!q) return true;
      return c.saying.toLowerCase().includes(q)
        || c.category.toLowerCase().includes(q)
        || c.aliases.some((a) => a.includes(q))
        || c.links.some((l) => l.title.toLowerCase().includes(q)
          || l.witnesses.some((w) => w[0].toLowerCase().includes(q))
          || l.records.some((r) => r.source.toLowerCase().includes(q)));
    }

    function render(c) {
      current = c;
      if (!c) { elChain.innerHTML = '<p class="ot-empty">Nothing matches those filters yet.</p>'; return; }
      const hinge = DATA.hinges.find((h) => h.id === c.hinge);
      const n = c.links.length;

      let h = `<div class="ot-head">
        <span class="ot-badge">${esc(hinge.name)}</span>
        <span class="ot-arrow" aria-hidden="true">&rarr;</span>
        <span class="ot-saying">&ldquo;${esc(c.saying)}&rdquo;</span>
        <span class="ot-linkcount">${n + 1} links</span>
      </div>
      <p class="ot-sub">${esc(c.category)} &middot; ${esc(c.spokenBy)}</p>
      <ol class="ot-ladder">`;

      c.links.forEach((l, i) => {
        const t = Math.round((i / n) * 100);
        const marks = [];
        if (l.records.length) marks.push(`${l.records.length} on the record`);
        if (shared[l.id] > 1) marks.push(`held by ${shared[l.id]} chains`);
        h += `<li class="ot-rung" style="--t:${t}%">
          <button class="ot-rung-btn" data-i="${i}" type="button">
            <span class="ot-num">${i + 1}</span>
            <span class="ot-rung-copy">
              <span class="ot-rung-title">${esc(l.title)}</span>
              <span class="ot-rung-line">${esc(l.line)}</span>
              ${marks.length ? `<span class="ot-marks">${marks.map((m) => `<span>${esc(m)}</span>`).join('')}</span>` : ''}
            </span>
            <span class="ot-cue">Evidence</span>
          </button>
        </li>
        <li class="ot-joint${i === n - 1 ? ' ot-joint-break' : ''}" aria-hidden="true" style="--t:${Math.round(((i + 0.5) / n) * 100)}%">${i === n - 1 ? JOINT_BROKEN : JOINT}</li>`;
      });

      h += `<li class="ot-rung ot-said" style="--t:100%">
          <button class="ot-rung-btn" data-i="${n}" type="button">
            <span class="ot-num">${n + 1}</span>
            <span class="ot-rung-copy">
              <span class="ot-said-label">What they say today</span>
              <span class="ot-said-text">&ldquo;${esc(c.saying)}&rdquo;</span>
            </span>
            <span class="ot-cue">The answer</span>
          </button>
        </li></ol>`;

      elChain.className = `ot-chain ot-h-${c.hinge}`;
      elChain.innerHTML = h;
      elChain.querySelectorAll('.ot-rung-btn').forEach((b) => {
        b.addEventListener('click', () => openModal(Number(b.dataset.i)));
      });
    }

    function evidenceHtml(node) {
      let h = '';
      if (node.witnesses && node.witnesses.length) {
        h += '<p class="ot-ev-label">Witnesses</p><dl class="ot-verses">';
        node.witnesses.forEach((w) => {
          h += `<div class="ot-verse"><dt>${esc(w[0])}</dt><dd>${esc(w[1])}</dd></div>`;
        });
        h += '</dl>';
      }
      if (node.records && node.records.length) {
        h += '<p class="ot-ev-label">The record</p><ol class="ot-records">';
        node.records.forEach((r) => {
          h += `<li class="ot-rec">
            <p class="ot-rec-head"><span class="ot-rec-src">${esc(r.source)}</span><span class="ot-rec-date">${esc(r.date)}</span></p>
            <p class="ot-rec-note">${esc(r.note)}</p>
          </li>`;
        });
        h += '</ol>';
      }
      if (node.finding) h += `<p class="ot-finding">${esc(node.finding)}</p>`;
      if (node.filings && node.filings.length) {
        h += '<p class="ot-ev-label">Filed with this link</p><p class="ot-chips">';
        node.filings.forEach((f) => { h += `<a class="ot-chip" href="${esc(f.url)}">${esc(f.title)}</a>`; });
        h += '</p>';
      }
      return h;
    }

    function openModal(i) {
      if (!current) return;
      openIndex = i;
      const n = current.links.length;
      const isSaid = i === n;
      const node = isSaid ? current.verdict : current.links[i];
      const hinge = DATA.hinges.find((h) => h.id === current.hinge);
      const t = Math.round((i / n) * 100);

      let h = `<p class="ot-eyebrow">${esc(hinge.name)} &middot; &ldquo;${esc(current.saying)}&rdquo;</p>`;
      if (isSaid) {
        h += `<p class="ot-kicker">What they say today</p>
              <h2 id="ot-modal-title" class="ot-modal-title">&ldquo;${esc(current.saying)}&rdquo;</h2>`;
      } else {
        h += `<h2 id="ot-modal-title" class="ot-modal-title"><span class="ot-modal-num">${i + 1}</span>${esc(node.title)}</h2>
              <p class="ot-modal-line">${esc(node.line)}</p>`;
        if (shared[node.id] > 1) h += `<p class="ot-shared">This link is held by ${shared[node.id]} chains.</p>`;
      }
      h += evidenceHtml(node);

      elBody.innerHTML = h;
      elModal.style.setProperty('--t', t + '%');
      elModal.className = `ot-modal ot-h-${current.hinge}`;
      elPos.textContent = `Link ${i + 1} of ${n + 1}`;
      elModal.querySelectorAll('.ot-step').forEach((b) => {
        const to = i + Number(b.dataset.step);
        b.disabled = to < 0 || to > n;
      });

      lastFocus = document.activeElement;
      elModal.hidden = false;
      document.body.classList.add('ot-locked');
      elModal.querySelector('.ot-panel').scrollTop = 0;
      elModal.querySelector('.ot-x').focus();
    }

    function closeModal() {
      elModal.hidden = true;
      document.body.classList.remove('ot-locked');
      if (lastFocus) lastFocus.focus();
    }

    elModal.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', closeModal));
    elModal.querySelectorAll('.ot-step').forEach((b) => {
      b.addEventListener('click', () => openModal(openIndex + Number(b.dataset.step)));
    });
    document.addEventListener('keydown', (e) => {
      if (elModal.hidden) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight' && openIndex < current.links.length) openModal(openIndex + 1);
      if (e.key === 'ArrowLeft' && openIndex > 0) openModal(openIndex - 1);
    });

    function refresh(keepSelection) {
      const list = order.map((id) => DATA.chains.find((c) => c.id === id)).filter(matches);
      elTotal.textContent = list.length;
      const prev = elPick.value;
      elPick.innerHTML = '';
      list.forEach((c) => {
        const o = document.createElement('option');
        o.value = c.id;
        o.textContent = '\u201C' + c.saying + '\u201D';
        elPick.appendChild(o);
      });
      if (keepSelection && list.some((c) => c.id === prev)) elPick.value = prev;
      render(list.find((c) => c.id === elPick.value));
    }

    elHinge.addEventListener('change', () => { syncTiles(); refresh(true); });
    elCat.addEventListener('change', () => refresh(true));
    elQ.addEventListener('input', () => refresh(true));
    elQ.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); refresh(true); elQ.blur(); } });
    document.getElementById('ot-search').addEventListener('click', () => { refresh(true); elQ.blur(); });
    elPick.addEventListener('change', () => render(DATA.chains.find((c) => c.id === elPick.value)));

    // No hinge chosen means both tiles read as active. Choosing one makes the other go quiet.
    function syncTiles() {
      const v = elHinge.value;
      document.querySelectorAll('.ot-tile').forEach((x) => {
        const on = v === 'all' || x.dataset.hinge === v;
        x.classList.toggle('is-off', !on);
        x.setAttribute('aria-pressed', String(v === x.dataset.hinge));
      });
    }
    document.querySelectorAll('.ot-tile').forEach((t) => {
      t.addEventListener('click', () => {
        const id = t.dataset.hinge;
        elHinge.value = elHinge.value === id ? 'all' : id;
        syncTiles();
        refresh(true);
      });
    });

    syncTiles();
    refresh(false);
  </script>

  <!--
    is:global is required. The chain is injected at runtime, so scoped styles never reach it.
    Custom properties live on :root, NOT on .ot. The modal is a sibling of .ot.

    COLOR RULE FOR THIS PAGE
    Anything sitting directly on the parchment ground uses --ot-ink or --ot-ink-2, both dark brown.
    Cream and gold appear only inside a dark card or inside the modal. Do not put gold text on
    parchment. That is what made V3 unreadable.
  -->
  <style is:global>
    :root {
      --ot-ink: #3b2a12;
      --ot-ink-2: #6a5433;
      --ot-ink-line: rgba(59, 42, 18, .32);
      --ot-ink-wash: rgba(59, 42, 18, .07);

      --ot-black: #0d0b09;
      --ot-panel: #17130e;
      --ot-panel-2: #1e1913;
      --ot-gold: #c8912f;
      --ot-gold-lit: #e3b559;
      --ot-silver: #a9b3c6;
      --ot-silver-lit: #cfd6e2;
      --ot-blood: #a8433a;
      --ot-blood-lit: #cd6a5c;
      --ot-cream: #e9e2d3;
      --ot-mute: #9b9080;
      --ot-rule: rgba(200, 145, 47, .22);
    }

    .ot { max-width: 1000px; margin: 0 auto; padding: 2.5rem 1.25rem 5rem; color: var(--ot-ink); }

    /* ---------- masthead, on parchment ---------- */

    .ot-mast { text-align: center; margin-bottom: 2.25rem; }
    .ot-over { font-size: .74rem; letter-spacing: .3em; text-transform: uppercase; color: var(--ot-ink-2); margin: 0; }
    .ot-mast h1 { font-family: Georgia, serif; font-variant: small-caps; color: var(--ot-ink); font-size: clamp(1.7rem, 4.4vw, 2.8rem); font-weight: 400; margin: .6rem 0 0; letter-spacing: .02em; }
    .ot-diamond { display: flex; align-items: center; justify-content: center; gap: .9rem; margin: .9rem 0; }
    .ot-diamond span { display: block; width: 62px; height: 1px; background: linear-gradient(90deg, transparent, var(--ot-ink)); }
    .ot-diamond span:last-child { background: linear-gradient(90deg, var(--ot-ink), transparent); }
    .ot-diamond i { width: 9px; height: 9px; border: 1px solid var(--ot-ink); transform: rotate(45deg); }
    .ot-lede { font-family: Georgia, serif; font-style: italic; color: var(--ot-ink-2); margin: 0; }

    /* ---------- hinge tiles: quiet state is parchment with brown type ---------- */

    .ot-hinges { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
    .ot-tile {
      display: block; width: 100%; text-align: left; cursor: pointer; font: inherit;
      padding: 1.35rem 1.5rem; border-radius: 10px;
      background: linear-gradient(180deg, var(--ot-panel-2), var(--ot-panel));
      border: 1px solid var(--ot-rule); border-top: 3px solid var(--ot-gold);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .ot-tile:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(0,0,0,.35); }
    .ot-tile-name { display: block; font-family: Georgia, serif; font-variant: small-caps; font-size: 1.5rem; letter-spacing: .04em; }
    .ot-tile-line { display: block; font-family: Georgia, serif; font-style: italic; font-size: 1rem; margin-top: .45rem; color: var(--ot-mute); }
    .ot-tile-count { display: block; font-size: .72rem; letter-spacing: .22em; text-transform: uppercase; margin-top: 1rem; }
    .ot-tile-torah { border-top-color: var(--ot-gold); }
    .ot-tile-torah .ot-tile-name, .ot-tile-torah .ot-tile-count { color: var(--ot-gold-lit); }
    .ot-tile-trinity { border-top-color: var(--ot-silver); }
    .ot-tile-trinity .ot-tile-name, .ot-tile-trinity .ot-tile-count { color: var(--ot-silver-lit); }

    .ot-tile.is-off { background: var(--ot-ink-wash); border-color: var(--ot-ink-line); box-shadow: none; }
    .ot-tile.is-off .ot-tile-name,
    .ot-tile.is-off .ot-tile-count { color: var(--ot-ink); }
    .ot-tile.is-off .ot-tile-line { color: var(--ot-ink-2); }
    .ot-tile-torah.is-off { border-top-color: var(--ot-ink); }
    .ot-tile-trinity.is-off { border-top-color: var(--ot-ink); }

    /* ---------- roots: one brown, both sides identical ---------- */

    .ot-band { display: block; width: 100%; height: 118px; }
    .ot-root path { fill: none; stroke: var(--ot-ink); stroke-width: 1.4; opacity: .55; }
    @media (max-width: 640px) { .ot-band { height: 64px; } }

    /* ---------- controls, on parchment ---------- */

    .ot-filters, .ot-picker { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; padding: 1rem 0; border-top: 1px solid var(--ot-ink-line); }
    .ot-filters { border-bottom: 1px solid var(--ot-ink-line); }
    .ot-field { display: flex; flex-direction: column; gap: .35rem; }
    .ot-field > span { font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--ot-ink); }
    .ot-grow { flex: 1 1 220px; }
    .ot-field select, .ot-field input { font: inherit; font-size: .95rem; padding: .6rem .8rem; border: 1px solid var(--ot-rule); border-radius: 8px; background: var(--ot-panel); color: var(--ot-cream); width: 100%; }
    .ot-field select:focus, .ot-field input:focus { outline: none; border-color: var(--ot-gold); }
    .ot-count { text-align: center; background: var(--ot-panel); border: 1px solid var(--ot-rule); border-radius: 8px; padding: .5rem 1.1rem; }
    .ot-count strong { display: block; font-family: Georgia, serif; font-size: 1.3rem; color: var(--ot-gold-lit); }
    .ot-count span { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--ot-mute); }
    .ot-searchbtn { font: inherit; font-family: Georgia, serif; font-variant: small-caps; font-size: 1.05rem; letter-spacing: .08em; padding: .62rem 1.6rem; border: 1px solid var(--ot-ink); border-radius: 8px; background: var(--ot-ink); color: var(--ot-cream); cursor: pointer; }
    .ot-searchbtn:hover { background: #2b1e0c; }

    /* ---------- chain header, on parchment ---------- */

    .ot-chain { --acc: var(--ot-gold); --acc-lit: var(--ot-gold-lit); margin: 2rem 0; min-height: 340px; }
    .ot-chain.ot-h-trinity, .ot-modal.ot-h-trinity { --acc: var(--ot-silver); --acc-lit: var(--ot-silver-lit); }
    .ot-chain.ot-h-torah, .ot-modal.ot-h-torah { --acc: var(--ot-gold); --acc-lit: var(--ot-gold-lit); }
    .ot-empty { color: var(--ot-ink-2); text-align: center; padding: 4rem 0; font-family: Georgia, serif; font-style: italic; }

    .ot-head { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
    .ot-badge { font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; padding: .32rem .85rem; border-radius: 999px; border: 1px solid var(--ot-ink); background: var(--ot-ink); color: var(--ot-cream); }
    .ot-arrow { color: var(--ot-ink-2); }
    .ot-saying { font-family: Georgia, serif; font-size: 1.5rem; color: var(--ot-ink); }
    .ot-linkcount { font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: var(--ot-ink-2); }
    .ot-sub { font-family: Georgia, serif; font-style: italic; font-size: .95rem; color: var(--ot-ink-2); margin: .5rem 0 1.5rem; }

    /* ---------- rungs: dark cards, cream type ---------- */

    .ot-ladder { list-style: none; margin: 0; padding: 0; }
    .ot-rung { margin: 0; }
    .ot-rung-btn {
      display: flex; align-items: flex-start; gap: 1.1rem; width: 100%; text-align: left; cursor: pointer; font: inherit;
      padding: 1.15rem 1.35rem; border-radius: 10px;
      background: linear-gradient(180deg, var(--ot-panel-2), var(--ot-panel));
      border: 1px solid var(--ot-rule);
      border-top: 3px solid var(--acc);
      border-top-color: color-mix(in oklab, var(--ot-blood) var(--t), var(--acc));
      color: var(--ot-cream);
      transition: transform .14s ease, box-shadow .14s ease, border-color .14s ease;
    }
    .ot-rung-btn:hover { transform: translateX(4px); box-shadow: 0 12px 30px rgba(0,0,0,.4); border-color: var(--acc); }

    .ot-num {
      flex: 0 0 auto; width: 32px; height: 32px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: Georgia, serif; font-size: .95rem; color: var(--ot-black);
      background: var(--acc-lit);
      background: color-mix(in oklab, var(--ot-blood-lit) var(--t), var(--acc-lit));
    }
    .ot-rung-copy { flex: 1; min-width: 0; }
    .ot-rung-title { display: block; font-family: Georgia, serif; font-variant: small-caps; font-size: 1.25rem; letter-spacing: .03em; color: var(--ot-cream); }
    .ot-rung-line { display: block; font-size: .95rem; margin-top: .25rem; color: var(--ot-mute); line-height: 1.6; }
    .ot-marks { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .65rem; }
    .ot-marks span { font-size: .64rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ot-mute); border: 1px solid var(--ot-rule); border-radius: 999px; padding: .2rem .6rem; }
    .ot-cue { flex: 0 0 auto; align-self: center; font-size: .64rem; letter-spacing: .2em; text-transform: uppercase; padding: .38rem .85rem; border-radius: 999px; border: 1px solid var(--acc); color: var(--acc-lit); }
    @media (max-width: 700px) { .ot-cue { display: none; } }

    /* ---------- the joint: a drawn interlocking link, sits on parchment so it is brown ---------- */

    .ot-joint { display: flex; justify-content: center; margin: -1px 0; }
    .ot-joint-svg { width: 31px; height: 46px; display: block; overflow: visible; }
    /* Alternating tilt so the ladder reads as slack chain, not a column of identical marks. */
    /* Rungs and joints are all <li> in one <ol>, so joints always sit on even
       :nth-of-type. Count position across the interleaved list with :nth-child
       (joints at 2/6/10 vs 4/8/12) and exclude the break so it stays straight. */
    .ot-joint:nth-child(4n+2):not(.ot-joint-break) .ot-joint-svg { transform: rotate(4deg); }
    .ot-joint:nth-child(4n):not(.ot-joint-break) .ot-joint-svg { transform: rotate(-4deg); }
    /* The ring deepens toward crimson as the chain descends, tracking the card borders. */
    .ot-ring {
      fill: none; stroke-width: 4.6;
      stroke: var(--ot-ink);
      stroke: color-mix(in oklab, #5c1712 var(--t, 0%), var(--ot-ink));
    }
    .ot-shine { fill: none; stroke: #d9c79c; stroke-width: 1.5; opacity: .5; transform: translate(-.7px, -.7px); }
    .ot-snap { stroke-linecap: round; }
    /* The last joint before the saying. The chain does not simply end. It breaks. */
    .ot-joint-break { margin: 3px 0 5px; }
    .ot-joint-break .ot-joint-svg { transform: none; }

    .ot-said .ot-rung-btn { padding: 1.5rem 1.35rem; border-top-width: 4px; border-top-color: var(--ot-blood); }
    .ot-said-label { display: block; font-size: .66rem; letter-spacing: .24em; text-transform: uppercase; color: var(--ot-blood-lit); }
    .ot-said-text { display: block; font-family: Georgia, serif; font-size: 1.6rem; margin-top: .35rem; color: var(--ot-cream); }
    .ot-said .ot-cue { border-color: var(--ot-blood); color: var(--ot-blood-lit); }

    /* ---------- modal ---------- */

    body.ot-locked { overflow: hidden; }
    .ot-modal[hidden] { display: none; }
    .ot-modal { --acc: var(--ot-gold); --acc-lit: var(--ot-gold-lit); position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 1.25rem; }
    .ot-scrim { position: absolute; inset: 0; background: rgba(6, 5, 4, .88); }
    .ot-panel {
      position: relative; z-index: 1; width: min(680px, 100%); max-height: 88vh; overflow-y: auto;
      background: #17130e; border: 1px solid var(--ot-rule);
      border-top: 5px solid var(--acc);
      border-top-color: color-mix(in oklab, var(--ot-blood) var(--t, 0%), var(--acc));
      border-radius: 10px; padding: 2.25rem 2.25rem 1rem;
      box-shadow: 0 30px 80px rgba(0,0,0,.8);
    }
    .ot-x { position: absolute; top: .6rem; right: 1rem; background: none; border: 0; font-size: 2rem; line-height: 1; color: var(--ot-mute); cursor: pointer; }
    .ot-x:hover { color: var(--ot-gold-lit); }
    .ot-eyebrow { font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; color: var(--acc-lit); margin: 0 0 1.2rem; }
    .ot-kicker { font-size: .66rem; letter-spacing: .24em; text-transform: uppercase; color: var(--ot-blood-lit); margin: 0; }
    .ot-modal-title { font-family: Georgia, serif; font-variant: small-caps; font-weight: 400; font-size: 1.85rem; color: var(--ot-cream); margin: 0 0 .5rem; display: flex; align-items: center; gap: .8rem; letter-spacing: .02em; }
    .ot-modal-num { flex: 0 0 auto; width: 36px; height: 36px; border-radius: 50%; font-size: 1rem; display: inline-flex; align-items: center; justify-content: center; color: var(--ot-black); background: var(--acc-lit); background: color-mix(in oklab, var(--ot-blood-lit) var(--t), var(--acc-lit)); }
    .ot-modal-line { font-family: Georgia, serif; font-size: 1.08rem; color: var(--ot-mute); margin: 0 0 1.5rem; line-height: 1.65; }
    .ot-shared { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--acc-lit); margin: -1rem 0 1.5rem; }

    .ot-ev-label { font-size: .66rem; letter-spacing: .24em; text-transform: uppercase; color: var(--ot-gold); margin: 2rem 0 .8rem; padding-bottom: .45rem; border-bottom: 1px solid var(--ot-rule); }
    .ot-verses { margin: 0; }
    .ot-verse { display: flex; flex-wrap: wrap; gap: .9rem; padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.05); }
    .ot-verse dt { min-width: 180px; font-family: Georgia, serif; color: var(--ot-cream); margin: 0; }
    .ot-verse dd { flex: 1; margin: 0; color: var(--ot-mute); }

    .ot-records { list-style: none; margin: 0; padding: 0; }
    .ot-rec { padding: .85rem 0; border-bottom: 1px solid rgba(255,255,255,.05); }
    .ot-rec:last-child { border-bottom: 0; }
    .ot-rec-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .7rem; margin: 0 0 .3rem; }
    .ot-rec-src { font-family: Georgia, serif; font-variant: small-caps; font-size: 1.08rem; letter-spacing: .03em; color: var(--ot-gold-lit); }
    .ot-rec-date { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ot-mute); border: 1px solid var(--ot-rule); border-radius: 999px; padding: .15rem .6rem; }
    .ot-rec-note { margin: 0; color: var(--ot-cream); opacity: .82; line-height: 1.65; }

    .ot-finding { font-family: Georgia, serif; font-style: italic; font-size: 1.1rem; color: var(--ot-cream); margin: 2rem 0 0; padding: 1.1rem 1.25rem; border-left: 3px solid var(--ot-gold); background: rgba(200,145,47,.07); }
    .ot-chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; }
    .ot-chip { font-size: .82rem; padding: .38rem .85rem; border-radius: 999px; background: var(--ot-panel-2); color: var(--ot-gold-lit); text-decoration: none; border: 1px solid var(--ot-rule); }
    .ot-chip:hover { border-color: var(--ot-gold); }

    .ot-foot { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-top: 2rem; padding: 1rem 0; border-top: 1px solid var(--ot-rule); position: sticky; bottom: 0; background: #17130e; }
    .ot-step { font: inherit; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; padding: .5rem 1rem; border: 1px solid var(--ot-rule); border-radius: 8px; background: transparent; color: var(--ot-gold-lit); cursor: pointer; }
    .ot-step:hover:not([disabled]) { border-color: var(--ot-gold); }
    .ot-step[disabled] { opacity: .28; cursor: default; }
    .ot-pos { font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--ot-mute); }
    @media (max-width: 560px) { .ot-panel { padding: 1.75rem 1.25rem 1rem; } .ot-verse dt { min-width: 100%; } }
  </style>
</Layout>
