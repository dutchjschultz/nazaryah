---
// on-these-two 0810 V2.astro
// V2. Fixes scoped-style bug that left the injected chain unstyled. Rebuilds the middle as graded
// rung cards with a chain joint between them. Evidence now opens in a modal instead of inline.
// Layout import: site has no Layout.astro; BaseLayout takes { title, description }.
// Only this import path changed — the <Layout title description> call is untouched.
import Layout from '../layouts/BaseLayout.astro';
import { links } from '../data/on-these-two/links.data.js';
import { chains, hinges, categories } from '../data/on-these-two/chains.data.js';
import { filings, unfiledLinks } from '../lib/chain-filings.js';

// Build-time writing queue: every link with no study filed against it yet.
// Prints once during `astro build` (and on dev start). It is the writing queue.
const _unfiled = unfiledLinks(links);
console.log(
  `\n[On These Two] unfiled links — ${_unfiled.length}/${Object.keys(links).length} have no study filed:`
);
for (const _id of _unfiled) console.log('  •', _id);
if (_unfiled.length === 0) console.log('  (every link has at least one study filed)');

const payload = {
  hinges,
  categories,
  chains: chains.map((c) => ({
    id: c.id,
    saying: c.saying,
    hinge: c.hinge,
    category: c.category,
    spokenBy: c.spokenBy,
    aliases: c.aliases || [],
    linkIds: c.links,
    links: c.links.map((id) => {
      const l = links[id];
      if (!l) throw new Error(`On These Two: chain "${c.id}" references unknown link id "${id}"`);
      return {
        id,
        title: l.title,
        line: l.line,
        witnesses: l.witnesses || [],
        record: l.record || null,
        finding: l.finding || null,
        filings: filings[id] || [],
      };
    }),
    verdict: {
      witnesses: c.verdict?.witnesses || [],
      record: c.verdict?.record || null,
      finding: c.verdict?.finding || null,
      filings: [],
    },
  })),
};

const counts = {};
for (const h of hinges) counts[h.id] = chains.filter((c) => c.hinge === h.id).length;
---

<Layout title="On These Two" description="Every lie hangs on one of two hinges. Walk the chain down to what people say out loud.">
  <section class="ot">

    <header class="ot-mast">
      <p class="ot-over">On these two</p>
      <h1>Every lie hangs on one of two hinges</h1>
      <p class="ot-lede">Pick a hinge. Walk the chain down. The last link is what people say out loud.</p>
    </header>

    <div class="ot-hinges">
      {hinges.map((h) => (
        <button class={`ot-tile ot-tile-${h.id}`} data-hinge={h.id} type="button">
          <span class="ot-tile-name">{h.name}</span>
          <span class="ot-tile-line">{h.line}</span>
          <span class="ot-tile-count">{counts[h.id]} chains</span>
        </button>
      ))}
    </div>

    <svg class="ot-band" viewBox="0 0 800 110" preserveAspectRatio="none" aria-hidden="true">
      <path d="M200 0 C200 50 90 60 70 110" />
      <path d="M200 0 C200 55 175 65 170 110" />
      <path d="M200 0 C200 55 250 65 280 110" />
      <path d="M600 0 C600 50 520 60 500 110" />
      <path d="M600 0 C600 55 615 65 620 110" />
      <path d="M600 0 C600 50 700 60 735 110" />
    </svg>

    <div class="ot-filters">
      <label class="ot-field">
        <span>Hinge</span>
        <select id="ot-hinge">
          <option value="all">All</option>
          {hinges.map((h) => <option value={h.id}>{h.name}</option>)}
        </select>
      </label>
      <label class="ot-field">
        <span>Category</span>
        <select id="ot-cat">
          <option value="all">All</option>
          {categories.map((c) => <option value={c}>{c}</option>)}
        </select>
      </label>
    </div>

    <div id="ot-chain" class="ot-chain" aria-live="polite"></div>

    <div class="ot-picker">
      <label class="ot-field ot-grow">
        <span>Saying</span>
        <select id="ot-pick"></select>
      </label>
      <div class="ot-count"><strong id="ot-total">0</strong><span>total</span></div>
      <label class="ot-field ot-grow">
        <span>Search</span>
        <input id="ot-q" type="search" placeholder="grace, saturn, colossians" autocomplete="off" />
      </label>
      <button id="ot-shuffle" class="ot-shuffle" type="button">Shuffle</button>
    </div>

  </section>

  <div id="ot-modal" class="ot-modal" role="dialog" aria-modal="true" aria-labelledby="ot-modal-title" hidden>
    <div class="ot-modal-scrim" data-close></div>
    <div class="ot-modal-panel">
      <button class="ot-modal-x" type="button" data-close aria-label="Close">&times;</button>
      <div id="ot-modal-body"></div>
      <div class="ot-modal-foot">
        <button class="ot-step" type="button" data-step="-1">&larr; Previous link</button>
        <span id="ot-modal-pos" class="ot-modal-pos"></span>
        <button class="ot-step" type="button" data-step="1">Next link &rarr;</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="ot-data" set:html={JSON.stringify(payload)}></script>

  <script>
    const DATA = JSON.parse(document.getElementById('ot-data').textContent);
    const elHinge = document.getElementById('ot-hinge');
    const elCat = document.getElementById('ot-cat');
    const elPick = document.getElementById('ot-pick');
    const elQ = document.getElementById('ot-q');
    const elTotal = document.getElementById('ot-total');
    const elChain = document.getElementById('ot-chain');
    const elModal = document.getElementById('ot-modal');
    const elBody = document.getElementById('ot-modal-body');
    const elPos = document.getElementById('ot-modal-pos');

    const KEY = 'ot-order';
    function newOrder() {
      const ids = DATA.chains.map((c) => c.id);
      for (let i = ids.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [ids[i], ids[j]] = [ids[j], ids[i]];
      }
      return ids;
    }
    let order;
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) || 'null');
      order = Array.isArray(saved) && saved.length === DATA.chains.length ? saved : newOrder();
    } catch (e) { order = newOrder(); }
    function saveOrder() { try { sessionStorage.setItem(KEY, JSON.stringify(order)); } catch (e) {} }
    saveOrder();

    const shared = {};
    DATA.chains.forEach((c) => c.linkIds.forEach((id) => { shared[id] = (shared[id] || 0) + 1; }));

    let current = null;
    let openIndex = -1;
    let lastFocus = null;

    const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));

    function matches(c) {
      if (elHinge.value !== 'all' && c.hinge !== elHinge.value) return false;
      if (elCat.value !== 'all' && c.category !== elCat.value) return false;
      const q = elQ.value.trim().toLowerCase();
      if (!q) return true;
      return c.saying.toLowerCase().includes(q)
        || c.category.toLowerCase().includes(q)
        || c.aliases.some((a) => a.includes(q))
        || c.links.some((l) => l.title.toLowerCase().includes(q)
          || l.witnesses.some((w) => w[0].toLowerCase().includes(q)));
    }

    // ---------- chain ----------

    function render(c) {
      current = c;
      if (!c) { elChain.innerHTML = '<p class="ot-empty">Nothing matches those filters yet.</p>'; return; }
      const hinge = DATA.hinges.find((h) => h.id === c.hinge);
      const n = c.links.length;

      let h = `<div class="ot-head">
        <span class="ot-badge">${esc(hinge.name)}</span>
        <span class="ot-arrow" aria-hidden="true">&rarr;</span>
        <span class="ot-saying">&ldquo;${esc(c.saying)}&rdquo;</span>
        <span class="ot-linkcount">${n + 1} links</span>
      </div>
      <p class="ot-sub">${esc(c.category)} &middot; ${esc(c.spokenBy)}</p>
      <ol class="ot-ladder">`;

      c.links.forEach((l, i) => {
        const t = Math.round((i / n) * 100);
        h += `<li class="ot-rung" style="--t:${t}%">
          <button class="ot-rung-btn" data-i="${i}" type="button">
            <span class="ot-num">${i + 1}</span>
            <span class="ot-rung-copy">
              <span class="ot-rung-title">${esc(l.title)}</span>
              <span class="ot-rung-line">${esc(l.line)}</span>
            </span>
            <span class="ot-rung-cue">Evidence</span>
          </button>
        </li>
        <li class="ot-joint" aria-hidden="true" style="--t:${Math.round(((i + 0.5) / n) * 100)}%"><span></span></li>`;
      });

      h += `<li class="ot-rung ot-rung-said" style="--t:100%">
          <button class="ot-rung-btn" data-i="${n}" type="button">
            <span class="ot-num">${n + 1}</span>
            <span class="ot-rung-copy">
              <span class="ot-said-label">What they say today</span>
              <span class="ot-said-text">&ldquo;${esc(c.saying)}&rdquo;</span>
            </span>
            <span class="ot-rung-cue">The answer</span>
          </button>
        </li></ol>`;

      elChain.className = `ot-chain ot-h-${c.hinge}`;
      elChain.innerHTML = h;
      elChain.querySelectorAll('.ot-rung-btn').forEach((b) => {
        b.addEventListener('click', () => openModal(Number(b.dataset.i)));
      });
    }

    // ---------- modal ----------

    function evidenceHtml(node) {
      let h = '';
      if (node.witnesses && node.witnesses.length) {
        h += '<p class="ot-ev-label">Witnesses</p><dl class="ot-verses">';
        node.witnesses.forEach((w) => {
          h += `<div class="ot-verse"><dt>${esc(w[0])}</dt><dd>${esc(w[1])}</dd></div>`;
        });
        h += '</dl>';
      }
      if (node.record) h += `<p class="ot-ev-label">The record</p><p class="ot-record">${esc(node.record)}</p>`;
      if (node.finding) h += `<p class="ot-finding">${esc(node.finding)}</p>`;
      if (node.filings && node.filings.length) {
        h += '<p class="ot-ev-label">Filed with this link</p><p class="ot-chips">';
        node.filings.forEach((f) => { h += `<a class="ot-chip" href="${esc(f.url)}">${esc(f.title)}</a>`; });
        h += '</p>';
      }
      return h;
    }

    function openModal(i) {
      if (!current) return;
      openIndex = i;
      const n = current.links.length;
      const isSaid = i === n;
      const node = isSaid ? current.verdict : current.links[i];
      const hinge = DATA.hinges.find((h) => h.id === current.hinge);
      const t = Math.round((i / n) * 100);

      let h = `<p class="ot-modal-eyebrow">${esc(hinge.name)} &middot; &ldquo;${esc(current.saying)}&rdquo;</p>`;
      if (isSaid) {
        h += `<p class="ot-modal-kicker">What they say today</p>
              <h2 id="ot-modal-title" class="ot-modal-title">&ldquo;${esc(current.saying)}&rdquo;</h2>`;
      } else {
        h += `<h2 id="ot-modal-title" class="ot-modal-title"><span class="ot-modal-num">${i + 1}</span>${esc(node.title)}</h2>
              <p class="ot-modal-line">${esc(node.line)}</p>`;
        if (shared[node.id] > 1) h += `<p class="ot-shared">This link is held by ${shared[node.id]} chains.</p>`;
      }
      h += evidenceHtml(node);

      elBody.innerHTML = h;
      elBody.style.setProperty('--t', t + '%');
      elModal.className = `ot-modal ot-h-${current.hinge}`;
      elPos.textContent = `Link ${i + 1} of ${n + 1}`;
      elModal.querySelectorAll('.ot-step').forEach((b) => {
        const to = i + Number(b.dataset.step);
        b.disabled = to < 0 || to > n;
      });

      lastFocus = document.activeElement;
      elModal.hidden = false;
      document.body.classList.add('ot-locked');
      elModal.querySelector('.ot-modal-x').focus();
    }

    function closeModal() {
      elModal.hidden = true;
      document.body.classList.remove('ot-locked');
      if (lastFocus) lastFocus.focus();
    }

    elModal.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', closeModal));
    elModal.querySelectorAll('.ot-step').forEach((b) => {
      b.addEventListener('click', () => openModal(openIndex + Number(b.dataset.step)));
    });
    document.addEventListener('keydown', (e) => {
      if (elModal.hidden) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight' && openIndex < current.links.length) openModal(openIndex + 1);
      if (e.key === 'ArrowLeft' && openIndex > 0) openModal(openIndex - 1);
    });

    // ---------- filters ----------

    function refresh(keepSelection) {
      const list = order.map((id) => DATA.chains.find((c) => c.id === id)).filter(matches);
      elTotal.textContent = list.length;
      const prev = elPick.value;
      elPick.innerHTML = '';
      list.forEach((c) => {
        const o = document.createElement('option');
        o.value = c.id;
        o.textContent = '\u201C' + c.saying + '\u201D';
        elPick.appendChild(o);
      });
      if (keepSelection && list.some((c) => c.id === prev)) elPick.value = prev;
      render(list.find((c) => c.id === elPick.value));
    }

    elHinge.addEventListener('change', () => refresh(true));
    elCat.addEventListener('change', () => refresh(true));
    elQ.addEventListener('input', () => refresh(true));
    elPick.addEventListener('change', () => render(DATA.chains.find((c) => c.id === elPick.value)));
    document.getElementById('ot-shuffle').addEventListener('click', () => { order = newOrder(); saveOrder(); refresh(false); });

    document.querySelectorAll('.ot-tile').forEach((t) => {
      t.addEventListener('click', () => {
        const id = t.dataset.hinge;
        elHinge.value = elHinge.value === id ? 'all' : id;
        document.querySelectorAll('.ot-tile').forEach((x) => {
          x.classList.toggle('is-dim', elHinge.value !== 'all' && x.dataset.hinge !== elHinge.value);
        });
        refresh(true);
      });
    });

    refresh(false);
  </script>

  <!-- is:global is required. The chain is injected at runtime, so Astro's scoped styles never reach it. -->
  <style is:global>
    .ot {
      --ot-navy: #1f3864;
      --ot-ink: #2b2b2b;
      --ot-mute: #7a7264;
      --ot-rule: #d9cfb8;
      --ot-card: #fffdf8;
      --ot-cream: #f5efe2;

      --ot-torah-bg: #f2e3c2;
      --ot-torah-ink: #6b4a08;
      --ot-torah-line: #c09a34;

      --ot-trin-bg: #e6e2f8;
      --ot-trin-ink: #352d80;
      --ot-trin-line: #7f77dd;

      --ot-lie-bg: #e9c9c3;
      --ot-lie-ink: #7a1f1f;
      --ot-lie-line: #b1584f;

      max-width: 980px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
      color: var(--ot-ink);
    }

    .ot-mast { text-align: center; margin-bottom: 1.75rem; }
    .ot-over { font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ot-mute); margin: 0; }
    .ot-mast h1 { font-family: Georgia, serif; color: var(--ot-navy); font-size: clamp(1.6rem, 4vw, 2.35rem); margin: .35rem 0 .5rem; }
    .ot-lede { color: var(--ot-mute); margin: 0; }

    .ot-hinges { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
    .ot-tile { display: block; width: 100%; text-align: left; border: 2px solid transparent; border-radius: 16px; padding: 1.15rem 1.3rem; cursor: pointer; font: inherit; transition: opacity .15s ease, transform .15s ease; box-shadow: 0 2px 0 rgba(0,0,0,.06); }
    .ot-tile:hover { transform: translateY(-2px); }
    .ot-tile.is-dim { opacity: .38; }
    .ot-tile-name { display: block; font-family: Georgia, serif; font-size: 1.4rem; }
    .ot-tile-line { display: block; font-size: .95rem; margin-top: .3rem; }
    .ot-tile-count { display: block; font-size: .78rem; margin-top: .8rem; letter-spacing: .1em; text-transform: uppercase; opacity: .85; }
    .ot-tile-torah { background: var(--ot-torah-bg); border-color: var(--ot-torah-line); color: var(--ot-torah-ink); }
    .ot-tile-trinity { background: var(--ot-trin-bg); border-color: var(--ot-trin-line); color: var(--ot-trin-ink); }

    .ot-band { display: block; width: 100%; height: 90px; }
    .ot-band path { fill: none; stroke: var(--ot-rule); stroke-width: 1.5; }
    @media (max-width: 640px) { .ot-band { height: 50px; } }

    .ot-filters, .ot-picker { display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-end; padding: .9rem 0; border-top: 1px solid var(--ot-rule); }
    .ot-filters { border-bottom: 1px solid var(--ot-rule); }
    .ot-field { display: flex; flex-direction: column; gap: .25rem; }
    .ot-field > span { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ot-mute); }
    .ot-grow { flex: 1 1 220px; }
    .ot-field select, .ot-field input { font: inherit; font-size: .95rem; padding: .55rem .75rem; border: 1px solid var(--ot-rule); border-radius: 10px; background: var(--ot-card); color: var(--ot-ink); width: 100%; }
    .ot-count { text-align: center; background: var(--ot-card); border: 1px solid var(--ot-rule); border-radius: 10px; padding: .45rem 1rem; }
    .ot-count strong { display: block; font-size: 1.2rem; color: var(--ot-navy); }
    .ot-count span { font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ot-mute); }
    .ot-shuffle { font: inherit; font-size: .9rem; padding: .6rem 1.1rem; border: 1px solid var(--ot-rule); border-radius: 10px; background: var(--ot-card); color: var(--ot-navy); cursor: pointer; }

    /* ---------- the chain ---------- */

    .ot-chain {
      --h-bg: var(--ot-torah-bg); --h-ink: var(--ot-torah-ink); --h-line: var(--ot-torah-line);
      margin: 1.6rem 0; min-height: 320px;
    }
    .ot-chain.ot-h-trinity, .ot-modal.ot-h-trinity { --h-bg: var(--ot-trin-bg); --h-ink: var(--ot-trin-ink); --h-line: var(--ot-trin-line); }
    .ot-chain.ot-h-torah, .ot-modal.ot-h-torah { --h-bg: var(--ot-torah-bg); --h-ink: var(--ot-torah-ink); --h-line: var(--ot-torah-line); }
    .ot-empty { color: var(--ot-mute); text-align: center; padding: 4rem 0; }

    .ot-head { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
    .ot-badge { font-size: .78rem; padding: .3rem .8rem; border-radius: 999px; background: var(--h-bg); color: var(--h-ink); border: 1px solid var(--h-line); }
    .ot-arrow { color: var(--ot-mute); }
    .ot-saying { font-family: Georgia, serif; font-size: 1.3rem; color: var(--ot-navy); }
    .ot-linkcount { font-size: .78rem; color: var(--ot-mute); }
    .ot-sub { font-size: .82rem; color: var(--ot-mute); margin: .4rem 0 1.2rem; }

    .ot-ladder { list-style: none; margin: 0; padding: 0; }

    .ot-rung { margin: 0; }
    .ot-rung-btn {
      display: flex; align-items: flex-start; gap: 1rem; width: 100%; text-align: left; cursor: pointer; font: inherit;
      padding: 1rem 1.15rem; border-radius: 14px;
      background: var(--h-bg);
      background: color-mix(in oklab, var(--ot-lie-bg) var(--t), var(--h-bg));
      border: 1px solid var(--h-line);
      border-color: color-mix(in oklab, var(--ot-lie-line) var(--t), var(--h-line));
      color: var(--h-ink);
      color: color-mix(in oklab, var(--ot-lie-ink) var(--t), var(--h-ink));
      box-shadow: 0 1px 0 rgba(0,0,0,.05);
      transition: transform .12s ease, box-shadow .12s ease;
    }
    .ot-rung-btn:hover { transform: translateX(3px); box-shadow: 0 3px 10px rgba(0,0,0,.09); }

    .ot-num {
      flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: Georgia, serif; font-size: .95rem;
      background: currentColor; color: var(--ot-card);
    }
    .ot-num { color: #fffdf8; }
    .ot-rung-copy { flex: 1; min-width: 0; }
    .ot-rung-title { display: block; font-family: Georgia, serif; font-size: 1.12rem; }
    .ot-rung-line { display: block; font-size: .95rem; margin-top: .2rem; opacity: .85; line-height: 1.55; }
    .ot-rung-cue { flex: 0 0 auto; align-self: center; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; padding: .3rem .7rem; border-radius: 999px; border: 1px solid currentColor; opacity: .7; }
    @media (max-width: 640px) { .ot-rung-cue { display: none; } }

    .ot-joint { height: 26px; display: flex; justify-content: center; align-items: center; }
    .ot-joint span {
      display: block; width: 10px; height: 26px; border-radius: 999px;
      border: 2px solid var(--h-line);
      border-color: color-mix(in oklab, var(--ot-lie-line) var(--t), var(--h-line));
    }

    .ot-rung-said .ot-rung-btn { padding: 1.25rem 1.3rem; border-width: 2px; }
    .ot-said-label { display: block; font-size: .7rem; letter-spacing: .14em; text-transform: uppercase; opacity: .8; }
    .ot-said-text { display: block; font-family: Georgia, serif; font-size: 1.45rem; margin-top: .25rem; }

    /* ---------- modal ---------- */

    body.ot-locked { overflow: hidden; }
    .ot-modal[hidden] { display: none; }
    .ot-modal { position: fixed; inset: 0; z-index: 90; display: flex; align-items: center; justify-content: center; padding: 1.25rem; }
    .ot-modal-scrim { position: absolute; inset: 0; background: rgba(30, 24, 14, .55); backdrop-filter: blur(2px); }
    .ot-modal-panel {
      position: relative; width: min(660px, 100%); max-height: 88vh; overflow-y: auto;
      background: var(--ot-card); border-radius: 18px; padding: 2rem 2rem 1rem;
      border-top: 8px solid var(--h-line);
      border-top-color: color-mix(in oklab, var(--ot-lie-line) var(--t, 0%), var(--h-line));
      box-shadow: 0 24px 60px rgba(0,0,0,.35);
    }
    .ot-modal-x { position: absolute; top: .8rem; right: 1rem; background: none; border: 0; font-size: 1.9rem; line-height: 1; color: var(--ot-mute); cursor: pointer; }
    #ot-modal-body { --t: 0%; }
    .ot-modal-eyebrow { font-size: .74rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ot-mute); margin: 0 0 1rem; }
    .ot-modal-kicker { font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ot-lie-ink); margin: 0; }
