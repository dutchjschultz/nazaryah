---
// src/pages/on-these-two.astro · 0806 V2
// V2: description tightened to the exact card deck line — this page has no
// rendered deck element, so the social-card generator uses og:description as the
// deck; the prior long description overran and clipped mid-sentence on the card.
// V1: The Lie Tree Walker. Four chains (Sunday, pork, three-persons, heaven)
// climbing to the two hinges. Landing grid → client-side walker, hash-linkable.
// Data + receipts live in src/data/lie-tree.data.js; children derived here.
import BaseLayout from '../layouts/BaseLayout.astro';
import { meta, entries, nodes } from '../data/lie-tree.data.js';

// ── DERIVE CHILDREN AT BUILD TIME ──────────────────────────────────────────
// A node's children are every node whose parent (string or array) names it.
// Never hand-maintained in the data file — recomputed on every build.
const parentsOf = (n) => (Array.isArray(n.parent) ? n.parent : n.parent ? [n.parent] : []);
const walker = {};
for (const [id, node] of Object.entries(nodes)) {
  walker[id] = {
    ...node,
    parents: parentsOf(node),
    children: Object.entries(nodes)
      .filter(([, other]) => parentsOf(other).includes(id))
      .map(([childId]) => childId),
  };
}
---

<BaseLayout
  title="On These Two — Nazaryah"
  description="Every lie was handed to somebody by somebody else. Walk it back up."
>
  <div class="lt-wrap">

    <!-- Banner strip — always visible -->
    <div class="lt-banner">{meta.banner}</div>

    <!-- LANDING SCREEN -->
    <section id="lt-landing" class="lt-landing">
      <header class="lt-head">
        <h1 class="lt-title">{meta.title}</h1>
        <p class="lt-standing">{meta.standingLine}</p>
      </header>
      <p class="lt-intro">{meta.intro}</p>

      <div class="lt-entry-grid">
        {entries.map((id) => (
          <button type="button" class="lt-entry-card" data-goto={id}>
            {walker[id].label}
          </button>
        ))}
      </div>
    </section>

    <!-- WALKER SCREEN — populated client-side -->
    <section id="lt-walker" class="lt-walker" hidden>
      <div class="lt-startover-row">
        <button type="button" id="lt-startover" class="lt-startover">&larr; Start over</button>
      </div>

      <!-- 1. PARENTS -->
      <div id="lt-parents" class="lt-zone lt-zone--parents"></div>

      <!-- 2. CURRENT NODE -->
      <div id="lt-current" class="lt-current-slot"></div>

      <!-- 3. CHILDREN -->
      <div id="lt-children" class="lt-zone lt-zone--children"></div>
    </section>

  </div>

  <script define:vars={{ walker, entries, meta }}>
    (function () {
      const landing = document.getElementById('lt-landing');
      const screen = document.getElementById('lt-walker');
      const parentsZone = document.getElementById('lt-parents');
      const currentSlot = document.getElementById('lt-current');
      const childrenZone = document.getElementById('lt-children');

      // Small helper — an element with class(es) and optional text.
      function el(tag, cls, text) {
        const n = document.createElement(tag);
        if (cls) n.className = cls;
        if (text != null) n.textContent = text;
        return n;
      }

      // A tappable step card (used in both the parents and children zones).
      function stepCard(id) {
        const node = walker[id];
        const card = el('button', 'lt-step');
        card.type = 'button';
        card.setAttribute('data-goto', id);
        card.appendChild(el('span', 'lt-step-label', node.label));
        card.appendChild(el('span', 'lt-step-era', node.era));
        return card;
      }

      const RECEIPT_LABEL = { history: 'Receipt', scripture: 'In the book', hinge: null };

      function render(id) {
        const node = walker[id];
        if (!node) return showLanding();

        landing.hidden = true;
        screen.hidden = false;

        // ---- PARENTS ZONE ----
        parentsZone.replaceChildren();
        if (node.parents.length) {
          parentsZone.appendChild(el('p', 'lt-zone-label', meta.upLabel));
          const grid = el('div', 'lt-step-grid');
          node.parents.forEach((p) => grid.appendChild(stepCard(p)));
          parentsZone.appendChild(grid);
          parentsZone.appendChild(el('div', 'lt-arrow', '↓')); // ↓ points down at current
        } else {
          parentsZone.appendChild(el('p', 'lt-nothing', 'Nothing above this. It is the hinge.'));
        }

        // ---- CURRENT NODE ----
        currentSlot.replaceChildren();
        const heavy = node.kind === 'hinge' || node.parents.length > 1;
        const current = el('div', 'lt-current' + (node.kind === 'hinge' ? ' lt-current--hinge' : '') + (heavy ? ' lt-current--heavy' : ''));
        current.appendChild(el('h2', 'lt-current-label', node.label));
        current.appendChild(el('p', 'lt-current-era', node.era));

        const receiptLabel = RECEIPT_LABEL[node.kind];
        const receipt = el('div', 'lt-receipt' + (node.kind === 'hinge' ? ' lt-receipt--hinge' : ''));
        if (receiptLabel) receipt.appendChild(el('p', 'lt-receipt-label', receiptLabel));
        receipt.appendChild(el('p', 'lt-receipt-text', node.receipt));
        current.appendChild(receipt);

        if (node.breaks) current.appendChild(el('p', 'lt-breaks', node.breaks));

        if (node.page) {
          const link = el('a', 'lt-morelink', 'More on this step →');
          link.href = '/' + String(node.page).replace(/^\/+/, '');
          current.appendChild(link);
        }
        currentSlot.appendChild(current);

        // ---- CHILDREN ZONE ----
        childrenZone.replaceChildren();
        if (node.children.length) {
          childrenZone.appendChild(el('div', 'lt-arrow', '↓')); // ↓ points down at fruit
          childrenZone.appendChild(el('p', 'lt-zone-label', meta.downLabel));
          const grid = el('div', 'lt-step-grid');
          node.children.forEach((c) => grid.appendChild(stepCard(c)));
          childrenZone.appendChild(grid);
        } else {
          childrenZone.appendChild(el('p', 'lt-nothing', 'Nothing below this. You are standing on the fruit.'));
        }

        if (('#' + id) !== location.hash) {
          history.replaceState(null, '', '#' + id);
        }
        window.scrollTo({ top: 0, behavior: 'auto' });
      }

      function showLanding() {
        screen.hidden = true;
        landing.hidden = false;
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      }

      // Delegated taps — entry cards + every step card route through data-goto.
      document.querySelector('.lt-wrap').addEventListener('click', (e) => {
        const goto = e.target.closest('[data-goto]');
        if (goto) { render(goto.getAttribute('data-goto')); return; }
        if (e.target.closest('#lt-startover')) showLanding();
      });

      // Hash → node. Direct links like /on-these-two#nicaea open on that node.
      function fromHash() {
        const id = decodeURIComponent(location.hash.replace(/^#/, ''));
        if (id && walker[id]) render(id); else showLanding();
      }
      window.addEventListener('hashchange', fromHash);
      fromHash();
    })();
  </script>

  <!-- is:global — the walker builds its cards client-side with createElement,
       so those nodes never receive Astro's scoped data-attribute. Scoped styles
       would miss them entirely. Every selector here is lt- prefixed, so global
       scope carries no collision risk. -->
  <style is:global>
    /* ============================================================
       ON THESE TWO — the lie-tree walker. House-plain: Georgia body,
       navy #1F3864 accent, no decorative dividers, no diamonds.
       ============================================================ */
    .lt-wrap {
      --navy: #1F3864;
      --ink: #23282f;
      --muted: #6b7280;
      --line: #d7dbe0;
      --paper: #ffffff;
      font-family: Georgia, 'Times New Roman', serif;
      color: var(--ink);
      max-width: 52rem;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
    }

    /* Banner strip — full width of the column, small caps, muted. */
    .lt-banner {
      text-align: center;
      font-variant: small-caps;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      color: var(--muted);
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
      margin-bottom: 2.5rem;
    }

    /* ── LANDING ── */
    .lt-head { text-align: center; }
    .lt-title {
      font-family: Georgia, serif;
      font-size: clamp(2rem, 5vw, 2.8rem);
      font-weight: 700;
      color: var(--navy);
      margin: 0;
      line-height: 1.1;
    }
    .lt-standing {
      font-style: italic;
      color: var(--muted);
      max-width: 40rem;
      margin: 1rem auto 0;
      line-height: 1.6;
      font-size: 1rem;
    }
    .lt-intro {
      max-width: 40rem;
      margin: 2.25rem auto 0;
      line-height: 1.75;
      font-size: 1.08rem;
    }

    .lt-entry-grid {
      margin-top: 2.75rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }
    .lt-entry-card {
      font-family: Georgia, serif;
      font-size: 1.25rem;
      line-height: 1.3;
      text-align: center;
      color: var(--navy);
      background: var(--paper);
      border: 1px solid var(--navy);
      border-radius: 4px;
      padding: 1.6rem 1.25rem;
      cursor: pointer;
      transition: background 0.15s ease, color 0.15s ease;
    }
    .lt-entry-card:hover,
    .lt-entry-card:focus-visible {
      background: var(--navy);
      color: #fff;
      outline: none;
    }

    /* ── WALKER ── */
    .lt-startover-row { margin-bottom: 1.5rem; }
    .lt-startover {
      font-family: Georgia, serif;
      font-size: 0.9rem;
      font-style: italic;
      color: var(--muted);
      background: none;
      border: none;
      padding: 0.25rem 0;
      cursor: pointer;
    }
    .lt-startover:hover { color: var(--navy); }

    .lt-zone { text-align: center; }
    .lt-zone-label {
      font-variant: small-caps;
      letter-spacing: 0.12em;
      font-size: 0.82rem;
      color: var(--muted);
      margin: 0 0 0.9rem;
    }
    .lt-zone--children .lt-zone-label { margin: 0.5rem 0 0.9rem; }

    .lt-step-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.9rem;
      max-width: 40rem;
      margin: 0 auto;
    }
    .lt-step {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      text-align: left;
      font-family: Georgia, serif;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0.95rem 1.1rem;
      cursor: pointer;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .lt-step:hover,
    .lt-step:focus-visible {
      border-color: var(--navy);
      background: #f4f6fa;
      outline: none;
    }
    .lt-step-label { font-size: 1.02rem; line-height: 1.3; color: var(--ink); }
    .lt-step-era {
      font-variant: small-caps;
      letter-spacing: 0.08em;
      font-size: 0.75rem;
      color: var(--muted);
    }

    /* Plain glyph arrow — not an image, not a divider. */
    .lt-arrow {
      font-size: 1.6rem;
      line-height: 1;
      color: var(--navy);
      margin: 0.9rem 0;
    }

    .lt-nothing {
      color: var(--muted);
      font-style: italic;
      max-width: 32rem;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ── CURRENT NODE — the one large element ── */
    .lt-current-slot { margin: 0.5rem 0; }
    .lt-current {
      border: 1px solid var(--navy);
      border-radius: 5px;
      padding: 1.9rem 1.75rem;
      background: var(--paper);
    }
    .lt-current--heavy { border-width: 3px; }
    .lt-current--hinge {
      background: #eef1f7;
      border-color: var(--navy);
    }
    .lt-current-label {
      font-family: Georgia, serif;
      font-size: 22px;
      line-height: 1.25;
      font-weight: 700;
      color: var(--navy);
      margin: 0;
    }
    .lt-current-era {
      font-variant: small-caps;
      letter-spacing: 0.1em;
      font-size: 0.82rem;
      color: var(--muted);
      margin: 0.4rem 0 0;
    }

    .lt-receipt {
      margin-top: 1.3rem;
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 1.05rem 1.15rem;
      background: #fbfcfd;
    }
    .lt-receipt--hinge {
      border-color: var(--navy);
      background: #fff;
    }
    .lt-receipt-label {
      font-variant: small-caps;
      letter-spacing: 0.12em;
      font-size: 0.75rem;
      color: var(--navy);
      margin: 0 0 0.5rem;
    }
    .lt-receipt-text { margin: 0; line-height: 1.7; font-size: 1.02rem; }

    .lt-breaks {
      margin: 1.15rem 0 0;
      color: var(--navy);
      font-style: italic;
      line-height: 1.6;
    }

    .lt-morelink {
      display: inline-block;
      margin-top: 1.2rem;
      font-size: 0.95rem;
      color: var(--navy);
      font-weight: 700;
      text-decoration: none;
      border-bottom: 1px solid var(--navy);
      padding-bottom: 1px;
    }
    .lt-morelink:hover { opacity: 0.75; }

    /* ── MOBILE ── the current node must never scroll sideways. ── */
    @media (max-width: 520px) {
      .lt-step-grid { grid-template-columns: 1fr; }
      .lt-entry-grid { grid-template-columns: 1fr; }
      .lt-current { padding: 1.4rem 1.2rem; }
    }

    /* Dark mode: the page keeps its paper-white ground on purpose (the walker
       is a document look), but lift text off pure black so it stays legible. */
    :global(.dark) .lt-wrap { color: var(--ink); }
  </style>

</BaseLayout>
