---
// src/pages/close-to-the-hip.astro · 0831 V5
// V5: carries a dedicated .cth-card-deck element — the SHORT deck the social
// card uses, kept separate from the visible thesis line and from the long meta
// description (the standing rule: the card deck and the meta description are
// separate fields and must never merge, because the long one clips on the card).
// It is clipped from the screen, not display:none, so it stays readable to the
// generator and to assistive tech. The page was on the social-card skip list as
// "a titleless two-lane listing"; it renders an h1 and is no longer titleless,
// so the exemption is lifted in check-cards.mjs and backfill-social-images.py.
// V4: an insight may carry an optional studyLink/studyLabel pair — rendered
// beneath the insight as a quiet text link. Absent -> nothing renders (no gap).
// V3: insights sort breaks postedDate ties by id descending, so same-day
// insights render newest-id-first (SI-003 above SI-002) deterministically.
// V2: ids are suppressed from the markup — no data-id, no number badge, no SI-###
// or DEF-### anywhere in the rendered output. The id stays in the JSON for
// tracking + duplicate detection only (unlike the Legal Lexicon, these lists show
// no visible numbers). Insights = text/blip/refs; Defense = trigger/answer only.
// Renamed from scripture-insights.astro. Now a TWO-LANE page at /close-to-the-hip
// (NOT under /torah/, though it wears the Legal Lexicon's look as a sibling):
//   Lane 1 — Scripture Insights: short truths to carry through the day.
//   Lane 2 — The Defense: short answers to what you'll hear pushed back at you.
// A 301 from /scripture-insights lives in netlify.toml.
//
// DATA (both read at build time, project-root/cwd paths — compiled module lives
// under .netlify/, so import.meta.url-relative paths would miss the sources):
//   public/data/scripture-insights.json  — versions by FIELDS (version/changeNote)
//   public/data/the-defense.json         — same field-versioning convention
//
// SCRIPTURE INSIGHTS field rules ----------------------------------------------
//   id · key · text (card body) · blip (optional, smaller/lighter) · refs (small,
//   joined " · ") · status ("open"|"approved"|"posted", only posted renders) ·
//   postedDate (drives the sort).
//
// THE DEFENSE field rules -----------------------------------------------------
//   id       — DEF-###, zero-padded to three, matching the master count. Never reused.
//   key      — lowercase hyphen slug; duplicate detection across chats
//   trigger  — the anticipated question/claim, as a real person would say it
//   answer   — the spoken reply. NEVER contains a verse reference.
//   refs     — FOR THE MASTER FILE ONLY. Not rendered on this page.
//   status   — "open"|"approved"|"posted"|"withdrawn". Only "posted" renders.
// -----------------------------------------------------------------------------
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

const readJson = (rel) => JSON.parse(fs.readFileSync(path.join(process.cwd(), rel), 'utf-8'));

// Lane 1 — posted insights, newest first by postedDate.
const insights = readJson('public/data/scripture-insights.json').insights
  .filter((i) => i.status === 'posted')
  .sort((a, b) =>
    String(b.postedDate).localeCompare(String(a.postedDate)) ||
    String(b.id).localeCompare(String(a.id)));

// Lane 2 — posted defenses, by id ascending. refs are intentionally NOT read here.
const defenses = readJson('public/data/the-defense.json').entries
  .filter((d) => d.status === 'posted')
  .sort((a, b) => String(a.id).localeCompare(String(b.id)));
---

<BaseLayout
  title="Close to the Hip — Nazaryah"
  description="Something to hold onto for the day, and something to say when it's questioned."
>
  <div class="cth">
    <div class="wrap">

      <section class="hero">
        <span class="eyebrow">Close to the Hip</span>
        <h1>Close to the Hip</h1>
        <p class="thesis">Short truths worth carrying, and short answers worth having.</p>
        <p class="cth-card-deck">Short answers, kept where they can be reached.</p>
      </section>

      {insights.length > 0 && (
        <section class="lane" aria-label="Scripture Insights">
          <div class="lane-head">
            <h2>Scripture Insights</h2>
            <p class="standfirst">Truths worth keeping close.</p>
          </div>
          <div class="insights">
            {insights.map((i) => (
              <article class="ins">
                <p class="ins-text">{i.text}</p>
                {i.blip && i.blip.trim() && <p class="ins-blip">{i.blip}</p>}
                {i.refs && i.refs.length > 0 && <p class="ins-refs">{i.refs.join(' · ')}</p>}
                {i.studyLink && i.studyLabel && (
                  <p class="ins-study"><a href={i.studyLink}>{i.studyLabel} <span aria-hidden="true">&rarr;</span></a></p>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      {defenses.length > 0 && (
        <section class="lane" aria-label="The Defense">
          <div class="lane-head">
            <h2>The Defense</h2>
            <p class="standfirst">For when it gets questioned.</p>
          </div>
          <div class="defense">
            {defenses.map((d) => (
              <article class="def">
                <p class="def-trigger">&ldquo;{d.trigger}&rdquo;</p>
                <p class="def-answer">{d.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>
</BaseLayout>

<style>
  /* Sibling of the Legal Lexicon (torah/legal-lexicon) — same fixed-dark ground,
     Crimson Pro serif, Cinzel accents, gold on parchment-brown. Reading column is
     narrower than the lexicon's table, since this lane is prose. */
  .cth {
    background: linear-gradient(180deg, #0e0904 0%, #1a1208 20%, #160f07 100%);
    color: #d9c9a8;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif; line-height: 1.7; font-size: 18px;
    min-height: 100vh;
  }
  .cth .wrap { max-width: 44rem; margin: 0 auto; padding: 40px 26px 90px; }
  .cth .eyebrow {
    font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: .24em; text-transform: uppercase;
    color: #8a6028; font-weight: 600;
  }

  /* ── Hero ── */
  .cth .hero { padding: 30px 0 8px; text-align: center; }
  .cth .hero h1 {
    font-family: 'Cinzel', serif; font-size: clamp(2rem, 5vw, 44px); line-height: 1.08;
    color: #f0e0bf; margin: 12px 0 12px; letter-spacing: -.01em;
  }
  .cth .thesis { font-size: 20px; color: #c4a46b; font-style: italic; margin: 0; }

  /* ── Lane heading — shared by both sections ── */
  .cth .lane { margin-top: 56px; }
  .cth .lane-head { margin-bottom: 24px; padding-bottom: 12px; border-bottom: 1px solid #3a2510; }
  .cth .lane-head h2 {
    font-family: 'Cinzel', serif; font-size: 15px; letter-spacing: .16em; text-transform: uppercase;
    color: #f0e0bf; margin: 0 0 6px;
  }
  /* The social card's deck. Clipped rather than display:none so the generator
     (which reads the rendered page) still finds it. Never shown on screen. */
  .cth .cth-card-deck {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .cth .lane-head .standfirst { font-size: 16px; color: #c4a46b; font-style: italic; margin: 0; }

  /* ── Lane 1: Scripture Insights — the heavier weight. Bordered panel, gold spine. ── */
  .cth .insights { display: flex; flex-direction: column; gap: 20px; }
  .cth .ins {
    background: rgba(20, 13, 5, .5); border: 1px solid #3a2510; border-left: 3px solid #8a6028;
    border-radius: 4px; padding: 26px 28px;
  }
  .cth .ins-text { font-size: 19px; line-height: 1.8; color: #e0d2b2; margin: 0; }
  .cth .ins-blip { font-size: 15.5px; line-height: 1.65; color: #9a8763; font-style: italic; margin: 14px 0 0; }
  .cth .ins-refs {
    font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    color: #8a6f45; margin: 18px 0 0; padding-top: 14px; border-top: 1px solid #2e1f0d;
  }
  /* Optional study link — a quiet text link beneath the insight, not a button.
     Only renders when the insight carries studyLink + studyLabel. */
  .cth .ins-study { margin: 12px 0 0; }
  .cth .ins-study a {
    font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: .14em; text-transform: uppercase;
    color: #BA7517; text-decoration: none; transition: color .2s ease;
  }
  .cth .ins-study a:hover { color: #f0e0bf; }

  /* ── Lane 2: The Defense — compact. Stacked rows, hairline between, no card frame. ── */
  .cth .defense { display: flex; flex-direction: column; }
  .cth .def { padding: 16px 0; border-top: 1px solid #2e1f0d; }
  .cth .def:first-child { border-top: 0; padding-top: 4px; }
  .cth .def-trigger { font-size: 17px; font-style: italic; color: #c4a46b; margin: 0 0 6px; line-height: 1.5; }
  .cth .def-answer { font-size: 17px; color: #d9c9a8; margin: 0; line-height: 1.65; }

  @media (max-width: 620px) {
    .cth { font-size: 17px; }
    .cth .wrap { padding: 28px 16px 60px; }
    .cth .hero h1 { font-size: 32px; } .cth .thesis { font-size: 17px; }
    .cth .ins { padding: 20px 18px; }
    .cth .ins-text { font-size: 18px; }
  }
</style>
