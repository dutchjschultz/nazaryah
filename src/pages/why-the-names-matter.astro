  .nm-bridge { margin: 2.6rem 0 2rem; text-align: center; font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif; font-style: italic; font-size: clamp(1.35rem, 4vw, 1.7rem); line-height: 1.35; color: var(--nm-ink); text-wrap: balance; }

  .nm-study { border-top: 1px solid var(--nm-rule); padding-top: 2rem; }
  .nm-study-title { margin: 0; font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(1.7rem, 5vw, 2.2rem); color: var(--nm-ink); }
  .nm-study-sub { margin: 0.3rem 0 1.4rem; font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif; font-style: italic; font-size: 1.15rem; color: var(--nm-muted); }
  .nm-study h3 { margin: 1.8rem 0 0.5rem; font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 1.3rem; color: var(--nm-ink); }
  .nm-study p { margin: 0 0 1rem; }
  .nm-quote { margin: 1.2rem 0; padding: 0.9rem 1.2rem; border-left: 3px solid var(--nm-gold); background: var(--nm-paper); }
  .nm-quote p { margin: 0; font-style: italic; }
  .nm-quote cite { display: block; margin-top: 0.4rem; font-style: normal; font-family: 'Cinzel', serif; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--nm-gold); }
  .nm-list { list-style: disc; padding-left: 1.4rem; margin: 0 0 1rem; display: grid; gap: 0.55rem; }
  .nm-next { display: inline-block; margin-top: 2rem; font-family: 'Cinzel', serif; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--nm-gold); text-decoration: none; }
