---
// src/pages/why-the-names-matter.astro · 1014 V1
// V1 (Homepage Corner Cards Spec 1014 V1, Part 3): Why the Names Matter — the
// Unmasking (five rounds of masked titles, tap to flip) above the full study.
// Without JavaScript every verse reads in its masked KJV form and the study is
// all there. Each masked title is a real <button aria-pressed>; both faces are
// already in the page and the script only flips attributes, so the scoped styles
// cover every state. A round's takeaway shows once all its titles are unmasked.
import BaseLayout from '../layouts/BaseLayout.astro';

// A round's verse: strings stay as written; { kjv, name, note? } is a masked title.
const rounds = [
  {
    ref: 'Psalm 110:1 (KJV)',
    question: 'Two Lords in one verse. Who is speaking to whom?',
    lines: [[
      'The ', { kjv: 'LORD', name: 'Yahuah', note: 'Hebrew YHWH, H3068' }, ' said unto my ', { kjv: 'Lord', name: 'adon — master (Yahushua)', note: 'Hebrew H113' },
      ', Sit thou at my right hand, until I make thine enemies thy footstool.',
    ]],
    takeaway: 'Two persons. One speaks, one is seated.',
  },
  {
    ref: 'John 20:17 (KJV)',
    question: 'After the resurrection, does the Son still have a God?',
    lines: [[
      'Jesus saith unto her, Touch me not; for I am not yet ascended to my Father: but go to my brethren, and say unto them, I ascend unto my Father, and your Father; and to my ',
      { kjv: 'God', name: 'Yahuah' }, ', and your ', { kjv: 'God', name: 'Yahuah' }, '.',
    ]],
    takeaway: 'After the resurrection, Yahushua still has a God.',
  },
  {
    ref: 'Acts 2:36 (KJV)',
    question: 'Who made whom?',
    lines: [[
      'Therefore let all the house of Israel know assuredly, that ', { kjv: 'God', name: 'Yahuah' }, ' hath made that same ', { kjv: 'Jesus', name: 'Yahushua' },
      ', whom ye have crucified, both ', { kjv: 'Lord', name: 'Master' }, ' and ', { kjv: 'Christ', name: 'Messiah' }, '.',
    ]],
    takeaway: 'The Son was made Master. Someone made Him.',
  },
  {
    ref: 'Ephesians 1:17 (KJV)',
    question: 'Whose God is this?',
    lines: [[
      'That the ', { kjv: 'God', name: 'Yahuah' }, ' of our ', { kjv: 'Lord', name: 'Master' }, ' ', { kjv: 'Jesus Christ', name: 'Yahushua Messiah' },
      ', the Father of glory, may give unto you the spirit of wisdom and revelation in the knowledge of him:',
    ]],
    takeaway: 'The Master has a God. The titles hide it; the names cannot.',
  },
  {
    ref: null,
    heading: 'One Pulpit, Two Sermons',
    question: 'Both are preached. Can both be true?',
    lines: [
      ['“The ', { kjv: 'Lord', name: 'Yahushua' }, ' died.”'],
      ['“The ', { kjv: 'Lord', name: 'Yahuah' }, ' is immortal.”'],
    ],
    takeaway: 'Yahushua died; Yahuah “only hath immortality” (1 Timothy 6:16). With the names in place, there is no contradiction.',
  },
];
---

<BaseLayout
  title="Why the Names Matter — Nazaryah"
  description="When every title means everyone, the verses stop meaning anything. Tap each title — LORD, Lord, God — to see who stands behind it, then read why the names matter."
>
  <div class="nm-page">
    <div class="nm-wrap">

      <header class="nm-head">
        <h1 class="nm-title">Who Is “the Lord”?</h1>
        <p class="nm-intro tr-sub">Same words, different persons. Tap each title to see who stands behind it.</p>
      </header>

      {rounds.map((r, i) => (
        <section class="nm-round" data-nm-round aria-labelledby={`nm-q-${i + 1}`}>
          <p class="nm-round-no">Round {i + 1}{r.ref ? ` — ${r.ref}` : r.heading ? ` — ${r.heading}` : ''}</p>
          <h2 class="nm-question" id={`nm-q-${i + 1}`}>{r.question}</h2>
          <div class="nm-verse">
            {r.lines.map((line) => (
              <p>
                {line.map((part) => typeof part === 'string' ? part : (
                  <button type="button" class="nm-mask" aria-pressed="false" data-nm-mask
                    data-label-masked={`${part.kjv}, tap to reveal`}
                    data-label-shown={`${part.name}, the ${part.kjv} unmasked; tap to mask again`}
                    aria-label={`${part.kjv}, tap to reveal`}>
                    <span class="nm-face nm-face--kjv">{part.kjv}</span>
                    <span class="nm-face nm-face--name"><b>{part.name}</b> <small>‹{part.kjv}›</small>{part.note && <small class="nm-note"> {part.note}</small>}</span>
                  </button>
                ))}
              </p>
            ))}
          </div>
          <div class="nm-round-foot">
            <button type="button" class="nm-showall" data-nm-showall>Show all</button>
          </div>
          <p class="nm-takeaway" data-nm-takeaway hidden>{r.takeaway}</p>
        </section>
      ))}

      <p class="nm-bridge">Put the names back, and the verses open up. Here is why.</p>

      <article class="nm-study">
        <h2 class="nm-study-title">Why the Names Matter</h2>
        <p class="nm-study-sub">When every title means everyone, the verses stop meaning anything</p>

        <h3>The Problem</h3>
        <p>Modern preaching runs on two words: “God” and “Lord.” Both are used for the Father and the Son alike. Both are titles, not names. So a speaker can slide from one person to the other mid-sentence, and no one notices. Contradictions that would be plain with names attached sound perfectly smooth without them. That is how the Father and the Son were blended into one undefined figure.</p>

        <h3>Titles Are Not Names</h3>
        <p>“God” translates elohim (H430), and Scripture uses it far beyond the Most High. Moses is “a god to Pharaoh” (Exodus 7:1). Judges are called elohim (Exodus 22:8). Men are told, “Ye are gods” (Psalm 82:6). The adversary is “the god of this world” (2 Corinthians 4:4). A title names a rank, never the one who holds it.</p>
        <p>“Lord” is the same. Hebrew adon (H113): master, sir, used of Abraham, kings, and husbands. Greek kurios (G2962): used of landowners, Roman officials, and Yahushua alike. The name, by contrast, belongs to one alone:</p>
        <blockquote class="nm-quote"><p>Yahuah God of your fathers... this is my name for ever, and this is my memorial unto all generations.</p><cite>Exodus 3:15</cite></blockquote>
        <p>The KJV removed that name about 6,800 times and printed “LORD.” The capital letters are the only trace, and no one can hear capital letters.</p>

        <h3>Baal Means Lord</h3>
        <p>Ba’al (H1167) simply means lord or master. Israel never dropped the word “lord.” It dropped the name, until the title fit anyone. Yahuah answered:</p>
        <blockquote class="nm-quote"><p>And it shall be at that day, saith Yahuah, that thou shalt call me Ishi; and shalt call me no more Baali.</p><cite>Hosea 2:16</cite></blockquote>
        <p>Stop calling Me “my lord.” Call Me “my husband.” The request is His, not some teacher’s.</p>

        <h3>How the Blur Turns Verses Around</h3>
        <p>Once Father and Son are both “the Lord,” any verse can be turned around. In the KJV, “Lord” stands for two different words, and this is not guesswork. Where the translators printed LORD in capitals, the Hebrew text has the four letters of the name, YHWH (H3068). The oldest Greek copies of the Old Testament, Septuagint fragments from before Messiah such as Papyrus Fouad 266, still write those four Hebrew letters right inside the Greek. Where the Hebrew has adon (H113), it means master, sir, or teacher. In the New Testament, Greek kurios (G2962) covers both, and the Old Testament verse being quoted shows which is meant. The parentheses below are not blanks filled in. They put back what the original text says.</p>
        <ul class="nm-list">
          <li>Psalm 110:1. “The LORD (Yahuah) said unto my Lord (adon: master, Yahushua), Sit thou at my right hand.” Two persons. One speaks, one is seated. That is not one Godhead talking to itself.</li>
          <li>Mark 12:29. “Hear, O Israel; The Lord (Yahuah) our God (Elohim) is one Lord (Yahuah).” Yahushua says it. The scribe answers, “there is none other but he,” and Yahushua says he answered wisely (12:32-34).</li>
          <li>Acts 2:36. “God (Yahuah) hath made that same Jesus (Yahushua)... both Lord (master) and Christ (Messiah).” The Son was made master. Someone made Him.</li>
          <li>John 20:17. “I ascend unto my Father, and your Father; and to my God (Yahuah), and your God (Yahuah).” After the resurrection, Yahushua still has a God.</li>
          <li>Ephesians 1:17. “The God (Yahuah) of our Lord (master) Jesus Christ (Yahushua Messiah), the Father of glory.” The master has a God. The titles hide it; the names cannot.</li>
          <li>Romans 1:7. “Grace to you and peace from God (Yahuah) our Father, and the Lord (master) Jesus Christ (Yahushua Messiah).” Paul opens nearly every letter this way. Two persons, two titles, never traded.</li>
          <li>Revelation 3:12. “A pillar in the temple of my God (Yahuah)... I will write upon him the name of my God (Yahuah).” Spoken from heaven. “My God” four times in one verse.</li>
          <li>One pulpit, two sermons. “The Lord died.” “The Lord is immortal.” With names: Yahushua died; Yahuah “only hath immortality” (1 Timothy 6:16).</li>
        </ul>

        <h3>Paul Keeps Them Separate</h3>
        <blockquote class="nm-quote"><p>But to us there is but one God (Yahuah), the Father... and one Lord (master) Yahushua Messiah.</p><cite>1 Corinthians 8:6</cite></blockquote>
        <p>One God: the Father. One Lord: Yahushua. Paul never trades them. The Trinity survives only where the titles float.</p>

        <h3>The Son Carries the Name</h3>
        <p>Yahushua means “Yahuah saves.” He came in His Father’s name (John 5:43). Strip both down to “the Lord” and the message vanishes.</p>

        <h3>Not Legalism</h3>
        <p>Most of Christianity will call this legalism. It is not. No one earns anything by saying a name. It is about clarity. Once the names go back in, the ambiguities disappear. Every verse tells you who is speaking, who is acting, and who is receiving. “God” and “Lord” leave the reader guessing. Yahuah and Yahushua do not. And the request to drop the title came from Yahuah Himself (Hosea 2:16).</p>

        <h3>Where It Ends</h3>
        <p>“His name shall be in their foreheads” (Revelation 22:4). Not a title. A name.</p>
      </article>

      <a class="nm-next" href="/riddle">Try the riddle <span aria-hidden="true">&rarr;</span></a>

    </div>
  </div>
</BaseLayout>

<script>
  for (const round of document.querySelectorAll('[data-nm-round]')) {
    const masks = [...round.querySelectorAll('[data-nm-mask]')];
    const takeaway = round.querySelector('[data-nm-takeaway]');
    const set = (btn, shown) => {
      btn.setAttribute('aria-pressed', String(shown));
      btn.setAttribute('aria-label', shown ? btn.dataset.labelShown : btn.dataset.labelMasked);
    };
    const check = () => { takeaway.hidden = !masks.every((m) => m.getAttribute('aria-pressed') === 'true'); };
    for (const m of masks) m.addEventListener('click', () => { set(m, m.getAttribute('aria-pressed') !== 'true'); check(); });
    round.querySelector('[data-nm-showall]').addEventListener('click', () => { masks.forEach((m) => set(m, true)); check(); });
  }
</script>

<style>
  .nm-page {
    --nm-bg: #f2ead9; --nm-paper: #f8f2e4; --nm-ink: #2b2117; --nm-muted: #6f5f4a; --nm-rule: #d9c8a6;
    --nm-gold: #7f601c; --nm-pill: #dfe5ef; --nm-pill-ink: #0a1d3a; --nm-pill-line: #0a1d3a;
    background: var(--nm-bg); color: var(--nm-ink); padding: 0 16px;
    font-family: 'EB Garamond', Garamond, Georgia, serif; font-size: 18px; line-height: 1.65;
  }
  :global(html.dark) .nm-page {
    --nm-bg: #15110c; --nm-paper: #1d1812; --nm-ink: #ece2cc; --nm-muted: #a8977a; --nm-rule: #3b3123;
    --nm-gold: #d2a849; --nm-pill: #1c2a45; --nm-pill-ink: #dbe4f5; --nm-pill-line: #8aa2cf;
  }
  .nm-wrap { max-width: 42rem; margin: 0 auto; padding: 3rem 0 4.5rem; }
  .nm-head { text-align: center; margin-bottom: 1.5rem; }
  .nm-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: clamp(2rem, 6vw, 2.9rem); line-height: 1.1; margin: 0 0 0.6rem; color: var(--nm-ink); }
  .nm-intro { font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif; font-style: italic; font-size: 1.2rem; color: var(--nm-muted); margin: 0; }

  .nm-round { background: var(--nm-paper); border: 1px solid var(--nm-rule); border-radius: 8px; padding: 1.2rem 1.3rem 1.1rem; margin-top: 1.2rem; }
  .nm-round-no { margin: 0; font-family: 'Cinzel', serif; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--nm-gold); }
  .nm-question { margin: 0.25rem 0 0.7rem; font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 1.25rem; line-height: 1.3; color: var(--nm-ink); }
  .nm-verse p { margin: 0 0 0.35rem; font-size: 1.08rem; line-height: 1.9; }

  .nm-mask {
    font: inherit; display: inline; padding: 0.05rem 0.45rem; margin: 0 0.05rem; border: 0; border-radius: 999px; cursor: pointer;
    background: var(--nm-pill); color: var(--nm-pill-ink); line-height: 1.5;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .nm-mask:focus-visible { outline: 2px solid var(--nm-gold); outline-offset: 2px; }
  .nm-face--kjv { font-variant: small-caps; letter-spacing: 0.04em; text-decoration: underline dotted; text-underline-offset: 3px; text-decoration-color: var(--nm-pill-line); }
  .nm-face--name { display: none; }
  .nm-face--name small { font-size: 0.72em; opacity: 0.8; }
  .nm-mask[aria-pressed='true'] { background: transparent; box-shadow: inset 0 0 0 1px var(--nm-pill-line); }
  .nm-mask[aria-pressed='true'] .nm-face--kjv { display: none; }
  .nm-mask[aria-pressed='true'] .nm-face--name { display: inline; }
  @media (prefers-reduced-motion: no-preference) {
    .nm-mask[aria-pressed='true'] .nm-face--name { animation: nm-flip 0.28s ease-out; }
    @keyframes nm-flip { from { opacity: 0; } to { opacity: 1; } }
  }

  .nm-round-foot { margin-top: 0.4rem; }
  .nm-showall { font: inherit; cursor: pointer; background: none; border: 1px solid var(--nm-rule); border-radius: 999px; padding: 0.25rem 0.9rem; font-family: 'Cinzel', serif; font-size: 0.6rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--nm-muted); }
  .nm-showall:hover { color: var(--nm-ink); border-color: var(--nm-muted); }
  .nm-showall:focus-visible { outline: 2px solid var(--nm-gold); outline-offset: 2px; }
