---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeCard from '../components/HomeCard.astro';
import { getCollection } from 'astro:content';

// ── THE RAIL (evergreen structure) ───────────────────────────────────────
// Level 1 group → its subcategory cards. The 11 EXISTING cards are reused
// verbatim. The 7 NEW subcategories carry `draft: true` — they render with a
// DRAFT badge and a NEUTRAL (unassigned) icon until Dutch approves the copy.
// `placeholder: true` = a subject with no route yet (Cosmology, Living Temple).
// Every href below is an existing route; nothing here invents a URL.
const railGroups = [
  {
    name: 'False Foundations',
    eyebrow: 'What modern Christianity got wrong',
    items: [
      { href: '/trinity', color: 'emerald', icon: '✡', eyebrow: 'Examining a sacred cow', title: 'The <em>Trinity</em>', description: 'Three Gods in one — or one Father quietly hidden behind the doctrine?', cta: 'Examine the Doctrine' },
      { href: '/sun-worship', color: 'amber', icon: '☀', eyebrow: 'The oldest counterfeit', title: 'Sun <em>Worship</em>', description: 'From Babel to Easter morning to the obelisks of every capital city.', cta: 'Trace the Pattern' },
      { href: '/catholicism', color: 'violet', icon: '†', eyebrow: 'The mother church', title: '<em>Catholicism</em>', description: 'The institution that crowned itself — and the daughters who never left home.', cta: 'Open the Indictment' },
      { href: '/foreign-fire', color: 'charcoal', icon: '🜂', eyebrow: 'Strange fire on the altar', title: 'Foreign <em>Fire</em>', description: 'Worship Yahuah did not command. Nadab and Abihu would recognize it.', cta: 'Read the Warning' },
    ],
  },
  {
    name: 'Restoration',
    eyebrow: 'What the text actually says',
    items: [
      { href: '/calendar', color: 'indigo', icon: '☾', eyebrow: 'Set in the lights', title: 'The <em>Calendar</em>', description: 'Aviv, the renewed moon, the Sabbath. The way Yahuah set the seasons.', cta: 'Open the Calendar' },
      { href: '/hebrew', color: 'oxblood', icon: 'ב', eyebrow: 'The language of Yahuah', title: 'Hebrew <em>Word</em>', description: 'Restored names, root words, and the meanings translation flattened.', cta: 'Study the Roots' },
      { placeholder: true, draft: true, color: 'navy', icon: '', eyebrow: 'Placeholder', title: '<em>Cosmology</em>', description: 'The shape of what Yahuah made — the firmament, the north, and the machine built to hide both.', cta: 'Coming soon' },
    ],
  },
  {
    name: 'Living Torah',
    eyebrow: 'Walking it out',
    items: [
      { href: '/hollywood', color: 'blackgold', icon: '◉', eyebrow: 'Raised on magic', title: '<em>Hollywood</em>', description: 'Wizards as heroes. Witches as misunderstood. Catechism in disguise.', cta: 'Open the Section' },
      { href: '/american-idolatry', color: 'navy', icon: '★', eyebrow: 'The flag on the pulpit', title: 'American <em>Idolatry</em>', description: 'When country becomes covenant and patriotism becomes worship.', cta: 'Examine It' },
      { href: '/holidays', color: 'burgundy', icon: '✦', eyebrow: 'Christmas · Easter · Sunday', title: 'The <em>Holidays</em>', description: 'Days the church kept that the text never named — and the Feasts it forgot.', cta: 'Trace the Origins' },
      { href: '/ekklesia', color: 'stone', icon: '⌂', eyebrow: 'What the church is not', title: '<em>Ekklesia</em>', description: 'The institution called “church” — and how far it drifted from the assembly.', cta: 'Recover the Pattern' },
    ],
  },
  {
    name: 'What They Buried',
    eyebrow: 'Dug back up',
    items: [
      { href: '/christian-or-demonic', draft: true, color: 'oxblood', icon: '', eyebrow: 'Test what you were taught', title: 'Christian <em>or Demonic?</em>', description: 'Five pillars, five hard questions — hold what you were taught up to the text.', cta: 'Begin the Examination' },
      { href: '/hidden-gems', color: 'teal', icon: '◈', eyebrow: 'Buried in plain sight', title: 'Hidden <em>Gems</em>', description: 'The verses your pastor flipped past — and what they actually mean.', cta: 'Dig In' },
      { placeholder: true, draft: true, color: 'sepia', icon: '', eyebrow: 'Placeholder', title: 'Living <em>Temple</em>', description: 'You are the temple — what dwells in it, and what keeps it clean.', cta: 'Coming soon' },
    ],
  },
  {
    name: 'Pathways',
    eyebrow: 'Build your own study',
    items: [
      { href: '/pathway/name-and-nature', draft: true, color: 'emerald', icon: '', eyebrow: 'Guided pathway', title: 'The Name <em>and the Nature</em>', description: 'Who Yahuah is, and how the church has been mistranslating His Name.', cta: 'Walk the Path' },
      { href: '/pathway/grave-and-gate', draft: true, color: 'indigo', icon: '', eyebrow: 'Guided pathway', title: 'The Grave <em>and the Gate</em>', description: 'What really happens when you die — and where the fiery hell came from.', cta: 'Walk the Path' },
    ],
  },
  {
    name: "The Scribe's Desk",
    eyebrow: 'The reference shelf',
    items: [
      { href: '/doctrines', draft: true, color: 'stone', icon: '', eyebrow: 'Start here', title: 'The <em>Doctrines</em>', description: 'The core teachings examined one at a time — the best place to start.', cta: 'Read the Doctrines' },
      { href: '/books', draft: true, color: 'blackgold', icon: '', eyebrow: 'Long-form', title: 'The <em>Books</em>', description: 'The full-length works, from Genesis patterns to Revelation’s courtroom.', cta: 'Open the Shelf' },
      { href: '/blog', color: 'sepia', icon: 'א', eyebrow: 'Scripture unfiltered', title: 'The <em>Studies</em>', description: 'Word studies, doctrines, and topical deep-dives — the full archive.', cta: 'All Studies' },
    ],
  },
];

// ── THE WATCHMAN'S REPORT (band) — the newest brief drives slot 1. ──
const _reports = (await getCollection('watchmans-report'))
  .filter((r) => r.data.draft !== true)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestReport = _reports[0];

// ── FEATURED PICKS (band) — 5 most recent blogs, with a manual override.
// Pin a blog to the front by adding its slug to PINNED_SLUGS (or set
// `featured: true` in a blog's frontmatter). Pins push the oldest auto-picks
// out; the total always stays at 5.
const PINNED_SLUGS: string[] = [];
const _allPosts = (await getCollection('posts', (p) => p.data.draft !== true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const _pinned = [
  ...PINNED_SLUGS.map((s) => _allPosts.find((p) => p.slug === s)).filter(Boolean),
  ..._allPosts.filter((p) => p.data.featured && !PINNED_SLUGS.includes(p.slug)),
];
const featuredPicks = [..._pinned, ..._allPosts.filter((p) => !_pinned.includes(p))].slice(0, 5);
---

<BaseLayout
  title="Nazaryah - Biblical Studies with Scholarly Integrity"
  description="Explore Scripture through original languages, fresh perspectives, and rich historical context. A modern biblical studies platform for serious learners."
>
  <!-- Hero Section -->
  <section class="hero-section relative overflow-hidden">
    <!-- Subtle grid texture overlay -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="
      background-image:
        repeating-linear-gradient(0deg, transparent, transparent 39px, rgba(0,0,0,0.022) 40px),
        repeating-linear-gradient(90deg, transparent, transparent 39px, rgba(0,0,0,0.022) 40px);
      z-index: 0;
    "></div>

    <div class="hero-grid relative z-10">
      <!-- LEFT: Logo panel (dark background matches logo image) -->
      <div class="logo-panel">
        <img
          src="/images/nazaryah-logo.png"
          alt="Nazaryah — Separated Unto Yah"
          class="logo-panel-img"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- RIGHT: Content -->
      <div class="content-panel">
        <div class="hero-eyebrow">Separated Unto Yahuah</div>
        <h1 class="hero-headline">
          The doctrine was built<br>
          to keep you <em>comfortable.</em>
        </h1>
        <div class="hero-rule"></div>
        <div class="hero-body-row">
          <p class="hero-body">
            Nazaryah goes back to the source — original languages, restored names, and the Torah your church quietly skipped. No denominations. No comfortable answers. Just the text.
          </p>
          <div class="hero-cta-stack">
            <a href="/doctrines" class="hero-cta" aria-label="Start here — Doctrines">
              <span class="hero-cta-badge"><span class="star" aria-hidden="true">★</span> Start Here</span>
              <span class="hero-cta-label">Doctrines</span>
              <span class="hero-cta-arrow" aria-hidden="true">→</span>
            </a>
            <a href="/books" class="hero-cta hero-cta--ghost" aria-label="Read — Published Books">
              <span class="hero-cta-badge"><span class="star" aria-hidden="true">★</span> Read</span>
              <span class="hero-cta-label">Published Books</span>
              <span class="hero-cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .hero-section {
      width: 100%;
      padding: 1rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 5fr 8fr;
      width: 100%;
      max-width: 80rem;
      /* Aspect ratio dropped — the second stacked CTA needs vertical room
         and the box now sizes to its content. min-height keeps the box
         from collapsing on copy changes. */
      min-height: 16rem;
      overflow: hidden;
      border-radius: 4px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.22), 0 2px 8px rgba(0,0,0,0.15);
    }

    /* ── LEFT PANEL: dark, logo centered ── */
    .logo-panel {
      position: relative;
      background: #0f0a04;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem 1.25rem;
      overflow: hidden;
    }

    /* Subtle warm radial glow behind the logo */
    .logo-panel::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 45%, rgba(180, 120, 30, 0.18) 0%, transparent 70%);
      pointer-events: none;
    }

    /* Corner ornaments */
    .logo-panel::after {
      content: '';
      position: absolute;
      top: 10px; left: 10px;
      width: 20px; height: 20px;
      border-top: 1.5px solid rgba(196, 154, 78, 0.45);
      border-left: 1.5px solid rgba(196, 154, 78, 0.45);
    }

    .logo-panel-img {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 85%;
      object-fit: contain;
    }

    /* ── RIGHT PANEL ── */
    .content-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.6rem;
      padding: 1rem 2rem;
    }

    .hero-eyebrow {
      color: #6b4d12;
      font-family: var(--font-display, 'Cinzel', Georgia, serif);
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 0.15rem;
    }
    .hero-eyebrow::before {
      content: '\25C6  '; /* ◆ */
      color: #d4a531;
    }

    .hero-headline {
      font-family: var(--font-display);
      font-size: clamp(1.25rem, 2.1vw, 1.85rem);
      font-weight: 700;
      line-height: 1.12;
      letter-spacing: -0.005em;
      color: var(--color-primary-text);
      margin: 0;
    }

    .hero-headline em {
      font-style: italic;
      color: #6b4d12;
      font-weight: 600;
    }

    .hero-rule {
      width: 50px;
      height: 2px;
      background: #d4a531;
      opacity: 0.85;
      margin-top: 0.1rem;
    }

    /* Body + CTA share one horizontal row so the button hangs to the
       right of the paragraph instead of dropping below the hero box. */
    .hero-body-row {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      margin-top: 0.4rem;
    }

    .hero-body {
      font-family: var(--font-body);
      font-size: 0.92rem;
      line-height: 1.5;
      color: var(--color-secondary-text);
      /* Cap the column so it never bleeds past the end of the headline
         word "COMFORTABLE." — leaves room for the CTA on the right. */
      flex: 1 1 0;
      max-width: 26rem;
      margin: 0;
    }

    /* Vertical stack for the two CTAs — primary on top, ghost secondary
       beneath. Aligned to the start of the column so both buttons start
       at the same left edge. */
    .hero-cta-stack {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      flex: 0 0 auto;
      align-self: center;
    }

    /* ── "Start Here · Doctrines" CTA — single gold pill with badge inside ── */
    .hero-cta {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      flex: 0 0 auto;
      align-self: center;
      padding: 0.85rem 1.6rem;
      background: linear-gradient(180deg, #f0c450 0%, #d4a531 100%);
      color: #1a0e06;
      text-decoration: none;
      font-family: var(--font-display, 'Cinzel', 'Playfair Display', Georgia, serif);
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      border: 2px solid #a87f1f;
      border-radius: 4px;
      box-shadow: 0 4px 12px -2px rgba(168, 127, 31, 0.45);
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }
    .hero-cta:hover {
      transform: translateY(-1px);
      background: linear-gradient(180deg, #d4a531 0%, #a87f1f 100%);
      box-shadow: 0 6px 16px -2px rgba(168, 127, 31, 0.55);
    }

    .hero-cta-badge {
      background: #1a0e06;
      color: #f0c450;
      font-size: 0.62rem;
      letter-spacing: 0.22em;
      font-weight: 700;
      padding: 0.32rem 0.7rem;
      border-radius: 999px;
      white-space: nowrap;
    }
    .hero-cta-badge .star {
      margin-right: 0.2rem;
    }

    .hero-cta-label {
      font-size: 1rem;
      font-weight: 700;
      color: #1a0e06;
    }
    .hero-cta-arrow {
      font-size: 1rem;
      line-height: 1;
      transition: transform 0.2s ease;
    }
    .hero-cta:hover .hero-cta-arrow {
      transform: translateX(3px);
    }

    /* Ghost variant — same compound shape as primary but transparent
       background with a gold outline. Visually subordinate so Doctrines
       stays the dominant "Start Here" entry point. */
    .hero-cta--ghost {
      background: transparent;
      border-color: #a87f1f;
      color: #6b4d12;
      padding: 0.65rem 1.3rem;
      font-size: 0.82rem;
      box-shadow: none;
    }
    .hero-cta--ghost .hero-cta-badge {
      background: #1a0e06;
      color: #f0c450;
      font-size: 0.55rem;
      padding: 0.25rem 0.55rem;
    }
    .hero-cta--ghost .hero-cta-label,
    .hero-cta--ghost .hero-cta-arrow {
      color: #6b4d12;
      font-size: 0.85rem;
    }
    .hero-cta--ghost:hover {
      transform: translateY(-1px);
      background: rgba(168, 127, 31, 0.1);
      border-color: #6b4d12;
      box-shadow: 0 4px 10px -3px rgba(168, 127, 31, 0.3);
    }

    /* ── Responsive ── */
    @media (max-width: 640px) {
      .pillar-grid {
        grid-template-columns: 1fr !important;
      }
    }

    @media (max-width: 720px) {
      .hero-section {
        padding: 1.5rem 1rem;
      }

      .hero-grid {
        grid-template-columns: 1fr;
        aspect-ratio: unset;
        max-width: 100%;
      }

      .logo-panel {
        padding: 1.75rem 1.5rem;
        min-height: 180px;
      }

      .logo-panel-img {
        max-width: 220px;
      }

      .content-panel {
        padding: 1.75rem 1.5rem;
        gap: 0.75rem;
      }

      .hero-headline {
        font-size: 1.6rem;
      }

      /* Stack body + button vertically once the hero collapses to one column */
      .hero-body-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .hero-body {
        max-width: 100%;
      }
    }
  </style>


  <!-- ============================================================
       THE RAIL — evergreen structure. CSS-only (hidden radios +
       :checked ~). Desktop = subject rail + card panel; <768px =
       <details> accordions. Container swap: HomeCard is untouched.
       ============================================================ -->
  <section class="rail-section" aria-label="Browse by subject">
    <div class="rail-shell">

      <!-- Desktop rail -->
      <div class="cat-rail">
        {railGroups.map((g, i) => (
          <input type="radio" name="home-rail" id={`home-rail-${i}`} class="cat-rail-radio" checked={i === 0} />
        ))}
        <div class="cat-rail-list">
          {railGroups.map((g, i) => (
            <label for={`home-rail-${i}`} class="cat-rail-item">
              <span class="cat-rail-name">{g.name}</span>
              <span class="cat-rail-tag">{g.eyebrow}</span>
            </label>
          ))}
        </div>
        <div class="cat-rail-panels">
          {railGroups.map((g) => (
            <div class="cat-rail-panel">
              <div class="rail-cards">
                {g.items.map((it) => (
                  it.placeholder ? (
                    <div class="rail-card--placeholder">
                      <span class="rail-draft-badge">DRAFT</span>
                      <span class="rail-ph-icon" aria-hidden="true">{it.icon}</span>
                      <div>
                        <p class="rail-ph-eyebrow">{it.eyebrow}</p>
                        <h3 class="rail-ph-title" set:html={it.title} />
                        <p class="rail-ph-desc">{it.description}</p>
                      </div>
                      <span class="rail-ph-cta">{it.cta}</span>
                    </div>
                  ) : it.draft ? (
                    <div class="rail-card--draft">
                      <span class="rail-draft-badge">DRAFT</span>
                      <HomeCard href={it.href} color={it.color} icon={it.icon} eyebrow={it.eyebrow} title={it.title} description={it.description} cta={it.cta} />
                    </div>
                  ) : (
                    <HomeCard href={it.href} color={it.color} icon={it.icon} eyebrow={it.eyebrow} title={it.title} description={it.description} cta={it.cta} />
                  )
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile accordion -->
      <div class="cat-accordion">
        {railGroups.map((g, i) => (
          <details class="cat-acc-item" open={i === 0}>
            <summary class="cat-acc-summary">{g.name}</summary>
            <div class="cat-acc-body">
              <div class="rail-cards">
                {g.items.map((it) => (
                  it.placeholder ? (
                    <div class="rail-card--placeholder">
                      <span class="rail-draft-badge">DRAFT</span>
                      <span class="rail-ph-icon" aria-hidden="true">{it.icon}</span>
                      <div>
                        <p class="rail-ph-eyebrow">{it.eyebrow}</p>
                        <h3 class="rail-ph-title" set:html={it.title} />
                        <p class="rail-ph-desc">{it.description}</p>
                      </div>
                      <span class="rail-ph-cta">{it.cta}</span>
                    </div>
                  ) : it.draft ? (
                    <div class="rail-card--draft">
                      <span class="rail-draft-badge">DRAFT</span>
                      <HomeCard href={it.href} color={it.color} icon={it.icon} eyebrow={it.eyebrow} title={it.title} description={it.description} cta={it.cta} />
                    </div>
                  ) : (
                    <HomeCard href={it.href} color={it.color} icon={it.icon} eyebrow={it.eyebrow} title={it.title} description={it.description} cta={it.cta} />
                  )
                ))}
              </div>
            </div>
          </details>
        ))}
      </div>

    </div>
  </section>


  <!-- ============================================================
       THE WATCHMAN'S REPORT — timely band. Slot 1 news brief (field-
       notes look), Slot 2 Featured Picks, Slot 3 YouTube, + archive link.
       ============================================================ -->
  <section class="wr-section" aria-label="The Watchman's Report">
    <div class="wr-container">

      <div class="wr-header">
        <p class="wr-eyebrow">★ Field Notes From the Wall ★</p>
        <h2 class="wr-title">The Watchman&rsquo;s Report</h2>
      </div>

      <div class="wr-top">
        {latestReport && (
          <article class={`wr-brief wr-tone-${latestReport.data.tone}`}>
            <div class="wr-tag">
              <span>{latestReport.data.tag}</span>
              <span class="wr-star">★</span>
            </div>
            <div class="wr-brief-body">
              <p class="wr-dateline">{latestReport.data.dateline}</p>
              <h3 class="wr-brief-title">{latestReport.data.title}</h3>
              <p class="wr-teaser">{latestReport.data.teaser}</p>
              <div class="wr-links">
                <a href="/watchmans-desk" class="wr-link">Read the brief &rarr;</a>
                <a href={latestReport.data.studyUrl} class="wr-link wr-link-study">{latestReport.data.linkText} &rarr;<span class="wr-link-sub">{latestReport.data.studyLabel}</span></a>
              </div>
            </div>
          </article>
        )}

        <a href="https://youtube.com/@Nazar-144" class="wr-youtube" target="_blank" rel="noopener noreferrer">
          <span class="wr-yt-avatar" aria-hidden="true">☾</span>
          <span class="wr-yt-kicker">YouTube</span>
          <span class="wr-yt-name">Dutchman</span>
          <span class="wr-yt-handle">@Nazar-144</span>
          <span class="wr-yt-cta">Visit the channel &rarr;</span>
        </a>
      </div>

      <div class="wr-picks">
        <p class="wr-picks-title">Featured Picks</p>
        <div class="wr-picks-grid">
          {featuredPicks.map((p) => (
            <a href={`/blog/${p.slug}`} class="wr-pick">
              <span class="wr-pick-date">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>
              <span class="wr-pick-title">{p.data.title}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="wr-archive">
        <a href="/watchmans-desk" class="wr-archive-btn">Browse all reports &rarr;</a>
      </div>

    </div>
  </section>

  <style>
    /* ============================================================
       THE RAIL — CSS-only subject switcher (hidden radios + :checked ~).
       Same pattern as the shipped /hollywood rail. No JS, no hydration.
       ============================================================ */
    .rail-section {
      background: #0a0a0a;
      padding: 2.75rem 0 3.25rem;
      border-bottom: 1px solid rgba(212, 175, 55, 0.1);
    }
    .rail-shell { max-width: 80rem; margin: 0 auto; padding: 0 2.5rem; }

    .cat-rail {
      position: relative;
      display: grid;
      grid-template-columns: 215px 1fr;
      gap: 2.4rem;
      align-items: start;
    }
    /* Radios: visually hidden but focusable (clipped sr-only, NOT display:none). */
    .cat-rail-radio {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; border: 0; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
    .cat-rail-list { position: sticky; top: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
    .cat-rail-item {
      display: flex; flex-direction: column; gap: 0.12rem;
      padding: 0.7rem 0.9rem; cursor: pointer;
      border-left: 2px solid transparent; border-radius: 0 3px 3px 0;
