    /* Draft badge — marks the 7 unapproved subcategories */
    .rail-card--draft { position: relative; }
    .rail-draft-badge {
      position: absolute; top: 0.55rem; right: 0.55rem; z-index: 5;
      font-family: 'Cinzel', serif; font-size: 0.5rem; letter-spacing: 0.16em;
