    /* ============================================================
       THE WATCHMAN'S REPORT — field-notes band. Deliberately looks
       different from the muted-dark rail: red / cream / navy news look.
       ============================================================ */
    .wr-section {
      --wr-navy: #0a1d3a; --wr-navy-deep: #061230; --wr-red: #b8232a;
      --wr-red-deep: #8a1a20; --wr-cream: #f5f1e6; --wr-parchment: #ebe3cf;
      --wr-gold: #c9a961; --wr-ink-soft: #3a3a3a;
      background: #0a0a0a; padding: 3.25rem 0 4rem; border-top: 4px solid var(--wr-red);
    }
    .wr-container { max-width: 80rem; margin: 0 auto; padding: 0 2.5rem; }
    .wr-header { text-align: center; margin-bottom: 2rem; }
    .wr-eyebrow { font-family: 'Cinzel', serif; font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--wr-red); font-weight: 700; margin: 0 0 0.5rem; }
    .wr-title { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-weight: 900; font-size: clamp(1.9rem, 3.4vw, 2.6rem); color: var(--wr-cream); margin: 0; }

    .wr-top { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; align-items: stretch; margin-bottom: 2.5rem; }

    /* Slot 1 — news brief, field-notes cream card on the dark band */
