    .wr-tag { background: var(--wr-navy-deep); color: var(--wr-cream); padding: 10px 20px; font-family: 'Cinzel', serif; font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; display: flex; align-items: center; justify-content: space-between; }
    .wr-tone-urgent .wr-tag { background: var(--wr-red); }
    .wr-tone-horizon .wr-tag { background: var(--wr-gold); color: var(--wr-navy-deep); }
    .wr-star { font-size: 0.85rem; }
    .wr-brief-body { padding: 1.5rem 1.6rem; display: flex; flex-direction: column; flex: 1; }
    .wr-dateline { font-family: 'Times New Roman', Georgia, serif; font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: #6e5a3f; font-weight: 700; margin: 0 0 0.6rem; }
    .wr-brief-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 800; font-size: clamp(1.3rem, 2.4vw, 1.7rem); line-height: 1.15; color: var(--wr-navy-deep); margin: 0 0 0.9rem; border-bottom: 1px solid rgba(10,29,58,0.18); padding-bottom: 0.7rem; }
    .wr-teaser { font-family: Georgia, serif; font-size: 1rem; line-height: 1.65; color: var(--wr-ink-soft); margin: 0 0 1.25rem; }
    .wr-links { margin-top: auto; display: flex; flex-direction: column; gap: 0.6rem; }
    .wr-link { display: block; padding: 0.7rem 1rem; background: var(--wr-parchment); border-left: 4px solid var(--wr-red); color: var(--wr-red-deep); font-family: 'Cinzel', serif; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; text-decoration: none; transition: all 0.2s ease; }
    .wr-link:hover { background: var(--wr-navy-deep); color: var(--wr-cream); border-left-color: var(--wr-gold); }
    .wr-link-sub { display: block; margin-top: 5px; font-family: Georgia, serif; font-style: italic; font-size: 0.85rem; text-transform: none; letter-spacing: 0; color: var(--wr-ink-soft); font-weight: 400; }
    .wr-link-study:hover .wr-link-sub { color: var(--wr-gold); }

    /* Slot 3 — YouTube link-out */
    .wr-youtube { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 0.3rem; padding: 2rem 1.5rem; border-radius: 6px; text-decoration: none; background: radial-gradient(ellipse at 50% 25%, #241318 0%, #140b0d 70%, #0b0607 100%); border: 1px solid rgba(184,35,42,0.4); transition: transform .2s ease, border-color .2s ease; }
    .wr-youtube:hover { transform: translateY(-3px); border-color: var(--wr-red); }
    .wr-yt-avatar { font-size: 2.2rem; line-height: 1; color: var(--wr-gold); }
    .wr-yt-kicker { font-family: 'Cinzel', serif; font-size: 0.58rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--wr-red); font-weight: 700; margin-top: 0.4rem; }
    .wr-yt-name { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 1.5rem; color: var(--wr-cream); }
    .wr-yt-handle { font-family: Georgia, serif; font-size: 0.9rem; color: #a09078; }
    .wr-yt-cta { font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--wr-gold); margin-top: 0.5rem; }

    /* Slot 2 — Featured Picks (blog pointers) */
    .wr-picks { margin-bottom: 2rem; }
    .wr-picks-title { font-family: 'Cinzel', serif; font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--wr-gold); text-align: center; margin: 0 0 1.2rem; }
    .wr-picks-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
    .wr-pick { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.1rem 1.2rem; border-radius: 4px; text-decoration: none; background: #141210; border: 1px solid rgba(201,169,97,0.16); border-top: 3px solid var(--wr-gold); transition: transform .2s ease, background .2s ease; }
    .wr-pick:hover { transform: translateY(-3px); background: #1b1813; }
    .wr-pick-date { font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.14em; text-transform: uppercase; color: #a08a4e; }
    .wr-pick-title { font-family: 'Playfair Display', Georgia, serif; font-size: 1.05rem; line-height: 1.2; color: #f5e6c8; }

    .wr-archive { text-align: center; }
    .wr-archive-btn { display: inline-block; padding: 0.75rem 1.8rem; border-radius: 3px; font-family: 'Cinzel', serif; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; text-decoration: none; color: var(--wr-cream); background: var(--wr-red-deep); border: 1px solid var(--wr-red); transition: background .2s ease, border-color .2s ease; }
    .wr-archive-btn:hover { background: var(--wr-navy-deep); border-color: var(--wr-gold); }

    /* ============================================================
       RESPONSIVE
