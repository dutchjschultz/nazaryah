---
import BaseLayout from '../layouts/BaseLayout.astro';
import MoedCountdown from '../components/MoedCountdown.jsx';
import { toScriptural } from '../lib/scriptural-date.js';
import { avivOneDate, romanDate } from '../lib/moedim.js';

// Aviv 1 is fixed for the whole year, so it is resolved once at build time
// rather than shipped to the browser. The weekday is left off: the Roman week
// is the thing this calendar exists to get out from under, and romanDate keeps
// it opt-in for that reason.
const avivOne = avivOneDate(toScriptural);
const avivOneRoman = romanDate(avivOne);
---

<BaseLayout
  title="Yahuah's Feast Calendar — Nazaryah"
  description="The mo'edim of the Father — set into the sun, the moon, and the stars on day four of creation, written in the heavens for every believer to see."
>
  <main class="cal-landing">

    <!-- ──────────────── TEASER BANNER ──────────────── -->
    <a href="/calendar/today" class="today-banner">
      <div class="today-banner-inner">
        <div class="today-banner-side roman">
          <span class="today-banner-label">Your phone says</span>
          <span class="today-banner-value" id="banner-roman-date">&mdash;</span>
        </div>

        <div class="today-banner-cta">
          <div class="today-banner-cta-eyebrow">Today</div>
          <div class="today-banner-cta-line">Which one are you on?</div>
          <div class="today-banner-cta-arrow">See both calendars &rarr;</div>
        </div>

        <div class="today-banner-side yahs">
          <span class="today-banner-label">The heavens say</span>
          <span class="today-banner-value" id="banner-yahs-date">&mdash;</span>
          <!-- Only ever "New Moon" or "Sabbath"; hidden on the other days. -->
          <span class="today-banner-daylabel" id="banner-yahs-daylabel" hidden></span>
          {avivOneRoman && (
            <span class="today-banner-aviv">Aviv 1 &middot; {avivOneRoman}</span>
          )}
        </div>
      </div>
    </a>

    <!-- ──────────────── NEXT MOED ────────────────
         client:load, not a build-time render: the site is static, so a
         countdown baked at deploy is wrong the next morning. -->
    <section class="cal-moed" aria-label="The next appointed time">
      <MoedCountdown client:load />
    </section>

    <!-- ──────────────── HERO ──────────────── -->
    <section class="cal-hero">
      <p class="cal-eyebrow with-rules">Feast Calendar</p>
      <h1 class="cal-title">Yahuah's Appointed Times</h1>
      <p class="cal-subtitle">The mo'edim of the Father &mdash; set into the sun, the moon, and the stars on day four of creation, written in the heavens for every believer to see.</p>
    </section>

    <!-- ──────────────── 3 LUMINARY CARDS ──────────────── -->
    <section class="cal-block">
      <div class="cal-section-head">
        <p class="cal-eyebrow with-rules">Before the Calendar</p>
        <h2 class="cal-section-title">The Lights Yahuah Made</h2>
        <p class="cal-section-subtitle">What the sun, moon, and stars are, what they were made for, and why the One who made them is the only One worth the credit.</p>
      </div>

      <div class="luminary-grid">

        <a href="/studies/the-sun-in-scripture" class="luminary-card lum-sun">
          <p class="card-label">Foundation &middot; The Greater Light</p>
          <h3>The Sun in Scripture</h3>
          <p>What the sun represents, where its light comes from, and why it is not the Son. The greater light, the Father's office, and the lamp that will one day be retired.</p>
          <span class="read-link">Read the Study &rarr;</span>
        </a>

        <a href="/studies/the-moon-in-scripture" class="luminary-card lum-moon">
          <p class="card-label">Foundation &middot; The Lesser Light</p>
          <h3>The Moon in Scripture</h3>
          <p>What the moon represents, where her light comes from, and the bride's witness in the heavens. Levanah, the white one &mdash; the lamp of the night who marks the months.</p>
          <span class="read-link">Read the Study &rarr;</span>
        </a>

        <a href="/studies/the-stars-in-scripture" class="luminary-card lum-stars">
          <p class="card-label">Foundation &middot; The Host of Heaven</p>
          <h3>The Stars in Scripture</h3>
          <p>What the stars represent, how they witness the year, and the bright morning Star Himself. The host of heaven &mdash; Yahuah's army of messengers marching in unison around the pole.</p>
          <span class="read-link">Read the Study &rarr;</span>
        </a>

      </div>
    </section>

    <!-- ──────────────── DIVIDER ──────────────── -->
    <div class="cal-divider">
      <span class="glyph">&#9670; &#9670; &#9670;</span>
    </div>

    <!-- ──────────────── 8 CATEGORY CARDS ──────────────── -->
    <section class="cal-block">
      <div class="cal-section-head">
        <p class="cal-eyebrow with-rules">The Eight Categories</p>
        <h2 class="cal-section-title">Walking Through the Calendar</h2>
        <p class="cal-section-subtitle">From the foundations of the appointed times, to the feasts themselves, to walking them out today.</p>
      </div>

      <div class="category-grid">

        <a href="/calendar/foundation" class="cat-card cat-card-active">
          <p class="roman">I</p>
          <h3>Foundation</h3>
          <p>The mo'edim of Yahuah, the Hebrew word that names them, and Creation's calendar set against man's.</p>
          <span class="study-count">3 Studies</span>
        </a>

        <a href="/calendar/whose-calendar" class="cat-card cat-card-active">
          <p class="roman">II</p>
          <h3>Whose Calendar?</h3>
          <p>How Rome's Gregorian system replaced Yahuah's heavens, and where the rabbinic calendar drifted from Torah.</p>
          <span class="study-count">3 Studies</span>
        </a>

        <a href="/calendar/the-day" class="cat-card cat-card-active">
          <p class="roman">III</p>
          <h3>The Day</h3>
          <p>The 12-hour day of light, dawn to dusk &mdash; the Babylonian sundown tradition, and the Roman midnight lie that crept into the church.</p>
          <span class="study-count">3 Studies</span>
        </a>

        <a href="/calendar/the-week" class="cat-card cat-card-active">
          <p class="roman">IV</p>
          <h3>The Week &amp; Sabbath</h3>
          <p>The lunar Sabbath cycle that resets every new moon, the perpetual sign Yahuah called <em>olam</em>, and the continuous Roman week Constantine layered Sunday on top of.</p>
          <span class="study-count">3 Studies</span>
        </a>

        <a href="/calendar/the-month" class="cat-card cat-card-active">
          <p class="roman">V</p>
          <h3>The Month</h3>
          <p>Chodesh meaning renewed, the new moon throughout Scripture, and how the moon is rightly determined.</p>
          <span class="study-count">3 Studies</span>
        </a>

        <a href="/calendar/the-year" class="cat-card cat-card-active">
          <p class="roman">VI</p>
          <h3>The Year</h3>
          <p>Aviv as the first month, what aviv actually means, the heavenly and earthly witnesses Yahuah set, and why equinox-based calendars miss the mark.</p>
          <span class="study-count">4 Studies</span>
        </a>

        <a href="/calendar/mazzaroth" class="cat-card cat-card-active">
          <p class="roman">VII</p>
          <h3>The Mazzaroth</h3>
          <p>Yahuah's gospel written in the stars, separated from zodiac corruption, and the banners of the twelve tribes.</p>
          <span class="study-count">3 Studies</span>
        </a>

        <a href="/calendar/seven-moedim" class="cat-card cat-card-active">
          <p class="roman">VIII</p>
          <h3>The Seven Moedim</h3>
          <p>Pesach, Hag HaMatzot, Bikkurim, Shavuot, Yom Teruah, Yom Kippur, and Sukkot.</p>
          <span class="study-count">8 Studies</span>
        </a>

      </div>
    </section>

    <!-- ──────────────── CLOSING STUDIES ──────────────── -->
    <section class="cal-closing-block">
      <div class="cal-closing-head">
        <p class="cal-closing-eyebrow">Before You Go</p>
      </div>

      <div class="closing-grid">

        <a href="/calendar/sabbatical-jubilee" class="closing-card">
          <h3>Sabbatical &amp; Jubilee</h3>
          <p>Two long-cycle commands the modern world cannot fully accommodate &mdash; what they were, what they represented, and what they still teach.</p>
          <span class="closing-cta">Read the Study →</span>
        </a>

        <a href="/calendar/false-feasts" class="closing-card">
          <h3>False Feasts Exposed</h3>
          <p>The pagan substitutes Christianity has adopted in place of Yahuah's moedim &mdash; Christmas, Easter, Lent, Halloween, and Sunday worship.</p>
          <span class="closing-cta">Read the Study →</span>
        </a>

        <a href="/calendar/salvation-first" class="closing-card">
          <h3>Salvation First</h3>
          <p>These studies are the fruit, not the root. Settle the foundation of deliverance by favor before walking out the rest of the calendar.</p>
          <span class="closing-cta">Read the Study →</span>
        </a>

        <a href="/calendar/where-to-start" class="closing-card">
          <h3>Where to Start</h3>
          <p>Practical first steps for walking out the calendar when you're just beginning &mdash; the next Sabbath, the next renewed moon, the next Pesach.</p>
          <span class="closing-cta">Read the Study →</span>
        </a>

      </div>
    </section>

  </main>
</BaseLayout>

<!-- ════════════════════════════════════════════════════════════════
     TEASER-BANNER DATE LOGIC
     Populates the Roman and Yahuah dates in the today-comparison
     banner. The month table is NOT here — it lives once, in
     src/lib/scriptural-date.js, and is imported below. Nothing to keep
     in sync any more.
     ════════════════════════════════════════════════════════════════ -->
<script>
import { toScriptural, scripturalLabel } from '../lib/scriptural-date.js';
import { dayLabel } from '../lib/moedim.js';

(function() {
  'use strict';

  var dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
  var monthNames = ['January','February','March','April','May','June',
                    'July','August','September','October','November','December'];

  var today = new Date();
  var dayName = dayNames[today.getDay()];
  var romanDate = monthNames[today.getMonth()] + ' ' + today.getDate();

  var romanEl = document.getElementById('banner-roman-date');
  if (romanEl) romanEl.textContent = dayName + ', ' + romanDate;

  // One source of truth. The table used to be pasted here and in
  // /calendar/today; both now import it from src/lib/scriptural-date.js, and
  // so does the moed countdown, so the three cannot drift apart.
  var todayScriptural = toScriptural(today);
  var yahsLabel = scripturalLabel(today) || '\u2014';

  // New Moon on day 1, Sabbath on the 8th/15th/22nd/29th, nothing otherwise.
  var bannerDayLabel = todayScriptural ? dayLabel(todayScriptural.day) : null;
  var dayLabelEl = document.getElementById('banner-yahs-daylabel');
  if (dayLabelEl) {
    dayLabelEl.textContent = bannerDayLabel || '';
    dayLabelEl.hidden = !bannerDayLabel;
  }

  var yahsEl = document.getElementById('banner-yahs-date');
  if (yahsEl) yahsEl.textContent = yahsLabel;
})();
</script>

<style>
  /* ─── Page wrap ─── */
  .cal-landing {
    background: linear-gradient(180deg, #0e0905 0%, #1a110a 25%, #160f07 100%);
    color: #b8a584;
    font-family: 'Crimson Pro', 'EB Garamond', Georgia, serif;
    padding: 2.5rem 1.75rem 6rem;
    min-height: 100vh;
  }

  /* ─── Teaser banner (today comparison) ─── */
  .today-banner {
    display: block;
    text-decoration: none;
    color: inherit;
    margin: 0 auto 4rem;
    max-width: 960px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    background:
      linear-gradient(
        90deg,
        rgba(107, 68, 35, 0.22) 0%,
        rgba(107, 68, 35, 0.18) 48%,
        rgba(70, 100, 145, 0.18) 52%,
        rgba(70, 100, 145, 0.22) 100%
      );
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .today-banner:hover {
    border-color: rgba(212, 161, 74, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .today-banner-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.6rem 2rem;
  }

  .today-banner-side {
    display: flex;
    flex-direction: column;
  }

  .today-banner-side.roman { align-items: flex-start; }
  .today-banner-side.yahs  { align-items: flex-end; }

  .today-banner-label {
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.65;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .today-banner-side.roman .today-banner-label { color: #D4924A; }
  .today-banner-side.yahs  .today-banner-label { color: #9BB5DA; }

  .today-banner-value {
    font-family: 'Cinzel', serif;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.015em;
  }

  .today-banner-side.roman .today-banner-value { color: #D4924A; }
  .today-banner-side.yahs  .today-banner-value { color: #9BB5DA; }

  /* Only ever "New Moon" or "Sabbath". Hidden outright on the other days, so
     the banner never carries an empty line. */
  .today-banner-daylabel {
    margin-top: 0.3rem;
    font-family: 'Cinzel', serif;
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #D4A14A;
  }

  /* Static for the whole year, so it is rendered at build time. */
  .today-banner-aviv {
    margin-top: 0.35rem;
    font-size: 0.72rem;
    font-style: italic;
    color: #8a7a5e;
  }

  /* The countdown sits between the banner and the hero: the banner says what
     day it is, this says what is coming, and the hero opens the section. */
  .cal-moed {
    max-width: 46rem;
    margin: 0 auto 4rem;
  }

  .today-banner-cta {
    text-align: center;
    padding: 0 0.75rem;
  }

  .today-banner-cta-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(244, 236, 219, 0.6);
    margin-bottom: 0.4rem;
    font-weight: 600;
  }

  .today-banner-cta-line {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    font-size: 1rem;
    color: #F4ECDB;
    line-height: 1.4;
    margin-bottom: 0.45rem;
  }

  .today-banner-cta-arrow {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #D4A14A;
    font-weight: 700;
    margin-top: 0.3rem;
  }

  .today-banner:hover .today-banner-cta-arrow { color: #F4ECDB; }

  @media (max-width: 720px) {
    .today-banner-inner {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 1.4rem 1.4rem;
      text-align: center;
    }
    .today-banner-side.roman,
    .today-banner-side.yahs {
      align-items: center;
    }
  }

  /* ─── Hero ─── */
  .cal-hero {
    max-width: 760px;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .cal-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.78rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #8a7855;
    font-weight: 500;
    margin: 0;
  }

  .cal-eyebrow.with-rules::before,
  .cal-eyebrow.with-rules::after {
    content: "—";
    margin: 0 0.7em;
    color: #6a5840;
  }

  .cal-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 600;
    color: #f0e0bf;
    letter-spacing: 0.025em;
    line-height: 1.12;
    margin: 1.4rem 0 1.4rem;
    text-transform: uppercase;
  }

  .cal-subtitle {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    font-size: 1.12rem;
    color: #b8a584;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ─── Section heads ─── */
  .cal-block { max-width: 1280px; margin: 0 auto; }
  .cal-block + .cal-block { margin-top: 3.5rem; }

  .cal-section-head {
    text-align: center;
    margin-bottom: 3rem;
  }

  .cal-section-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    font-weight: 600;
    color: #f0e0bf;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0.9rem 0 0.85rem;
  }

  .cal-section-subtitle {
    font-family: 'Crimson Pro', Georgia, serif;
    font-style: italic;
    color: #b8a584;
    max-width: 580px;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.65;
  }

  /* ─── Luminary cards (3-up) ─── */
  .luminary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6rem;
  }

  .luminary-card {
    position: relative;
    background: #1a110a;
    border: 1px solid rgba(180, 140, 80, 0.18);
    border-radius: 4px;
    padding: 2.25rem 1.85rem 1.7rem;
    transition: background 0.25s, border-color 0.25s, transform 0.2s;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .luminary-card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
  }

  .lum-sun::before   { background: #d4a04a; }
  .lum-moon::before  { background: #8aa4c4; }
  .lum-stars::before { background: #9678b8; }

  .luminary-card:hover {
    background: #221710;
    border-color: rgba(200, 160, 100, 0.34);
    transform: translateY(-2px);
  }

  .card-label {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: #8a7855;
    margin: 0 0 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .luminary-card h3 {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #f0e0bf;
    letter-spacing: 0.02em;
    margin: 0 0 1rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .luminary-card > p {
    font-family: 'Crimson Pro', Georgia, serif;
    color: #b8a584;
    line-height: 1.65;
    margin: 0 0 1.7rem;
    font-size: 1rem;
    flex: 1;
  }

  .read-link {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    color: #c9a961;
    font-weight: 600;
    text-transform: uppercase;
    transition: color 0.2s;
  }

  .luminary-card:hover .read-link { color: #f0e0bf; }

  /* ─── Decorative divider ─── */
  .cal-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 5rem auto 4rem;
    color: #a88b4f;
    max-width: 520px;
  }

  .cal-divider::before,
  .cal-divider::after {
    content: "";
    height: 1px;
    flex: 1;
    background: linear-gradient(to right, transparent, rgba(200, 160, 100, 0.34), transparent);
  }

  .cal-divider .glyph {
    margin: 0 1.4rem;
    font-size: 0.85rem;
    letter-spacing: 0.5em;
  }

  /* ─── Category cards (4×2 grid for 8 main sections) ─── */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.15rem;
  }

  .cat-card {
    position: relative;
    background: #1a110a;
    border: 1px solid rgba(180, 140, 80, 0.18);
    border-radius: 4px;
    padding: 1.7rem 1.5rem 1.4rem;
    transition: background 0.25s, border-color 0.25s, transform 0.2s, opacity 0.25s;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    min-height: 240px;
  }

  .cat-card:hover {
    background: #221710;
    border-color: rgba(200, 160, 100, 0.34);
    transform: translateY(-2px);
  }

  .cat-card-pending { opacity: 0.62; }
  .cat-card-pending:hover { opacity: 0.85; }

  .roman {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    color: #a88b4f;
    letter-spacing: 0.18em;
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .cat-card h3 {
    font-family: 'Cinzel', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f0e0bf;
    letter-spacing: 0.025em;
    margin: 0 0 0.75rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .cat-card > p {
    font-family: 'Crimson Pro', Georgia, serif;
    color: #b8a584;
    line-height: 1.55;
    font-size: 0.93rem;
    flex: 1;
    margin: 0 0 1.15rem;
  }

  .study-count {
    font-family: 'Cinzel', serif;
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    color: #a88b4f;
    font-weight: 600;
    text-transform: uppercase;
  }

  /* ─── Closing-studies row (Before You Go) ─── */
  .cal-closing-block {
    max-width: 1100px;
    margin: 4rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid rgba(180, 140, 80, 0.16);
  }

  .cal-closing-head {
    text-align: center;
    margin-bottom: 2rem;
  }

  .cal-closing-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #8a7855;
    font-weight: 500;
    margin: 0;
  }

  .cal-closing-eyebrow::before,
  .cal-closing-eyebrow::after {
    content: "—";
    margin: 0 0.7em;
    color: #6a5840;
  }

  .closing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .closing-card {
    background: rgba(26, 17, 10, 0.6);
    border: 1px solid rgba(180, 140, 80, 0.12);
    border-radius: 4px;
    padding: 1.4rem 1.3rem 1.2rem;
    text-decoration: none;
