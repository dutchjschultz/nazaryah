---
// src/pages/five-offerings.astro · 1012 V3
// V3 (Five Offerings Etsy Block 1012 V3): the full page, every word from
// src/data/offerings.js — `page` (title, subtitle, intro, close) and the five
// `offerings`. Order: title + italic subtitle → intro → jump row (one pill per
// card: the Hebrew word, muted, then the short name, linking to #id) → the five
// cards in ONE column (drop-downs make two columns uneven) → the close.
// The data file holds words only, so the build checks live here: five
// drop-downs with the five standard headings in order, a believer note in each,
// and one of the two statuses.
// V2: intro paragraph three rewritten. V1: page + first card.
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferingCard from '../components/OfferingCard.astro';
import { page, offerings } from '../data/offerings.js';
import { withRefs } from '../lib/offerings-text.js';

const HEADINGS = ['Voluntary or Required', 'What Was Offered', 'What Was Added', 'Where the Blood Went', 'Who Ate It'];
const STATUSES = ['Still standing', 'At rest · finished once'];
for (const o of offerings) {
  if (!STATUSES.includes(o.status)) throw new Error(`offerings.js: ${o.id} status "${o.status}" must be ${STATUSES.join(' or ')}`);
  if (o.drops.map((d) => d.heading).join('|') !== HEADINGS.join('|')) throw new Error(`offerings.js: ${o.id} drop-downs must be, in order: ${HEADINGS.join(', ')}`);
  if (o.drops.some((d) => !d.believer)) throw new Error(`offerings.js: ${o.id} every drop-down needs its believer note`);
}
const shortName = (title: string) => title.replace(/^The\s+/, '');
---

<BaseLayout
  title={`${page.title} | Nazaryah`}
  description="The five offerings of Leviticus 1–7 — burnt, meal, peace, sin, and trespass — what each one held, what each pictured of the Messiah, and why three are carried forward and two are at rest, finished once, but none of them abolished."
>
  <div class="fo-page">
    <header class="fo-header">
      <h1 class="fo-title">{page.title}</h1>
      <p class="fo-sub">{page.subtitle}</p>
    </header>

    <section class="fo-col fo-intro">
      {page.intro.map((p) => <p set:html={withRefs(p)} />)}
    </section>

    <nav class="fo-jump" aria-label="The five offerings">
      {offerings.map((o) => (
        <a class="fo-pill" href={`#${o.id}`}>
          <span class="fo-pill-he" lang="he" dir="rtl">{o.hebrew.word}</span>
          <span class="fo-pill-name">{shortName(o.title)}</span>
        </a>
      ))}
    </nav>

    <div class="fo-cards">
      {offerings.map((o) => <OfferingCard o={o} />)}
    </div>

    <section class="fo-col fo-close">
      <h2 class="fo-close-h">{page.closeTitle}</h2>
      <p set:html={withRefs(page.close)} />
    </section>
  </div>
</BaseLayout>

<style>
  .fo-page { background: #0e0d0b; min-height: 100vh; padding: 3.5rem 2rem 5rem; color: #cfc7b6; }
  .fo-header { text-align: center; max-width: 46rem; margin: 0 auto 2.2rem; }
  .fo-title {
    font-family: var(--font-display); font-size: clamp(1.9rem, 1.3rem + 2.6vw, 2.9rem);
    font-weight: 700; color: #e8e2d4; margin: 0 0 0.8rem; line-height: 1.12;
  }
  .fo-sub { font-family: var(--font-family-serif); font-style: italic; font-size: 1.2rem; color: #a89f8c; margin: 0; line-height: 1.5; }

  .fo-col { max-width: 44rem; margin: 0 auto; }
  .fo-col p { font-family: var(--font-body); font-size: 1.08rem; line-height: 1.8; color: #cfc7b6; margin: 0 0 1.15rem; }
  .fo-col :global(i) { font-family: var(--font-family-serif); font-style: italic; }
  .fo-col :global(.cite) { color: #8f8775; }
  .fo-intro { margin-bottom: 1.8rem; }

  /* Jump row: one pill per card; wraps on a phone. */
  .fo-jump {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.55rem;
    max-width: 46rem; margin: 0 auto 2.4rem;
  }
  .fo-pill {
    display: inline-flex; align-items: baseline; gap: 0.45rem; padding: 0.4rem 0.85rem; border-radius: 999px;
    border: 1px solid rgba(212,165,49,0.4); background: rgba(186,117,23,0.08); text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .fo-pill:hover, .fo-pill:focus-visible { background: rgba(186,117,23,0.22); border-color: #d8b06a; outline: none; }
  .fo-pill-he { font-size: 1.05rem; color: #8f8775; line-height: 1; }
  .fo-pill-name {
    font-family: var(--font-display); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: #e8c98a;
  }

  /* The five cards, one column. */
  .fo-cards { display: grid; gap: 1.6rem; max-width: 46rem; margin: 0 auto; }

  .fo-close { margin-top: 3.2rem; padding-top: 1.6rem; border-top: 1px solid rgba(186,117,23,0.35); }
  .fo-close-h { font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; color: #e8e2d4; margin: 0 0 1rem; }

  @media (max-width: 760px) {
    .fo-page { padding: 2.6rem 1rem 4rem; }
  }
</style>
