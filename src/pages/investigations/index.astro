---
// src/pages/investigations/index.astro · 1013 V6
// V6 (Dutch 1013): restyled to the Pathway look — dark ground, thin gold rule
// down the left edge, left-aligned hero. Title Investigations (standard page
// title); the subtitle is a two-tone headline in Pathway's type ("One lie.
// Many witnesses."); the intro in Pathway's body style; a closing gold italic
// line. Cards go dark: gold top rule, gold INVESTIGATION kicker, parchment
// title, gold italic deck, the teaching on trial under a hairline, and a foot
// row (N WITNESSES · Open the File →; a coming-soon case at 60% reads
// IN PREPARATION · live OF pieces). The case pages themselves are unchanged.
// V5: the section name is the title; the clever line is the subtitle beneath it (Dutch, Page titles 1013).
// Title Investigations, set larger; subtitle One Lie, Many Witnesses; the ― INVESTIGATIONS ― kicker is gone.
// V4: the page now says what each case is AGAINST. H1 "One Question, Many
// Witnesses" -> "One Lie, Many Witnesses"; the intro names false teachings
// rather than errors; every card carries a "teaching on trial" line (the new
// `teaching` field in investigations.js) above its question, in the shape of
// the study pages' claim block. The H1 change reminted the page's social card.
// V3: the intro under the H1 is rewritten in plain words — the old line
// ("a nucleus that argues the method…") read as jargon to anyone who has not
// built one of these. The H1, the hidden card deck and the meta description
// are untouched.
// V2: the page no longer assumes every case has four witnesses. The heading, the
// intro and the meta description all said four, and the card link said "Enter the
// orbit" — every one of them written when the ring was the only shape. The link
// words now come from the record (enterLabel), so a card names the shape it
// opens; The Living Temple's card is unchanged, because its record carries the
// same words the page used to hard-code. The heading change forced the page's own
// social card to be reminted, which exposed a second fault: it had no card deck
// and was falling back to the meta description, clipping mid-sentence. It carries
// a proper one now (.inv-card-deck, hidden). Nothing visible else moves.
// V1:
// The investigations landing — one card per entry in src/data/investigations.js.
// A live case links to its orbit page; a `soon: true` case is dimmed, carries a
// Coming Soon pill and is not a link, because its page is not built.
//
// An investigation is not an association. An association is a subject tag —
// automatic, unordered, membership grows by tagging. An investigation is a
// curated case: one question, one nucleus, three or four witnesses, and an end.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INVESTIGATIONS, liveCount } from '../../data/investigations.js';

const cards = INVESTIGATIONS.map((inv) => ({
  ...inv,
  pieces: 1 + inv.witnesses.length,
  live: liveCount(inv),
}));
---

<BaseLayout
  title="Investigations — One Lie, Many Witnesses | Nazaryah"
  description="Curated cases, not subject tags. Each investigation asks one question, argues its method in a nucleus study, and closes the case with several witnesses from different directions."
>
  <div class="inv-page">
    <div class="inv-rule" aria-hidden="true"></div>
    <main class="hub">
      <header class="inv-hero">
        <h1 class="inv-title">Investigations</h1>
        <p class="inv-headline">
          One <em>lie.</em> Many <em>witnesses.</em>
        </p>
        {/* The short CARD deck, read by the social-card generator. Not visible: the
            page's own intro is below, and the meta description is a third field
            again. The card must never fall back to the description, which is long
            enough to clip mid-sentence. */}
        <p class="inv-card-deck">A case, not a category. Read one, or read the case.</p>
        <p class="inv-intro">
          Some false teachings are too large to answer in a single study. They run through
          dozens of sermons, hold up whole systems, and get repeated until nobody checks
          them. An investigation takes one of them by name, puts it on trial, and answers it
          from several directions at once. One study sets out the case. Each of the others
          closes one part of it and stands on its own. Start anywhere.
        </p>
        <p class="inv-close">
          Each investigation puts one teaching on trial and calls the witnesses one at a time.
        </p>
      </header>

      <div class="grid">
        {cards.map((inv) => {
          const Tag = inv.soon ? 'div' : 'a';
          const n = inv.witnesses.length;
          return (
            <Tag
              class:list={['inv-card', { soon: inv.soon }]}
              href={inv.soon ? undefined : `/investigations/${inv.slug}`}
            >
              <p class="kicker">Investigation</p>
              <h2>{inv.title}</h2>
              <p class="deck">{inv.deck}</p>
              {inv.teaching && (
                <div class="trial">
                  <p class="trial-label">The teaching on trial</p>
                  <p class="trial-text">{inv.teaching}</p>
                </div>
              )}
              <p class="question">{inv.question}</p>
              <p class="foot">
                {inv.soon ? (
                  <span>In preparation · {inv.live} of {inv.pieces}</span>
                ) : (
                  <>
                    <span>{n} {n === 1 ? 'witness' : 'witnesses'}</span>
                    <span class="go">Open the File →</span>
                  </>
                )}
              </p>
            </Tag>
          );
        })}
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap');

  /* Pathway's ground, colours and type (PathwayLanding.jsx), adapted. */
  .inv-page {
    position: relative;
    min-height: 100vh;
    background-color: #0d140f;
    background-image:
      radial-gradient(ellipse at top left, rgba(212, 168, 106, 0.08) 0%, transparent 55%),
      radial-gradient(ellipse at bottom right, rgba(109, 135, 113, 0.06) 0%, transparent 60%);
    color: #ede4cf;
    font-family: "Spectral", Georgia, serif;
  }
  /* The thin gold rule down the left edge. */
  .inv-rule {
    position: absolute; top: 0; bottom: 0; left: 2rem; width: 1px; pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(212, 168, 106, 0.18) 6%, rgba(212, 168, 106, 0.5) 40%, rgba(212, 168, 106, 0.18) 94%, transparent 100%);
    box-shadow: 0 0 14px rgba(212, 168, 106, 0.35);
  }
  .hub { max-width: 64rem; margin: 0 auto; padding: 3.5rem 3rem 5rem; }
  @media (min-width: 768px) { .hub { padding: 4.5rem 5rem 5.5rem; } }

  .inv-hero { max-width: 44rem; margin: 0 0 4rem; text-align: left; }
  .inv-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 1.3rem + 2.6vw, 2.8rem);
    line-height: 1.14;
    color: #e8e2d4;
    margin: 0 0 1.5rem;
  }
  .inv-headline {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 300;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 18ch;
    color: #6f6c64;
    margin: 0 0 1.5rem;
  }
  .inv-headline em { font-style: italic; font-weight: 400; color: #d4a86a; }
  /* Visually hidden; it exists for the card generator, not the reader. */
  .inv-card-deck {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .inv-intro { font-size: 1.1rem; line-height: 1.7; color: #ede4cf; opacity: 0.85; max-width: 38rem; margin: 0 0 1.5rem; }
  .inv-close {
    font-family: "Fraunces", Georgia, serif; font-style: italic; font-weight: 300;
    font-size: 1.15rem; line-height: 1.65; color: #d4a86a; max-width: 40rem; margin: 0;
  }

  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.3rem; }
  .inv-card {
    display: flex; flex-direction: column;
    text-decoration: none; color: inherit;
    background: rgba(237, 228, 207, 0.025);
    border: 1px solid rgba(212, 168, 106, 0.16);
    border-top: 2px solid rgba(212, 168, 106, 0.45);
    border-radius: 6px;
    padding: 1.6rem 1.5rem 1.3rem;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  a.inv-card:hover, a.inv-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(212, 168, 106, 0.4);
    border-top-color: #e6bf7f;
    box-shadow: 0 8px 30px rgba(212, 168, 106, 0.08);
    outline: none;
  }
  .inv-card.soon { opacity: 0.6; cursor: default; }
  .kicker {
    font-family: var(--font-display); font-size: 0.68rem; font-weight: 600;
    letter-spacing: 0.24em; text-transform: uppercase; color: #d4a86a; margin: 0 0 0.6rem;
  }
  .inv-card h2 {
    font-family: var(--font-display); font-weight: 600; font-size: 1.3rem; line-height: 1.25;
    color: #ede4cf; margin: 0 0 0.4rem;
  }
  .deck { font-style: italic; font-size: 1rem; line-height: 1.45; color: #d4a86a; margin: 0 0 1rem; }
  .trial { border-top: 1px solid rgba(212, 168, 106, 0.2); padding-top: 0.85rem; margin: 0 0 0.9rem; }
  .trial-label {
    font-family: var(--font-display); font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(237, 228, 207, 0.5); margin: 0 0 0.35rem;
  }
  /* the body serif: Cinzel is capitals-only and has no italic */
  .trial-text { font-style: italic; font-size: 1.02rem; line-height: 1.5; color: #f0e0bf; margin: 0; }
  .question { font-size: 0.92rem; line-height: 1.5; color: rgba(237, 228, 207, 0.55); margin: 0 0 1.2rem; }
  .foot {
    margin: auto 0 0; padding-top: 0.9rem; border-top: 1px solid rgba(212, 168, 106, 0.12);
    display: flex; justify-content: space-between; gap: 0.6rem; flex-wrap: wrap;
    font-family: var(--font-display); font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(237, 228, 207, 0.5);
  }
  .foot .go { color: #d4a86a; }
</style>
