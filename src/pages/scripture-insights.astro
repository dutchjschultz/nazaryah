---
// src/pages/scripture-insights.astro · 0805 V1
// Standing page at /scripture-insights. Short truths — NOT studies: no titles, no
// deck lines, no reference eyebrow, no association tags, no companion strip, no
// category chips. One card per insight, single column, comfortable reading width.
//
// DATA: public/data/scripture-insights.json (read at build time). That file
// versions with FIELDS ("version" / "changeNote"), since JSON carries no line-1
// comment; the climb rule matches associations.js and never resets at a new day.
//
// FIELD RULES (the JSON shape) ------------------------------------------------
//   id         — SI-###, sequential, never reused even if an entry is removed
//   key        — lowercase hyphen slug; duplicate detection across chats
//   text       — the insight itself; renders as the card body
//   blip       — optional supporting line; smaller + lighter, beneath the text.
//                Rendered ONLY when non-empty — no empty element ships.
//   refs       — array of verse references; small muted line at the card foot,
//                joined with " · "
//   status     — "open" | "approved" | "posted". ONLY "posted" renders here.
//   postedDate — ISO date, set when status flips to posted; drives the sort
// -----------------------------------------------------------------------------
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

// Read at build time from the project root (cwd) — the compiled module lives under
// .netlify/, so an import.meta.url-relative path would miss the source file.
const raw = fs.readFileSync(path.join(process.cwd(), 'public/data/scripture-insights.json'), 'utf-8');
const { insights } = JSON.parse(raw);

// Only "posted" entries render; newest first by postedDate (ISO strings sort
// correctly under a plain string compare).
const posted = insights
  .filter((i) => i.status === 'posted')
  .sort((a, b) => String(b.postedDate).localeCompare(String(a.postedDate)));
---

<BaseLayout
  title="Scripture Insights — Nazaryah"
  description="Short truths worth keeping close to the hip — one line of Scripture, seen plainly."
>
  <section class="si-page">
    <header class="si-header">
      <h1 class="si-title">Scripture Insights</h1>
      <div class="si-rule" aria-hidden="true">
        <span class="rule-line"></span>
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1" y="1" width="12" height="12" stroke="#BA7517" stroke-width="1" fill="none" transform="rotate(45 7 7)"/>
        </svg>
        <span class="rule-line"></span>
      </div>
      <p class="si-subhead">Short truths worth keeping close to the hip.</p>
    </header>

    <div class="si-list">
      {posted.map((i) => (
        <article class="si-card" data-id={i.id}>
          <p class="si-text">{i.text}</p>
          {i.blip && i.blip.trim() && <p class="si-blip">{i.blip}</p>}
          {i.refs && i.refs.length > 0 && <p class="si-refs">{i.refs.join(' · ')}</p>}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .si-page { background: #0e0d0b; min-height: 100vh; padding: clamp(3rem, 6vw, 4.5rem) 1.5rem 5rem; }

  .si-header { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
  .si-title {
    font-family: var(--font-display); font-size: clamp(1.8rem, 1.4rem + 2.2vw, 2.6rem); font-weight: 700;
    color: #f0e0bf; margin: 0 0 0.75rem; letter-spacing: 0.02em;
  }
  .si-rule { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 0.7rem; }
  .rule-line { display: block; height: 1px; width: 80px; background: #BA7517; opacity: 0.4; }
  .si-subhead { font-family: var(--font-body); font-size: 1.1rem; font-style: italic; color: #a89f8c; margin: 0; }

  .si-list { max-width: 44rem; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; }

  .si-card {
    background: #161512; border: 0.5px solid rgba(255,255,255,0.07); border-left: 3px solid #BA7517;
    border-radius: 10px; padding: 1.9rem 2rem;
  }
  .si-text {
    font-family: var(--font-body); font-size: 1.14rem; line-height: 1.85; font-weight: 400;
    color: #cfc7b6; margin: 0;
  }
  /* Optional supporting line — smaller + lighter, beneath the text. */
  .si-blip {
    font-family: var(--font-body); font-size: 0.98rem; line-height: 1.7; color: #8f8672;
    margin: 1rem 0 0;
  }
  /* Refs — smallest, muted, joined with " · " at the card foot. */
  .si-refs {
    font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.1em;
    color: #97854f; margin: 1.15rem 0 0; padding-top: 0.9rem;
    border-top: 0.5px solid rgba(186,117,23,0.22);
  }

  @media (max-width: 520px) {
    .si-card { padding: 1.5rem 1.4rem; }
    .si-text { font-size: 1.08rem; }
  }
</style>
