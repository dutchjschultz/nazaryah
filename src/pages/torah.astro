---
import BaseLayout from '../layouts/BaseLayout.astro';
import { liveTerms, terms } from '../data/legal-lexicon.js';

const lexiconMeta = `${liveTerms.length} of ${terms.length} words live · growing`;
---

<BaseLayout
  title="Torah - Nazaryah"
  description="The covenant law, read on its own terms — the standard the whole courtroom runs on, beginning with the Legal Lexicon of Scripture."
>
  <div class="to-wrap">

    <section class="to-hero">
      <p class="to-label">&#8213; The Covenant on Trial &#8213;</p>
      <h1 class="to-title">Torah</h1>
      <p class="to-sub">The covenant law, read on its own terms — the standard the whole courtroom runs on.</p>
    </section>

    <section class="to-section">
      <div class="to-prose">
        <h2 class="to-h2">The Bible Is a Law Book</h2>
        <p>Scripture is not a devotional book with a few legal words in it. It is a legal book, and the warmth readers feel is the warmth of a covenant kept.</p>
        <p>Judge, witness, covenant, ransom, verdict — the vocabulary is a courtroom's, and even the softest, most familiar words turn out to be doing legal work. Read that way, the whole Bible opens as a single trial: a court, a code, a people named on the docket, an acquittal, a walk under testing, a record, and a verdict.</p>
        <p>This section reads the covenant law on its own terms — and shows that the gospel itself is written in the book's own language.</p>
      </div>
    </section>

    <section class="to-section to-section-alt">
      <div class="to-cards">
        <a href="/torah/legal-lexicon" class="to-card">
          <p class="to-card-meta">{lexiconMeta}</p>
          <h3 class="to-card-title">The Legal Lexicon of Scripture</h3>
          <p class="to-card-deck">The whole Bible is a courtroom. These are its words.</p>
          <p class="to-card-body">Seven movements from the bench to the final verdict — every covenant term read as the courtroom word it is.</p>
          <span class="to-card-cta">Enter &nbsp;&#8594;</span>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* Torah section — matches the Trinity page theme (fixed dark, cream serif, gold accents). */
  .to-wrap{
    background:linear-gradient(180deg,#0e0904 0%,#1a1208 20%,#160f07 100%);
    color:#d9c9a8;
    font-family:'Crimson Pro','Crimson Text',Georgia,serif;
    min-height:80vh;
  }

  .to-hero{
    text-align:center;padding:5rem 1.5rem 3.5rem;border-bottom:1px solid #4a3218;
    background:radial-gradient(ellipse at 50% 0%,rgba(150,90,40,.18),transparent 70%),linear-gradient(180deg,#0a0602 0%,#1a1208 100%);
  }
  .to-label{font-family:'Cinzel',serif;font-size:10px;letter-spacing:4px;color:#8a6028;text-transform:uppercase;margin-bottom:.75rem;}
  .to-title{font-family:'Cinzel',serif;font-size:clamp(2.5rem,6vw,4rem);font-weight:700;color:#f0e0bf;margin:0 0 1rem;line-height:1.1;}
  .to-sub{font-size:clamp(1rem,2vw,1.2rem);color:#c4a46b;font-style:italic;max-width:600px;margin:0 auto;line-height:1.6;}

  .to-section{padding:3.5rem 1.5rem;border-bottom:1px solid #2e1f0d;}
  .to-section-alt{background:rgba(10,6,2,.3);}
  .to-prose{max-width:680px;margin:0 auto;font-size:1.125rem;line-height:1.85;color:#d9c9a8;}
  .to-prose p{margin:0 0 1.5rem;} .to-prose p:last-child{margin:0;}
  .to-h2{font-family:'Cinzel',serif;font-size:clamp(1.2rem,2.5vw,1.6rem);font-weight:600;color:#f0e0bf;margin:0 0 1.25rem;padding-bottom:.6rem;border-bottom:1px solid #3a2510;}

  .to-cards{max-width:680px;margin:0 auto;}
  .to-card{display:block;text-decoration:none;background:rgba(20,13,5,.6);border:1px solid #3a2510;border-radius:4px;padding:2rem 2.25rem;transition:all .2s ease;}
  .to-card:hover{border-color:#8a6028;background:rgba(30,20,8,.7);transform:translateY(-2px);}
  .to-card-meta{font-family:'Cinzel',serif;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#8a6028;margin:0 0 .75rem;}
  .to-card-title{font-family:'Cinzel',serif;font-size:1.5rem;color:#f0e0bf;margin:0 0 .5rem;}
  .to-card-deck{color:#c4a46b;font-style:italic;margin:0 0 .75rem;}
  .to-card-body{color:#d9c9a8;font-size:1rem;line-height:1.7;margin:0 0 1.25rem;}
  .to-card-cta{font-family:'Cinzel',serif;font-size:.8rem;letter-spacing:2px;text-transform:uppercase;color:#c4a46b;}
  .to-card:hover .to-card-cta{color:#f0e0bf;}

  @media (max-width:620px){
    .to-hero{padding:3.5rem 1rem 2.5rem;}
    .to-section{padding:2.5rem 1rem;}
    .to-card{padding:1.5rem;}
  }
</style>
