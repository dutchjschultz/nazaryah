---
// src/pages/peah/index.astro · 1002 V5
// V5: each drop-down book carries its coverage in parentheses — "Jude (32%)",
// "(<1%)", or "(complete)" for a book in peah-finished-books.js — from
// bookCoverage() in src/lib/peah.js (main `reference` verses only, over the KJV
// count). The book heading on the page stays the name alone.
// V4: ONE BOOK AT A TIME. The page never lists every entry: it opens on the
// earliest book in canonical order that holds an entry (Genesis once one
// exists), and shows only that book's entries until another is picked. The
// drop-down has no "All books". Chips narrow the chosen book only; a chip with
// nothing in that book is greyed out (disabled), never hidden, so the row holds
// still between books. A bare /peah opens the default book; ?book=&subject=
// still makes a view shareable. All books stay in the HTML (search engines);
// non-default books carry `hidden` until picked, and a no-script reader sees
// them all.
// V3: the index is in Bible order. Entries sit under a heading per book,
// Genesis to Revelation (src/data/bible-books.js), then by chapter and verse,
// read from `reference` alone (src/lib/peah.js — an unknown book or an
// unparseable reference fails the build and names the file). A Book drop-down
// (only books holding an entry, canonical order) and the subject chips (from the
// entries' `group` values, in PEAH_SUBJECTS order) filter together, and the
// choice is kept in the address: /peah?book=romans&subject=law. With no script,
// everything shows. Cards carry the composed title `reference — title`.
// V2: Pe'ah entries carry no topic group now, so the chip row does not render.
// Pe'ah is not a Studies card or collection; the Studies dropdown is its only
// entry point, and it stays out of /blog/all and the association clusters
// (separate collection, never read by inFeed or study-pool.js).
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { parsePeahRef, bookCoverage, PEAH_SUBJECTS, slugify } from '../../lib/peah.js';

const entries = (await getCollection('peah', ({ data }) => data.draft !== true))
  .map((e) => ({ e, ref: parsePeahRef(e) }))
  .sort((a, b) =>
    a.ref.bookIndex - b.ref.bookIndex ||
    a.ref.chapter - b.ref.chapter ||
    a.ref.verse - b.ref.verse ||
    a.e.data.title.localeCompare(b.e.data.title));

// One section per book that holds at least one entry, in canonical order.
const books = [];
for (const x of entries) {
  const last = books[books.length - 1];
  if (last && last.slug === x.ref.bookSlug) last.items.push(x.e);
  else books.push({ slug: x.ref.bookSlug, name: x.ref.heading, items: [x.e] });
}

// Coverage figure per book, for the drop-down.
const coverage = bookCoverage(entries.map((x) => x.e));

// Chips: subjects in use, in PEAH_SUBJECTS order. Never hand-maintained.
const used = new Set(entries.map((x) => x.e.data.group).filter(Boolean));
const chips = PEAH_SUBJECTS.filter((s) => used.has(s)).map((s) => ({ name: s, slug: slugify(s) }));
---

<BaseLayout
  title="Pe'ah — The Corner of the Field | Nazaryah"
  description="Short reads gathered from the edges of the field — “Thou shalt leave them for the poor and stranger” (Leviticus 19:10)."
>
  <section class="peah-head">
    <a href="/blog" class="peah-back">&larr; Studies</a>
    <h1 class="peah-title">Pe'ah</h1>
    <p class="peah-sub">The Corner of the Field</p>
    <p class="peah-intro">
      Short reads gathered from the edges of the field — “Thou shalt leave them for the poor
      and stranger” (Leviticus 19:10).
    </p>
    <p class="peah-count">{entries.length} {entries.length === 1 ? 'read' : 'reads'}</p>
  </section>

  <div class="peah-wrap">
    <div class="peah-controls">
      <label class="peah-book-pick">
        <span class="peah-book-label">Book</span>
        <select id="peah-book">
          {books.map((b) => <option value={b.slug}>{b.name}{coverage.has(b.name) ? ` (${coverage.get(b.name).label})` : ''}</option>)}
        </select>
      </label>
      {chips.length > 0 && (
        <div class="peah-chips" role="group" aria-label="Filter by subject">
          <button type="button" class="peah-chip is-on" data-chip="">All</button>
          {chips.map((c) => (
            <button type="button" class="peah-chip" data-chip={c.slug}>{c.name}</button>
          ))}
        </div>
      )}
    </div>

    <div id="peah-list">
      {books.map((b, i) => (
        <section class="peah-bookgroup" data-book={b.slug} hidden={i > 0}>
          <h2 class="peah-book-name">{b.name}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-5">
            {b.items.map((e) => (
              <div class="peah-cell" data-subject={e.data.group ? slugify(e.data.group) : ''}>
                <BlogCard post={e} />
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    <p class="peah-empty" id="peah-empty" hidden>No entry yet on that passage.</p>
    <noscript><style>.peah-bookgroup[hidden]{display:block !important}</style></noscript>
  </div>
</BaseLayout>

<style>
  /* Header mirrors .blog-subhead on the Studies archive. */
  .peah-head { font-family: Georgia, 'Times New Roman', serif; background: #cfc0a0; padding: 2.25rem 2rem 1.75rem; text-align: center; }
  .peah-back { display: inline-block; font-family: 'Cinzel', Georgia, serif; font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: #6b3010; text-decoration: none; margin-bottom: 0.9rem; }
  .peah-back:hover { color: #3a1a04; }
  .peah-title { font-size: 2.3rem; font-weight: 900; color: #1e1208; font-variant: small-caps; letter-spacing: 0.03em; margin: 0; }
  .peah-sub { font-family: 'Cinzel', Georgia, serif; font-size: 0.8rem; letter-spacing: 0.22em; text-transform: uppercase; color: #6b3010; margin: 0.35rem 0 0.9rem; }
  /* italic -> the body serif, never Cinzel */
  .peah-intro { font-family: var(--font-family-serif); font-size: 1.05rem; font-style: italic; color: #4a3520; max-width: 44rem; margin: 0 auto 0.6rem; line-height: 1.55; }
  .peah-count { font-family: 'Cinzel', Georgia, serif; font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: #7a4f28; margin: 0; }

  .peah-wrap { padding: 2.25rem 1.5rem 3rem; max-width: 84rem; margin: 0 auto; }

  .peah-controls { display: flex; flex-direction: column; gap: 1rem; align-items: center; margin-bottom: 2.2rem; }
  .peah-book-pick { display: inline-flex; align-items: center; gap: 0.6rem; }
  .peah-book-label { font-family: 'Cinzel', Georgia, serif; font-size: 0.64rem; letter-spacing: 0.16em; text-transform: uppercase; color: #6b3010; }
  #peah-book {
    font-family: var(--font-family-serif); font-size: 1rem; color: #2b1d11;
    padding: 0.35rem 2rem 0.35rem 0.75rem; border: 1px solid #c4a97d; border-radius: 4px; background-color: #fbf5e6;
    max-width: 100%;
  }
  :global(.dark) .peah-book-label { color: #c4a46b; }
  :global(.dark) #peah-book { background-color: #130e06; color: #e8d9b8; border-color: #3a2510; }

  .peah-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .peah-chip {
    font-family: 'Cinzel', Georgia, serif; font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 0.4rem 0.85rem; border-radius: 999px; cursor: pointer;
    border: 1px solid #c4a97d; background: #fbf5e6; color: #2b1d11;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .peah-chip:hover { border-color: #a07850; }
  .peah-chip.is-on { background: #4a2808; color: #f5e8d0; border-color: #4a2808; }
  .peah-chip:disabled { opacity: 0.38; cursor: default; }
  .peah-chip:disabled:hover { border-color: #c4a97d; }
  :global(.dark) .peah-chip { border-color: #3a2510; background: #130e06; color: #c4a46b; }
  :global(.dark) .peah-chip:hover { border-color: #ba7517; }
  :global(.dark) .peah-chip.is-on { background: #ba7517; color: #140d04; border-color: #ba7517; }

  .peah-bookgroup + .peah-bookgroup { margin-top: 2.5rem; }
  .peah-book-name {
    font-family: 'Cinzel', Georgia, serif; font-size: 1.05rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: #4a2808; margin: 0 0 1rem; padding-bottom: 0.45rem; border-bottom: 1px solid #c4a97d;
  }
  :global(.dark) .peah-book-name { color: #e8c98a; border-bottom-color: #3a2510; }
  .peah-cell { display: flex; }
  .peah-cell > :global(*) { flex: 1; }

  .peah-empty { text-align: center; font-family: var(--font-family-serif); font-style: italic; font-size: 1.1rem; color: #6b5a45; margin: 2rem 0; }
  :global(.dark) .peah-empty { color: #b8a888; }
</style>

<script>
  // One book at a time. The book is the drop-down's value (default: its first
  // option, the earliest book holding an entry); the subject chip narrows that
  // book only. Chips with nothing in the chosen book are disabled (greyed). The
  // choice is kept in the address (?book=<slug>&subject=<slug>); an unknown value
  // is ignored. A subject the newly chosen book does not hold falls back to All.
  const select = document.getElementById('peah-book') as HTMLSelectElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.peah-chip'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.peah-bookgroup'));
  const empty = document.getElementById('peah-empty');

  const bookOk = (v: string) => groups.some((g) => g.dataset.book === v);
  const subjectsIn = (bk: string) => {
    const g = groups.find((x) => x.dataset.book === bk);
    return new Set(Array.from(g ? g.querySelectorAll<HTMLElement>('.peah-cell') : []).map((c) => c.dataset.subject || ''));
  };

  let book = groups[0]?.dataset.book || '';
  let subject = '';

  function apply(updateUrl: boolean) {
    if (select) select.value = book;
    const has = subjectsIn(book);
    if (subject && !has.has(subject)) subject = '';
    chips.forEach((c) => {
      const v = c.dataset.chip || '';
      c.disabled = !!v && !has.has(v);
      c.classList.toggle('is-on', v === subject);
    });
    let shown = 0;
    groups.forEach((g) => {
      const mine = g.dataset.book === book;
      g.hidden = !mine;
      if (!mine) return;
      g.querySelectorAll<HTMLElement>('.peah-cell').forEach((cell) => {
        const on = !subject || cell.dataset.subject === subject;
        cell.style.display = on ? '' : 'none';
        if (on) shown++;
      });
    });
    if (empty) empty.hidden = shown > 0;
    if (updateUrl) {
      const q = new URLSearchParams();
      q.set('book', book);
      if (subject) q.set('subject', subject);
      history.replaceState(null, '', `${location.pathname}?${q.toString()}${location.hash}`);
    }
  }

  const params = new URLSearchParams(location.search);
  const b = (params.get('book') || '').toLowerCase();
  const s = (params.get('subject') || '').toLowerCase();
  if (bookOk(b)) book = b;
  if (chips.some((c) => (c.dataset.chip || '') === s)) subject = s;
  apply(false);

  select?.addEventListener('change', () => { book = select.value; apply(true); });
  chips.forEach((chip) => {
    chip.addEventListener('click', () => { if (!chip.disabled) { subject = chip.dataset.chip || ''; apply(true); } });
  });
</script>
