---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { words, movements, terms, slugify } from '../../../data/legal-lexicon.js';

export function getStaticPaths() {
  // Only terms with a written word record get a page. As records are added,
  // their pages generate automatically — no markup change.
  return Object.values(words).map((w) => ({
    params: { slug: slugify(w.term) },
    props: { w },
  }));
}

const { w } = Astro.props;
const mv = movements[w.movement - 1];
// A term may carry a "break" aspect (counterfeit-court use) in the master; render
// its "In the Break" callout when present. Recompense has none.
const term = terms.find((t) => t.n === w.n);
const brk = (term && term.break) || w.break || null;
const kick = w.lead.charAt(0);
const leadRest = w.lead.slice(1);

// Cross-links light up only when the sibling/related word page exists.
const liveSiblings = (w.sharesRoot?.siblings || []).filter((s) => words[String(s.n)]);
const liveRelated = (w.relatedInMovement || []).filter((r) => words[String(r.n)]);
---

<BaseLayout
  title={`${w.term} — The Legal Lexicon of Scripture | Nazaryah`}
  description={w.lead.slice(0, 155)}
>
  <div class="ll">
    <div class="wrap">

      <p class="crumb">
        <a href="/torah">Torah</a> &rsaquo; <a href="/torah/legal-lexicon">Legal Lexicon</a> &rsaquo; {w.term}
      </p>

      <article class="page">
        <header class="page-head">
          <span class="eyebrow">The Legal Lexicon of Scripture</span>
          <div class="caseno"><b>Entry No. {w.n}</b>{w.caseStrongs}</div>
          <h1 class="word"><span class="num">{w.n}</span>{w.term}</h1>
          <p class="rootline">{w.rootLine}</p>
        </header>

        <div class="lead"><span class="kick">{kick}</span>{leadRest}</div>

        <div class="body">

          <section class="sec">
            <span class="eyebrow">The Root</span>
            <p set:html={w.root.map((r) => `<strong>${r.lemma}</strong> (${r.strong}) — ${r.sense}`).join('. Paired with ') + '.'} />
          </section>

          {(w.sharesRoot?.note || liveSiblings.length > 0) && (
            <section class="sec">
              <span class="eyebrow">Shares a Root With</span>
              {liveSiblings.length > 0 && (
                <div class="roots">
                  <span class="lbl">{w.root[0].lemma} ({w.root[0].strong}) &mdash;</span>
                  {liveSiblings.map((s) => (
                    <a class="rootchip" href={`/torah/legal-lexicon/${slugify(s.term)}`}><b>{s.n}.</b> {s.term}</a>
                  ))}
                </div>
              )}
              {w.sharesRoot?.note && <p class="rootnote">{w.sharesRoot.note}</p>}
            </section>
          )}

          <section class="sec">
            <span class="eyebrow">The Courtroom Word</span>
            <p>{w.courtroomWord}</p>
          </section>

          <section class="sec">
            <span class="eyebrow">Its Role in the Court</span>
            <p>{w.itsRole}</p>
          </section>

          <section class="sec">
            <span class="eyebrow">Proof Texts</span>
            <div class="evidence">
              {w.proofTexts.map((pt) => (
                <p class="verse">
                  <span class="vref">{pt.ref}</span>
                  <span class="vtext">&ldquo;{pt.text}&rdquo;</span>
                  <span class="vnote">{pt.note}</span>
                </p>
              ))}
            </div>
          </section>

          <section class="sec">
            <span class="eyebrow">In Plain Terms</span>
            <div class="plain">
              {w.plainTerms.map((p) => <p>{p}</p>)}
            </div>
          </section>

          <section class="sec home">
            <span class="eyebrow">Bring It Home</span>
            {w.bringItHome.map((p) => <p class="scene">{p}</p>)}
            {w.bringItHomeForward && <p class="fwd">{w.bringItHomeForward}</p>}
          </section>

          <section class="sec">
            <span class="eyebrow">Courtroom Roles</span>
            <ul class="roles">
              {w.courtroomRoles.map((r) => (
                <li>
                  <span class="who">{r.who} <span class="role">({r.role})</span></span>
                  <span class="does">{r.does}</span>
                </li>
              ))}
            </ul>
          </section>

          {brk && (
            <section class="sec">
              <span class="eyebrow brk-label">In the Break</span>
              <div class="brk-body"><p>{brk.note}</p></div>
            </section>
          )}

          <section class="sec stepper">
            <span class="eyebrow">Where It Sits</span>
            <div class="rail" aria-label={`Seven movements of the Legal Lexicon; this term sits in Movement ${w.movement}`}>
              {movements.map((m, i) => {
                const cls = (i + 1) < w.movement ? 'done' : (i + 1) === w.movement ? 'here' : 'ahead';
                return (
                  <div class={`step ${cls}`}><span class="dot"></span><span class="n">{m.rom}</span><span class="t">{m.name}</span></div>
                );
              })}
            </div>
            <p class="movecap"><b>Movement {mv.rom} — {mv.name}.</b> {mv.desc}</p>
            {liveRelated.length > 0 && (
              <p class="related">Related terms in this movement: {liveRelated.map((r, i) => (
                <>{i > 0 && ' · '}<a href={`/torah/legal-lexicon/${slugify(r.term)}`}>{r.term}</a></>
              ))}</p>
            )}
          </section>

        </div>
      </article>

      <p class="foot">nazaryah.com &nbsp;·&nbsp; The Legal Lexicon of Scripture</p>

    </div>
  </div>
</BaseLayout>

<style>
  /* Torah section — matches the Trinity page theme (fixed dark, cream serif, gold accents). */
  .ll{
    background:linear-gradient(180deg,#0e0904 0%,#1a1208 20%,#160f07 100%);
    color:#d9c9a8;
    font-family:'Crimson Pro','Crimson Text',Georgia,serif;line-height:1.7;font-size:18px;
  }
  .ll .wrap{max-width:820px;margin:0 auto;padding:40px 26px 80px;}
  .ll .crumb{font-family:'Cinzel',serif;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#8a6028;margin:0 0 24px;}
  .ll .crumb a{color:#c4a46b;text-decoration:none;border-bottom:1px dotted #6a4820;}
  .ll .crumb a:hover{color:#f0e0bf;}
  .ll .eyebrow{font-family:'Cinzel',serif;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8a6028;font-weight:600;}

  .ll .page{background:rgba(20,13,5,.5);border:1px solid #3a2510;border-radius:4px;overflow:hidden;}
  .ll .page-head{padding:34px 40px 26px;border-bottom:1px solid #3a2510;background:radial-gradient(ellipse at 50% 0%,rgba(150,90,40,.12),transparent 70%);}
  .ll .page-head .eyebrow{display:block;margin-bottom:16px;}
  .ll .caseno{float:right;text-align:right;font-family:'Cinzel',serif;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:#8a6f45;line-height:1.8;}
  .ll .caseno b{color:#c4a46b;display:block;font-size:11px;}
  .ll .word{font-family:'Cinzel',serif;font-size:52px;line-height:1.04;color:#f0e0bf;margin:0 0 8px;font-weight:700;letter-spacing:-.01em;}
  .ll .word .num{font-size:20px;color:#8a6028;vertical-align:super;margin-right:10px;font-weight:400;}
  .ll .rootline{font-size:17px;color:#c4a46b;font-style:italic;margin:0;}

  .ll .lead{padding:28px 40px 6px;font-size:19px;line-height:1.7;color:#e0d2b2;}
  .ll .lead .kick{float:left;font-family:'Cinzel',serif;font-size:58px;line-height:.82;color:#c4a46b;font-weight:700;margin:6px 12px 0 0;}

  .ll .body{padding:8px 40px 44px;}
  .ll .sec{padding-top:26px;margin-top:26px;border-top:1px solid #2e1f0d;}
  .ll .sec:first-child{border-top:0;margin-top:0;}
  .ll .sec .eyebrow{display:block;margin-bottom:12px;padding-bottom:.5rem;border-bottom:1px solid #3a2510;}
  .ll .sec p{margin:0;}
  .ll .sec p + p{margin-top:12px;}
  .ll .sec strong{color:#e8d5a8;} .ll .sec em{color:#c4a46b;}

  .ll .roots{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;align-items:center;}
  .ll .roots .lbl{font-size:14px;color:#9a8763;font-style:italic;margin-right:2px;}
  .ll .rootchip{display:inline-block;font-size:14px;color:#e0d2b2;text-decoration:none;
    border:1px solid #3a2510;border-left:3px solid #8a6028;border-radius:2px;padding:4px 11px;background:rgba(0,0,0,.25);}
  .ll .rootchip b{color:#c4a46b;font-weight:400;}
  .ll .rootchip:hover{border-color:#8a6028;color:#f0e0bf;}
  .ll .rootnote{font-size:14px;color:#9a8763;margin-top:9px;font-style:italic;}
  .ll .rootnote em{color:#c4a46b;}

  .ll .evidence{border-left:3px solid #8a6028;padding-left:20px;margin-top:4px;}
  .ll .verse{margin:0 0 16px;}
  .ll .verse:last-child{margin-bottom:0;}
  .ll .vref{display:block;font-family:'Cinzel',serif;color:#c4a46b;font-weight:600;font-size:13px;letter-spacing:.04em;margin-bottom:3px;}
  .ll .vtext{font-style:italic;color:#e0d2b2;}
  .ll .vnote{font-style:normal;color:#9a8763;font-size:14px;display:block;margin-top:3px;}

  .ll .plain{background:rgba(0,0,0,.28);border:1px solid #3a2510;border-radius:3px;padding:18px 22px;}
  .ll .plain p{margin:0;font-size:18px;color:#e0d2b2;}
  .ll .plain p + p{margin-top:12px;}
  .ll .home .scene{font-style:italic;}
  .ll .fwd{font-size:15px;color:#9a8763;border-top:1px solid #2e1f0d;margin-top:16px;padding-top:14px;}

  .ll .roles{list-style:none;margin:4px 0 0;padding:0;}
  .ll .roles li{padding:11px 0;border-top:1px solid #2e1f0d;display:flex;gap:14px;align-items:baseline;}
  .ll .roles li:first-child{border-top:0;}
  .ll .roles .who{color:#f0e0bf;font-weight:600;min-width:210px;}
  .ll .roles .who .role{color:#c4a46b;font-weight:400;font-style:italic;}
  .ll .roles .does{color:#d9c9a8;}

  .ll .stepper{margin-top:6px;}
  .ll .rail{display:flex;gap:0;margin:14px 0 12px;flex-wrap:wrap;}
  .ll .step{flex:1 1 0;min-width:88px;text-align:center;position:relative;padding-top:20px;}
  .ll .step::before{content:"";position:absolute;top:6px;left:0;right:0;height:2px;background:#3a2510;}
  .ll .step:first-child::before{left:50%;}
  .ll .step:last-child::before{right:50%;}
  .ll .step .dot{position:absolute;top:1px;left:calc(50% - 6px);width:12px;height:12px;border-radius:50%;background:#160f07;border:2px solid #3a2510;}
  .ll .step.done .dot{border-color:#8a6028;background:#8a6028;}
  .ll .step.here .dot{border-color:#f0e0bf;background:#c4a46b;transform:scale(1.35);}
  .ll .step.ahead .dot{border-color:#3a2510;background:#160f07;}
  .ll .step .n{font-family:'Cinzel',serif;font-size:12px;color:#8a6f45;letter-spacing:.1em;}
  .ll .step .t{font-size:11px;color:#8a6f45;line-height:1.25;display:block;margin-top:2px;}
  .ll .step.here .n,.ll .step.here .t{color:#f0e0bf;font-weight:600;}
  .ll .movecap{font-size:15px;color:#d9c9a8;margin-top:6px;}
  .ll .movecap b{color:#f0e0bf;}
  .ll .related{font-size:14px;color:#9a8763;margin-top:12px;}
  .ll .related a{color:#c4a46b;text-decoration:none;border-bottom:1px dotted #6a4820;}

  .ll .foot{text-align:center;color:#6a5a3a;font-family:'Cinzel',serif;font-size:11px;letter-spacing:.1em;margin-top:36px;}

  /* In the Break — red accent adapted for legibility on the dark theme */
  .ll .brk-label{color:#e0655b;border-bottom-color:#5a2420 !important;}
  .ll .brk-body{border-left:3px solid #e0655b;padding-left:20px;margin-top:4px;}
  .ll .brk-body p{margin:0;color:#e8c5b8;}

  @media (max-width:620px){
    .ll{font-size:17px;}
    .ll .wrap{padding:28px 16px 60px;}
    .ll .page-head,.ll .lead,.ll .body{padding-left:22px;padding-right:22px;}
    .ll .word{font-size:38px;}
    .ll .caseno{float:none;text-align:left;margin-bottom:14px;}
    .ll .lead .kick{font-size:46px;}
    .ll .roles li{flex-direction:column;gap:2px;}
    .ll .roles .who{min-width:0;}
    .ll .step .t{display:none;}
    .ll .step{min-width:34px;}
  }
</style>
