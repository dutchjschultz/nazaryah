---
// torah/testimonies/index.astro · 1011 V8
// V8 (Torah Index Sorting Fix 1011 V1): group headers under "All" in both
// sorts, a third switch Sort by verse (book dropdown), and reference search in
// any common spelling. Each entry's book, chapter and verses are worked out here
// from its `ref` with the Scripture index's book table (src/lib/scripture/
// books.js); a reference that will not parse fails the build. Group headers
// read "<letter>. <section>" — the letter is the entry ids' group letter (A–G).
// V7:// V7: Sort by argument | Sort by foundation. The sixteen Foundations (names,
// links) come from FOUNDATIONS in law-on-trial.js — the same source the
// Foundation pages use; each testimony names its own by id (F-01…) in
// torah-testimonies.js. The build fails on an id with no Foundation.
// V6: the seven-card grid is retired. The page now carries every Law on Trial
// passage, written and coming, as one numbered list in Bible order — the
// shared ProofTextList (also on /trinity/files), fed by
// src/data/torah-testimonies.js. Coming rows are grayed with their claim, no
// link, no tag (the Parables treatment). No "In progress" state survives.
// The testimony pages themselves still build from STUDIES in law-on-trial.js;
// the guard below fails the build if the two lists disagree on what is live.
// V5: first content load — seven testimonies live (data file V5). Empty-state
// line reads "Testimonies", not "Studies". Nothing else changes.
// V4: section renamed "Torah Testimonies" and route moved from /torah/law-on-trial
// to /torah/testimonies (all internal links updated; 301 in netlify.toml). Title +
// kicker come from the data file (title "Torah Testimonies", kicker "The Law on Trial").
// V3: draft card border is now SOLID (was dashed) — a live study differs from a
// draft only in brightness, so flipping to live moves nothing.
// V2: live-study CTA is "Open Testimony →" (was "Open Study"); kicker copy comes
// from SECTION.kicker in the data file.
// Structural twin of /trinity/files. Studies render in array order (Acts 10
// leads — do not sort). Draft studies render dimmed with no link. The word
// "file" appears nowhere reader-facing here; the CTA is "Open Testimony".
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProofTextList from '../../../components/ProofTextList.jsx';
import '../../../styles/proof-list.css';
import { SECTION, STUDIES, FOUNDATIONS } from '../../../data/law-on-trial.js';
import { torahTestimonies } from '../../../data/torah-testimonies.js';
import { BOOKS, resolveBook } from '../../../lib/scripture/books.js';

// Build guard: a written entry must have a testimony page (a live STUDIES
// entry), and every live testimony must be written on the list.
const pages = new Set(STUDIES.filter((s) => s.status === 'live').map((s) => s.slug));
const listed = new Set(torahTestimonies.filter((t) => t.slug).map((t) => t.slug));
const noPage = [...listed].filter((s) => !pages.has(s));
const notListed = [...pages].filter((s) => !listed.has(s));
if (noPage.length) throw new Error(`torah-testimonies.js: no live testimony page for ${noPage.join(', ')} (add it to STUDIES in law-on-trial.js)`);
if (notListed.length) throw new Error(`torah-testimonies.js: live testimony not written on the list: ${notListed.join(', ')}`);

// Foundations for the dropdown, in F-number order: "F-01" from key 'f-01'.
const foundations = FOUNDATIONS.map((f) => ({
  id: f.key.toUpperCase(),
  title: f.title,
  href: f.status === 'live' ? `/torah/testimonies/foundations/${f.slug}` : null,
}));
const known = new Set(foundations.map((f) => f.id));
const badIds = torahTestimonies.flatMap((t) => (t.foundations || []).filter((id) => !known.has(id)).map((id) => `${t.id} ${id}`));
if (badIds.length) throw new Error(`torah-testimonies.js: unknown foundation id: ${badIds.join(', ')}`);

// Book / chapter / verse spans for Sort by verse and reference search.
// "Matthew 15:11, 17–20" → Matt 15:11, 15:17–20; "Psalm 40:6 with Hebrews
// 10:5–8" → both passages, filed under the first book. "First Corinthians" is
// read as 1 Corinthians.
const ORDINAL = { First: '1', Second: '2', Third: '3' };
function spansOf(ref) {
  const spans = [];
  for (const part of ref.split(/\s+with\s+|;\s*/)) {
    const m = part.trim().match(/^((?:First|Second|Third)\s+)?(.+?)\s+(\d+):(.+)$/);
    const b = m && resolveBook(`${m[1] ? ORDINAL[m[1].trim()] + ' ' : ''}${m[2]}`);
    if (!b) throw new Error(`torah-testimonies.js: cannot read the reference "${ref}"`);
    for (const piece of m[4].split(/,\s*/)) {
      const [from, to = from] = piece.split(/[–—-]/).map(Number);
      if (!from || !to) throw new Error(`torah-testimonies.js: cannot read the verses in "${ref}"`);
      spans.push({ key: b.key, c: Number(m[3]), from, to, book: b, label: `${m[1] ?? ''}${m[2]}` });
    }
  }
  return spans;
}
const items = torahTestimonies.map((t) => {
  const spans = spansOf(t.ref);
  return {
    ...t,
    book: spans[0].label,
    bookKey: spans[0].key,
    bookOrder: spans[0].book.order,
    spans: spans.map(({ key, c, from, to }) => ({ key, c, from, to })),
  };
});
// Every spelling the book table accepts, folded the way the list folds a query
// ("1 cor" → "1cor"), mapped to the book key.
const fold = (x) => x.toLowerCase().replace(/\.$/, '').replace(/\s+/g, '');
const bookAliases = {};
for (const b of BOOKS) for (const f of [b.key, b.name, b.kjv, b.refName, ...b.aliases]) bookAliases[fold(f)] = b.key;

// Group header text: the group letter from the entry ids + the section name.
const groupNames = {};
for (const t of torahTestimonies) groupNames[t.section] ??= `${t.id.charAt(0)}. ${t.section}`;
---

<BaseLayout
  title="Torah Testimonies — Nazaryah"
  description="Every passage modern teaching uses to argue the Torah was abolished, set aside, or replaced — examined one at a time, and returned to the argument it was actually written into."
>
  <div class="tr-wrap">

    <!-- ── HERO ── -->
    <section class="tr-hero">
      <a href="/torah" class="tr-back">&#8592; Back to Torah</a>
      <p class="tr-label">&#8213; {SECTION.kicker} &#8213;</p>
      <h1 class="tr-title">{SECTION.title}</h1>
      <p class="tr-sub">{SECTION.standfirst}</p>
    </section>

    <!-- ── INTRO ── -->
    <section class="tr-section">
      <div class="tr-prose">
        {SECTION.intro.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <!-- ── FOUNDATIONS DOORWAY ── -->
    <a class="fdoor" href="/torah/testimonies/foundations">
      <div class="fdoor-intro">
        <p class="fdoor-eyebrow">&#8213; The Foundations &#8213;</p>
        <p class="fdoor-desc">{SECTION.foundationsBlurb}</p>
      </div>
      <span class="fdoor-open">Open the Foundations&nbsp;<span class="arrow">&rarr;</span></span>
    </a>

    <!-- ── EVERY TESTIMONY ── -->
    <section class="tr-posts-section" id="testimonies" aria-label="Every testimony, in order">
      <h2 class="pl-heading">Every Testimony, in Order.</h2>
      <p class="pl-intro">Every passage used to argue the Law was abolished, numbered once in Bible order. Choose an argument to narrow the list, or search by reference.</p>
      <div class="pl-index" data-pagefind-ignore>
        <ProofTextList
          client:load
          items={items}
          base="/torah/testimonies/"
          cta="Open Testimony"
          noun="testimonies"
          label="Search the testimonies"
          foundations={foundations}
          groupLabel="argument"
          groupHeaders
          groupNames={groupNames}
          verseSort
          bookAliases={bookAliases}
        />
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .tr-wrap {
    background: linear-gradient(180deg, #0e0904 0%, #1a1208 20%, #160f07 100%);
    color: #f0e0bf;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    min-height: 80vh;
  }

  .tr-hero {
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    border-bottom: 1px solid #4a3218;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(150, 90, 40, 0.18), transparent 70%),
      linear-gradient(180deg, #0a0602 0%, #1a1208 100%);
    position: relative;
  }

  .tr-back {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #8a6028;
    text-decoration: none;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }
  .tr-back:hover { color: #c4a46b; }

  .tr-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    color: #8a6028;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .tr-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: #f0e0bf;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .tr-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #c4a46b;
    font-style: italic;
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .tr-section {
    padding: 3rem 1.5rem;
    border-bottom: 1px solid #2e1f0d;
  }

  /* ── Foundations doorway ── */
  .fdoor {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: center;
    max-width: 980px;
    margin: 10px auto 42px;
    padding: 26px 1.5rem;
    border-top: 1px solid #3a2510;
    border-bottom: 1px solid #3a2510;
    text-decoration: none;
    color: inherit;
  }

  .fdoor-eyebrow {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: #8a6028;
    margin: 0 0 10px;
  }

  .fdoor-desc {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.55;
    color: #c4a46b;
    margin: 0;
    max-width: 52ch;
  }

  .fdoor-open {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: #8a6028;
    white-space: nowrap;
    position: relative;
    padding-bottom: 6px;
    transition: color 0.3s ease;
  }
  .fdoor-open::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: rgba(138, 96, 40, 0.45);
    transition: background 0.3s ease;
  }
  .fdoor-open .arrow {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .fdoor:hover .fdoor-open { color: #f0e0bf; }
  .fdoor:hover .fdoor-open::after { background: #8a6028; }
  .fdoor:hover .fdoor-open .arrow { transform: translateX(7px); }
  .fdoor:focus-visible { outline: 2px solid #8a6028; outline-offset: 4px; }

  @media (max-width: 680px) {
    .fdoor { grid-template-columns: 1fr; gap: 20px; padding: 24px 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fdoor-open, .fdoor-open::after, .fdoor-open .arrow { transition: none; }
  }

  .tr-prose {
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #dcc99a;
  }
  .tr-prose p { margin-bottom: 1.2rem; }
  .tr-prose p:last-child { margin-bottom: 0; }

  .tr-posts-section {
    padding: 1rem 1.5rem 3.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

</style>
