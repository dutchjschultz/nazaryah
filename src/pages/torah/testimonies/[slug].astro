---
// torah/testimonies/[slug].astro · 1003 V3
// V3: renders the testimony body. One page per LIVE entry in STUDIES; the body
// is the `testimonies` collection entry the data file names in `body`
// (src/content/testimonies/<slug>.md, no frontmatter: reference, title and deck
// come from law-on-trial.js). The draft stub is gone; a draft testimony gets no
// page, and the index shows it dimmed with no link. A live testimony with no
// body file fails the build. The first ## ("Where the … Collapses") is the
// opening section (TestimonyBody `opening`).
// V2: section renamed/moved — links read "Torah Testimonies" and point at
// /torah/testimonies.
// No "file" wording anywhere reader-facing.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TestimonyBody from '../../../components/TestimonyBody.astro';
import { getEntry } from 'astro:content';
import { STUDIES } from '../../../data/law-on-trial.js';

export function getStaticPaths() {
  return STUDIES.filter((s) => s.status === 'live').map((study) => ({ params: { slug: study.slug }, props: { study } }));
}

const { study } = Astro.props;
const id = (study.body || `${study.slug}.md`).replace(/\.md$/, '');
const entry = await getEntry('testimonies', id);
if (!entry) throw new Error(`Torah Testimonies: ${study.slug} is live but src/content/testimonies/${id}.md is missing`);
const { Content } = await entry.render();
---

<BaseLayout title={`${study.reference} — ${study.title} — Torah Testimonies`} description={study.deck}>
  <div class="tr-wrap">

    <section class="ls-hero">
      <a href="/torah/testimonies" class="ls-back">&larr; Back to Torah Testimonies</a>
      <p class="ls-ref">{study.reference}</p>
      <h1 class="ls-title">{study.title}</h1>
      <p class="ls-deck">{study.deck}</p>
    </section>

    <TestimonyBody opening>
      <Content />
    </TestimonyBody>

    <nav class="ls-foot">
      <a href="/torah/testimonies/foundations" class="ls-foot-link">The Foundations&nbsp;&#8594;</a>
      <a href="/torah/testimonies" class="ls-foot-link">All Torah Testimonies&nbsp;&#8594;</a>
    </nav>

  </div>
</BaseLayout>

<style>
  .tr-wrap {
    background: linear-gradient(180deg, #0e0904 0%, #1a1208 20%, #160f07 100%);
    color: #f0e0bf;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    min-height: 80vh;
  }

  .ls-hero {
    text-align: center;
    padding: 4rem 1.5rem 3rem;
    border-bottom: 1px solid #4a3218;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(150, 90, 40, 0.18), transparent 70%),
      linear-gradient(180deg, #0a0602 0%, #1a1208 100%);
  }
  .ls-back {
    display: inline-block;
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #8a6028;
    text-decoration: none;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    transition: color 0.2s;
  }
  .ls-back:hover { color: #c4a46b; }

  .ls-ref {
    font-family: 'Cinzel', serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #c4a46b;
    margin: 0 0 1rem;
  }
  .ls-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: #f0e0bf;
    margin: 0 0 1rem;
    line-height: 1.15;
  }
  .ls-deck {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #c4a46b;
    font-style: italic;
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ls-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2.5rem;
    padding: 0 1.5rem 5rem;
  }
  .ls-foot-link {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a6028;
    text-decoration: none;
    transition: color 0.2s;
  }
  .ls-foot-link:hover { color: #f0e0bf; }
</style>
