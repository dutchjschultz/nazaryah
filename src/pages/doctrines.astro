---
// src/pages/doctrines.astro · 0804 V3
// V3: the section links + count render from the data file (sections / doctrines),
// not hand-written markup — adding a doctrine never touches this page.
// V2: this URL is the DOCTRINES landing — two links only, no cards. The old "Ten
// Doctrines the Church Got Wrong" grid moved to /doctrines/the-departure.
import BaseLayout from '../layouts/BaseLayout.astro';
import { sections, doctrines } from '../data/doctrines.data.js';
---

<BaseLayout
  title="Doctrines — The Old Paths & The Departure | Nazaryah"
  description="Two ways to read the same ten doctrines: The Old Paths, what Scripture holds, and The Departure, where the church went wrong."
>
  <div class="dl-page">
    <header class="dl-header">
      <p class="dl-eyebrow">Doctrines</p>
      <h1 class="dl-title">Two Roads From the Same Verses</h1>
      <p class="dl-sub">Read what Scripture holds, or read where the church departed. The same {doctrines.length} doctrines, from both directions.</p>
    </header>

    <div class="dl-links">
      {sections.map((s) => (
        <a class="dl-link" href={s.href}>
          <p class="dl-link-kicker">{s.kicker}</p>
          <h2 class="dl-link-title">{s.title}</h2>
          <p class="dl-link-deck">{s.deck}</p>
          <span class="dl-link-cta">{s.cta} <span aria-hidden="true">&rarr;</span></span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .dl-page { background: #0e0d0b; min-height: 100vh; padding: 4rem 2rem 5rem; }
  .dl-header { text-align: center; max-width: 44rem; margin: 0 auto 3rem; }
  .dl-eyebrow {
    font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.28em;
    text-transform: uppercase; color: #BA7517; margin: 0 0 0.7rem;
  }
  .dl-title {
    font-family: var(--font-display); font-size: clamp(1.7rem, 1.3rem + 2.4vw, 2.6rem);
    font-weight: 700; color: #e8e2d4; margin: 0 0 0.9rem; line-height: 1.14;
  }
  .dl-sub { font-family: var(--font-body); font-style: italic; font-size: 1.1rem; color: #a89f8c; margin: 0; line-height: 1.5; }

  .dl-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; max-width: 60rem; margin: 0 auto; }
  .dl-link {
    display: flex; flex-direction: column; gap: 0.6rem;
    background: #161512; border: 0.5px solid rgba(255,255,255,0.07); border-top: 3px solid #BA7517;
    border-radius: 14px; padding: 2.5rem 2rem; text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .dl-link:hover, .dl-link:focus-visible {
    background: #1c1a16; border-color: rgba(186,117,23,0.45); transform: translateY(-3px); outline: none;
  }
  .dl-link-kicker {
    font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.2em;
    text-transform: uppercase; color: #BA7517; margin: 0;
  }
  .dl-link-title { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; color: #e8e2d4; margin: 0; line-height: 1.2; }
  .dl-link-deck { font-family: var(--font-body); font-style: italic; font-size: 1.02rem; color: #a89f8c; margin: 0 0 0.5rem; line-height: 1.4; }
  .dl-link-cta {
    margin-top: auto; font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: #d8b06a; font-weight: 600;
  }

  @media (max-width: 640px) {
    .dl-links { grid-template-columns: 1fr; }
    .dl-page { padding: 3rem 1.25rem 4rem; }
  }
</style>
