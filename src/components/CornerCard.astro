---
// src/components/CornerCard.astro · 1014 V1
// V1 (Homepage Corner Cards Spec 1014 V1): one small puzzle card — the whole
// card is a single link. Tone 'burgundy' (#7A1E2B) or 'navy' (the site navy).
// A small mark in the top corner (a question mark or a mask) says "puzzle" at a
// glance. One gentle lift on load, then still; none under reduced motion.
interface Props {
  heading: string;
  line: string;
  linkText: string;
  href: string;
  tone: 'burgundy' | 'navy';
  mark?: 'question' | 'mask';
  index?: number;
}
const { heading, line, linkText, href, tone, mark = 'question', index = 0 } = Astro.props;
---

<a class:list={['cc', `cc--${tone}`]} href={href} style={`--cc-delay: ${index * 120}ms`}>
  <span class="cc-mark" aria-hidden="true">
    {mark === 'question' ? (
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10.5" /><path d="M9.2 9.2a2.9 2.9 0 1 1 4.1 2.6c-.8.4-1.3 1-1.3 1.9v.6" /><circle class="cc-dot" cx="12" cy="17.4" r="0.9" /></svg>
    ) : (
      <svg viewBox="0 0 24 24"><path d="M3 8.5c3-1.6 6-1.6 9 0 3-1.6 6-1.6 9 0 0 4.6-2.2 7.5-5 7.5-1.7 0-2.9-.9-4-2.4-1.1 1.5-2.3 2.4-4 2.4-2.8 0-5-2.9-5-7.5z" /><path d="M6.6 10.6c.8-.6 1.9-.6 2.7 0M14.7 10.6c.8-.6 1.9-.6 2.7 0" /></svg>
    )}
  </span>
  <span class="cc-heading">{heading}</span>
  <span class="cc-line">{line}</span>
  <span class="cc-link">{linkText} <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .cc {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 260px;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.8rem 2.4rem 0.8rem 1rem;
    border-radius: 10px;
    text-decoration: none;
    color: #f5ecd8;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
    animation: cc-lift 0.7s ease-out both;
    animation-delay: var(--cc-delay, 0ms);
  }
  .cc--burgundy { background: linear-gradient(160deg, #8a2533 0%, #7a1e2b 55%, #5e1520 100%); }
  .cc--navy { background: linear-gradient(160deg, #13284d 0%, #0a1d3a 55%, #061230 100%); }
  .cc:focus-visible { outline: 3px solid #d4af37; outline-offset: 3px; }
  .cc-mark { position: absolute; top: 0.75rem; right: 0.8rem; width: 1.35rem; height: 1.35rem; color: #e9cf85; }
  .cc-mark svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .cc-mark .cc-dot { fill: currentColor; stroke: none; }
  .cc-heading { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 1.02rem; line-height: 1.25; color: #fbf3e2; }
  .cc-line { font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif; font-style: italic; font-size: 0.94rem; line-height: 1.35; color: rgba(245, 236, 216, 0.86); }
  .cc-link { margin-top: 0.1rem; font-family: 'Cinzel', serif; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #e9cf85; }
  .cc:hover .cc-link { color: #fff; }
  @keyframes cc-lift {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) { .cc { animation: none; } }
</style>
