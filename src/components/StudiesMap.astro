---
// StudiesMap.astro · 1007 V1
// The Berean Studies landing, lifted out of src/pages/blog/index.astro so three
// pages can share it. `show` decides what renders:
//   'all'          /blog              — studies, Pe'ah + Trilogies cards, collections
//   'studies'      /blog/topics       — All Studies + the topic cards only
//   'collections'  /blog/collections  — the collection cards only
// The Studies dropdown in Header.astro points at these addresses.
import { getCollection } from 'astro:content';
import { BLOG_GROUPS, BLOG_JUMPOUTS, groupOf, inFeed, extrasOf } from '../data/blog-groups.js';
import { COLLECTIONS, collectionSlugs, leavesTopic, entryCount } from '../data/collections.js';
import { READING_SETS } from '../data/reading-sets.js';
import CollectionCard from './CollectionCard.astro';

const { show = 'all' } = Astro.props;
const showStudies = show === 'all' || show === 'studies';
const showShort = show === 'all';
const showCollections = show === 'all' || show === 'collections';

const all = await getCollection('posts', ({ data }) => data.draft !== true);
const posts = all.filter(inFeed);
const countByGroup = Object.fromEntries(
  BLOG_GROUPS.map((g) => [g.key, posts.filter((p) => groupOf(p.slug) === g.key && !leavesTopic(p.slug)).length + extrasOf(g.key).length])
);
const total = posts.length;
const slugSet = new Set(all.map((p) => p.slug));
const collections = COLLECTIONS.map((c) => ({
  collection: c,
  count: c.entries ? entryCount(c) : collectionSlugs(c).filter((s) => slugSet.has(s)).length,
}));
const peahCount = (await getCollection('peah', ({ data }) => data.draft !== true)).length;
const trilogyCount = READING_SETS.length;
---

<section class="blog-map">
  <div class="blog-map-inner">

    {showStudies && (
      <>
        <a href="/blog/all" class="blog-all">
          <span class="blog-all-label">All Studies</span>
          <span class="blog-all-meta">{total} studies · search the full archive</span>
          <span class="blog-all-cta">Search &amp; browse &rarr;</span>
        </a>

        <p class="blog-map-eyebrow">Studies · browse by topic</p>
        <div class="blog-group-grid">
          {BLOG_GROUPS.map((g) => (
            <a href={`/blog/c/${g.key}`} class="blog-group-card">
              <span class="bg-name">{g.name}</span>
              {g.subtitle && <span class="bg-sub">{g.subtitle}</span>}
              <span class="bg-blurb">{g.blurb}</span>
              <span class="bg-count">{countByGroup[g.key]} {countByGroup[g.key] === 1 ? 'study' : 'studies'} &rarr;</span>
            </a>
          ))}
        </div>
      </>
    )}

    {showShort && (
      <>
        <p class="blog-map-eyebrow">A short read · a set of three</p>
        <div class="blog-feature-grid">
          <a href="/peah" class="blog-feature-card">
            <span class="bf-label">Pe'ah</span>
            <span class="bf-name">The Corner of the Field</span>
            <span class="bf-blurb">A short read on one verse, one point. Fits with morning coffee.</span>
            <span class="bf-count">{peahCount} {peahCount === 1 ? 'entry' : 'entries'} &rarr;</span>
          </a>
          <a href="/trilogies" class="blog-feature-card">
            <span class="bf-label">Trilogies</span>
            <span class="bf-name">Studies That Belong Together</span>
            <span class="bf-blurb">Three studies that stand on their own and shed light on one another. Start with any one.</span>
            <span class="bf-count">{trilogyCount} {trilogyCount === 1 ? 'trilogy' : 'trilogies'} &rarr;</span>
          </a>
        </div>
      </>
    )}

    {showCollections && collections.length > 0 && (
      <>
        <p class="blog-map-eyebrow">Collections · studies that outgrew the page</p>
        <div class="blog-group-grid blog-collection-grid">
          {collections.map(({ collection, count }) => <CollectionCard collection={collection} count={count} />)}
        </div>
      </>
    )}

    {showStudies && (
      <div class="blog-jumpouts">
        {BLOG_JUMPOUTS.map((j) => (
          <a href={j.href} class="blog-jumpout">
            <span class="jo-label">{j.label}</span>
            <span class="jo-note">{j.note} &rarr;</span>
          </a>
        ))}
      </div>
    )}

  </div>
</section>

<style>

  .blog-map { background: #0a0a0a; padding: 3rem 1.5rem 4rem; border-top: 3px solid #b89150; }
  .blog-map-inner { max-width: 72rem; margin: 0 auto; }

  /* All Studies — the wide primary entry */
  .blog-all {
    display: flex; flex-direction: column; gap: 0.3rem; text-decoration: none; margin-bottom: 2.5rem;
    padding: 1.5rem 1.75rem; border-radius: 6px; border: 1px solid rgba(212,175,55,0.35); border-left: 4px solid #d4af37;
    background: radial-gradient(ellipse at 20% 0%, #241a0c 0%, #14110c 70%, #0b0906 100%);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .blog-all:hover { transform: translateY(-2px); background: radial-gradient(ellipse at 20% 0%, #2c2010 0%, #1a1510 70%, #0e0b07 100%); }
  .blog-all-label { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 1.7rem; color: #f5e6c8; }
  .blog-all-meta { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 1rem; color: #a09078; }
  .blog-all-cta { font-family: 'Cinzel', serif; font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: #d4af37; margin-top: 0.3rem; }

  .blog-map-eyebrow { font-family: 'Cinzel', serif; font-size: 0.66rem; letter-spacing: 0.26em; text-transform: uppercase; color: #a08a4e; text-align: center; margin: 0 0 1.3rem; }

  .blog-group-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.1rem; margin-bottom: 2.5rem; }
  .blog-group-card {
    display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; padding: 1.3rem 1.4rem 1.2rem;
    border-radius: 6px; background: #141210; border: 1px solid rgba(201,169,97,0.16); border-top: 3px solid #c9a961;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .blog-group-card:hover { transform: translateY(-3px); background: #1b1813; }
  /* Collection cards are src/components/CollectionCard.astro (own styles).
     auto-fill, not auto-fit: one or two collections keep a topic card's width
     instead of stretching across the row. */
  .blog-collection-grid { grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .bg-name { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 1.3rem; color: #f5e6c8; line-height: 1.15; }
  .bg-blurb { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 0.95rem; line-height: 1.45; color: rgba(232,217,184,0.75); flex: 1; }
  .bg-count { font-family: 'Cinzel', serif; font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; color: #c9a961; padding-top: 0.5rem; border-top: 1px solid rgba(201,169,97,0.14); }

  .blog-jumpouts { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1rem; }
  .blog-jumpout {
    display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; padding: 1.1rem 1.3rem; border-radius: 6px;
    background: rgba(20,18,16,0.6); border: 1px dashed rgba(201,169,97,0.4); transition: border-color 0.2s ease, background 0.2s ease;
  }
  .blog-jumpout:hover { border-color: #c9a961; background: rgba(28,24,19,0.7); }
  .jo-label { font-family: 'Cinzel', serif; font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; color: #c9a961; }
  .jo-note { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 0.95rem; color: #a09078; }
  .bg-sub { font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: #c9a961; margin-top: -0.3rem; }

  /* Pe'ah and Trilogies — parchment cards on the dark map, so they read as a
     different kind of thing from the topic cards. */
  .blog-feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.1rem; margin-bottom: 2.5rem; }
  .blog-feature-card {
    display: flex; flex-direction: column; gap: 0.45rem; text-decoration: none; padding: 1.3rem 1.5rem 1.2rem;
    border-radius: 6px; background: #e8d9b3; border: 1px solid #c9a961; border-left: 4px solid #a0451c;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .blog-feature-card:hover { transform: translateY(-3px); background: #efe1c0; }
  .bf-label { font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: #a0451c; }
  .bf-name { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 1.35rem; color: #2b1d11; line-height: 1.15; }
  .bf-blurb { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 1rem; line-height: 1.45; color: #4a3520; flex: 1; }
  .bf-count { font-family: 'Cinzel', serif; font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; color: #7d3414; padding-top: 0.5rem; border-top: 1px solid rgba(122,79,40,0.25); }
</style>
