---
// src/components/DoctrineCard.astro · 1021 V6
// V6 (Riddle Cards brief 1021 V2): optional `banner`. The doctrine (the `tag`) moves
// from the card's foot to a banner across its top — large gold small caps, the
// number small and muted at its right end, a faint gold wash and a gold-dim
// hairline under it — so the doctrine shows once and the number can no longer
// collide with the series line. Body order: banner, series line, title, deck,
// then the riddle block under a hairline at the card's foot. In this mode the
// wrap carries the card's frame and the riddle block flows beneath the link
// (still a sibling, no nested links), so it can never overlap the text. Tighter
// for five across. Without `banner` the card renders exactly as V5.
// V5 (Etsy Riddles Revelation Split 1021 V1): optional `groupLabel` — a small gold
// eyebrow ("Revelation · 1 of 3") above the title, set by DoctrineGrid.
// V4 (Etsy Doctrine Riddles 1019 V4): `riddle` becomes `riddles` ({ href, number }[],
// by number). One riddle: the V3 link. Two or more: the block is a <div> holding
// separate links — "Solve the Riddles in 3 Verses" (to the first) and "You can
// crack them →" followed by one small gold number link per riddle (2 · 3 · 4).
// V3 (Etsy Doctrine Riddles 1019 V3): optional `riddle` ({ href, number }). When
// set, the card sits in a .doctrine-card-wrap and a SIBLING link (the card is
// already one <a>, so no nesting) is laid over its bottom-left, under the tag:
// "Solve the Riddle in 3 Verses" / "You can crack it →". The card gains bottom
// padding to make room. Without `riddle` the card renders exactly as V2.
// V2: the recognition `tag` renders beneath the deck — the doctrine named in
// church vocabulary, muted gold small caps, so a reader who does not recognise
// the poetic title knows the subject before he clicks. Optional: a card without
// a tag renders exactly as it did in V1.
// V1: The one card used by BOTH doctrine grids (Old Paths + The Departure). Gold
// top rule, number in small gold caps, title, italic deck. The WHOLE card is the
// link — no hover panel, no body text on the card.
interface Props { n: string; title: string; deck: string; tag?: string; href: string; riddles?: { href: string; number: number }[]; groupLabel?: string; banner?: boolean; }
const { n, title, deck, tag, href, riddles = [], groupLabel, banner = false } = Astro.props;
const riddle = riddles[0];
const several = riddles.length > 1;
---

{banner ? (
  <div class:list={['doctrine-card-wrap', 'is-banner', { 'has-riddle': riddle }]}>
    <a class="doctrine-card" href={href}>
      <span class="dc-banner">
        <span class="dc-doctrine">{tag}</span>
        <span class="dc-num">{n}</span>
      </span>
      <span class="dc-body">
        {groupLabel && <span class="doctrine-group">{groupLabel}</span>}
        <span class="doctrine-cat">{title}</span>
        <span class="doctrine-deck">{deck}</span>
      </span>
    </a>
    {riddle && (several ? (
      <div class="doctrine-riddle">
        <a class="dr-line1" href={riddle.href} aria-label={`Solve the riddles for ${title}`}>Solve the Riddles in 3 Verses</a>
        <span class="dr-line2">You can crack them &rarr;{riddles.map((r, i) => (
          <>{i > 0 && <span class="dr-dot" aria-hidden="true"> &middot; </span>}<a class="dr-num" href={r.href} aria-label={`Riddle ${r.number}`}>{i === 0 && ' '}{r.number}</a></>
        ))}</span>
      </div>
    ) : (
      <a class="doctrine-riddle" href={riddle.href} aria-label={`Solve the riddle for ${title}`}>
        <span class="dr-line1">Solve the Riddle in 3 Verses</span>
        <span class="dr-line2">You can crack it &rarr;</span>
      </a>
    ))}
  </div>
) : riddle ? (
  <div class="doctrine-card-wrap">
    <a class="doctrine-card has-riddle" href={href}>
      <span class="doctrine-num">{n}</span>
      {groupLabel && <span class="doctrine-group">{groupLabel}</span>}
      <p class="doctrine-cat">{title}</p>
      <p class="doctrine-deck">{deck}</p>
      {tag && <p class="doctrine-tag">{tag}</p>}
    </a>
    {several ? (
      <div class="doctrine-riddle">
        <a class="dr-line1" href={riddle.href} aria-label={`Solve the riddles for ${title}`}>Solve the Riddles in 3 Verses</a>
        <span class="dr-line2">You can crack them &rarr;{riddles.map((r, i) => (
          <>{i > 0 && <span class="dr-dot" aria-hidden="true"> &middot; </span>}<a class="dr-num" href={r.href} aria-label={`Riddle ${r.number}`}>{i === 0 && ' '}{r.number}</a></>
        ))}</span>
      </div>
    ) : (
      <a class="doctrine-riddle" href={riddle.href} aria-label={`Solve the riddle for ${title}`}>
        <span class="dr-line1">Solve the Riddle in 3 Verses</span>
        <span class="dr-line2">You can crack it &rarr;</span>
      </a>
    )}
  </div>
) : (
  <a class="doctrine-card" href={href}>
    <span class="doctrine-num">{n}</span>
      {groupLabel && <span class="doctrine-group">{groupLabel}</span>}
    <p class="doctrine-cat">{title}</p>
    <p class="doctrine-deck">{deck}</p>
    {tag && <p class="doctrine-tag">{tag}</p>}
  </a>
)}

<style>
  .doctrine-card {
    background: #161512;
    border: 0.5px solid rgba(255,255,255,0.07);
    border-top: 3px solid #BA7517;
    border-radius: 12px;
    padding: 2.25rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .doctrine-card:hover,
  .doctrine-card:focus-visible {
    background: #1c1a16;
    border-color: rgba(186,117,23,0.45);
    transform: translateY(-2px);
    outline: none;
  }
  .doctrine-num {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: #BA7517;
    text-transform: uppercase;
  }
  .doctrine-group {
    margin-top: -0.35rem;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: #d8a24a;
    text-transform: uppercase;
  }
  .doctrine-cat {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
    color: #e8e2d4;
    line-height: 1.35;
  }
  .doctrine-deck {
    font-family: var(--font-body);
    font-size: 17px;
    font-style: italic;
    color: #a89f8c;
    line-height: 1.3;
  }
  /* Recognition tag — muted gold, never the gold of the number above it, so it
     reads as a label on the card rather than a second heading. Pushed to the
     bottom so tags line up across a row of uneven decks. */
  .doctrine-tag {
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--font-display);
    font-variant: all-small-caps;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #9a7c46;
    line-height: 1.2;
  }

  /* Riddle link (V3) — a sibling of the card link, laid over its bottom-left. */
  .doctrine-card-wrap { position: relative; display: grid; min-width: 0; }
  .doctrine-card.has-riddle { padding-bottom: 5rem; }
  .doctrine-riddle {
    position: absolute; left: 1.8rem; bottom: 1.1rem;
    display: flex; flex-direction: column; gap: 0.15rem;
    text-decoration: none;
  }
  .dr-line1 {
    font-family: var(--font-display); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.15em; color: #e0a54a; line-height: 1.3;
    transition: color 0.2s;
  }
  .dr-line2 {
    font-family: var(--font-body); font-size: 15px; font-style: italic;
    color: #a89f8c; line-height: 1.3;
  }
  .doctrine-riddle:hover .dr-line1,
  .doctrine-riddle:focus-visible .dr-line1 { color: #e8e2d4; }
  .doctrine-riddle:hover .dr-line2,
  .doctrine-riddle:focus-visible .dr-line2 { text-decoration: underline; text-underline-offset: 4px; }
  .doctrine-riddle:focus-visible { outline: 1px solid #BA7517; outline-offset: 4px; }
  /* Two or more riddles (V4): the block is a div; each line part is its own link. */
  div.doctrine-riddle .dr-line1 { text-decoration: none; }
  div.doctrine-riddle .dr-line1:hover,
  div.doctrine-riddle .dr-line1:focus-visible { color: #e8e2d4; outline: none; }
  .dr-dot { color: #9a7c46; font-style: normal; }
  .dr-num {
    font-family: var(--font-display); font-style: normal; font-size: 13px; font-weight: 600;
    color: #e0a54a; text-decoration: none; padding: 0 0.1rem;
  }
  .dr-num:hover, .dr-num:focus-visible { color: #e8e2d4; text-decoration: underline; text-underline-offset: 4px; outline: none; }

  /* Banner mode (V6) — the Old Paths grid, five across. */
  .doctrine-card-wrap.is-banner {
    display: flex; flex-direction: column; min-width: 0;
    background: #161512; border: 0.5px solid rgba(255,255,255,0.07); border-top: 3px solid #BA7517; border-radius: 8px;
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
  }
  .doctrine-card-wrap.is-banner:hover, .doctrine-card-wrap.is-banner:focus-within {
    background: #1c1a16; border-color: rgba(186,117,23,0.45); transform: translateY(-2px);
  }
  .is-banner .doctrine-card {
    flex: 1; gap: 0; padding: 0 0 14px; background: none; border: 0; border-radius: 0; transform: none;
  }
  .is-banner .doctrine-card:hover, .is-banner .doctrine-card:focus-visible { background: none; transform: none; }
  .is-banner .doctrine-card:focus-visible { outline: 1px solid #BA7517; outline-offset: -3px; }
  .dc-banner {
    display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;
    padding: 12px 14px 10px; background: rgba(201,162,94,0.07); border-bottom: 1px solid rgba(201,162,94,0.28);
  }
  .dc-doctrine {
    font-family: var(--font-display); font-variant: all-small-caps; font-size: 1.2rem; font-weight: 600;
    letter-spacing: 0.06em; line-height: 1.1; color: #d8a24a;
  }
  .dc-num { flex: none; font-family: var(--font-display); font-size: 0.68rem; letter-spacing: 0.16em; color: #8f8574; }
  .dc-body { flex: 1; display: flex; flex-direction: column; gap: 0.35rem; padding: 12px 14px 0; }
  .is-banner .doctrine-group { display: block; margin: 0 0 0.1rem; font-size: 0.68rem; letter-spacing: 0.2em; }
  .is-banner .doctrine-cat { font-size: 1.3rem; line-height: 1.2; }
  .is-banner .doctrine-deck { flex: 1; font-size: 1.02rem; line-height: 1.25; }
  .is-banner .doctrine-riddle {
    position: static; margin: 0 14px 14px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.08);
  }
  .is-banner .dr-line1 { font-size: 0.68rem; letter-spacing: 0.15em; }
  .is-banner .dr-line2 { font-size: 0.98rem; }
</style>
