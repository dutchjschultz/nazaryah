---
// Header.astro · 1008 V14 — the mobile menu opens on its own dark panel (the
// dropdowns' ground) so it reads in light mode, where it sat over the header's
// cream half.
// V13: Topics retired. COUNTERFEITS and RESTORED TRUTH are
// top-level dropdowns of their own (after Doctrines), one column each, every link
// with a one-line description under it. Neither label is a link (Counterfeits no
// longer jumps to /foreign-fire). Links + descriptions come from
// src/data/nav-sections.js. "On These Two" reads The Paper Trail (address
// unchanged). Mobile groups read Counterfeits / Restored Truth, with descriptions.
// Eleven top-level items: the row tightens in two steps (below 1700px, below
// 1480px) rather than wrapping; under 1240px the hamburger menu takes over (it was
// 768px — ten items already overflowed at 1280). The mobile menu now scrolls
// inside itself; inside the sticky header its lower groups were unreachable.
// V12: Doctrines dropdown and mobile menu gain Words Your
// Bible Borrowed (/doctrines/borrowed-words) after The Departure.
// V11: STUDIES is now BEREAN STUDIES (Acts 17:11). The
// label still opens /blog, which now shows all four kinds of reading. The
// dropdown has four items, each with a one-line description under its name
// (the Doctrines sublabel line): Studies (/blog/topics), Pe'ah (/peah),
// Trilogies (/trilogies), Collections (/blog/collections). Mobile lists all four.
// V10: Header.astro · 0929 V10 — BLOG is now STUDIES, a hover dropdown (Studies →
// /blog, Pe'ah — The Corner of the Field → /peah) built on the Doctrines
// dropdown's markup and classes. Reader-facing word only: every address stays
// /blog. Mobile lists both links.
// V9 — Topics → Restored Truth: COSMOLOGY now opens the
// /cosmology section front instead of the study itself (the study moved to
// /cosmology/the-heavens-and-the-earth). Mobile inherits it.
// V8 — Topics → Restored Truth: COSMOLOGY goes live. The
// "coming soon" stub now links to The Heavens and the Earth
// (/blog/the-heavens-and-the-earth), the cosmology page. Same slot, same order;
// mobile inherits it via the ...topicsRestoredTruth.items spread.
// V7 — Topics → Restored Truth: added THE PARABLES
// (/parables), the new section landing. Placed with the live links, above
// Investigations. Mobile inherits it via the ...topicsRestoredTruth.items spread.
// V6 — Topics → Restored Truth: the LIVING TEMPLE "coming
// soon" entry is gone, replaced by INVESTIGATIONS (/investigations). The Living
// Temple is now a live investigation reached from that hub, not a nav stub, and
// the entry sits with the live links, above Cosmology.
// V5 — added "On These Two" (/on-these-two) to Topics →
// Counterfeits; mobile inherits it via the ...topicsForeignFire.items spread.
// V4 — "Scripture Insights" renamed to "Close to the Hip"
// (/close-to-the-hip) in Topics → Restored Truth; mobile inherits from the array.
// V3 — added the entry to Topics → Restored Truth (adjacent to Hidden Gems).
// V2 — DOCTRINES is a hover dropdown (The Old Paths / The Departure); the label
// itself still links to /doctrines.
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { counterfeitsNav, restoredTruthNav } from '../data/nav-sections.js';

const currentPath = Astro.url.pathname;

// Single row of eleven primary items. Counterfeits and Restored Truth are the two
// topical dropdowns; their links live in src/data/nav-sections.js.
const primaryNav = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Doctrines', href: '/doctrines', dropdown: 'doctrines' },
  { name: 'Counterfeits', href: null, dropdown: 'section', section: counterfeitsNav },
  { name: 'Restored Truth', href: null, dropdown: 'section', section: restoredTruthNav },
  { name: 'Torah', href: '/torah' },
  { name: 'Trinity', href: '/trinity' },
  { name: 'Berean Studies', href: '/blog', dropdown: 'studies' },
  { name: 'Voices', href: '/voices' },
  { name: 'Books', href: '/books' },
  { name: 'Contact', href: '/contact' },
];

// Doctrines dropdown — two entries; the label itself links to /doctrines.
const doctrinesNav = {
  href: '/doctrines',
  items: [
    { name: 'The Old Paths', href: '/doctrines/old-paths', sublabel: 'What Scripture holds' },
    { name: 'The Departure', href: '/doctrines/the-departure', sublabel: 'Where the church went' },
    { name: 'Words Your Bible Borrowed', href: '/doctrines/borrowed-words', sublabel: 'The Greek behind the doctrines' },
  ],
};

// Studies dropdown — the label itself links to the index. Addresses did not
// move: the index is still /blog and every study is still /blog/<slug>; only the
// reader-facing word changed from Blog to Studies.
const studiesNav = {
  href: '/blog',
  items: [
    { name: 'Studies', href: '/blog/topics', sublabel: 'Full Bible studies, one subject at a time, sorted by topic.' },
    { name: "Pe'ah — The Corner of the Field", href: '/peah', sublabel: 'A short read on one verse, one point. Fits with morning coffee.' },
    { name: 'Trilogies', href: '/trilogies', sublabel: 'Three studies that belong together. Each one opens the other two wider.' },
    { name: 'Collections', href: '/blog/collections', sublabel: 'Studies that outgrew the page.' },
  ],
};

// Flat list of every link, used for the mobile menu.
const mobileNav = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about' },
  { name: 'Doctrines', href: '/doctrines' },
  { name: 'The Old Paths', href: '/doctrines/old-paths' },
  { name: 'The Departure', href: '/doctrines/the-departure' },
  { name: 'Words Your Bible Borrowed', href: '/doctrines/borrowed-words' },
  { name: 'Torah', href: '/torah' },
  { name: 'Trinity', href: '/trinity' },
  { name: 'Berean Studies', href: '/blog' },
  { name: 'Studies', href: '/blog/topics' },
  { name: "Pe'ah — The Corner of the Field", href: '/peah' },
  { name: 'Trilogies', href: '/trilogies' },
  { name: 'Collections', href: '/blog/collections' },
  { name: 'Voices', href: '/voices' },
  { name: 'Books', href: '/books' },
  { name: 'Contact', href: '/contact' },
  ...[counterfeitsNav, restoredTruthNav].flatMap((sec) =>
    sec.items.map((it, i) => ({ name: it.label, href: it.href, desc: it.desc, ...(i === 0 ? { section: sec.label } : {}) }))
  ),
];

const isActive = (href: string | null) =>
  href !== null && (currentPath === href || (href !== '/' && currentPath.startsWith(href)));

// A section dropdown is "active" if any of its pages is the current path.
const sectionActive = (sec: { items: { href: string }[] }) => sec.items.some((it) => isActive(it.href));

const doctrinesActive = isActive('/doctrines');
const studiesActive = isActive('/blog') || isActive('/peah') || isActive('/trilogies');
---

<header class="site-header sticky top-0 z-50 border-b border-[var(--sand-dark)] dark:border-[rgba(139,125,107,0.25)] backdrop-blur-sm" data-pagefind-ignore>
  <nav class="w-full pl-4 pr-6 md:pl-6 md:pr-10 py-1">
    <div class="flex items-center justify-between">
      <a href="/" class="no-underline group">
        <Logo variant="full" />
      </a>

      <!-- Desktop nav: single right-justified row -->
      <div class="desktop-nav hidden min-[1240px]:flex items-center gap-3">
        <ul class="nav-row">
          {primaryNav.map((item) => (
            item.dropdown === 'section' ? (
              <li class="topics-wrap">
                <button
                  type="button"
                  class:list={['nav-link nav-link--dropdown', sectionActive(item.section) ? 'active' : '']}
                  aria-haspopup="true"
                >
                  {item.name}
                  <span class="caret" aria-hidden="true">▾</span>
                </button>

                <div class="topics-dropdown" role="menu" aria-label={item.section.label}>
                  <div class="topics-column">
                    <div class="topics-section-header">
                      <span class="topics-icon">{item.section.glyph}</span>
                      <span class="topics-section-title">
                        <span class="label">{item.section.label}</span>
                        <span class="sublabel">{item.section.sublabel}</span>
                      </span>
                    </div>
                    <ul class="topics-items">
                      {item.section.items.map((sub) => (
                        <li>
                          <a
                            href={sub.href}
                            class:list={['topics-item', isActive(sub.href) ? 'active' : '']}
                            role="menuitem"
                          >
                            <span class="topics-item-name">{sub.label}</span>
                            <span class="topics-item-desc">{sub.desc}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="topics-footer">
                    <span class="topics-tagline">Separated unto Yahuah</span>
                  </div>
                </div>
              </li>
            ) : item.dropdown === 'doctrines' ? (
              <li class="doctrines-wrap">
                <a
                  href={doctrinesNav.href}
                  class:list={['nav-link nav-link--dropdown', doctrinesActive ? 'active' : '']}
                >
                  {item.name}
                  <span class="caret" aria-hidden="true">▾</span>
                </a>
                <div class="doctrines-dropdown" role="menu" aria-label="Doctrines">
                  {doctrinesNav.items.map((sub) => (
                    <a
                      href={sub.href}
                      class:list={['doctrines-item', isActive(sub.href) ? 'active' : '']}
                      role="menuitem"
                    >
                      <span class="doctrines-item-name">{sub.name}</span>
                      <span class="doctrines-item-sub">{sub.sublabel}</span>
                    </a>
                  ))}
                </div>
              </li>
            ) : item.dropdown === 'studies' ? (
              /* Same hover dropdown as Doctrines, same classes, and now the
                 same sublabel line under each item. */
              <li class="doctrines-wrap">
                <a
                  href={studiesNav.href}
                  class:list={['nav-link nav-link--dropdown', studiesActive ? 'active' : '']}
                >
                  {item.name}
                  <span class="caret" aria-hidden="true">▾</span>
                </a>
                <div class="doctrines-dropdown" role="menu" aria-label="Studies">
                  {studiesNav.items.map((sub) => (
                    <a
                      href={sub.href}
                      class:list={['doctrines-item', isActive(sub.href) ? 'active' : '']}
                      role="menuitem"
                    >
                      <span class="doctrines-item-name">{sub.name}</span>
                      {sub.sublabel && <span class="doctrines-item-sub">{sub.sublabel}</span>}
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class:list={['nav-link', isActive(item.href) ? 'active' : '']}
                >
                  {item.name}
                </a>
              </li>
            )
          ))}
        </ul>
        <div class="nav-icons">
          <button
            data-search-trigger
            aria-label="Open search"
            class="icon-btn"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
          <ThemeToggle />
        </div>
      </div>

      <!-- Mobile: Theme Toggle + Menu Button -->
      <div class="flex items-center gap-2 min-[1240px]:hidden">
        <button
          data-search-trigger
          aria-label="Open search"
          class="p-2 transition-colors hover:bg-[rgba(139,105,20,0.1)] rounded"
          style="color: var(--ink-faded);"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        <ThemeToggle />
        <button
          id="mobile-menu-button"
          class="p-2 text-[var(--ink)] dark:text-[var(--sand-light)]"
          aria-label="Toggle menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden min-[1240px]:hidden mt-3 mb-2">
      <ul class="space-y-2">
        {mobileNav.map((item) => (
          <>
            {item.section && (
              <li class="mobile-section-label">{item.section}</li>
            )}
            <li>
              {item.soon ? (
                <span class="nav-link-mobile nav-link-mobile--soon" aria-disabled="true">
                  {item.name}<span class="topics-soon-tag">Coming Soon</span>
                </span>
              ) : (
                <a
                  href={item.href}
                  class:list={['nav-link-mobile', isActive(item.href) ? 'active' : '']}
                >
                  {item.name}
                  {item.desc && <span class="nav-mobile-desc">{item.desc}</span>}
                </a>
              )}
            </li>
          </>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Mobile menu toggle
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    button?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
    // Desktop Topics dropdown is now CSS-driven via :hover on .topics-wrap —
    // no JS toggle needed.
  });
</script>

<style>
  /* ============================================================
     HEADER GRADIENT — dark logo zone fades to parchment.
     ============================================================ */
  .site-header {
    background: linear-gradient(
      90deg,
      #000000 0%,
      #0f0a04 22%,
      rgba(70, 40, 12, 0.80) 34%,
      rgba(245, 240, 230, 0.98) 46%,
      rgba(245, 240, 230, 0.98) 100%
    );
  }

  :global(.dark) .site-header {
    background: linear-gradient(
      90deg,
      #000000 0%,
      #0f0a04 25%,
      rgba(25, 17, 8, 0.98) 46%,
      rgba(30, 22, 12, 0.98) 100%
    );
  }

  @media (max-width: 900px) {
    .site-header {
      background: linear-gradient(
        90deg,
        #000000 0%,
        #0f0a04 26%,
        rgba(70, 40, 12, 0.80) 44%,
        rgba(245, 240, 230, 0.98) 58%,
        rgba(245, 240, 230, 0.98) 100%
      );
    }
  }

  @media (max-width: 640px) {
    .site-header {
      background: linear-gradient(
        90deg,
        #000000 0%,
        #0f0a04 36%,
        rgba(70, 40, 12, 0.80) 56%,
        rgba(245, 240, 230, 0.98) 72%,
        rgba(245, 240, 230, 0.98) 100%
      );
    }
  }

  /* ============================================================
     PRIMARY NAV ROW
     ============================================================ */
  .nav-row {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  /* Nav links carry a soft cream backdrop so they stay readable
     even when they land over the dark portion of the header gradient.
     The backdrop is invisible against the cream side but creates a
     subtle halo on dark — buttons "make themselves known" either way. */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.95rem;
    color: #2a1a08;
    text-decoration: none;
    font-family: var(--font-display, 'Cinzel', Georgia, serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 4px;
    background: rgba(245, 240, 230, 0.55);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
    text-shadow: 0 0 6px rgba(245, 240, 230, 0.7);
    white-space: nowrap;
  }

  /* Hover + current page: dark brown box, bright gold lettering.
     text-shadow is killed on these states so the gold doesn't pick up
     the cream halo we use for visibility on the resting state. */
  .nav-link:hover,
  .nav-link.active {
    background: #1a0e06;
    color: #f0c450;
    border-color: #a87f1f;
    text-shadow: none;
  }
  .nav-link:hover .caret,
  .nav-link.active .caret {
    color: #f0c450;
    opacity: 1;
  }

  /* Eleven items: the row tightens in even steps (padding, letter-spacing, size)
     as the window narrows, so nothing wraps or clips. Below 1240px the
     hamburger menu takes over — every item is there, none dropped. */
  @media (max-width: 1699px) {
    .nav-row { gap: 0.1rem; }
    .nav-link { padding: 0.45rem 0.42rem; font-size: 0.7rem; letter-spacing: 0.05em; }
    .nav-icons { margin-left: 0.3rem; padding-left: 0.45rem; }
  }
  @media (max-width: 1479px) {
    .nav-link { padding: 0.42rem 0.32rem; font-size: 0.66rem; letter-spacing: 0.04em; }
  }

  .nav-link--dropdown .caret {
    font-size: 0.65rem;
    opacity: 0.7;
    margin-left: 0.1rem;
  }

  :global(.dark) .nav-link {
    color: #ede4cf;
    background: rgba(40, 28, 14, 0.65);
    text-shadow: 0 0 6px rgba(15, 10, 4, 0.8);
  }
  :global(.dark) .nav-link:hover,
  :global(.dark) .nav-link.active {
    background: #0f0a04;
    color: #f0c450;
    border-color: #a87f1f;
    text-shadow: none;
  }

  /* ============================================================
     ICON BUTTONS (search + theme)
     ============================================================ */
  .nav-icons {
    display: flex;
    gap: 0.35rem;
    margin-left: 0.5rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(168, 127, 31, 0.3);
    align-items: center;
  }

  .icon-btn {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1.5px solid rgba(168, 127, 31, 0.3);
    background: rgba(168, 127, 31, 0.08);
    color: #6b4d12;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .icon-btn:hover {
    background: rgba(168, 127, 31, 0.25);
    color: #1a0e06;
    border-color: rgba(168, 127, 31, 0.55);
  }
  :global(.dark) .icon-btn {
    color: #e4bd6a;
    border-color: rgba(212, 165, 49, 0.35);
  }

  /* ============================================================
     TOPICS DROPDOWN
     ============================================================ */
  .topics-wrap {
    position: relative;
  }

  /* ── Doctrines dropdown — same hover/focus mechanism as Topics, one narrow
     column. The label is a real link to /doctrines; hover reveals the two. ── */
  .doctrines-wrap { position: relative; }
  .doctrines-dropdown {
    position: absolute; top: 100%; left: 0; min-width: 16rem; padding: 0.5rem;
    background:
      radial-gradient(ellipse at top, rgba(168, 127, 31, 0.15) 0%, transparent 60%),
      linear-gradient(180deg, #1a0e06 0%, #0d0703 100%);
    border: 1px solid rgba(212, 165, 49, 0.4); border-radius: 8px;
    box-shadow: 0 20px 50px -12px rgba(0,0,0,0.7), 0 0 0 1px rgba(212,165,49,0.1);
    overflow: hidden; z-index: 60;
    visibility: hidden; opacity: 0; transform: translateY(-4px); pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .doctrines-dropdown::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, #d4a531, #f0c450, #d4a531, transparent);
  }
  .doctrines-wrap:hover .doctrines-dropdown,
  .doctrines-wrap:focus-within .doctrines-dropdown,
  .doctrines-dropdown:hover {
    visibility: visible; opacity: 1; transform: translateY(0); pointer-events: auto;
  }
  .doctrines-item {
    display: flex; flex-direction: column; gap: 0.1rem;
    padding: 0.6rem 0.8rem; border-radius: 5px; text-decoration: none; transition: background 0.15s;
  }
  .doctrines-item:hover, .doctrines-item.active { background: rgba(212,165,49,0.12); }
  .doctrines-item-name {
    font-family: var(--font-display, 'Cinzel', Georgia, serif);
    font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #ede4cf;
  }
  .doctrines-item:hover .doctrines-item-name, .doctrines-item.active .doctrines-item-name { color: #f0c450; }
  .doctrines-item-sub {
    font-family: var(--font-body, Georgia, serif); font-size: 0.72rem; font-style: italic;
    color: #a89478; letter-spacing: 0;
  }

  /* Hover-only dropdown. Hidden by default; the parent .topics-wrap
     :hover (or hovering the panel itself) reveals it. We use opacity +
     visibility so the transition stays smooth and the panel stops being
     a click target when closed.

     Panel sits FLUSH against the button (top: 100%, no margin) so there
     is zero dead-zone between the trigger and the panel — the cursor
     moves directly from one hoverable element to the next. */
  .topics-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0;
    width: 23rem;
    /* Nine described links run tall — on a short screen the panel scrolls
       inside itself rather than running off the bottom. */
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 165, 49, 0.4) transparent;
    background:
      radial-gradient(ellipse at top, rgba(168, 127, 31, 0.15) 0%, transparent 60%),
      linear-gradient(180deg, #1a0e06 0%, #0d0703 100%);
    border: 1px solid rgba(212, 165, 49, 0.4);
    border-radius: 8px;
    box-shadow:
      0 20px 50px -12px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(212, 165, 49, 0.1),
      0 4px 20px -4px rgba(212, 165, 49, 0.15);
    overflow-x: hidden;
    z-index: 60;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  /* Hover/focus on the wrap (button + panel are both descendants) keeps
     the panel open. Hovering the panel itself also keeps it open via
     the same selector — once it is visible, .topics-dropdown:hover holds
     it there. */
  .topics-wrap:hover .topics-dropdown,
  .topics-wrap:focus-within .topics-dropdown,
  .topics-dropdown:hover {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Top accent line — the same gold gradient used elsewhere on the site */
  .topics-dropdown::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #d4a531, #f0c450, #d4a531, transparent);
  }

  .topics-column {
    padding: 1.4rem 1.3rem;
  }

  .topics-section-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(212, 165, 49, 0.2);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .topics-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 165, 49, 0.25) 0%, transparent 70%);
    display: flex;
    align-items: center;
