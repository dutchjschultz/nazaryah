---
// Header.astro · 1010 V15 — header rework: seven tabs, panel menus, all read
// from src/data/nav.js (nav-sections.js retired). Top row: Counterfeits ·
// Restored Truth · Torah · Trinity · Berean Studies · Edited After the Cross ·
// Books; far right, smaller: search, About, Contact, theme. Home and About leave
// the row (the logo is home; About rides with Contact). Doctrines is pinned first
// in both the Counterfeits and Restored Truth panels and opens the paired
// /doctrines page. Panels open on hover or click (touch laptops), one at a time;
// Escape or a click outside closes; buttons carry aria-expanded so the row and
// an open panel are keyboard-reachable. More than six links → two columns. Phone:
// logo + menu button only; the menu lists the seven tabs, panels expand in place
// (accordion), search / About / Contact / theme sit at its foot.
// V14 (1008) — the mobile menu opens on its own dark panel (the
// dropdowns' ground) so it reads in light mode, where it sat over the header's
// cream half.
// V13: Topics retired. COUNTERFEITS and RESTORED TRUTH are
// top-level dropdowns of their own (after Doctrines), one column each, every link
// with a one-line description under it. Neither label is a link (Counterfeits no
// longer jumps to /foreign-fire). Links + descriptions come from
// src/data/nav-sections.js. "On These Two" reads The Paper Trail (address
// unchanged). Mobile groups read Counterfeits / Restored Truth, with descriptions.
// Eleven top-level items: the row tightens in two steps (below 1700px, below
// 1480px) rather than wrapping; under 1240px the hamburger menu takes over (it was
// 768px — ten items already overflowed at 1280). The mobile menu now scrolls
// inside itself; inside the sticky header its lower groups were unreachable.
// V12: Doctrines dropdown and mobile menu gain Words Your
// Bible Borrowed (/doctrines/borrowed-words) after The Departure.
// V11: STUDIES is now BEREAN STUDIES (Acts 17:11). The
// label still opens /blog, which now shows all four kinds of reading. The
// dropdown has four items, each with a one-line description under its name
// (the Doctrines sublabel line): Studies (/blog/topics), Pe'ah (/peah),
// Trilogies (/trilogies), Collections (/blog/collections). Mobile lists all four.
// V10: Header.astro · 0929 V10 — BLOG is now STUDIES, a hover dropdown (Studies →
// /blog, Pe'ah — The Corner of the Field → /peah) built on the Doctrines
// dropdown's markup and classes. Reader-facing word only: every address stays
// /blog. Mobile lists both links.
// V9 — Topics → Restored Truth: COSMOLOGY now opens the
// /cosmology section front instead of the study itself (the study moved to
// /cosmology/the-heavens-and-the-earth). Mobile inherits it.
// V8 — Topics → Restored Truth: COSMOLOGY goes live. The
// "coming soon" stub now links to The Heavens and the Earth
// (/blog/the-heavens-and-the-earth), the cosmology page. Same slot, same order;
// mobile inherits it via the ...topicsRestoredTruth.items spread.
// V7 — Topics → Restored Truth: added THE PARABLES
// (/parables), the new section landing. Placed with the live links, above
// Investigations. Mobile inherits it via the ...topicsRestoredTruth.items spread.
// V6 — Topics → Restored Truth: the LIVING TEMPLE "coming
// soon" entry is gone, replaced by INVESTIGATIONS (/investigations). The Living
// Temple is now a live investigation reached from that hub, not a nav stub, and
// the entry sits with the live links, above Cosmology.
// V5 — added "On These Two" (/on-these-two) to Topics →
// Counterfeits; mobile inherits it via the ...topicsForeignFire.items spread.
// V4 — "Scripture Insights" renamed to "Close to the Hip"
// (/close-to-the-hip) in Topics → Restored Truth; mobile inherits from the array.
// V3 — added the entry to Topics → Restored Truth (adjacent to Hidden Gems).
// V2 — DOCTRINES is a hover dropdown (The Old Paths / The Departure); the label
// itself still links to /doctrines.
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { mainNav, utilityNav } from '../data/nav.js';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const matches = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/');

// Within a panel only the most specific match lights up, so /doctrines/borrowed-words
// marks Words Your Bible Borrowed, not Doctrines as well.
const activeHref = (links: { href: string }[]) =>
  links.filter((l) => matches(l.href)).sort((a, b) => b.href.length - a.href.length)[0]?.href;

type NavLink = { label: string; href: string; desc: string; pinned?: boolean };
type Tab = { label: string; href?: string; sublabel?: string; glyph?: string; links?: NavLink[] };

const tabs = (mainNav as Tab[]).map((tab, i) => {
  if (!tab.links) return { ...tab, id: `np-${i}`, active: matches(tab.href!) };
  const current = activeHref(tab.links);
  return {
    ...tab,
    id: `np-${i}`,
    current,
    pinned: tab.links.filter((l) => l.pinned),
    rest: tab.links.filter((l) => !l.pinned),
    twoCol: tab.links.length > 6,
    active: !!current || (tab.href ? matches(tab.href) : false),
  };
});
---

<header class="site-header sticky top-0 z-50 border-b border-[var(--sand-dark)] dark:border-[rgba(139,125,107,0.25)] backdrop-blur-sm" data-pagefind-ignore>
  <nav class="w-full pl-4 pr-6 md:pl-6 md:pr-10 py-1" aria-label="Main">
    <div class="flex items-center justify-between">
      <a href="/" class="no-underline group" aria-label="Nazaryah — home">
        <Logo variant="full" />
      </a>

      <!-- Desktop: one right-justified row of seven tabs, then the utility cluster -->
      <div class="desktop-nav hidden min-[1240px]:flex items-center">
        <ul class="nav-row">
          {tabs.map((tab) =>
            tab.links ? (
              <li class="np-wrap" data-np>
                <button
                  type="button"
                  class:list={['nav-link nav-link--dropdown', tab.active && 'active']}
                  aria-expanded="false"
                  aria-controls={tab.id}
                  data-np-trigger
                >
                  {tab.label}
                  <span class="caret" aria-hidden="true">▾</span>
                </button>
                <div id={tab.id} class:list={['np-panel', tab.twoCol && 'np-panel--two']} data-np-panel>
                  {tab.href ? (
                    <a href={tab.href} class="np-head np-head--link">
                      <span class="np-glyph" aria-hidden="true">{tab.glyph}</span>
                      <span class="np-head-text">
                        <span class="np-head-label">{tab.label}</span>
                        <span class="np-head-sub">{tab.sublabel}</span>
                      </span>
                      <span class="np-head-go" aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <div class="np-head">
                      <span class="np-glyph" aria-hidden="true">{tab.glyph}</span>
                      <span class="np-head-text">
                        <span class="np-head-label">{tab.label}</span>
                        <span class="np-head-sub">{tab.sublabel}</span>
                      </span>
                    </div>
                  )}
                  {tab.pinned.length > 0 && (
                    <ul class="np-pinned">
                      {tab.pinned.map((l) => (
                        <li>
                          <a href={l.href} class:list={['np-item np-item--pinned', tab.current === l.href && 'active']}>
                            <span class="np-item-name">{l.label}</span>
                            {l.desc && <span class="np-item-desc">{l.desc}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                  <ul class="np-items">
                    {tab.rest.map((l) => (
                      <li>
                        <a href={l.href} class:list={['np-item', tab.current === l.href && 'active']}>
                          <span class="np-item-name">{l.label}</span>
                          {l.desc && <span class="np-item-desc">{l.desc}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <div class="np-foot">Separated unto Yahuah</div>
                </div>
              </li>
            ) : (
              <li>
                <a href={tab.href} class:list={['nav-link', tab.active && 'active']}>{tab.label}</a>
              </li>
            )
          )}
        </ul>
        <div class="nav-utility">
          <button data-search-trigger aria-label="Open search" class="icon-btn">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
          {utilityNav.map((u) => (
            <a href={u.href} class:list={['util-link', matches(u.href) && 'active']}>{u.label}</a>
          ))}
          <ThemeToggle />
        </div>
      </div>

      <!-- Phone / narrow: the mark and a menu button, nothing else -->
      <button
        id="mobile-menu-button"
        class="min-[1240px]:hidden p-2 text-[var(--ink)] dark:text-[var(--sand-light)]"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Phone menu: the seven tabs; a panel tab expands in place -->
    <div id="mobile-menu" class="hidden min-[1240px]:hidden mt-3 mb-2">
      <ul class="m-list">
        {tabs.map((tab) =>
          tab.links ? (
            <li class="m-group">
              <button
                type="button"
                class:list={['m-tab', tab.active && 'active']}
                aria-expanded={tab.active ? 'true' : 'false'}
                aria-controls={`m-${tab.id}`}
                data-m-trigger
              >
                {tab.label}
                <span class="m-caret" aria-hidden="true">▾</span>
              </button>
              <ul id={`m-${tab.id}`} class="m-sub" hidden={!tab.active}>
                {tab.href && (
                  <li>
                    <a href={tab.href} class:list={['m-link', currentPath === tab.href && 'active']}>
                      All {tab.label}
                    </a>
                  </li>
                )}
                {tab.links.map((l) => (
                  <li class:list={[l.pinned && 'm-pinned']}>
                    <a href={l.href} class:list={['m-link', tab.current === l.href && 'active']}>
                      {l.label}
                      {l.desc && <span class="m-desc">{l.desc}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="m-group">
              <a href={tab.href} class:list={['m-tab', tab.active && 'active']}>{tab.label}</a>
            </li>
          )
        )}
      </ul>
      <div class="m-utility">
        <button type="button" data-search-trigger class="m-util-link">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Search
        </button>
        {utilityNav.map((u) => (
          <a href={u.href} class="m-util-link">{u.label}</a>
        ))}
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script>
  // Panels: hover (mouse only) or click opens; one open at a time; Escape or a
  // click outside closes. Touch pointers skip the hover path so a tap toggles once.
  const wraps = Array.from(document.querySelectorAll<HTMLElement>('[data-np]'));
  let closeTimer: number | undefined;

  const triggerOf = (w: HTMLElement) => w.querySelector<HTMLButtonElement>('[data-np-trigger]')!;
  const panelOf = (w: HTMLElement) => w.querySelector<HTMLElement>('[data-np-panel]')!;

  function place(w: HTMLElement) {
    // Keep a wide panel on screen: shift it left when it would run off the right edge.
    const panel = panelOf(w);
    panel.style.left = '0px';
    const r = panel.getBoundingClientRect();
    const over = r.right - (document.documentElement.clientWidth - 16);
    if (over > 0) panel.style.left = `${-over}px`;
  }

  function open(w: HTMLElement) {
    window.clearTimeout(closeTimer);
    wraps.forEach((o) => o !== w && close(o));
    if (w.classList.contains('is-open')) return;
    w.classList.add('is-open');
    triggerOf(w).setAttribute('aria-expanded', 'true');
    place(w);
  }
  function close(w: HTMLElement) {
    w.classList.remove('is-open');
    triggerOf(w).setAttribute('aria-expanded', 'false');
  }
  const closeAll = () => wraps.forEach(close);

  wraps.forEach((w) => {
    // A mouse has already opened the panel by hovering, so its click only keeps
    // it open; keyboard and touch clicks toggle.
    let pointer = '';
    triggerOf(w).addEventListener('pointerdown', (e) => { pointer = e.pointerType; });
    triggerOf(w).addEventListener('click', (e) => {
      const byMouse = e.detail > 0 && pointer === 'mouse';
      pointer = '';
      if (byMouse || !w.classList.contains('is-open')) open(w);
      else close(w);
    });
    w.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') open(w);
    });
    w.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      closeTimer = window.setTimeout(() => close(w), 160);
    });
    // Tabbing out of a tab and its panel closes it.
    w.addEventListener('focusout', (e) => {
      const to = (e as FocusEvent).relatedTarget as Node | null;
      if (to && !w.contains(to)) close(w);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openWrap = wraps.find((w) => w.classList.contains('is-open'));
    if (openWrap) {
      close(openWrap);
      triggerOf(openWrap).focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!wraps.some((w) => w.contains(e.target as Node))) closeAll();
  });
  window.addEventListener('resize', () => wraps.filter((w) => w.classList.contains('is-open')).forEach(place));

  // Phone menu and its accordion groups.
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  button?.addEventListener('click', () => {
    const hidden = menu?.classList.toggle('hidden');
    button.setAttribute('aria-expanded', hidden ? 'false' : 'true');
  });
  document.querySelectorAll<HTMLButtonElement>('[data-m-trigger]').forEach((t) => {
    t.addEventListener('click', () => {
      const sub = document.getElementById(t.getAttribute('aria-controls')!);
      const expanded = t.getAttribute('aria-expanded') === 'true';
      t.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (sub) sub.hidden = expanded;
    });
  });
  // Search opens over the page; fold the phone menu away behind it.
  menu?.querySelectorAll('[data-search-trigger]').forEach((s) =>
    s.addEventListener('click', () => {
      menu.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
    })
  );
</script>

<style>
  /* ============================================================
     HEADER GRADIENT — dark logo zone fades to parchment.
     ============================================================ */
  .site-header {
    background: linear-gradient(
      90deg,
      #000000 0%,
      #0f0a04 22%,
      rgba(70, 40, 12, 0.80) 34%,
      rgba(245, 240, 230, 0.98) 46%,
      rgba(245, 240, 230, 0.98) 100%
    );
  }

  :global(.dark) .site-header {
    background: linear-gradient(
      90deg,
      #000000 0%,
      #0f0a04 25%,
      rgba(25, 17, 8, 0.98) 46%,
      rgba(30, 22, 12, 0.98) 100%
    );
  }

  @media (max-width: 900px) {
    .site-header {
      background: linear-gradient(
        90deg,
        #000000 0%,
        #0f0a04 26%,
        rgba(70, 40, 12, 0.80) 44%,
        rgba(245, 240, 230, 0.98) 58%,
        rgba(245, 240, 230, 0.98) 100%
      );
    }
  }

  @media (max-width: 640px) {
    .site-header {
      background: linear-gradient(
        90deg,
        #000000 0%,
        #0f0a04 36%,
        rgba(70, 40, 12, 0.80) 56%,
        rgba(245, 240, 230, 0.98) 72%,
        rgba(245, 240, 230, 0.98) 100%
      );
    }
  }

  /* ============================================================
     PRIMARY NAV ROW
     ============================================================ */
  .nav-row {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: nowrap;
  }

  /* Nav links carry a soft cream backdrop so they stay readable
     even when they land over the dark portion of the header gradient. */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.95rem;
    color: #2a1a08;
    text-decoration: none;
    font-family: var(--font-display, 'Cinzel', Georgia, serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 4px;
    background: rgba(245, 240, 230, 0.55);
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
    text-shadow: 0 0 6px rgba(245, 240, 230, 0.7);
    white-space: nowrap;
  }

  /* Hover, open panel, current page: dark brown box, bright gold lettering. */
  .nav-link:hover,
  .nav-link.active,
  .np-wrap.is-open > .nav-link {
    background: #1a0e06;
    color: #f0c450;
    border-color: #a87f1f;
    text-shadow: none;
  }
  .nav-link:focus-visible { outline: 2px solid #d4a531; outline-offset: 2px; }

  .nav-link--dropdown .caret {
    font-size: 0.65rem;
    opacity: 0.7;
    margin-left: 0.1rem;
    transition: transform 0.18s;
  }
  .np-wrap.is-open .caret { transform: rotate(180deg); opacity: 1; }

  :global(.dark) .nav-link {
    color: #ede4cf;
    background: rgba(40, 28, 14, 0.65);
    text-shadow: 0 0 6px rgba(15, 10, 4, 0.8);
  }
  :global(.dark) .nav-link:hover,
  :global(.dark) .nav-link.active,
  :global(.dark) .np-wrap.is-open > .nav-link {
    background: #0f0a04;
    color: #f0c450;
    border-color: #a87f1f;
    text-shadow: none;
  }

  /* Seven tabs fit easily wide; the row tightens in the same two steps the
     eleven-item row used (no smaller than before) as the window narrows. */
  @media (max-width: 1699px) {
    .nav-row { gap: 0.1rem; }
    .nav-link { padding: 0.45rem 0.55rem; font-size: 0.72rem; letter-spacing: 0.07em; }
  }
  @media (max-width: 1479px) {
    .nav-link { padding: 0.42rem 0.4rem; font-size: 0.68rem; letter-spacing: 0.05em; }
  }

  /* ============================================================
     UTILITY CLUSTER — search, About, Contact, theme (smaller type)
     ============================================================ */
  .nav-utility {
    display: flex;
    gap: 0.2rem;
    margin-left: 0.6rem;
    padding-left: 0.6rem;
    border-left: 1px solid rgba(168, 127, 31, 0.3);
    align-items: center;
  }
  .util-link {
    font-family: var(--font-display, 'Cinzel', Georgia, serif);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b4d12;
    text-decoration: none;
    padding: 0.35rem 0.35rem;
    border-radius: 3px;
    white-space: nowrap;
  }
  .util-link:hover, .util-link.active { color: #1a0e06; background: rgba(168, 127, 31, 0.15); }
  :global(.dark) .util-link { color: #c9a95c; }
  :global(.dark) .util-link:hover, :global(.dark) .util-link.active { color: #f0c450; background: rgba(212, 165, 49, 0.12); }

  .icon-btn {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 1.5px solid rgba(168, 127, 31, 0.3);
    background: rgba(168, 127, 31, 0.08);
    color: #6b4d12;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }
  .icon-btn:hover {
    background: rgba(168, 127, 31, 0.25);
    color: #1a0e06;
    border-color: rgba(168, 127, 31, 0.55);
  }
  :global(.dark) .icon-btn {
    color: #e4bd6a;
    border-color: rgba(212, 165, 49, 0.35);
  }

  /* ============================================================
     PANELS — open on hover or click (script sets .is-open)
     ============================================================ */
  .np-wrap { position: relative; }

  .np-panel {
    position: absolute;
    top: 100%;
    left: 0;
    width: 24rem;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 165, 49, 0.4) transparent;
    background:
      radial-gradient(ellipse at top, rgba(168, 127, 31, 0.15) 0%, transparent 60%),
      linear-gradient(180deg, #1a0e06 0%, #0d0703 100%);
    border: 1px solid rgba(212, 165, 49, 0.4);
    border-radius: 8px;
    box-shadow:
      0 20px 50px -12px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(212, 165, 49, 0.1),
      0 4px 20px -4px rgba(212, 165, 49, 0.15);
    z-index: 60;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }
  .np-panel--two { width: 42rem; }
  .np-wrap.is-open .np-panel {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Top accent line — the site's gold gradient */
  .np-panel::before {
    content: '';
    position: sticky;
    display: block;
    top: 0;
    height: 2px;
    margin-bottom: -2px;
    background: linear-gradient(90deg, transparent, #d4a531, #f0c450, #d4a531, transparent);
  }

  .np-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.2rem 1.3rem 0.6rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(212, 165, 49, 0.2);
    text-decoration: none;
  }
  .np-head--link:hover .np-head-label, .np-head--link:focus-visible .np-head-label { color: #fff1c4; }
  .np-head-go { margin-left: auto; color: #d4a531; font-size: 0.9rem; }
  .np-glyph {
    width: 2rem; height: 2rem; border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 165, 49, 0.25) 0%, transparent 70%);
    display: flex; align-items: center; justify-content: center;
    color: #f0c450; font-size: 1rem; flex-shrink: 0;
  }
  .np-head-text { display: flex; flex-direction: column; }
  .np-head-label {
    font-family: var(--font-display, 'Cinzel', Georgia, serif);
    font-size: 0.85rem; font-weight: 700; color: #f0c450;
    letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.2;
  }
  .np-head-sub {
    font-family: var(--font-family-serif, 'Crimson Text', Georgia, serif);
    font-size: 0.78rem; color: rgba(240, 196, 80, 0.6);
    font-style: italic; margin-top: 2px;
