---
// ReadingSet.astro · 1007 V3
// V3: the panel becomes the TRILOGY panel, reworked to Dutch's notes.
//   - Wider and shorter: the studies sit side by side on desktop (stacked on a
//     phone), with tighter padding top to bottom.
//   - Header names what it is: "A Trilogy" kicker, the trilogy's title, and one
//     standing sentence on what a trilogy is.
//   - No order: no Roman numerals, no "Reading II of III", no "Next" line.
//   - The "Also" line has more presence and reads "Also part of the trilogy",
//     with the other trilogy's title set larger than the words before it.
// V2: a study may sit in more than one set; one panel shows, chosen by ?set=.
// V1: the panel, one set per study.
//
// Shown at the top of every study named in src/data/reading-sets.js, directly
// under the masthead. It is built to look NOTHING like the Quick Read / Full
// Study bar: a dark bound-leather panel with tooled gold rules and the current
// study marked in clay.
//
// MORE THAN ONE TRILOGY: the page still shows ONE panel, the trilogy the reader
// came in through. Every link inside a panel carries ?set=<key>. A reader
// arriving cold sees the first trilogy listed in the data file. The "Also"
// line swaps the panel in place (no reload) and updates the address. Without
// JavaScript the first trilogy shows and the "Also" links still work.
//
// Renders nothing when the study is in no trilogy. Unknown slugs are skipped.
//
// COLOUR NOTE: every colour is declared for light, then restated under
// :global(.dark). Do not lean on var(--token, fallback) here; several site
// tokens have no dark value and the fallback silently wins.

import { getEntry } from 'astro:content';
import { setsFor } from '../data/reading-sets.js';
import { postHref } from '../lib/post-href.js';

const { current } = Astro.props;
const withSet = (href, key) => `${href}${href.includes('?') ? '&' : '?'}set=${key}`;

const sets = current
  ? (
      await Promise.all(
        setsFor(current.slug).map(async (set) => {
          const readings = (
            await Promise.all(
              set.readings.map(async (r) => {
                const entry = await getEntry('posts', r.slug).catch(() => null);
                if (!entry) return null;
                return {
                  title: entry.data.title,
                  href: postHref(entry),
                  line: r.line,
                  here: entry.slug === current.slug,
                };
              }),
            )
          ).filter(Boolean);
          return { ...set, readings };
        }),
      )
    ).filter((s) => s.readings.length > 1 && s.readings.some((r) => r.here))
  : [];
---

{sets.length > 0 && (
  <div class="rs-wrap" data-reading-sets data-pagefind-ignore>
    {sets.map((set, si) => (
      <aside class="rs" aria-label={`Trilogy: ${set.title}`} data-set={set.key} hidden={si > 0}>
        <div class="rs-inner">
          <header class="rs-head">
            <p class="rs-kicker">A Trilogy</p>
            <p class="rs-title">{set.title}</p>
            <p class="rs-intro">Three studies that stand on their own and shed light on one another. Start with any one.</p>
          </header>

          <ul class="rs-list" style={`--rs-cols:${set.readings.length}`}>
            {set.readings.map((r) => (
              <li class={r.here ? 'rs-item rs-here' : 'rs-item'}>
                {r.here && <span class="rs-mark">You are reading</span>}
                {r.here ? (
                  <span class="rs-name" aria-current="page">{r.title}</span>
                ) : (
                  <a class="rs-name" href={withSet(r.href, set.key)}>{r.title}</a>
                )}
                <span class="rs-line">{r.line}</span>
              </li>
            ))}
          </ul>

          {sets.length > 1 && (
            <div class="rs-also">
              {sets.filter((o) => o.key !== set.key).map((o) => (
                <a class="rs-also-link" href={`?set=${o.key}`} data-switch={o.key}>
                  <span class="rs-also-label">Also part of the trilogy</span>
                  <span class="rs-also-title">{o.title}</span>
                  <span class="rs-also-arrow" aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>
    ))}
  </div>
)}

<script>
  // Show the trilogy the reader came in through (?set=key); otherwise the first.
  // The "Also" links swap panels in place and keep the address in step.
  document.querySelectorAll('[data-reading-sets]').forEach((wrap) => {
    const panels = Array.from(wrap.querySelectorAll('[data-set]'));
    const show = (key) => {
      const hit = panels.find((p) => p.dataset.set === key);
      if (!hit) return false;
      panels.forEach((p) => { p.hidden = p !== hit; });
      return true;
    };
    const wanted = new URLSearchParams(location.search).get('set');
    if (wanted) show(wanted);
    wrap.addEventListener('click', (e) => {
      const link = e.target.closest('[data-switch]');
      if (!link) return;
      e.preventDefault();
      if (show(link.dataset.switch)) {
        const url = new URL(location.href);
        url.searchParams.set('set', link.dataset.switch);
        history.replaceState(null, '', url);
      }
    });
  });
</script>

<style>
  .rs {
    margin: 0.25rem auto 1.75rem;
    padding: 5px;
    background: #2a1d10;
    border-radius: 6px;
    box-shadow: 0 6px 22px rgba(43, 29, 17, 0.28);
  }
  .rs[hidden] { display: none; }
  .rs-inner {
    border: 1px solid #8a6520;
    outline: 1px solid rgba(196, 154, 78, 0.35);
    outline-offset: -5px;
    border-radius: 3px;
    padding: 1rem 1.5rem 1.05rem;
  }

  .rs-head { text-align: center; margin: 0 0 0.85rem; }
  .rs-kicker {
    margin: 0;
    font-family: 'Cinzel', serif;
    font-size: 0.66rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #c49a4e;
  }
  .rs-title {
    margin: 0.1rem 0 0;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    line-height: 1.2;
    color: #f0e0bf;
  }
  .rs-intro {
    margin: 0.2rem auto 0;
    max-width: 40rem;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 0.98rem;
    line-height: 1.4;
    color: #c4ad84;
  }

  .rs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--rs-cols, 3), minmax(0, 1fr));
    border-top: 1px solid rgba(196, 154, 78, 0.35);
    border-bottom: 1px solid rgba(196, 154, 78, 0.35);
  }
  .rs-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.2rem;
    padding: 0.75rem 1rem;
    text-align: center;
  }
  .rs-item + .rs-item { border-left: 1px solid rgba(196, 154, 78, 0.35); }
  .rs-name {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 1.08rem;
    font-weight: 600;
    line-height: 1.25;
    color: #f0e0bf;
    text-decoration: none;
  }
  a.rs-name:hover { color: #c49a4e; text-decoration: underline; text-underline-offset: 3px; }
  a.rs-name:focus-visible { outline: 2px solid #c49a4e; outline-offset: 2px; }
  .rs-line {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.35;
    color: #c4ad84;
  }
  .rs-here { background: rgba(160, 69, 28, 0.24); }
  .rs-mark {
    align-self: center;
    margin-bottom: 0.15rem;
    font-family: 'Cinzel', serif;
    font-size: 0.56rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #f0e0bf;
    background: #a0451c;
    border-radius: 3px;
    padding: 0.22rem 0.5rem;
  }

  .rs-also {
    margin: 0.85rem 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .rs-also-link {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 0.6rem;
    padding: 0.45rem 1.1rem;
    border: 1px solid rgba(196, 154, 78, 0.7);
    border-radius: 4px;
    background: rgba(196, 154, 78, 0.08);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .rs-also-label {
    font-family: 'Cinzel', serif;
    font-size: 0.66rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #c4ad84;
  }
  .rs-also-title {
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.2;
    color: #e2b864;
  }
  .rs-also-arrow { font-size: 1.1rem; color: #e2b864; }
  .rs-also-link:hover { border-color: #e2b864; background: rgba(196, 154, 78, 0.18); }
  .rs-also-link:focus-visible { outline: 2px solid #c49a4e; outline-offset: 2px; }

  @media (max-width: 680px) {
    .rs-inner { padding: 0.9rem 0.9rem 0.95rem; }
    .rs-list { grid-template-columns: 1fr; }
    .rs-item { padding: 0.65rem 0.6rem; }
    .rs-item + .rs-item { border-left: 0; border-top: 1px solid rgba(196, 154, 78, 0.35); }
  }

  /* Dark site: the panel lifts one step off the dark page and keeps its gold. */
  :global(.dark) .rs { background: #3a2a18; box-shadow: 0 6px 22px rgba(0, 0, 0, 0.45); }
  :global(.dark) .rs-inner { border-color: #c49a4e; }
  :global(.dark) .rs-title,
  :global(.dark) .rs-name,
  :global(.dark) .rs-mark { color: #f0e0bf; }
  :global(.dark) .rs-intro,
  :global(.dark) .rs-line,
  :global(.dark) .rs-also-label { color: #c4ad84; }
  :global(.dark) .rs-kicker { color: #c49a4e; }
  :global(.dark) .rs-also-title,
  :global(.dark) .rs-also-arrow { color: #e2b864; }
  :global(.dark) .rs-here { background: rgba(160, 69, 28, 0.3); }
</style>
