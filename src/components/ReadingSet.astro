---
// ReadingSet.astro · 1007 V2
// V2: a study may sit in MORE THAN ONE set. The page still shows ONE panel:
// the set the reader came in through. Every link inside a panel carries
// ?set=<key>, so clicking from Reading I of one set lands on Reading II of
// THAT set. A reader arriving from search or a card sees the first set the
// study is listed in. Under the list, an "Also" line names each other set this
// study belongs to, with its reading number; clicking it swaps the panel in
// place (no reload) and updates the address. Without JavaScript the first set
// shows and the "Also" links still work as ordinary links.
// V1: the panel, one set per study.
//
// The Reading Set panel: studies meant to be read together, in order, like
// the lessons of one Bible study. Shown at the top of every study named in a
// set in src/data/reading-sets.js, directly under the masthead.
//
// It is built to look NOTHING like the Quick Read / Full Study bar. That bar is
// light parchment with gold pills; this is a dark bound-leather panel with
// tooled gold rules, Roman-numeral lessons and the current reading marked in
// clay. A reader should see at a glance that this is a course of study, not a
// page control.
//
// Renders nothing when the study is in no set, so every other study is
// untouched. Unknown slugs in the data file are skipped.
//
// COLOUR NOTE: every colour is declared for light, then restated under
// :global(.dark). Do not lean on var(--token, fallback) here; several site
// tokens have no dark value and the fallback silently wins.

import { getEntry } from 'astro:content';
import { setsFor } from '../data/reading-sets.js';
import { postHref } from '../lib/post-href.js';

const { current } = Astro.props;
const NUMERALS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const WORDS = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const num = (n) => NUMERALS[n - 1] ?? String(n);
const withSet = (href, key) => `${href}${href.includes('?') ? '&' : '?'}set=${key}`;

const sets = current
  ? (
      await Promise.all(
        setsFor(current.slug).map(async (set) => {
          const readings = (
            await Promise.all(
              set.readings.map(async (r) => {
                const entry = await getEntry('posts', r.slug).catch(() => null);
                if (!entry) return null;
                return {
                  title: entry.data.title,
                  href: postHref(entry),
                  line: r.line,
                  here: entry.slug === current.slug,
                };
              }),
            )
          ).filter(Boolean);
          const position = readings.findIndex((r) => r.here) + 1;
          return { ...set, readings, position };
        }),
      )
    ).filter((s) => s.readings.length > 1 && s.position > 0)
  : [];
---

{sets.length > 0 && (
  <div class="rs-wrap" data-reading-sets data-pagefind-ignore>
    {sets.map((set, si) => (
      <aside class="rs" aria-label={`Reading set: ${set.title}`} data-set={set.key} hidden={si > 0}>
        <div class="rs-inner">
          <p class="rs-kicker">A Study in {WORDS[set.readings.length] || set.readings.length} Readings</p>
          <p class="rs-title">{set.title}</p>
          <p class="rs-intro">{set.intro}</p>

          <ol class="rs-list">
            {set.readings.map((r, i) => (
              <li class={r.here ? 'rs-item rs-here' : 'rs-item'}>
                <span class="rs-num" aria-hidden="true">{num(i + 1)}</span>
                <span class="rs-body">
                  {r.here ? (
                    <span class="rs-name" aria-current="page">{r.title}</span>
                  ) : (
                    <a class="rs-name" href={withSet(r.href, set.key)}>{r.title}</a>
                  )}
                  <span class="rs-line">{r.line}</span>
                </span>
                {r.here && <span class="rs-mark">You are reading</span>}
              </li>
            ))}
          </ol>

          <p class="rs-foot">
            Reading {num(set.position)} of {num(set.readings.length)}
            {set.position < set.readings.length && (
              <>
                {' · '}
                <a href={withSet(set.readings[set.position].href, set.key)}>Next: {set.readings[set.position].title} &rarr;</a>
              </>
            )}
          </p>

          {sets.length > 1 && (
            <div class="rs-also">
              <span class="rs-also-label">This study is also</span>
              {sets.filter((o) => o.key !== set.key).map((o) => (
                <a class="rs-also-link" href={`?set=${o.key}`} data-switch={o.key}>
                  Reading {num(o.position)} of <em>{o.title}</em> &rarr;
                </a>
              ))}
            </div>
          )}
        </div>
      </aside>
    ))}
  </div>
)}

<script>
  // Show the set the reader came in through (?set=key); otherwise the first.
  // The "Also" links swap panels in place and keep the address in step.
  document.querySelectorAll('[data-reading-sets]').forEach((wrap) => {
    const panels = Array.from(wrap.querySelectorAll('[data-set]'));
    const show = (key) => {
      const hit = panels.find((p) => p.dataset.set === key);
      if (!hit) return false;
      panels.forEach((p) => { p.hidden = p !== hit; });
      return true;
    };
    const wanted = new URLSearchParams(location.search).get('set');
    if (wanted) show(wanted);
    wrap.addEventListener('click', (e) => {
      const link = e.target.closest('[data-switch]');
      if (!link) return;
      e.preventDefault();
      if (show(link.dataset.switch)) {
        const url = new URL(location.href);
        url.searchParams.set('set', link.dataset.switch);
        history.replaceState(null, '', url);
      }
    });
  });
</script>

<style>
  .rs {
    max-width: 46rem;
    margin: 0.5rem auto 2.25rem;
    padding: 6px;
    background: #2a1d10;
    border-radius: 6px;
    box-shadow: 0 6px 22px rgba(43, 29, 17, 0.28);
  }
  .rs-inner {
    border: 1px solid #8a6520;
    outline: 1px solid rgba(196, 154, 78, 0.35);
    outline-offset: -5px;
    border-radius: 3px;
    padding: 1.6rem 1.75rem 1.3rem;
    text-align: center;
  }
  .rs-kicker {
    margin: 0 0 0.35rem;
    font-family: 'Cinzel', serif;
    font-size: 0.68rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #c49a4e;
  }
  .rs-title {
    margin: 0;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    line-height: 1.2;
    color: #f0e0bf;
  }
  .rs-intro {
    margin: 0.35rem 0 1.2rem;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 1rem;
    color: #c4ad84;
  }
  .rs-list {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
    border-top: 1px solid rgba(196, 154, 78, 0.35);
  }
  .rs-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 0.6rem;
    border-bottom: 1px solid rgba(196, 154, 78, 0.35);
  }
  .rs-num {
    flex: 0 0 2.6rem;
    text-align: center;
    font-family: 'Cinzel', serif;
    font-size: 1.15rem;
    color: #c49a4e;
  }
  .rs-body { flex: 1 1 auto; min-width: 0; }
  .rs-name {
    display: block;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: #f0e0bf;
    text-decoration: none;
  }
  a.rs-name:hover { color: #c49a4e; text-decoration: underline; text-underline-offset: 3px; }
  a.rs-name:focus-visible { outline: 2px solid #c49a4e; outline-offset: 2px; }
  .rs-line {
    display: block;
    margin-top: 0.1rem;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-style: italic;
    font-size: 0.95rem;
    color: #c4ad84;
  }
  .rs-here { background: rgba(160, 69, 28, 0.22); }
  .rs-here .rs-num { color: #e08a5c; }
  .rs-mark {
    flex: 0 0 auto;
    font-family: 'Cinzel', serif;
    font-size: 0.58rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #f0e0bf;
    background: #a0451c;
    border-radius: 3px;
    padding: 0.3rem 0.55rem;
  }
  .rs-foot {
    margin: 1rem 0 0;
    font-family: 'Cinzel', serif;
    font-size: 0.64rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #c4ad84;
  }
  .rs-foot a { color: #c49a4e; text-decoration: none; }
  .rs-foot a:hover { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 560px) {
    .rs-inner { padding: 1.3rem 1rem 1.1rem; }
    .rs-item { flex-wrap: wrap; gap: 0.6rem; padding: 0.8rem 0.25rem; }
    .rs-num { flex-basis: 2rem; font-size: 1rem; }
    .rs-body { flex-basis: calc(100% - 2.6rem); }
    .rs-mark { margin-left: 2.6rem; }
  }

  /* Dark site: the panel lifts one step off the dark page and keeps its gold. */
  :global(.dark) .rs { background: #3a2a18; box-shadow: 0 6px 22px rgba(0, 0, 0, 0.45); }
  :global(.dark) .rs-inner { border-color: #c49a4e; }
  :global(.dark) .rs-title,
  :global(.dark) .rs-name,
  :global(.dark) .rs-mark { color: #f0e0bf; }
  :global(.dark) .rs-intro,
  :global(.dark) .rs-line,
  :global(.dark) .rs-foot { color: #c4ad84; }
  :global(.dark) .rs-kicker,
  :global(.dark) .rs-num,
  :global(.dark) .rs-foot a { color: #c49a4e; }
  :global(.dark) .rs-here { background: rgba(160, 69, 28, 0.3); }
  :global(.dark) .rs-here .rs-num { color: #e08a5c; }
  .rs[hidden] { display: none; }
  .rs-also {
    margin: 0.9rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px dashed rgba(196, 154, 78, 0.35);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    font-family: 'Crimson Pro', 'Crimson Text', Georgia, serif;
    font-size: 0.98rem;
  }
  .rs-also-label { color: #c4ad84; font-style: italic; }
  .rs-also-link {
    color: #f0e0bf;
    text-decoration: none;
    border: 1px solid rgba(196, 154, 78, 0.55);
    border-radius: 3px;
    padding: 0.15rem 0.6rem;
  }
  .rs-also-link em { color: #c49a4e; }
  .rs-also-link:hover { border-color: #c49a4e; background: rgba(196, 154, 78, 0.12); }
  .rs-also-link:focus-visible { outline: 2px solid #c49a4e; outline-offset: 2px; }
  :global(.dark) .rs-also-label { color: #c4ad84; }
  :global(.dark) .rs-also-link { color: #f0e0bf; }
  :global(.dark) .rs-also-link em { color: #c49a4e; }
</style>
