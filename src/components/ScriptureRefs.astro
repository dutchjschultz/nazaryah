---
// ScriptureRefs.astro · 0927 V1
// V1: the per-page back-reference (Scripture Index brief, section 6). At the
// foot of a study, the passages that study cites, grouped by book in canonical
// order, each linking to its entry in the Scripture index (/scripture#Gen.1.14).
// Reads the study's own `refs` frontmatter and nothing else; the same printing
// rule as the card Verses lines (src/lib/scripture/printed-refs.js). Renders
// nothing on a study with no refs.
import { BOOK_BY_KEY } from '../lib/scripture/books.js';
import { verseId } from '../lib/scripture/parse-ref.js';
import { printedRefs } from '../lib/scripture/printed-refs.js';

interface Props { refs?: { ref: string; anchor?: string; lead?: boolean }[] }
const { refs = [] } = Astro.props;

// One link per distinct passage, sorted book → chapter → verse → width.
const seen = new Set();
const passages = printedRefs(refs)
  .map(({ p }) => p)
  .filter((p) => (seen.has(p.key) ? false : (seen.add(p.key), true)))
  .sort((a, b) =>
    BOOK_BY_KEY[a.book].order - BOOK_BY_KEY[b.book].order ||
    a.start.c - b.start.c || a.start.v - b.start.v ||
    a.end.c - b.end.c || a.end.v - b.end.v);

const books = [];
for (const p of passages) {
  let g = books[books.length - 1];
  if (!g || g.key !== p.book) books.push((g = { key: p.book, name: BOOK_BY_KEY[p.book].name, items: [] }));
  g.items.push({
    label: p.display.slice(BOOK_BY_KEY[p.book].refName.length + 1),
    full: p.display,
    href: `/scripture#${verseId({ book: p.book, c: p.start.c, v: p.start.v })}`,
  });
}
---

{books.length > 0 && (
  <aside class="srefs" aria-labelledby="srefs-heading">
    <h2 id="srefs-heading" class="srefs-heading">Scripture on This Page</h2>
    <p class="srefs-note">Each reference opens its entry in the <a href="/scripture">Scripture index</a>, with every study that uses it.</p>
    <dl class="srefs-list">
      {books.map((g) => (
        <div class="srefs-row">
          <dt class="srefs-book">{g.name}</dt>
          <dd class="srefs-refs">
            {g.items.map((it, i) => (
              <>{i > 0 && <span class="srefs-sep" aria-hidden="true"> · </span>}<a href={it.href} aria-label={it.full}>{it.label}</a></>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </aside>
)}

<style>
  .srefs {
    margin: 3rem 0 1rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--color-border-strong, #d4cec4);
    border-left: 3px solid var(--gold);
    border-radius: 4px;
    font-family: var(--font-body);
  }
  :global(.dark) .srefs { border-color: var(--color-dark-border-strong); border-left-color: var(--gold-light); }
  .srefs-heading {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 0.3rem;
  }
  :global(.dark) .srefs-heading { color: var(--gold-light); }
  .srefs-note { font-size: 0.9rem; font-style: italic; color: var(--ink-faded); margin: 0 0 0.9rem; }
  :global(.dark) .srefs-note { color: var(--color-dark-secondary-text); }
  .srefs-list { margin: 0; }
  .srefs-row { display: grid; grid-template-columns: minmax(7.5rem, max-content) 1fr; gap: 0.2rem 1rem; padding: 0.3rem 0; border-top: 1px solid var(--color-border, #e8e5df); }
  .srefs-row:first-child { border-top: 0; }
  :global(.dark) .srefs-row { border-top-color: var(--color-dark-border); }
  .srefs-book { font-variant: small-caps; font-weight: 600; letter-spacing: 0.02em; }
  .srefs-refs { margin: 0; line-height: 1.6; }
  .srefs-refs a { color: var(--color-link, #1e4d7b); text-decoration: none; white-space: nowrap; }
  .srefs-refs a:hover { text-decoration: underline; }
  :global(.dark) .srefs-refs a { color: var(--color-dark-link); }
  .srefs-sep { color: var(--ink-faded); }
  @media (max-width: 480px) {
    .srefs-row { grid-template-columns: 1fr; }
  }
</style>
