---
// CollectionCard 1002 V1.astro
// A COLLECTION card on the Studies index (/blog). One per entry in
// src/data/collections.js — adding a collection there adds its card here, with
// no markup change. Same card as a topic card, plus a thin gold border all round
// and a small-caps COLLECTION label. Opens /blog/c/<key>.
// Props: collection (a COLLECTIONS entry), count (live items it holds).
// The count noun is `countNoun` from the entry ([singular, plural]) or "study".
const { collection: c, count } = Astro.props;
const [one, many] = c.countNoun || ['study', 'studies'];
---

<a href={`/blog/c/${c.key}`} class="cc-card">
  <span class="cc-label">Collection</span>
  <span class="cc-name">{c.name}</span>
  <span class="cc-blurb">{c.blurb}</span>
  <span class="cc-count">{count} {count === 1 ? one : many} &rarr;</span>
</a>

<style>
  .cc-card {
    display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; padding: 1.3rem 1.4rem 1.2rem;
    border-radius: 6px; background: #141210; border: 1px solid #c9a961; border-top: 3px solid #c9a961;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .cc-card:hover { transform: translateY(-3px); background: #1b1813; }
  /* The gap under the label is taken back so the title sits where a topic title does. */
  .cc-label { font-family: 'Cinzel', serif; font-size: 0.58rem; letter-spacing: 0.2em; text-transform: uppercase; color: #c9a961; margin-bottom: -0.3rem; }
  .cc-name { font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 1.3rem; color: #f5e6c8; line-height: 1.15; }
  .cc-blurb { font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 0.95rem; line-height: 1.45; color: rgba(232,217,184,0.75); flex: 1; }
  .cc-count { font-family: 'Cinzel', serif; font-size: 0.58rem; letter-spacing: 0.16em; text-transform: uppercase; color: #c9a961; padding-top: 0.5rem; border-top: 1px solid rgba(201,169,97,0.14); }
</style>
