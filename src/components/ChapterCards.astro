---
// Shared chapter-card list for the book intro pages (Five Titles, The Bearer).
// Cards display the MASTER chapter title + topic in chapter order (I -> V) — never
// the blog's own title, never sorted by date. `chapters` items: { num, title, topic, href, desc }.
import { roman } from '../data/books.js';
const { chapters = [] } = Astro.props;
---

<section class="cc-section">
  <div class="cc-grid">
    {chapters.map((ch) => (
      <a href={ch.href} class="cc-card">
        <span class="cc-num">{roman(ch.num)}</span>
        <h2 class="cc-title">{ch.title}<span class="cc-topic"> &mdash; {ch.topic}</span></h2>
        <p class="cc-desc">{ch.desc}</p>
        <span class="cc-read">Read Study &nbsp;&#8594;</span>
      </a>
    ))}
  </div>
</section>

<style>
  .cc-section { padding: 3.5rem 1.5rem; max-width: 860px; margin: 0 auto; }
  .cc-grid { display: grid; gap: 1.5rem; }
  .cc-card {
    display: block;
    background: rgba(30, 18, 8, 0.7);
    border: 1px solid #3a2410;
    border-radius: 4px;
    padding: 1.6rem 2rem 1.8rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .cc-card:hover { border-color: #8a6028; background: rgba(50, 30, 10, 0.7); }
  .cc-num {
    font-family: 'Cinzel', serif;
    font-size: 12px;
    letter-spacing: 3px;
    color: #8a6028;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.5rem;
  }
  .cc-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 600;
    color: #f0e0bf;
    margin: 0 0 0.7rem;
    line-height: 1.3;
  }
  .cc-topic { color: #c4a46b; font-weight: 400; font-style: italic; }
  .cc-desc { font-size: 1rem; color: #b09060; line-height: 1.65; margin: 0 0 1rem; }
  .cc-read {
    font-family: 'Cinzel', serif;
    font-size: 11px;
    letter-spacing: 2px;
    color: #8a6028;
    text-transform: uppercase;
  }
</style>
