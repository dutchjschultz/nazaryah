---
// src/components/StudySeriesPanel.astro · 1023 V2
// V2 (associations batch 72): colours per series (toneOf(group, data)); Ezekiel's
// visions ember, its Read Alongside tiles parchment.
// V1 (associations batch 70): the button panel at the top of a book's Quick Scroll
// study, directly under the masthead. One block per group (a letterspaced header,
// its italic `sub`), then big tiles: `n` large and bold, `title` beneath. Each
// group wears its own colour (toneOf in src/lib/study-series.js): the visions
// night-sky navy with gold, the fasting question burgundy
// with parchment, the burdens bronze with cream. A `soon` item keeps its size and
// colour, faded, dashed, "Coming soon" in place of the title, and is not a link;
// changing its `status` to "live" (with a slug) lights it. Reusable: the series
// data comes from src/lib/study-series.js, so Ezekiel or Daniel only need a data
// file. Deliberately unlike the Quick Read / Full Study toggle and the trilogy
// links: tiles, not text links.
import { seriesFor, toneOf } from '../lib/study-series.js';
interface Props { post: any; }
const { post } = Astro.props;
const data = seriesFor(post);
const show = data && post.slug === data.main;

---
{show && (
  <nav class="ssp" aria-label="Study series" data-pagefind-ignore>
    {data.groups.map((g: any) => {
      const t = toneOf(g, data);
      return (
        <section class:list={['ssp-group', `ssp-${g.key}`, { 'ssp-single': g.items.length === 1 }]}
          style={`--ssp-bg: linear-gradient(160deg, ${t.from}, ${t.to}); --ssp-ink: ${t.ink}; --ssp-edge: ${t.edge};`}>
          <p class="ssp-label">{g.label}</p>
          {g.sub && <p class="ssp-sub">{g.sub}</p>}
          <div class="ssp-tiles">
            {g.items.map((it: any) =>
              it.status === 'live' && it.slug ? (
                <a class="ssp-tile" href={`/blog/${it.slug}`}>
                  <span class="ssp-n">{it.n}</span>
                  <span class="ssp-title">{it.title}</span>
                </a>
              ) : (
                <div class="ssp-tile is-soon" aria-disabled="true">
                  <span class="ssp-n">{it.n}</span>
                  <span class="ssp-title">Coming soon</span>
                </div>
              )
            )}
          </div>
        </section>
      );
    })}
  </nav>
)}

<style>
  .ssp { margin: 0.5rem 0 2.5rem; display: grid; gap: 1.6rem; }
  .ssp-label {
    font-family: var(--font-display); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.24em; text-transform: uppercase; color: var(--deep-earth, #2b1d11); margin: 0;
  }
  .ssp-sub {
    font-family: var(--font-family-serif, var(--font-body)); font-style: italic; font-size: 0.95rem;
    color: var(--ink-faded, #5c4033); margin: 0.15rem 0 0.7rem;
  }
  .ssp-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
  @media (min-width: 768px) { .ssp-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .ssp-single .ssp-tiles { grid-template-columns: minmax(0, 1fr); }

  .ssp-tile {
    display: flex; flex-direction: column; justify-content: center; gap: 0.2rem;
    min-height: 64px; padding: 0.75rem 0.9rem; border-radius: 6px;
    background: var(--ssp-bg); color: var(--ssp-ink); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--ssp-edge) 45%, transparent);
    box-shadow: 0 1px 2px rgba(0,0,0,0.18);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  a.ssp-tile:hover, a.ssp-tile:focus-visible {
    transform: translateY(-2px); border-color: var(--ssp-edge);
    box-shadow: 0 4px 10px rgba(0,0,0,0.22), 0 0 0 1px var(--ssp-edge);
  }
  .ssp-n { font-family: var(--font-display); font-size: 1.12rem; font-weight: 700; line-height: 1.2; }
  .ssp-title { font-family: var(--font-family-serif, var(--font-body)); font-size: 0.92rem; line-height: 1.3; opacity: 0.92; }
  .ssp-tile.is-soon { opacity: 0.4; border: 1px dashed var(--ssp-edge); box-shadow: none; cursor: default; }
</style>
