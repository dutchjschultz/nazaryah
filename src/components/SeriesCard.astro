---
// src/components/SeriesCard.astro · 1011 V1
// V1: the one card every series wears. Replaces HomeCard (the homepage rail's
// card): the look now comes from a skin in src/data/series-skins.js, passed in
// whole, so a new series is a new skin entry and never a new component.
// Top to bottom: glyph, kicker (small caps), title (HTML — an <em> takes the
// skin's italic gold accent), italic deck, call to action, optional date foot.
// `links` (secondary links, side by side under the CTA) turns the card into a
// <div> whose title link stretches over the card, since links cannot nest.

interface Skin {
  background: string;
  glow: string;
  icon: string;
  kicker: string;
  accent: string;
  ctaColor: string;
  topRule?: string;
}
interface Props {
  skin: Skin;
  href: string;
  title: string;
  description?: string;
  cta: string;
  kicker?: string;
  date?: string;
  links?: { label: string; href: string }[];
  class?: string;
}

const { skin, href, title, description, cta, kicker = skin.kicker, date, links, class: extra } = Astro.props;
const vars = [
  `--sc-bg: ${skin.background}`,
  `--sc-glow: ${skin.glow}`,
  `--sc-accent: ${skin.accent}`,
  `--sc-cta: ${skin.ctaColor}`,
  skin.topRule ? `--sc-top: 3px solid ${skin.topRule}` : '',
].filter(Boolean).join('; ');
const Tag = links?.length ? 'div' : 'a';
---

<Tag href={Tag === 'a' ? href : undefined} class:list={['series-card', links?.length && 'series-card--links', extra]} style={vars}>
  <span class="series-card-icon" aria-hidden="true">{skin.icon}</span>
  <div class="series-card-content">
    {kicker && <p class="series-card-kicker">{kicker}</p>}
    <h3 class="series-card-title">
      {Tag === 'div' ? <a href={href} class="series-card-stretch" set:html={title} /> : <Fragment set:html={title} />}
    </h3>
    {description && <p class="series-card-desc">{description}</p>}
  </div>
  <div class="series-card-foot">
    <span class="series-card-cta">{cta} <span aria-hidden="true">→</span></span>
    {links?.length && (
      <span class="series-card-links">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </span>
    )}
    {date && <span class="series-card-date">{date}</span>}
  </div>
</Tag>

<style>
  .series-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 6px;
    border-top: var(--sc-top, 0);
    padding: 1.9rem 1.5rem 1.4rem;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--sc-bg);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .series-card::before {
    content: '';
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    height: 100%;
    background: radial-gradient(ellipse at center, var(--sc-glow) 0%, transparent 60%);
    pointer-events: none;
  }
  .series-card:hover, .series-card:focus-within {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.6);
  }
  .series-card:focus-visible, .series-card-stretch:focus-visible { outline: 2px solid var(--sc-accent); outline-offset: 2px; }

  .series-card-icon {
    font-family: 'Cinzel', serif;
    font-size: 1.5rem;
    color: rgba(212, 175, 55, 0.7);
    z-index: 2;
    height: 2rem;
    line-height: 1;
  }
  .series-card-content { z-index: 2; }
  .series-card-kicker {
    font-family: 'Cinzel', serif;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    color: rgba(212, 175, 55, 0.85);
    margin: 0 0 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
  }
  .series-card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.6rem;
    line-height: 1.1;
    color: #f5e6c8;
    margin: 0 0 0.85rem;
    font-weight: 600;
  }
  .series-card-title :global(em) { font-style: italic; color: #d4af37; }
  .series-card-stretch { color: inherit; text-decoration: none; }
  .series-card-stretch::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .series-card-desc {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(232, 217, 184, 0.82);
    margin: 0;
  }
  .series-card-foot {
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(212, 175, 55, 0.2);
  }
  .series-card-cta, .series-card-date, .series-card-links a {
    font-family: 'Cinzel', serif;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    font-weight: 600;
    text-transform: uppercase;
  }
  .series-card-cta { color: var(--sc-cta); }
  .series-card-date { color: rgba(232, 217, 184, 0.55); letter-spacing: 0.14em; font-variant: small-caps; }
  .series-card-links { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .series-card-links a { color: #e8d9b8; text-decoration: none; border-bottom: 1px solid rgba(212, 175, 55, 0.35); padding-bottom: 1px; }
  .series-card-links a:hover { color: #f0c450; border-bottom-color: #f0c450; }
</style>
