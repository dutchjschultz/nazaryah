---
// src/components/SeriesCard.astro · 1012 V2
// V2 (Homepage Featured and Recent Spec 1012 V3, Part B): the featured card,
// about a third of V1's height so five sit in one row. Top to bottom: the
// category symbol in the skin's accent, the location line in small caps (the
// menu path a reader would follow, from nav.js), the title, the italic deck
// (two lines, then an ellipsis), and a foot row — call to action left, publish
// date right. The background is still the series skin from
// src/data/series-skins.js (house skin for sections without one); the old
// kicker lines and the diamond placeholder are gone. The Doctrines-card mode
// (secondary links) went with the Doctrines card.
// V1: the one card every series wears, extracted from the homepage rail.
import Symbol from './Symbol.astro';

interface Skin {
  background: string;
  glow: string;
  accent: string;
  ctaColor: string;
  topRule?: string;
}
interface Props {
  skin: Skin;
  href: string;
  title: string;
  description?: string;
  cta: string;
  date?: string;
  location?: string[];
  symbol?: string;
}

const { skin, href, title, description, cta, date, location = [], symbol } = Astro.props;
const vars = [
  `--sc-bg: ${skin.background}`,
  `--sc-glow: ${skin.glow}`,
  `--sc-accent: ${skin.accent}`,
  `--sc-cta: ${skin.ctaColor}`,
  skin.topRule ? `--sc-top: 2px solid ${skin.topRule}` : '',
].filter(Boolean).join('; ');
---

<a href={href} class="series-card" style={vars}>
  <div class="series-card-head">
    {symbol && <span class="series-card-symbol"><Symbol name={symbol} size="1.05rem" /></span>}
    {location.length > 0 && (
      <p class="series-card-loc">
        {location.map((part, i) => (
          <>{i > 0 && <span class="series-card-chev" aria-hidden="true"> › </span>}{part}</>
        ))}
      </p>
    )}
  </div>
  <h3 class="series-card-title">{title}</h3>
  {description && <p class="series-card-desc">{description}</p>}
  <div class="series-card-foot">
    <span class="series-card-cta">{cta} <span aria-hidden="true">→</span></span>
    {date && <span class="series-card-date">{date}</span>}
  </div>
</a>

<style>
  .series-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    box-sizing: border-box;
    padding: 0.95rem 1rem 0.85rem;
    border-radius: 6px;
    border-top: var(--sc-top, 0);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: var(--sc-bg);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .series-card::before {
    content: '';
    position: absolute;
    top: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    height: 100%;
    background: radial-gradient(ellipse at center, var(--sc-glow) 0%, transparent 60%);
    pointer-events: none;
  }
  .series-card:hover, .series-card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
    outline: none;
  }
  .series-card:focus-visible { box-shadow: 0 0 0 2px var(--sc-accent), 0 14px 30px rgba(0, 0, 0, 0.5); }

  .series-card-head { position: relative; display: flex; align-items: center; gap: 0.45rem; min-height: 1.1rem; }
  .series-card-symbol { display: inline-flex; flex: none; color: var(--sc-accent); }
  .series-card-loc {
    margin: 0;
    font-family: 'Cinzel', serif;
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.35;
    color: rgba(212, 175, 55, 0.85);
  }
  .series-card-chev { color: rgba(232, 217, 184, 0.45); }
  .series-card-title {
    position: relative;
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    color: #f5e6c8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .series-card:hover .series-card-title { color: #f0c450; }
  .series-card-desc {
    position: relative;
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 0.86rem;
    line-height: 1.35;
    color: rgba(232, 217, 184, 0.78);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .series-card-foot {
    position: relative;
    margin-top: auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(212, 175, 55, 0.18);
  }
  .series-card-cta, .series-card-date {
    font-family: 'Cinzel', serif;
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .series-card-cta { color: var(--sc-cta); }
  .series-card-date { color: rgba(232, 217, 184, 0.55); }
</style>
