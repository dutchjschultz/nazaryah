---
// StackUpIndex 1114 V3.astro
// V3 (Dutch 1114): `sets={false}` shows the Religion Overviews only (the
// Counterfeit front page, where the sets became one card).
// V2 (Dutch 1114): each set card leads with the plain doctrine name (Tongue
// Talking) as the big line, then its Old Paths title (A Pure Lip) as a
// subtitle, then the catchphrase in small italic, then the count. From
// headOf() in src/data/stackup.js.
// V1 (Counterfeit Section Load 1110 V1): the religion overviews, then all 25
// Stack Up sets in Old Paths order (number, title, how many religions answer).
// Used on /counterfeit (with `more`, a link to the Stack Up landing page) and on
// /counterfeit/stack-up itself. Must sit inside a .su wrapper.
import '../../styles/stackup.css';
import { stackup, setHref, liveAnswers, headOf } from '../../data/stackup.js';
import { overviews, religion } from '../../data/counterfeit.js';

interface Props { more?: boolean; heading?: boolean; sets?: boolean }
const { more = false, heading = true, sets = true } = Astro.props;
const count = (d: any) => {
  const n = liveAnswers(d).length;
  return n === 5 ? 'All five religions' : n === 1 ? 'One religion answers' : `${n} of five religions`;
};
---

<div class="su-index">
  <h2 class="su-index-h">Religion Overviews</h2>
  <p class="su-index-sub">One study per religion, measuring it against the Law.</p>
  <div class="su-overviews">
    {overviews().map((o) => (
      <a class="su-ov" href={o.href}><b>{religion(o.religion).name}</b><span>{o.title}</span></a>
    ))}
  </div>

  {sets && <>
  {heading && <h2 class="su-index-h">How the Five Religions Stack Up</h2>}
  <p class="su-index-sub">Every Old Paths doctrine, and how Islam, Judaism, Hinduism, Buddhism and Christianity each answer it.</p>
  <ol class="su-sets">
    {stackup.map((d) => (
      <li>
        <a class="su-set" href={setHref(d)}>
          <span class="su-set-n">{d.n}</span>
          <span><span class="su-set-t">{headOf(d).name}</span><span class="su-set-s">{headOf(d).title}</span><span class="su-set-d">{headOf(d).deck}</span><span class="su-set-c">{count(d)}</span></span>
        </a>
      </li>
    ))}
  </ol>
  {more && <p class="su-index-more"><a href="/counterfeit/stack-up">Open How the Five Religions Stack Up →</a></p>}
  </>}
</div>
