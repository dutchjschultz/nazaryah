---
// src/components/RecentStudies.astro · 1021 V1
// V1 (Recently Added Strip brief 1021 V2): the five most recently added studies,
// one row, on the Berean Studies page between the All Studies box and "Studies ·
// browse by topic". Built from the same study data as the archive (posts in the
// feed, not drafts); nothing is hand-kept, and it rebuilds on every deploy.
//   Order — newest `date` first; studies sharing a date are ordered by when their
//   file first entered the repo (git), newest first, else by title.
//   Card — category tag (the study's group name), reference, title, deck, and a
//   reading time (words ÷ 200, rounded up). No date shows anywhere on the card.
//   Reference — the study's `verse` field; failing that, the first Scripture
//   citation in parentheses in its body, e.g. "(Deuteronomy 28:58)".
//   Reading time — of the body a reader lands on: a Quick Read / Full Study page
//   counts its Quick Read.
// Look: one gold-dim hairline box with a faint gold wash; dashed-edge cards with
// a solid gold tag, smaller than the topic cards; hover turns the edge solid
// gold with a slight lift. Below 900px, a sideways swipe strip that snaps.
import { getCollection } from 'astro:content';
import { execSync } from 'node:child_process';
import { BLOG_GROUPS, groupOf, inFeed } from '../data/blog-groups.js';
import { postHref } from '../lib/post-href.js';

const COUNT = 5;
const posts = (await getCollection('posts', ({ data }) => data.draft !== true)).filter(inFeed);
const groupName = Object.fromEntries(BLOG_GROUPS.map((g) => [g.key, g.name]));

// When a study's file first entered the repo (seconds), to order a shared date.
const added = (p) => {
  try {
    const out = execSync(`git log --diff-filter=A --follow --format=%ct -- "src/content/posts/${p.id}"`, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim().split('\n').pop();
    return Number(out) || 0;
  } catch { return 0; }
};

const day = (p) => p.data.date.valueOf();
const byDate = [...posts].sort((a, b) => day(b) - day(a));
// Only the studies that could make the five need a git lookup.
const cutoff = byDate[COUNT - 1] ? day(byDate[COUNT - 1]) : 0;
const pool = byDate.filter((p) => day(p) >= cutoff).map((p) => ({ p, t: added(p) }));
pool.sort((a, b) => day(b.p) - day(a.p) || b.t - a.t || a.p.data.title.localeCompare(b.p.data.title));

// The body a reader lands on: a StudyModes page's Quick Read slot, else the whole body.
const landingBody = (body) => {
  const quick = body.match(/<div slot="quick">([\s\S]*?)<\/div>\s*<div slot="full">/);
  return quick ? quick[1] : body;
};
const words = (text) => text
  .replace(/^import .*$/gm, '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/[#>*_`[\]()|-]/g, ' ')
  .split(/\s+/).filter(Boolean).length;
const minutes = (p) => Math.max(1, Math.ceil(words(landingBody(p.body)) / 200));

const BOOK = String.raw`(?:[1-3] )?[A-Z][a-z]+(?: of [A-Z][a-z]+)?`;
const CITE = new RegExp(String.raw`\((${BOOK} \d+:\d+(?:[-–]\d+)?(?:, ?\d+)*)`);
const reference = (p) => p.data.verse || p.body.match(CITE)?.[1] || '';

const cards = pool.slice(0, COUNT).map(({ p }) => ({
  href: postHref(p),
  tag: groupName[groupOf(p.slug)] || p.data.category || '',
  ref: reference(p),
  title: p.data.title,
  deck: p.data.deck || p.data.subtitle || '',
  read: `${minutes(p)} min read`,
}));
---

{cards.length > 0 && (
  <section class="rs-strip" aria-labelledby="rs-strip-h">
    <div class="rs-strip-head">
      <h2 id="rs-strip-h" class="rs-strip-label">Recently Added</h2>
      <a class="rs-strip-all" href="/blog/all">See all &rarr;</a>
    </div>
    <div class="rs-strip-row">
      {cards.map((c) => (
        <a class="rs-card" href={c.href}>
          <span class="rs-tag">{c.tag}</span>
          {c.ref && <span class="rs-ref">{c.ref}</span>}
          <span class="rs-title">{c.title}</span>
          <span class="rs-deck">{c.deck}</span>
          <span class="rs-read">{c.read}</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .rs-strip {
    margin: 0 0 2.5rem; padding: 1.1rem 1.1rem 1.25rem;
    border: 1px solid rgba(184,145,80,0.32); border-radius: 6px; background: rgba(184,149,90,0.03);
  }
  .rs-strip-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin: 0 0 0.9rem; padding: 0 0.25rem; }
  .rs-strip-label { margin: 0; font-family: 'Cinzel', serif; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.26em; text-transform: uppercase; color: #c9a961; }
  .rs-strip-all { font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: #a09078; text-decoration: none; white-space: nowrap; }
  .rs-strip-all:hover, .rs-strip-all:focus-visible { color: #d4af37; }

  .rs-strip-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; }
  .rs-card {
    display: flex; flex-direction: column; min-width: 0; text-decoration: none;
    padding: 0.85rem 0.85rem 0.75rem; border-radius: 4px;
    background: #1a1611; border: 1px dashed rgba(184,145,80,0.42);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .rs-card:hover, .rs-card:focus-visible { border-style: solid; border-color: #c9a961; transform: translateY(-2px); outline: none; }
  .rs-tag {
    align-self: flex-start; max-width: 100%; margin-bottom: 0.6rem; padding: 0.15rem 0.45rem; border-radius: 2px;
    font-family: 'Cinzel', serif; font-size: 0.52rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; line-height: 1.3;
    color: #0b0b0b; background: #c9a961;
  }
  .rs-ref { font-family: 'Cormorant Garamond', Georgia, serif; font-variant: small-caps; letter-spacing: 0.06em; font-size: 0.9rem; color: #c9a961; }
  .rs-title { margin: 0.2rem 0 0.35rem; font-family: 'Playfair Display', Georgia, serif; font-style: italic; font-size: 1.05rem; line-height: 1.22; color: #f5e6c8; }
  .rs-deck { flex: 1; font-family: 'Cormorant Garamond', Georgia, serif; font-style: italic; font-size: 0.92rem; line-height: 1.3; color: #a09078; }
  .rs-read {
    margin-top: 0.65rem; padding-top: 0.5rem; border-top: 1px solid rgba(184,145,80,0.25);
    font-family: 'Cinzel', serif; font-size: 0.54rem; letter-spacing: 0.14em; text-transform: uppercase; color: #a09078;
  }

  /* Below 900px: a sideways swipe strip, about one and a half cards in view. */
  @media (max-width: 900px) {
    .rs-strip-row {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 64%;
      overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; padding-bottom: 0.4rem;
    }
    .rs-card { scroll-snap-align: start; }
  }
  @media (prefers-reduced-motion: reduce) { .rs-card, .rs-card:hover { transition: none; transform: none; } }
</style>
