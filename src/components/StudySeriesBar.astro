---
// src/components/StudySeriesBar.astro · 1023 V2
// V2 (associations batch 72): Previous / Next run through the series' own companions
// only (not its Read Alongside studies); colours per series.
// V1 (associations batch 70): the slim bar under the masthead of each companion
// study in a book study series. "Part of <main title>" (linked to the Quick
// Scroll), the item's place ("Vision 1 of 8" when its `n` is a counted run, else
// `n` as given), and Previous / Next in data-file order, skipping `soon` items.
// Wears the group's colour (toneOf, the panel's palette), so a reader sees which
// part of the book they are in. Nothing on a post outside a series, or on the main.
import { getCollection } from 'astro:content';
import { seriesFor, isSeriesCompanion, placeOf, toneOf } from '../lib/study-series.js';
interface Props { post: any; }
const { post } = Astro.props;
const data = isSeriesCompanion(post) ? seriesFor(post) : null;
const posts = data ? await getCollection('posts') : [];
const place = data ? placeOf(data, post.slug, posts) : null;
const main = place ? posts.find((p) => p.slug === data.main) : null;

const t = place ? toneOf(place.group, data) : null;
// "Vision 1" -> "Vision 1 of 8"; other labels stand as written.
const where = place
  ? (/^\S+ \d+$/.test(place.item.n) ? `${place.item.n} of ${place.group.items.length}` : place.item.n)
  : '';
---
{place && main && (
  <nav class="ssb" aria-label="Study series" data-pagefind-ignore
    style={`--ssb-bg: linear-gradient(100deg, ${t.from}, ${t.to}); --ssb-ink: ${t.ink}; --ssb-edge: ${t.edge};`}>
    <p class="ssb-part">
      Part of <a href={`/blog/${main.slug}`}><em>{main.data.title}</em></a>
      <span class="ssb-where">{where}</span>
    </p>
    <p class="ssb-steps">
      {place.prev
        ? <a class="ssb-btn" href={`/blog/${place.prev.item.slug}`}>&larr; Previous</a>
        : <span class="ssb-btn is-off">&larr; Previous</span>}
      {place.next
        ? <a class="ssb-btn" href={`/blog/${place.next.item.slug}`}>Next &rarr;</a>
        : <span class="ssb-btn is-off">Next &rarr;</span>}
    </p>
  </nav>
)}

<style>
  .ssb {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem;
    margin: 0.25rem 0 2rem; padding: 0.6rem 0.9rem; border-radius: 6px;
    background: var(--ssb-bg); color: var(--ssb-ink);
    border: 1px solid color-mix(in srgb, var(--ssb-edge) 45%, transparent);
  }
  .ssb p { margin: 0; }
  .ssb-part { font-family: var(--font-family-serif, var(--font-body)); font-size: 0.98rem; }
  .ssb-part a { color: inherit; text-decoration: underline; text-decoration-color: var(--ssb-edge); text-underline-offset: 3px; }
  .ssb-part em { font-style: italic; }
  .ssb-where {
    margin-left: 0.7rem; font-family: var(--font-display); font-size: 0.68rem; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; white-space: nowrap;
  }
  .ssb-steps { display: flex; gap: 0.5rem; }
  .ssb-btn {
    font-family: var(--font-display); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: inherit; text-decoration: none; white-space: nowrap;
    padding: 0.35rem 0.7rem; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--ssb-edge) 60%, transparent);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  a.ssb-btn:hover, a.ssb-btn:focus-visible { border-color: var(--ssb-edge); transform: translateY(-1px); }
  .ssb-btn.is-off { opacity: 0.4; }
</style>
