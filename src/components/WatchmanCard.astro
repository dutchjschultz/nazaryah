---
// src/components/WatchmanCard.astro · 0804 V2
// Shared Watchman's Desk card — used by the homepage featured band AND the
// archive list. The header pill and the status line resolve from the CLOSED
// KINDS / STATUSES maps in the data file; nothing here is hand-written per card.
//   variant "featured" = half-width band card: title + deck + first body
//                        paragraph clamped to 3 lines, cream strip pinned to the
//                        card bottom so paired cards align (equal-height columns).
//   variant "archive"  = full-width card: eyebrow + title + deck + first body
//                        paragraph clamped to 3 lines.
import { KINDS, STATUSES } from '../data/watchmans-desk.js';

interface Props {
  entry: any;
  variant?: 'featured' | 'archive';
  showArchiveLink?: boolean; // featured band only — the "Browse the archive" button in the strip
}
const { entry, variant = 'archive', showArchiveLink = false } = Astro.props;
const { kind, status, date, eyebrow, title, deck, body, source, companionStudy, slug } = entry;
const st = STATUSES[status];

// Entry has its own reader page? (letters do; field briefs point at a study.)
const hasPage = kind === 'weekly-letter' || kind === 'open-letter';
const pageUrl = `/watchmans-desk/${slug}`;

// Companion strip, pinned to the card bottom: entries with their own reader page
// (letters — weekly AND open) link to it; linked field briefs point at the study.
const strip =
  hasPage
    ? { label: 'Read the letter', url: pageUrl, sub: null }
    : source === 'linked'
      ? { label: 'Read the full study', url: companionStudy.url, sub: companionStudy.title }
      : null;
---

<article class={`wc-card wc-${variant} wc-band-${st.band}`}>
  <div class="wc-head">
    <span class="wc-pill">{KINDS[kind]}</span>
    <span class="wc-status">{st.label} &middot; {date}</span>
  </div>

  <div class="wc-body">
    {variant === 'archive' && eyebrow && <p class="wc-eyebrow">{eyebrow}</p>}
    <h3 class="wc-title">{hasPage ? <a href={pageUrl}>{title}</a> : title}</h3>
    <p class="wc-deck">{deck}</p>
    <p class="wc-teaser">{body}</p>
  </div>

  {strip && (
    <div class="wc-strip">
      <div class="wc-strip-row">
        <a class="wc-strip-link" href={strip.url}>{strip.label} &rarr;</a>
        {showArchiveLink && (
          <a class="wc-archive-btn" href="/watchmans-desk">Browse the archive &rarr;</a>
        )}
      </div>
      {strip.sub && <a class="wc-strip-sub" href={strip.url}>{strip.sub}</a>}
    </div>
  )}
</article>

<style>
  .wc-card {
    --navy: #0a1d3a; --navy-deep: #061230;
    --gold: #c9a961; --gold-deep: #7f6327;
    --red: #b8232a; --red-deep: #6e1418;
    --charcoal: #17140f; --charcoal-deep: #000000;
    --cream: #f5f1e6; --parchment: #ebe3cf; --ink: #26241f; --ink-soft: #3a3a3a;

    background: #fff;
    border: 1px solid var(--navy);
    box-shadow: 0 4px 16px rgba(10,29,58,0.12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: Georgia, 'Times New Roman', serif;
  }

  /* ── Header band — pill (kind) + status·date. Colour driven by status only. ── */
  .wc-head {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 9px 18px;
  }
  .wc-band-navy     .wc-head { background: var(--navy);     color: var(--cream); }
  .wc-band-red      .wc-head { background: var(--red);      color: var(--cream); }
  .wc-band-charcoal .wc-head { background: var(--charcoal); color: var(--cream); }
  .wc-band-gold     .wc-head { background: var(--gold);     color: var(--navy-deep); }

  /* Pill — solid darker block of the band colour, cream text (all bands match). */
  .wc-pill {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
    font-size: 0.56rem; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
    color: var(--cream); padding: 3px 9px; border-radius: 3px; white-space: nowrap;
  }
  .wc-band-navy     .wc-pill { background: var(--navy-deep); }
  .wc-band-red      .wc-pill { background: var(--red-deep); }
  .wc-band-charcoal .wc-pill { background: var(--charcoal-deep); }
  .wc-band-gold     .wc-pill { background: var(--gold-deep); }

  .wc-status {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif;
    font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
    text-align: right;
  }

  /* ── Body ── */
  .wc-body { padding: 1.4rem 1.6rem 1.4rem; flex: 1; }
  .wc-eyebrow {
    font-family: 'Times New Roman', Georgia, serif; font-size: 0.7rem; letter-spacing: 0.2em;
    text-transform: uppercase; color: #6e5a3f; font-weight: 700; margin: 0 0 0.6rem;
  }
  .wc-title {
    font-family: 'Playfair Display', 'Cinzel', Georgia, serif; font-weight: 800;
    color: var(--navy-deep); line-height: 1.15; margin: 0 0 0.7rem; text-wrap: balance;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
  }
  .wc-title a { color: inherit; text-decoration: none; }
  .wc-title a:hover { color: var(--red-deep); }
  .wc-deck { font-style: italic; font-size: 1.02rem; line-height: 1.55; color: var(--ink-soft); margin: 0; }
  /* Teaser — first body paragraph, clamped to 3 lines (both variants). */
  .wc-teaser {
    font-size: 0.98rem; line-height: 1.6; color: var(--ink-soft); margin: 0.7rem 0 0;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden;
  }

  /* ── Companion strip — parchment, red left bar, flush to the bottom, full width. ── */
  .wc-strip { background: var(--parchment); border-left: 4px solid var(--red); padding: 0.7rem 1rem; }
  .wc-strip-row {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
  }
  .wc-strip-link {
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif; font-size: 0.72rem; letter-spacing: 0.14em;
    text-transform: uppercase; font-weight: 700; color: var(--red-deep); text-decoration: none;
    transition: color 0.2s ease;
  }
  .wc-strip-link:hover { color: var(--navy-deep); }
  .wc-strip-sub {
    display: block; margin-top: 5px; font-family: Georgia, serif; font-style: italic;
    font-size: 0.88rem; color: var(--ink-soft); text-decoration: none;
  }
  .wc-strip-sub:hover { color: var(--red-deep); }
  /* Archive button — dark red block, sized to content, right of the strip row. */
  .wc-archive-btn {
    display: inline-block; padding: 0.5rem 1rem; border-radius: 3px;
    font-family: 'Cinzel', 'Playfair Display', Georgia, serif; font-size: 0.7rem; letter-spacing: 0.2em;
    text-transform: uppercase; font-weight: 700; text-decoration: none;
    color: var(--cream); background: var(--red-deep); border: 1px solid var(--red);
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .wc-archive-btn:hover { background: var(--navy-deep); border-color: var(--gold); }

  @media (max-width: 640px) { .wc-body { padding: 1.25rem 1.25rem; } }
</style>
