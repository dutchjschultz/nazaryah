---
// src/components/DoctrinePageV2.astro · 1022 V4
// V4 (Tribulation / Rapture / Millennium briefs 1022): a pair with a `group` is
// one of a series ("Revelation · 2 of 3", counted as DoctrineGrid counts the card
// eyebrow). Both foot rows gain the neighbours: the Old Path's "← Revelation 1 of
// 3: <Old Path title>" before All The Old Paths and "Revelation 3 of 3: … →" after;
// the Departure's the same pair, with Departure titles, after the riddle link.
// The series words in the kickers are the content's own (doctrine-v2.js).
// V3 (Hell Doctrine V2 brief 1022 V4): the Go Deeper strip (DoctrineStudies,
// filled from each study's `doctrines` tag) on both pages: Old Path after the
// Torah / Second Witness lines, before the turn box; Departure after The Old
// Path, in place of the hand-typed Further Reading. Greek Influence moves to
// the Departure foot.
// V2 (Hell Doctrine V2 brief 1022 V2): the Departure's open word cards are gone.
// Where It Came From is two paragraphs, then the words as tabs through the
// existing DoctrineTabs (bare: no opening or close of its own; warmGreek: the
// "What the Greek brought in" heading in the warm red), Hadēs open by default,
// every tab carrying every section. Then The Old Path, further reading, foot.
// V1 (Hell Doctrine V2 brief 1022 V1): the trial doctrine layout, beside
// DoctrineInfo (the classic layout), never replacing it. A pair reaches it only
// when doctrines.data.js sets `layout: "v2"` AND src/data/doctrine-v2.js holds
// its content; the routes check both. One template for both halves, `side`
// picks which:
//   old-paths  numbered sections, the keepers list, the closing paragraph, the
//              Torah / Second Witness lines, and the red turn box that hands the
//              reader to the Departure (it replaces "Where the church departed").
//   departure  the StandingStone banner (as on every Departure page), What You
//              Were Taught, Where It Came From and the word tabs, the green-edged
//              Old Path close, the Go Deeper strip and the foot.
// The riddle line keeps its place at the foot of both pages.
import StandingStone from './StandingStone.astro';
import DoctrineTabs from './DoctrineTabs.astro';
import DoctrineStudies from './DoctrineStudies.astro';
import { riddlesForDoctrine } from '../data/riddles.js';
import { v2For } from '../data/doctrine-v2.js';
import { doctrines as PAIRS } from '../data/doctrines.data.js';
interface Props { side: 'old-paths' | 'departure'; pair: any; }
const { side, pair } = Astro.props;
const isOld = side === 'old-paths';
const v2 = v2For(pair);
const op = v2.oldPaths;
const dp = v2.departure;
const riddle = riddlesForDoctrine(pair.n)[0];
const oldHref = `/doctrines/old-paths/${pair.oldPaths.slug}`;
const depHref = `/doctrines/the-departure/${pair.departure.slug}`;
const greekHref = `/doctrines/borrowed-words#d-${pair.departure.slug}`;
// Series neighbours (empty when the pair has no group).
const members = pair.group ? PAIRS.filter((p: any) => p.group === pair.group) : [];
const pos = members.findIndex((p: any) => p.n === pair.n);
const seriesName = pair.group ? pair.group.charAt(0).toUpperCase() + pair.group.slice(1) : '';
const step = (d: number) => {
  const p = pos >= 0 ? members[pos + d] : undefined;
  return p && { p, label: `${seriesName} ${pos + d + 1} of ${members.length}` };
};
const prev = step(-1);
const next = step(1);
---

<div class="d2-page">
<article class="d2">
  {isOld ? (
    <>
      <p class="d2-kicker">{op.kicker}</p>
      <h1 class="d2-title">{op.title}</h1>
      <p class="d2-sub">{op.subtitle}</p>

      {op.sections.map((s: any, i: number) => (
        <section class="d2-sec">
          <h2 class="d2-h2"><span class="d2-step">{i + 1}</span>{s.title}</h2>
          {s.paras?.map((p: string) => <p set:html={p} />)}
          {s.keepers && (
            <ul class="d2-keepers">
              {s.keepers.map(([who, what]: [string, string]) => (
                <li><b>{who}</b> — <span set:html={what} /></li>
              ))}
            </ul>
          )}
        </section>
      ))}

      <p class="d2-closing" set:html={op.closing} />

      <div class="d2-verses">
        <div><span class="d2-vlabel">Torah</span>{op.torah.join('  ·  ')}</div>
        <div><span class="d2-vlabel">Second Witness</span>{op.witness.join('  ·  ')}</div>
      </div>

      <DoctrineStudies slug={pair.departure.slug} name={pair.departure.title} />

      <div class="d2-turn">
        <p>{op.turn.text}</p>
        <a href={depHref}>{op.turn.label} <span aria-hidden="true">&rarr;</span></a>
      </div>

      <p class="d2-back">
        {prev && <a href={`/doctrines/old-paths/${prev.p.oldPaths.slug}`}>&larr; {prev.label}: {prev.p.oldPaths.title}</a>}
        <a href="/doctrines/old-paths">&larr; All The Old Paths</a>
        {next && <a href={`/doctrines/old-paths/${next.p.oldPaths.slug}`}>{next.label}: {next.p.oldPaths.title} <span aria-hidden="true">&rarr;</span></a>}
      </p>
      {riddle && <p class="d2-riddle"><a href={riddle.href}>Test it yourself <span aria-hidden="true">&rarr;</span> Try the riddle</a></p>}
    </>
  ) : (
    <>
      <StandingStone />
      <p class="d2-kicker">{dp.kicker}</p>
      <h1 class="d2-title">{dp.title}</h1>
      <p class="d2-sub">{dp.subtitle}</p>
      <p class="d2-attrib">{dp.attribution}</p>

      <section class="d2-sec">
        <h2 class="d2-h2"><span class="d2-step">1</span>What You Were Taught</h2>
        {dp.taught.map((p: string) => <p set:html={p} />)}
      </section>

      <section class="d2-sec">
        <h2 class="d2-h2"><span class="d2-step">2</span>Where It Came From</h2>
        {dp.roots.map((p: string) => <p set:html={p} />)}
        <DoctrineTabs data={dp.tabs} bare warmGreek />
      </section>

      <section class="d2-sec">
        <h2 class="d2-h2"><span class="d2-step">3</span>The Old Path</h2>
        <div class="d2-old"><p set:html={dp.oldPath} /></div>
      </section>

      <DoctrineStudies slug={pair.departure.slug} name={pair.departure.title} />

      <p class="d2-foot">
        <a href={oldHref}>&larr; {pair.oldPaths.title}</a>
        <a href={greekHref}>Greek Influence: {pair.departure.title}</a>
        <a href="/doctrines/the-departure">All The Departure</a>
        {riddle && <a href={riddle.href}>Test it yourself <span aria-hidden="true">&rarr;</span> Try the riddle</a>}
        {prev && <a href={`/doctrines/the-departure/${prev.p.departure.slug}`}>&larr; {prev.label}: {prev.p.departure.title}</a>}
        {next && <a href={`/doctrines/the-departure/${next.p.departure.slug}`}>{next.label}: {next.p.departure.title} <span aria-hidden="true">&rarr;</span></a>}
      </p>
    </>
  )}
</article>
</div>

<style>
  /* The doctrine pages' fixed dark palette (DoctrineInfo): #0e0d0b ground,
     #BA7517 gold, #d8b06a soft gold, #cfc7b6 body, #e8e2d4 titles, #161512
     panels. Added for the trial: a warm red (the turn box) and a muted green
     (the Old Path close). set:html content (em, b) is not
     scoped, so it is reached through :global() under a scoped wrapper. */
  .d2-page { background: #0e0d0b; min-height: 100vh; }
  .d2 {
    max-width: 50rem; margin: 0 auto;
    padding: clamp(3rem, 6vw, 4.5rem) 1rem 4rem;
    font-family: var(--font-body); font-size: 1.12rem; line-height: 1.75; color: #cfc7b6;
  }
  .d2 :global(em) { font-family: var(--font-body); font-style: italic; }
  .d2 p { margin: 0 0 1.1rem; }
  .d2-kicker {
    font-family: var(--font-display); font-size: 11px; font-weight: 600;
    letter-spacing: 0.28em; text-transform: uppercase; color: #BA7517; margin: 0 0 1rem !important;
  }
  .d2-title {
    font-family: var(--font-display); font-size: clamp(1.9rem, 1.4rem + 2.4vw, 2.8rem);
    font-weight: 700; line-height: 1.12; color: #e8e2d4; margin: 0 0 0.7rem; letter-spacing: 0.01em;
  }
  .d2-sub {
    font-family: var(--font-body); font-style: italic;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem); line-height: 1.45; color: #a89f8c;
  }
  .d2-attrib { font-style: italic; color: #d8b06a; margin-top: 1.2rem !important; }

  .d2-sec { margin-top: 2.4rem; }
  .d2-h2 {
    display: flex; align-items: center; gap: 0.7rem;
    font-family: var(--font-display); font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem); font-weight: 700;
    letter-spacing: 0.04em; color: #d8b06a; line-height: 1.3; margin: 0 0 1rem;
  }
  .d2-step {
    flex: none; width: 1.8rem; height: 1.8rem; border-radius: 50%;
    border: 1px solid rgba(186,117,23,0.55); color: #BA7517;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: var(--font-body); font-size: 0.95rem; font-weight: 600; letter-spacing: 0;
  }

  .d2-keepers { list-style: none; margin: 0; padding: 0; }
  .d2-keepers li { padding: 0.55rem 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
  .d2-keepers b { color: #d8b06a; font-weight: 700; }
  .d2-closing { margin-top: 1.6rem !important; }

  .d2-verses {
    margin: 1.8rem 0 0; padding: 1.1rem 1.4rem;
    background: #161512; border: 0.5px solid rgba(255,255,255,0.07); border-radius: 10px;
    display: flex; flex-direction: column; gap: 0.45rem; font-size: 1.02rem;
  }
  .d2-vlabel {
    display: inline-block; min-width: 9rem; margin-right: 0.6rem;
    font-family: var(--font-display); font-size: 10px; font-weight: 600;
    letter-spacing: 0.22em; text-transform: uppercase; color: #BA7517;
  }

  .d2-turn {
    margin-top: 2.2rem; padding: 1.2rem 1.4rem;
    border: 1px solid #a5533f; border-left: 4px solid #a5533f; border-radius: 8px;
    background: rgba(165,83,63,0.08);
  }
  .d2-turn p { font-style: italic; color: #e8e2d4; margin-bottom: 0.6rem; }
  .d2-turn a {
    font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: #e0a08c; text-decoration: none;
  }
  .d2-turn a:hover { color: #f0bca9; text-decoration: underline; text-underline-offset: 4px; }

  .d2-old {
    padding: 1.1rem 1.3rem; border: 1px solid #4d6a49; border-radius: 8px;
    background: rgba(111,143,106,0.08);
  }
  .d2-old p { margin: 0; }

  .d2-foot a { color: #d8b06a; text-decoration: none; }
  .d2-foot a:hover { color: #e8c98a; text-decoration: underline; text-underline-offset: 3px; }
  .d2-foot {
    margin-top: 1.4rem !important; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.08);
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem;
    font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase;
  }

  .d2-back { margin: 1.6rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; }
  .d2-back a {
    font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: #8a8172; text-decoration: none;
  }
  .d2-back a:hover { color: #BA7517; }
  .d2-riddle { margin: 2.4rem 0 0; text-align: center; }
  .d2-riddle a {
    font-family: var(--font-display); font-variant: all-small-caps; font-size: 1rem;
    letter-spacing: 0.12em; color: #BA7517; text-decoration: none;
  }
  .d2-riddle a:hover { color: #e0a54a; text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 700px) {
    .d2-vlabel { display: block; min-width: 0; }
  }
</style>
