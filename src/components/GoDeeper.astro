---
// GoDeeper 1005 V1.astro
// The "Go deeper" callout inside a study body: one boxed, wholly clickable panel
// that opens an unlisted deeper page (a post with `unlisted: true`). It is that
// page's ONLY entry point, so it sits mid-study as its own moment, not as a
// footnote and not as a Read Next card. Styled off the Read Next note
// (parchment, gold rule) and made into a call to action.
// Used from .mdx: import GoDeeper from '../../components/GoDeeper.astro';
//   <GoDeeper href="/blog/<slug>" title="…" blurb="…" />
// Props: href, title, blurb, label (default "Go Deeper").
const { href, title, blurb, label = 'Go Deeper' } = Astro.props;
---

<a href={href} class="go-deeper not-prose" data-pagefind-ignore>
  <span class="gd-label">{label}</span>
  <span class="gd-title">{title}&nbsp;<span class="gd-arrow" aria-hidden="true">&rarr;</span></span>
  {blurb && <span class="gd-blurb">{blurb}</span>}
</a>

<style>
  a.go-deeper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    margin: 3rem auto;
    padding: 1.75rem 1.75rem 1.6rem;
    text-align: center;
    text-decoration: none;
    border: 1px solid var(--sand-dark, #c4a97d);
    border-top: 3px solid var(--gold, #b8862b);
    border-bottom: 3px solid var(--gold, #b8862b);
    border-radius: 4px;
    background: linear-gradient(180deg, rgba(184, 134, 43, 0.10) 0%, rgba(138, 101, 32, 0.04) 100%);
    box-shadow: 0 2px 10px rgba(75, 54, 33, 0.10);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  a.go-deeper:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(75, 54, 33, 0.18);
    background: linear-gradient(180deg, rgba(184, 134, 43, 0.16) 0%, rgba(138, 101, 32, 0.07) 100%);
  }
  a.go-deeper:focus-visible { outline: 2px solid var(--gold, #b8862b); outline-offset: 3px; }

  .gd-label {
    /* Cinzel is caps-only: plain uppercase, never font-variant small-caps (which
       shrinks it to a whisper). */
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--gold, #b8862b);
  }
  .gd-title {
    font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif;
    font-size: clamp(1.25rem, 2.6vw, 1.5rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--bronze, #8a5a20);
  }
  /* Inline (not inline-block) after a no-break space, so the arrow always wraps
     with the last word instead of falling onto a line of its own. */
  .gd-arrow {
    position: relative;
    left: 0;
    transition: left 0.2s ease;
  }
  a.go-deeper:hover .gd-arrow { left: 5px; }
  a.go-deeper:hover .gd-title { color: var(--deep-earth, #2b1d11); }
  .gd-blurb {
    font-family: var(--font-family-serif, 'Crimson Text'), Georgia, serif;
    font-style: italic;
    font-size: 1.02rem;
    line-height: 1.5;
    max-width: 34rem;
    color: var(--ink-faded, #6b5a45);
  }

  :global(.dark) a.go-deeper {
    border-color: rgba(196, 173, 132, 0.30);
    border-top-color: var(--gold-light, #d4a85a);
    border-bottom-color: var(--gold-light, #d4a85a);
    background: linear-gradient(180deg, rgba(212, 168, 90, 0.10) 0%, rgba(212, 168, 90, 0.03) 100%);
  }
  :global(.dark) .gd-label { color: var(--gold-light, #d4a85a); }
  :global(.dark) .gd-title { color: var(--gold-light, #d4a85a); }
  :global(.dark) a.go-deeper:hover .gd-title { color: var(--color-dark-text, #f0e0bf); }
  :global(.dark) .gd-blurb { color: rgba(240, 224, 191, 0.75); }

  @media (prefers-reduced-motion: reduce) {
    a.go-deeper, .gd-arrow { transition: none; }
    a.go-deeper:hover { transform: none; }
  }
  @media (max-width: 600px) {
    a.go-deeper { margin: 2.25rem auto; padding: 1.4rem 1.1rem 1.3rem; }
  }
</style>
