---
// src/components/DoctrineInfo.astro · 1008 V4
// V4: every Departure page opens with the StandingStone notice (above the
// kicker and title; never on the Old Paths side). A Departure entry with a
// departure-tabs.js entry renders DoctrineTabs in place of its body; every other
// entry renders its body exactly as before.
// V3: an entry marked `bodyFormat: "markdown"` renders its body as markdown
// (Astro's own processor, so headings, lists, links and blockquotes come out as
// they do in a study), styled below in this page's dark palette. Every other
// entry still renders its body as one plain paragraph, exactly as before.
// V2: the recognition `tag` renders beneath the deck. Both halves of a pair
// carry the identical tag, so the reader landing on either side sees the same
// label and understands they are two readings of one question.
// V1: One template for BOTH info pages. `side` picks which half of the pair is the
// subject; the counterpart link is DERIVED from the same object, never stored —
// so the round-trip can't break. Scripture shows on the Old Paths side only.
// The tagline arrow is intentionally reversed between the two sides.
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import StandingStone from './StandingStone.astro';
import DoctrineTabs from './DoctrineTabs.astro';
import { departureTabs } from '../data/departure-tabs.js';
interface Props { side: 'old-paths' | 'departure'; pair: any; }
const { side, pair } = Astro.props;
const isOld = side === 'old-paths';
const entry = isOld ? pair.oldPaths : pair.departure;
const counterpart = isOld ? pair.departure : pair.oldPaths;
const kicker = isOld ? 'The Old Paths' : 'The Departure';
const hasTabs = !isOld && Boolean(departureTabs[entry.slug]);
const bodyHtml = !hasTabs && entry.bodyFormat === 'markdown'
  ? (await (await createMarkdownProcessor()).render(entry.body)).code
  : null;
const counterpartHref = isOld
  ? `/doctrines/the-departure/${counterpart.slug}`
  : `/doctrines/old-paths/${counterpart.slug}`;
---

<div class="di-page">
<article class="di">
  {!isOld && <StandingStone />}
  <p class="di-kicker">{kicker}</p>
  <h1 class="di-title">{entry.title}</h1>
  <p class="di-deck">{entry.deck}</p>
  {entry.tag && <p class="di-tag">{entry.tag}</p>}

  {hasTabs
    ? <DoctrineTabs slug={entry.slug} />
    : bodyHtml
      ? <div class="di-body di-body-md" set:html={bodyHtml} />
      : <div class="di-body"><p>{entry.body}</p></div>}

  {isOld && (
    <div class="di-scripture">
      <div class="di-scripture-group">
        <span class="di-scripture-label">Torah</span>
        <span class="di-scripture-refs">{entry.torah.join('  ·  ')}</span>
      </div>
      <div class="di-scripture-group">
        <span class="di-scripture-label">Second Witness</span>
        <span class="di-scripture-refs">{entry.witness.join('  ·  ')}</span>
      </div>
    </div>
  )}

  <a class="di-tagline" href={counterpartHref}>
    {isOld
      ? <span>Where the church departed: <strong>{counterpart.title}</strong> <span class="di-arrow">&rarr;</span></span>
      : <span><span class="di-arrow">&larr;</span> What Scripture holds: <strong>{counterpart.title}</strong></span>}
  </a>

  <p class="di-back"><a href={isOld ? '/doctrines/old-paths' : '/doctrines/the-departure'}>&larr; All {kicker}</a></p>
</article>
</div>

<style>
  .di-page { background: #0e0d0b; min-height: 100vh; }
  .di {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 4.5rem) 1.5rem 4rem;
  }
  .di-kicker {
    font-family: var(--font-display);
    font-size: 11px; font-weight: 600; letter-spacing: 0.28em; text-transform: uppercase;
    color: #BA7517; margin: 0 0 1rem;
  }
  .di-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 1.4rem + 2.4vw, 2.8rem); font-weight: 700; line-height: 1.12;
    color: #e8e2d4; margin: 0 0 0.8rem; letter-spacing: 0.01em;
  }
  .di-deck {
    font-family: var(--font-body); font-style: italic;
    font-size: clamp(1.05rem, 1rem + 0.5vw, 1.3rem); line-height: 1.5;
    color: #a89f8c; margin: 0 0 2.2rem;
  }
  /* Recognition tag — muted gold small caps under the deck. When it is present
     the deck's bottom margin is collapsed so the two read as one unit. */
  .di-deck:has(+ .di-tag) { margin-bottom: 0.7rem; }
  .di-tag {
    font-family: var(--font-display); font-variant: all-small-caps;
    font-size: 1rem; letter-spacing: 0.14em; font-weight: 600;
    color: #9a7c46; margin: 0 0 2.2rem;
  }
  .di-body { font-family: var(--font-body); font-size: 1.12rem; line-height: 1.85; color: #cfc7b6; }
  .di-body p { margin: 0 0 1.3rem; }

  /* Markdown body (bodyFormat: "markdown"). set:html content is not scoped, so
     every rule reaches it through :global() under the scoped wrapper. */
  .di-body-md :global(h2) {
    font-family: var(--font-display); font-size: clamp(1.3rem, 1.1rem + 0.9vw, 1.65rem); font-weight: 700;
    line-height: 1.25; letter-spacing: 0.01em; color: #e8e2d4;
    margin: 2.6rem 0 1rem; padding-bottom: 0.45rem; border-bottom: 1px solid rgba(186,117,23,0.45);
  }
  .di-body-md :global(p) { margin: 0 0 1.3rem; }
  .di-body-md :global(h2:first-child) { margin-top: 0; }
  .di-body-md :global(strong) { color: #e8e2d4; font-weight: 700; }
  .di-body-md :global(em) { font-family: var(--font-body); font-style: italic; }
  .di-body-md :global(a) { color: #d8b06a; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(216,176,106,0.45); }
  .di-body-md :global(a:hover) { color: #e8c98a; text-decoration-color: #BA7517; }
  .di-body-md :global(ul) { list-style: disc; margin: 0 0 1.4rem; padding-left: 1.3rem; }
  .di-body-md :global(li) { margin: 0 0 0.55rem; }
  .di-body-md :global(li::marker) { color: #BA7517; }
  .di-body-md :global(li p) { margin: 0; }
  /* Scripture: the gold-ruled quote block the site uses for verses. */
  .di-body-md :global(blockquote) {
    margin: 1.4rem 0 1.6rem; padding: 1rem 1.3rem;
    background: #161512; border: 0.5px solid rgba(255,255,255,0.07); border-left: 3px solid #BA7517; border-radius: 0 10px 10px 0;
    color: #ddd5c4;
  }
  .di-body-md :global(blockquote p) { margin: 0 0 0.7rem; }
  .di-body-md :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Scripture — labeled reference groups, references only (Old Paths side). */
  .di-scripture {
    margin: 2.4rem 0 0; padding: 1.5rem 1.6rem;
    background: #161512; border: 0.5px solid rgba(255,255,255,0.07); border-radius: 12px;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .di-scripture-group { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; }
  .di-scripture-label {
    font-family: var(--font-display); font-size: 10px; font-weight: 600; letter-spacing: 0.22em;
    text-transform: uppercase; color: #BA7517; min-width: 8.5rem;
  }
  .di-scripture-refs { font-family: var(--font-body); font-size: 1.02rem; color: #cfc7b6; }

  /* Tagline — a bordered, gold-ruled block that stands out. Not an inline link. */
  .di-tagline {
    display: block; margin: 3rem 0 0; padding: 1.15rem 1.4rem;
    background: linear-gradient(180deg, rgba(186,117,23,0.08), rgba(186,117,23,0.03));
    border: 1px solid rgba(186,117,23,0.4); border-left: 4px solid #BA7517; border-radius: 10px;
    font-family: var(--font-display); font-size: 0.95rem; letter-spacing: 0.04em;
    color: #d8b06a; text-decoration: none; text-align: center;
    transition: background 0.2s, border-color 0.2s;
  }
  .di-tagline:hover { background: rgba(186,117,23,0.14); border-color: #BA7517; }
  .di-tagline strong { color: #e8e2d4; font-weight: 700; }
  .di-arrow { color: #BA7517; }

  .di-back { margin: 1.6rem 0 0; }
  .di-back a {
    font-family: var(--font-display); font-size: 0.72rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: #8a8172; text-decoration: none;
  }
  .di-back a:hover { color: #BA7517; }

  @media (max-width: 520px) {
    .di-scripture-label { min-width: 100%; }
  }
</style>
