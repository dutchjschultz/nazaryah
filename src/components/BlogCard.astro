---
// Single blog post card. Extracted from the old blog index so the paginated
// group views and the All Posts view render identical cards.
import { masterTitleBySlug } from '../data/books.js';
const { post } = Astro.props;

// Chapters of the multi-part books display the master chapter title from the
// book's Contents (the single source of truth), not the blog's own title.
// Non-chapter posts are unaffected.
const displayTitle = masterTitleBySlug[post.slug] ?? post.data.title;

// Book-chapter categories still get the "From the Bookshelf" treatment — the
// card shows the post's underlying category; the rail groups them thematically.
const bookCategories = {
  'The Bearer': { href: '/books/the-bearer' },
  'Five Titles, One Christ': { href: '/books/five-titles' },
  'What the Pulpit Buried': { href: '/books/pulpit-buried' },
};
const cat = post.data.category;
const book = bookCategories[cat];
const blurb = post.data.subtitle || post.data.deck || post.data.description;

// Reference line: the passage, plus the parable's common name when the study
// carries one — MATTHEW 24:1-25:13 · THE TEN VIRGINS. The name identifies the
// parable; the card's title stays the study's own.
const verseLine = [post.data.verse, post.data.commonName].filter(Boolean).join(' · ');

// The study's video, if it has one — the same `watch` block that draws the watch
// card on the study page. No block, no second action row.
const watch = post.data.watch;
---

<article class="post-item card group flex flex-col overflow-hidden h-full"
  data-title={displayTitle.toLowerCase()}
  data-search={`${displayTitle} ${post.data.title} ${blurb || ''} ${cat} ${post.data.commonName || ''}`.toLowerCase()}>
  <div class="p-6 flex flex-col flex-1">
    {book && <a href={book.href} class="bookshelf-badge">&#9672; From the Bookshelf</a>}
    <div class:list={["tag mb-3", { "tag-book": book }]} style="color: var(--bronze);">{cat}</div>
    {verseLine && <div class="post-verse">{verseLine}</div>}
    <h3 class="post-title text-sm font-semibold mb-3 leading-snug" style="font-family: var(--font-display);">
      <a href={`/blog/${post.slug}`} style="color: var(--deep-earth);">{displayTitle}</a>
    </h3>
    <p class="post-subtitle text-sm leading-relaxed mb-5 line-clamp-4 flex-1">{blurb}</p>
    {/* The actions, pinned to the foot of the card. READ IS LAST, so it sits on
        the bottom line of every card in the grid. Watch goes above it with its
        CTA line closest to Read, so that line holds too; a long video title
        wraps UPWARD into the slack above, which is the only part of the card
        that has any. Nothing is truncated. */}
    <div class="card-actions">
      {watch && (
        <a class="card-watch" href={watch.url} target="_blank" rel="noopener noreferrer">
          <span class="card-watch-title">{watch.title}</span>
          <span class="card-watch-cta">Watch on YouTube <span class="card-watch-arrow" aria-hidden="true">&rarr;</span></span>
        </a>
      )}
      <div class="flex items-center justify-between text-xs pt-4 border-t border-[var(--sand-dark)]" style="color: var(--ink-faded); font-family: var(--font-body);">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </time>
        <a href={`/blog/${post.slug}`} class="font-medium group-hover:translate-x-1 transition-transform inline-flex items-center gap-1" style="color: var(--bronze);">
          Read <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .bookshelf-badge {
    display: inline-flex; align-items: center; gap: 5px; align-self: flex-start;
    font-family: 'Cinzel', Georgia, serif; font-size: 9px; letter-spacing: 2px; text-transform: uppercase;
    color: #8a6028; background: linear-gradient(180deg, rgba(201,169,97,0.12), rgba(201,169,97,0.04));
    border: 1px solid #b89150; border-radius: 2px; padding: 2px 8px; margin-bottom: 6px; text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .bookshelf-badge:hover { color: #4a2808; border-color: #c4a46b; background: rgba(201,169,97,0.2); }
  .tag-book { color: #9a6b1f !important; font-weight: bold; }
  .post-verse {
    font-family: 'Cinzel', Georgia, serif; font-size: 10px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase;
    color: #9a6b1f; margin: -2px 0 8px; padding-bottom: 7px; border-bottom: 1px solid var(--sand-dark);
  }
  .post-subtitle { font-style: italic; color: var(--ink-faded); }

  /* ── Card foot ────────────────────────────────────────────────────────────
     margin-top:auto pins the action block to the bottom of the card, and the
     grid stretches the cards to a common height (see .h-full on the article), so
     the block's bottom edge is the same line on every card. Read is the last row
     in the block, which puts it on that line everywhere — with or without a
     video. The Watch CTA is the row directly above Read, so it lines up too, and
     a video title that wraps to two lines grows upward into the card's slack
     instead of pushing anything down. Nothing is clamped. */
  .card-actions { margin-top: auto; }
  .card-watch {
    display: flex; flex-direction: column; gap: 2px;
    margin-top: 14px; padding-top: 10px;
    border-top: 1px solid var(--sand-dark);
    text-decoration: none;
  }
  .card-watch-cta {
    display: inline-flex; align-items: center; gap: 4px; margin-top: 2px;
    font-family: 'Cinzel', Georgia, serif; font-size: 9px; font-weight: 600;
    letter-spacing: 2px; text-transform: uppercase;
    color: #9a6b1f;
  }
  .card-watch-arrow { transition: transform 0.2s ease; }
  .card-watch:hover .card-watch-arrow { transform: translateX(3px); }
  .card-watch:hover .card-watch-cta { color: #4a2808; }
  /* The video's full title. It wraps; it is never clamped. */
  .card-watch-title {
    font-family: var(--font-body); font-size: 0.78rem; line-height: 1.4;
    color: var(--ink-faded); overflow-wrap: break-word;
  }
  .card-watch:hover .card-watch-title { color: var(--deep-earth); }
  @media (prefers-reduced-motion: reduce) {
    .card-watch-arrow { transition: none; }
  }
  .line-clamp-4 { display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
  .post-title, .post-title a { overflow-wrap: break-word; word-wrap: break-word; hyphens: auto; }
  h3.post-title { font-size: 1.05rem; line-height: 1.35; }
  h3.post-title a:hover { color: var(--bronze); }
</style>
