---
// StudiesHero.astro · 1007 V1
// The parchment header shared by the Berean Studies pages (/blog, /blog/topics,
// /blog/collections, /trilogies). Lifted from src/pages/blog/index.astro; same
// look. Props: title, verse (optional {text, ref}), and the intro in the slot.
const { title, verse } = Astro.props;
---

<section class="blog-hero">
  <h1 class="blog-hero-title">{title}</h1>
  <div class="blog-hero-rule" aria-hidden="true"><span></span><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><rect x="1" y="1" width="12" height="12" stroke="#7a4f28" stroke-width="1" transform="rotate(45 7 7)" opacity="0.6"/></svg><span></span></div>
  {verse && (
    <p class="blog-hero-verse">&ldquo;{verse.text}&rdquo; <span class="blog-hero-ref">{verse.ref}</span></p>
  )}
  <p class="blog-hero-intro"><slot /></p>
</section>

<style>
  .blog-hero { font-family: Georgia, 'Times New Roman', serif; background: #cfc0a0; padding: 3rem 2rem 2.5rem; text-align: center; }
  .blog-hero-title { font-size: 2.6rem; font-weight: 900; color: #1e1208; font-variant: small-caps; letter-spacing: 0.04em; margin: 0 0 0.75rem; }
  .blog-hero-rule { display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.1rem; }
  .blog-hero-rule span { display: block; height: 1px; width: 80px; background: #7a4f28; opacity: 0.5; }
  .blog-hero-intro { font-size: 0.97rem; color: #2e1e0e; max-width: 46rem; margin: 0 auto; line-height: 1.8; }
  .blog-hero-intro strong { color: #6b3010; }
  .blog-hero-verse { font-family: Georgia, serif; font-style: italic; font-size: 1.05rem; color: #3a2614; max-width: 40rem; margin: 0 auto 0.9rem; line-height: 1.6; }
  .blog-hero-ref { font-family: 'Cinzel', serif; font-style: normal; font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: #7a4f28; white-space: nowrap; }
</style>
