---
// StudyCard.astro · 0928 V6
// V6: `alias` — a reading that is picked on its own (an Enoch card) answers to
// a short alias (#enoch-2) and is a pick item for its view's picker.
// V5: `passages` — a reading can carry its own printed "Passages" line (the
// Enoch cards), printed exactly as written, Enoch refs and all. Its canon
// refs reach the section's verse index through passages-line.js; the reading
// needs no refs frontmatter.
// V4: the open/close script moved to src/lib/cards-client.ts, shared with
// BandCard, so a link can open the band and the reading around its target in
// one step. New `open` prop: the reading starts open (The Claim's reading).
// V3: cards open in place. Each card starts COLLAPSED to its title and deck
// line; clicking the title (a button) or the deck opens the rest in place, and
// clicking the title again closes it. Every card toggles on its own — a band is
// a row of cards, not one accordion. A link into a card (#the-firmament, e.g.
// from the Scripture index) opens that card and scrolls to it. Without
// JavaScript every card is simply open. The Verses line now uses the shared
// rule in src/lib/scripture/printed-refs.js (same as the page's foot block).
// V2: a `lead: true` ref whose verses are all covered by another ref on the
// same card is not printed. It exists to steer the Scripture index (e.g. a lead
// Gen 1:5 beside the printed Gen 1:3-5), not for the card's Verses line. Every
// other ref prints exactly as the copy has it, overlaps included.
// V1: one card in a StudyCardGrid. The card's title is an ordinary markdown
// heading written inside it (so it gets an id, shows in the page's headings,
// and can be a Scripture-index `anchor`); the deck line, body, and verses
// follow as markdown.
//
// `verses` + `anchor`: the card's "Verses:" line is NOT typed in the body. It is
// built from the post's own `refs` frontmatter — every ref whose anchor is this
// card's heading id — so the verse list lives in one place and the Scripture
// index and the card can never disagree. Pass `verses={frontmatter.refs}`.
//
// `source`: a record citation (Band 7 style), shown under the body. `sourceLinks`
// is an optional list of { label, href } rendered after it.
// `link`: an optional { label, href } read-more line at the foot of the card.
import { printedRefs } from '../../lib/scripture/printed-refs.js';

interface Ref { ref: string; anchor?: string; lead?: boolean }
interface Props {
  anchor?: string;
  verses?: Ref[];
  source?: string;
  sourceLinks?: { label: string; href: string }[];
  link?: { label: string; href: string };
  open?: boolean;
  passages?: string;
  alias?: string;
}
const { anchor, verses = [], source, sourceLinks = [], link, open = false, passages, alias } = Astro.props;

// Every ref on this card prints as written, except an index-steering lead ref
// another ref on the card already covers (see printed-refs.js).
const mine = anchor
  ? printedRefs(verses.filter((r) => r.anchor === anchor)).map(({ p }) => p.display)
  : [];
if (anchor && !mine.length && !passages) {
  throw new Error(`[StudyCard] card "${anchor}" has an anchor but no refs in frontmatter point at it`);
}
---

<div class="sc" data-sc id={alias ? `${anchor}-card` : undefined} data-pick-item={alias ? true : undefined} data-alias={alias} data-open={open ? "true" : undefined}>
  <slot />
  {passages && (
    <p class="sc-verses"><span class="sc-label">Passages</span> {passages}</p>
  )}
  {mine.length > 0 && (
    <p class="sc-verses"><span class="sc-label">Verses</span> {mine.join('; ')}</p>
  )}
  {source && (
    <p class="sc-source">
      <span class="sc-label">Source</span> {source}
      {sourceLinks.map((l, i) => (
        <>
          {i === 0 ? ' ' : ' · '}<a href={l.href} rel="noopener" target="_blank">{l.label}</a>
        </>
      ))}
    </p>
  )}
  {link && (
    <p class="sc-link"><a href={link.href}>{link.label} &rarr;</a></p>
  )}
</div>

<style>
  .sc {
    border: 1px solid var(--color-border-strong, #d4cec4);
    border-top: 3px solid var(--gold);
    border-radius: 4px;
    padding: 1.1rem 1.25rem 1rem;
    background: rgba(255, 255, 255, 0.35);
    min-width: 0;
  }
  :global(.dark) .sc {
    border-color: var(--color-dark-border-strong);
    border-top-color: var(--gold-light);
    background: rgba(255, 255, 255, 0.03);
  }
  /* Slotted markdown: Astro scoping does not reach it, hence :global under .sc */
  .sc :global(h3) { margin-top: 0 !important; margin-bottom: 0.35rem !important; }
  .sc :global(h3 + p > em:only-child) { display: block; }
  .sc :global(p) { margin: 0.6rem 0; }
  .sc-verses,
  .sc-source {
    font-size: 0.9rem;
    line-height: 1.5;
    border-top: 1px solid var(--color-border, #e8e5df);
    padding-top: 0.55rem;
    margin-top: 0.9rem !important;
  }
  :global(.dark) .sc-verses,
  :global(.dark) .sc-source { border-top-color: var(--color-dark-border); }
  .sc-source + .sc-verses,
  .sc-verses + .sc-source { border-top: 0; padding-top: 0; margin-top: 0.3rem !important; }
  .sc-label {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-right: 0.35rem;
  }
  :global(.dark) .sc-label { color: var(--gold-light); }
  .sc-link { font-size: 0.95rem; margin-bottom: 0 !important; }
</style>

<style is:global>
  /* Open-in-place behaviour. is:global because the script adds the classes and
     the title button at runtime; every selector is scoped under .sc-js, which
     only exists once the script has run. */
  .sc.sc-js > h3 { margin-bottom: 0 !important; }
  /* Land link targets (cards, band headings) below the fixed site header. */
  .prose :is(h2, h3)[id] { scroll-margin-top: 7.5rem; }
  .sc-toggle {
    all: unset;
    box-sizing: border-box;
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    cursor: pointer;
    font: inherit;
    color: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .sc-toggle::after {
    content: '+';
    flex: none;
    font-family: var(--font-body);
    font-size: 1.3rem;
    line-height: 1;
    color: var(--gold);
  }
  .dark .sc-toggle::after { color: var(--gold-light); }
  .sc-js:not(.is-closed) .sc-toggle::after { content: '\2212'; }
  .sc-toggle:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; border-radius: 2px; }
  .sc-js .sc-deck { margin-bottom: 0 !important; }
  .sc-js.is-closed .sc-deck { cursor: pointer; }
  .sc-js.is-closed > :not(h3):not(.sc-deck) { display: none !important; }
  .sc-js.is-closed { padding-bottom: 1.1rem; }
  .sc-js:not(.is-closed) .sc-deck { margin-bottom: 0.6rem !important; }
</style>

<script>
  import '../../lib/cards-client.ts';
</script>
