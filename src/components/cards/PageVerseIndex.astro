---
// PageVerseIndex.astro · 0927 V5
// V5: the panel starts CLOSED — the full list is not shown on the page until
// the reader asks for it ("Enter by Scripture", or any #verse-index link),
// though every entry stays in the page source. Bands are named "Band Four ·
// The Witnesses" (src/lib/number-words.js), the same form the band cards show.
// By book stays the default, the full list. By band and By reading are now
// PICKERS, not sorts: each shows a dropdown and nothing else; choosing a band
// (or a reading) shows only its passages, with a count line ("14 passages in
// Band Four") so a narrowed list never reads as a short one, and a visible
// control to clear the choice and return to the full list. All lists are
// built at build time; the controls only show one. No tier filter.
// V4: a panel of its own under the introduction, entries naming band and
// reading, three sort views.
// V3: SPLIT-READY — reads a list of SOURCES (each a page of the section with
// its own refs, headings, bands and address), not only the page it sits on.
// Today /cosmology passes one source (itself, href ""), so links are
// "#anchor". A reading that later moves to its own page is added as a source
// and its links follow it. Only the section's own pages, never other studies.
// V2: deck and note are section copy, passed by the page.
// V1: the page's own verse index, from the same verse lines the readings
// print (printed-refs.js). A passage taught in two readings lists both.
import { BOOK_BY_KEY } from '../../lib/scripture/books.js';
import { printedRefs } from '../../lib/scripture/printed-refs.js';
import { bandName, numberWord } from '../../lib/number-words.js';

interface Band { number: number; id: string; title: string; anchors: string[] }
interface Source {
  refs?: { ref: string; anchor?: string; lead?: boolean }[];
  /** That page's headings, in page order (from render()). */
  headings: { slug: string; text: string }[];
  /** That page's bands, in order (src/lib/section-structure.js). */
  bands: Band[];
  /** That page's address: "" for the page the index sits on. */
  href?: string;
}
interface Props {
  sources: Source[];
  id?: string;
  title?: string;
  deck?: string;
  note?: string;
}
const { sources, id = 'verse-index', title = 'Verse Index', deck, note } = Astro.props;

// Every reading in the section, keyed by its link, in reading order.
const readings = new Map();
const bands = [];
sources.forEach(({ headings, bands: srcBands, href = '' }, s) => {
  const titleOf = new Map(headings.map((h) => [h.slug, h.text]));
  const rankOf = new Map(headings.map((h, i) => [h.slug, i]));
  for (const band of srcBands) {
    bands.push(band);
    for (const anchor of band.anchors) {
      if (!titleOf.has(anchor)) throw new Error(`[PageVerseIndex] band "${band.id}" holds "${anchor}", which is not a heading on that page`);
      readings.set(`${href}#${anchor}`, {
        href: `${href}#${anchor}`,
        key: `${s}-${anchor}`,
        title: titleOf.get(anchor),
        band,
        rank: s * 100000 + rankOf.get(anchor),
        passages: [],
      });
    }
  }
});

const canon = (a, b) =>
  BOOK_BY_KEY[a.book].order - BOOK_BY_KEY[b.book].order ||
  a.start.c - b.start.c || a.start.v - b.start.v || a.end.c - b.end.c || a.end.v - b.end.v;

// Passages, and which readings teach each (every reading, in page order).
const byPassage = new Map();
for (const { refs = [], href = '' } of sources) {
  for (const { r, p } of printedRefs(refs)) {
    const reading = readings.get(`${href}#${r.anchor ?? ''}`);
    if (!reading) throw new Error(`[PageVerseIndex] ref "${r.ref}" (anchor ${r.anchor ?? 'none'}) is not a reading in any band`);
    if (!reading.passages.some((q) => q.key === p.key)) reading.passages.push(p);
    const entry = byPassage.get(p.key) ?? { p, readings: [] };
    if (!entry.readings.includes(reading)) entry.readings.push(reading);
    byPassage.set(p.key, entry);
  }
}
for (const e of byPassage.values()) e.readings.sort((a, b) => a.rank - b.rank);
const all = [...byPassage.values()].sort((a, b) => canon(a.p, b.p));

const plural = (n) => `${n} ${n === 1 ? 'passage' : 'passages'}`;

// By book — the full list, grouped by book.
const byBook = [];
for (const e of all) {
  let g = byBook[byBook.length - 1];
  if (!g || g.key !== e.p.book) byBook.push((g = { key: e.p.book, name: BOOK_BY_KEY[e.p.book].name, rows: [] }));
  g.rows.push(e);
}

// By band — one list per band: that band's passages in book order, each with
// the reading(s) in that band that teach it.
const bandLists = bands.map((band) => {
  const rows = all
    .map((e) => ({ p: e.p, readings: e.readings.filter((rd) => rd.band === band) }))
    .filter((row) => row.readings.length);
  return { band, rows, count: `${plural(rows.length)} in Band ${numberWord(band.number)}` };
});

// By reading — one list per reading with verses: its passages, as its verse line has them.
const withPassages = [...readings.values()].filter((rd) => rd.passages.length).sort((a, b) => a.rank - b.rank);
const readingLists = withPassages.map((rd) => ({ rd, count: `${plural(rd.passages.length)} in ${rd.title}` }));
const readingGroups = bands
  .map((band) => ({ band, readings: withPassages.filter((rd) => rd.band === band) }))
  .filter((g) => g.readings.length);
---

<section class="pvi" id={id} data-pvi data-panel aria-labelledby={`${id}-title`}>
  <header class="pvi-head">
    <h2 class="pvi-title" id={`${id}-title`}>{title}</h2>
    <button type="button" class="pvi-close" data-panel-close hidden>Close <span aria-hidden="true">×</span></button>
    {deck && <p class="pvi-deck">{deck}</p>}
    {note && <p class="pvi-note">{note}</p>}

    <div class="pvi-controls" hidden>
      <div class="pvi-modes" role="group" aria-label="How to find a passage">
        <button type="button" class="pvi-mode" data-mode="book" aria-pressed="true">By book</button>
        <button type="button" class="pvi-mode" data-mode="band" aria-pressed="false">By band</button>
        <button type="button" class="pvi-mode" data-mode="reading" aria-pressed="false">By reading</button>
      </div>
      <label class="pvi-pick" data-pick="band" hidden>
        <span class="sr-only">Choose a band</span>
        <select>
          <option value="">Choose a band…</option>
          {bandLists.map(({ band, rows }) => (
            <option value={band.id} disabled={!rows.length}>{bandName(band.number, band.title)}{!rows.length && ' (no verse lines)'}</option>
          ))}
        </select>
      </label>
      <label class="pvi-pick" data-pick="reading" hidden>
        <span class="sr-only">Choose a reading</span>
        <select>
          <option value="">Choose a reading…</option>
          {readingGroups.map((g) => (
            <optgroup label={bandName(g.band.number, g.band.title)}>
              {g.readings.map((rd) => <option value={rd.key}>{rd.title}</option>)}
            </optgroup>
          ))}
        </select>
      </label>
      <p class="pvi-status" aria-live="polite" hidden>
        <span class="pvi-count"></span>
        <button type="button" class="pvi-clear">Show all passages</button>
      </p>
    </div>
  </header>

  <!-- By book: the full list (the default) -->
  <div class="pvi-list pvi-book" data-list="book">
    {byBook.map((g) => (
      <div class="pvi-group">
        <h3 class="pvi-group-name">{g.name}</h3>
        <ul class="pvi-rows">
          {g.rows.map((e) => (
            <li class="pvi-row">
              <span class="pvi-ref">{e.p.display}</span>
              <span class="pvi-where">
                {e.readings.map((rd) => (
                  <span class="pvi-line">
                    <span class="pvi-band">{bandName(rd.band.number, rd.band.title)}</span>
                    <span class="pvi-arrow" aria-hidden="true"> → </span>
                    <a href={rd.href}>{rd.title}</a>
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- By band: one list per band, shown only when that band is chosen -->
  {bandLists.map(({ band, rows, count }) => (
    <div class="pvi-list" data-list={`band:${band.id}`} data-count={count} hidden>
      <ul class="pvi-rows">
        {rows.map((row) => (
          <li class="pvi-row">
            <span class="pvi-ref">{row.p.display}</span>
            <span class="pvi-where">
              {row.readings.map((rd) => <a href={rd.href}>{rd.title}</a>)}
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <!-- By reading: one list per reading, shown only when that reading is chosen -->
  {readingLists.map(({ rd, count }) => (
    <div class="pvi-list" data-list={`reading:${rd.key}`} data-count={count} hidden>
      <p class="pvi-reading-of">
        <span class="pvi-band">{bandName(rd.band.number, rd.band.title)}</span>
        <span class="pvi-arrow" aria-hidden="true"> → </span>
        <a href={rd.href}>{rd.title}</a>
      </p>
      <ul class="pvi-rows pvi-rows-single">
        {rd.passages.map((p) => (
          <li class="pvi-row"><a class="pvi-ref" href={rd.href}>{p.display}</a></li>
        ))}
      </ul>
    </div>
  ))}
</section>

<script>
  // Mode and picker. All lists are in the page source; this only chooses which
  // one shows. Without JavaScript the controls stay hidden and By book shows.
  document.querySelectorAll<HTMLElement>('[data-pvi]').forEach((panel) => {
    const controls = panel.querySelector<HTMLElement>('.pvi-controls');
    if (!controls) return;
    controls.hidden = false;
    const modes = [...panel.querySelectorAll<HTMLButtonElement>('.pvi-mode')];
    const picks = [...panel.querySelectorAll<HTMLElement>('.pvi-pick')];
    const lists = [...panel.querySelectorAll<HTMLElement>('.pvi-list')];
    const status = panel.querySelector<HTMLElement>('.pvi-status')!;
    const countEl = panel.querySelector<HTMLElement>('.pvi-count')!;
    let mode = 'book';

    const show = (key: string | null) => {
      lists.forEach((l) => { l.hidden = l.dataset.list !== key; });
      const shown = lists.find((l) => l.dataset.list === key);
      countEl.textContent = shown?.dataset.count ?? '';
    };
    const setMode = (m: string) => {
      mode = m;
      modes.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
      picks.forEach((p) => {
        p.hidden = p.dataset.pick !== m;
        const sel = p.querySelector('select');
        if (sel) sel.value = '';
      });
      // By book: the full list. By band / By reading: the dropdown and nothing
      // else, until a choice is made.
      show(m === 'book' ? 'book' : null);
      status.hidden = m === 'book';
    };

    modes.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode!)));
    picks.forEach((p) => p.querySelector('select')?.addEventListener('change', (ev) => {
      const value = (ev.target as HTMLSelectElement).value;
      show(value ? `${mode}:${value}` : null);
    }));
    panel.querySelector('.pvi-clear')?.addEventListener('click', () => setMode('book'));
  });
</script>

<style>
  .pvi {
    scroll-margin-top: 7.5rem;
    position: relative;
    margin: 0 0 1rem;
    padding: 2rem 2rem 1.75rem;
    background: rgba(9, 18, 34, 0.85);
    border: 1px solid var(--band-border, #1d2e4a);
    border-left: 3px solid var(--band-accent, #c9a85c);
    border-radius: 4px;
  }
  .pvi.panel-js.is-closed { display: none; }
  .pvi-head { max-width: 46rem; margin: 0 0 1.5rem; }
  .pvi-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    font-weight: 700;
    color: var(--band-title, #eef2fa);
    margin: 0 0 0.4rem;
    padding-right: 5rem;
  }
  .pvi-close {
    position: absolute;
    top: 1.6rem;
    right: 1.5rem;
    font: inherit;
    font-size: 0.9rem;
    background: transparent;
    border: 1px solid var(--band-border, #1d2e4a);
    border-radius: 999px;
    color: var(--band-count, #7f9bc8);
    padding: 0.2rem 0.75rem;
    cursor: pointer;
  }
  .pvi-close[hidden] { display: none; }
  .pvi-deck { font-style: italic; font-size: 1.05rem; color: var(--band-deck, #a9c0e2); margin: 0 0 0.75rem; }
  .pvi-note { font-size: 1rem; line-height: 1.75; color: var(--band-text, #c3cddd); margin: 0 0 1.25rem; }

  .pvi-controls { display: flex; flex-direction: column; gap: 0.75rem; }
  .pvi-controls[hidden] { display: none; }
  .pvi-modes { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pvi-mode, .pvi-clear {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--band-border, #1d2e4a);
    background: transparent;
    color: var(--band-text, #c3cddd);
    cursor: pointer;
  }
  .pvi-mode[aria-pressed='true'] {
    background: var(--band-accent, #c9a85c);
    border-color: var(--band-accent, #c9a85c);
    color: #0b1526;
  }
  .pvi-mode:focus-visible, .pvi-clear:focus-visible, .pvi-close:focus-visible, .pvi-pick select:focus-visible {
    outline: 2px solid var(--band-accent, #c9a85c);
    outline-offset: 2px;
  }
  .pvi-pick[hidden] { display: none; }
  .pvi-pick select {
    font: inherit;
    font-size: 1rem;
    width: 100%;
    max-width: 30rem;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    border: 1px solid var(--band-border, #1d2e4a);
    background: #0f1b31;
    color: var(--band-title, #eef2fa);
  }
  .pvi-status { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin: 0; }
  .pvi-status[hidden] { display: none; }
  .pvi-count { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--band-accent, #c9a85c); }
  .pvi-count:empty { display: none; }

  .pvi-list[hidden] { display: none; }
  .pvi-book { columns: 2 22rem; column-gap: 2.75rem; }
  .pvi-group { break-inside: avoid; margin: 0 0 1.4rem; }
  .pvi-group-name {
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--band-count, #7f9bc8);
    margin: 0 0 0.4rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--band-border, #1d2e4a);
  }
  .pvi-rows { list-style: none; margin: 0; padding: 0; }
  .pvi-list:not(.pvi-book) .pvi-rows { columns: 2 20rem; column-gap: 2.75rem; }
  .pvi-row { display: grid; grid-template-columns: 7.75rem 1fr; gap: 0.75rem; padding: 0.3rem 0; font-size: 0.95rem; line-height: 1.5; break-inside: avoid; }
  .pvi-rows-single .pvi-row { grid-template-columns: 1fr; }
  .pvi-ref { color: var(--band-title, #eef2fa); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pvi-where { display: flex; flex-direction: column; }
  .pvi-band { color: var(--band-count, #7f9bc8); font-size: 0.88em; }
  .pvi-arrow { color: var(--band-accent, #c9a85c); }
  .pvi a { color: var(--band-link, #9cc0f0); text-decoration: none; }
  .pvi a:hover { text-decoration: underline; }
  .pvi-reading-of { margin: 0 0 0.6rem; font-size: 1rem; }
  @media (max-width: 560px) {
    .pvi { padding: 1.4rem 1.1rem 1.25rem; }
    .pvi-close { top: 1.1rem; right: 1rem; }
    .pvi-row { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
