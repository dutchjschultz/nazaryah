---
// PageVerseIndex.astro · 0927 V4
// V4: a PANEL, not a band card — no count line, no (+), open by default so the
// passages show without a click. Every entry names the band and reading it
// points to ("Band 4, The Witnesses → Two Great Lights"). A sort control
// regroups the same build-time data three ways: By book (default), By band
// (band, then reading, in page order), By reading (reading titles A–Z, each
// with every passage it rests on). All three views are in the page source;
// the control only shows one and hides the others. No tier filter yet.
// V3: SPLIT-READY — reads a list of SOURCES (each a page of the section with
// its own refs, headings, bands and address), not only the page it sits on.
// Today /cosmology passes one source (itself, href ""), so links are
// "#anchor". A reading that later moves to its own page is added as a source
// and its links follow it. Only the section's own pages, never other studies.
// V2: deck and note are section copy, passed by the page.
// V1: the page's own verse index, from the same verse lines the readings
// print (printed-refs.js). A passage taught in two readings lists both.
import { BOOK_BY_KEY } from '../../lib/scripture/books.js';
import { printedRefs } from '../../lib/scripture/printed-refs.js';

interface Band { number: number; id: string; title: string; anchors: string[] }
interface Source {
  refs?: { ref: string; anchor?: string; lead?: boolean }[];
  /** That page's headings, in page order (from render()). */
  headings: { slug: string; text: string }[];
  /** That page's bands, in order (src/lib/section-structure.js). */
  bands: Band[];
  /** That page's address: "" for the page the index sits on. */
  href?: string;
}
interface Props {
  sources: Source[];
  id?: string;
  title?: string;
  deck?: string;
  note?: string;
}
const { sources, id = 'verse-index', title = 'Verse Index', deck, note } = Astro.props;

// Every reading in the section, keyed by its link, in reading order.
const readings = new Map();
sources.forEach(({ headings, bands, href = '' }, s) => {
  const titleOf = new Map(headings.map((h) => [h.slug, h.text]));
  const rankOf = new Map(headings.map((h, i) => [h.slug, i]));
  for (const band of bands) {
    for (const anchor of band.anchors) {
      if (!titleOf.has(anchor)) throw new Error(`[PageVerseIndex] band "${band.id}" holds "${anchor}", which is not a heading on that page`);
      readings.set(`${href}#${anchor}`, {
        href: `${href}#${anchor}`,
        title: titleOf.get(anchor),
        band,
        rank: s * 100000 + rankOf.get(anchor),
        passages: [],
      });
    }
  }
});

const canon = (a, b) =>
  BOOK_BY_KEY[a.book].order - BOOK_BY_KEY[b.book].order ||
  a.start.c - b.start.c || a.start.v - b.start.v || a.end.c - b.end.c || a.end.v - b.end.v;

// Passages, and which readings teach each (every reading, in page order).
const byPassage = new Map();
for (const { refs = [], href = '' } of sources) {
  for (const { r, p } of printedRefs(refs)) {
    const reading = readings.get(`${href}#${r.anchor ?? ''}`);
    if (!reading) throw new Error(`[PageVerseIndex] ref "${r.ref}" (anchor ${r.anchor ?? 'none'}) is not a reading in any band`);
    if (!reading.passages.some((q) => q.key === p.key)) reading.passages.push(p);
    const entry = byPassage.get(p.key) ?? { p, readings: [] };
    if (!entry.readings.includes(reading)) entry.readings.push(reading);
    byPassage.set(p.key, entry);
  }
}
for (const e of byPassage.values()) e.readings.sort((a, b) => a.rank - b.rank);

const bandLabel = (band) => `Band ${band.number}, ${band.title}`;
const withPassages = [...readings.values()].filter((rd) => rd.passages.length);

// View 1 — by book, canonical order.
const byBook = [];
for (const e of [...byPassage.values()].sort((a, b) => canon(a.p, b.p))) {
  let g = byBook[byBook.length - 1];
  if (!g || g.key !== e.p.book) byBook.push((g = { key: e.p.book, name: BOOK_BY_KEY[e.p.book].name, rows: [] }));
  g.rows.push(e);
}

// View 2 — by band, then reading, in page order.
const byBand = [];
for (const rd of [...withPassages].sort((a, b) => a.rank - b.rank)) {
  let g = byBand[byBand.length - 1];
  if (!g || g.band !== rd.band) byBand.push((g = { band: rd.band, readings: [] }));
  g.readings.push(rd);
}

// View 3 — by reading title, A–Z (quote marks and a leading "The" ignored).
const sortKey = (t) => t.replace(/^[“"‘']+/, '').replace(/^The\s+/i, '').toLowerCase();
const byReading = [...withPassages].sort((a, b) => sortKey(a.title).localeCompare(sortKey(b.title)));
---

<section class="pvi" id={id} data-pvi aria-labelledby={`${id}-title`}>
  <header class="pvi-head">
    <h2 class="pvi-title" id={`${id}-title`}>{title}</h2>
    {deck && <p class="pvi-deck">{deck}</p>}
    {note && <p class="pvi-note">{note}</p>}
    <div class="pvi-sort" role="group" aria-label="Sort the verse index" hidden>
      <span class="pvi-sort-label">Sort</span>
      <button type="button" class="pvi-sort-btn" data-view="book" aria-pressed="true">By book</button>
      <button type="button" class="pvi-sort-btn" data-view="band" aria-pressed="false">By band</button>
      <button type="button" class="pvi-sort-btn" data-view="reading" aria-pressed="false">By reading</button>
    </div>
  </header>

  <div class="pvi-view" data-view="book">
    {byBook.map((g) => (
      <div class="pvi-group">
        <h3 class="pvi-group-name">{g.name}</h3>
        <ul class="pvi-rows">
          {g.rows.map((e) => (
            <li class="pvi-row">
              <span class="pvi-ref">{e.p.display}</span>
              <span class="pvi-where">
                {e.readings.map((rd) => (
                  <span class="pvi-line">
                    <span class="pvi-band">{bandLabel(rd.band)}</span>
                    <span class="pvi-arrow" aria-hidden="true"> → </span>
                    <a href={rd.href}>{rd.title}</a>
                  </span>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="pvi-view" data-view="band" hidden>
    {byBand.map((g) => (
      <div class="pvi-group">
        <h3 class="pvi-group-name">Band {g.band.number} — {g.band.title}</h3>
        {g.readings.map((rd) => (
          <div class="pvi-reading">
            <h4 class="pvi-reading-name"><a href={rd.href}>{rd.title}</a></h4>
            <p class="pvi-passages">
              {rd.passages.map((p, i) => (
                <>{i > 0 && <span class="pvi-sep" aria-hidden="true"> · </span>}<a href={rd.href}>{p.display}</a></>
              ))}
            </p>
          </div>
        ))}
      </div>
    ))}
  </div>

  <div class="pvi-view" data-view="reading" hidden>
    {byReading.map((rd) => (
      <div class="pvi-reading">
        <h4 class="pvi-reading-name"><a href={rd.href}>{rd.title}</a> <span class="pvi-band">{bandLabel(rd.band)}</span></h4>
        <p class="pvi-passages">
          {rd.passages.map((p, i) => (
            <>{i > 0 && <span class="pvi-sep" aria-hidden="true"> · </span>}<a href={rd.href}>{p.display}</a></>
          ))}
        </p>
      </div>
    ))}
  </div>
</section>

<script>
  // The sort control only regroups: all three views are in the page source.
  // Without JavaScript the control stays hidden and By book shows.
  document.querySelectorAll<HTMLElement>('[data-pvi]').forEach((panel) => {
    const control = panel.querySelector<HTMLElement>('.pvi-sort');
    if (!control) return;
    control.hidden = false;
    const buttons = [...control.querySelectorAll<HTMLButtonElement>('.pvi-sort-btn')];
    const views = [...panel.querySelectorAll<HTMLElement>('.pvi-view')];
    buttons.forEach((btn) => btn.addEventListener('click', () => {
      const view = btn.dataset.view;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      views.forEach((v) => { v.hidden = v.dataset.view !== view; });
    }));
  });
</script>

<style>
  .pvi {
    scroll-margin-top: 7.5rem;
    margin: 0 0 1rem;
    padding: 2rem 2rem 1.75rem;
    background: rgba(9, 18, 34, 0.85);
    border: 1px solid var(--band-border, #1d2e4a);
    border-left: 3px solid var(--band-accent, #c9a85c);
    border-radius: 4px;
  }
  .pvi-head { max-width: 46rem; margin: 0 0 1.5rem; }
  .pvi-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    font-weight: 700;
    color: var(--band-title, #eef2fa);
    margin: 0 0 0.4rem;
  }
  .pvi-deck { font-style: italic; font-size: 1.05rem; color: var(--band-deck, #a9c0e2); margin: 0 0 0.75rem; }
  .pvi-note { font-size: 1rem; line-height: 1.75; color: var(--band-text, #c3cddd); margin: 0 0 1.25rem; }
  .pvi-sort { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .pvi-sort[hidden] { display: none; }
  .pvi-sort-label {
    font-family: 'Cinzel', serif;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--band-count, #7f9bc8);
    margin-right: 0.25rem;
  }
  .pvi-sort-btn {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--band-border, #1d2e4a);
    background: transparent;
    color: var(--band-text, #c3cddd);
    cursor: pointer;
  }
  .pvi-sort-btn[aria-pressed='true'] {
    background: var(--band-accent, #c9a85c);
    border-color: var(--band-accent, #c9a85c);
    color: #0b1526;
  }
  .pvi-sort-btn:focus-visible { outline: 2px solid var(--band-accent, #c9a85c); outline-offset: 2px; }

  .pvi-view { columns: 2 22rem; column-gap: 2.75rem; }
  .pvi-view[hidden] { display: none; }
  .pvi-group { break-inside: avoid; margin: 0 0 1.4rem; }
  .pvi-view[data-view='band'] .pvi-group { break-inside: auto; }
  .pvi-group-name {
    font-family: 'Cinzel', serif;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--band-count, #7f9bc8);
    margin: 0 0 0.4rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--band-border, #1d2e4a);
  }
  .pvi-rows { list-style: none; margin: 0; padding: 0; }
  .pvi-row { display: grid; grid-template-columns: 7.75rem 1fr; gap: 0.75rem; padding: 0.3rem 0; font-size: 0.95rem; line-height: 1.5; }
  .pvi-ref { color: var(--band-title, #eef2fa); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pvi-where { display: flex; flex-direction: column; }
  .pvi-band { color: var(--band-count, #7f9bc8); font-size: 0.88em; }
  .pvi-arrow { color: var(--band-accent, #c9a85c); }
  .pvi a { color: var(--band-link, #9cc0f0); text-decoration: none; }
  .pvi a:hover { text-decoration: underline; }
  .pvi-reading { break-inside: avoid; margin: 0 0 0.9rem; }
  .pvi-reading-name { font-size: 1rem; font-weight: 600; margin: 0 0 0.15rem; color: var(--band-title, #eef2fa); }
  .pvi-reading-name .pvi-band { font-weight: 400; margin-left: 0.35rem; }
  .pvi-passages { font-size: 0.92rem; line-height: 1.6; margin: 0; color: var(--band-text, #c3cddd); }
  .pvi-sep { color: var(--band-count, #7f9bc8); }
  @media (max-width: 560px) {
    .pvi { padding: 1.4rem 1.1rem 1.25rem; }
    .pvi-row { grid-template-columns: 1fr; gap: 0.1rem; }
  }
</style>
