---
import fs from 'node:fs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title = 'Nazaryah - Biblical Studies',
  description = 'A modern biblical studies platform emphasizing original languages, fresh perspectives, and rich contextual understanding.',
  image,
  article = false,
  canonical,
  ogTitle,
  ogDescription,
  ogImage
} = Astro.props;

// canonical override lets a duplicate page (e.g. the Foreign Fire copy of a study)
// point search engines at the primary /blog/ version.
const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site || 'http://localhost:4321');

// Open Graph / Twitter Card. Site-wide defaults below; individual studies may
// override og:title / og:description / og:image from frontmatter. Resolution:
// an explicit og* value wins, else the page's own title/description/image,
// else the site default.
const OG_DEFAULT_TITLE = 'Nazaryah — Separated Unto Yah';
const OG_DEFAULT_DESCRIPTION = 'Biblical studies checked against the text itself.';
const OG_DEFAULT_IMAGE = '/og-default.jpg';
const ogTitleResolved = ogTitle ?? title ?? OG_DEFAULT_TITLE;
const ogDescriptionResolved = ogDescription ?? description ?? OG_DEFAULT_DESCRIPTION;

// Per-piece social card: the social-image scripts write a titled 1200×630 card
// to public/og/<path>.png mirroring the page's URL path (e.g. /hebrew/alphabet/
// aleph -> public/og/hebrew/alphabet/aleph.png). Keying by full path — not the
// last segment — keeps distinct pages that share a leaf name (aleph appears
// under alphabet, messiah-letters, and psalm-119) on distinct cards. Prefer that
// card for og:image/twitter:image when it exists; an explicit frontmatter
// `ogImage` still wins; pages with no card fall back to the site logo. The
// homepage (empty path) always keeps the logo.
const cardRel = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const perPageCard = cardRel && fs.existsSync(`public/og/${cardRel}.png`) ? `/og/${cardRel}.png` : undefined;
const ogImageURL = new URL(ogImage ?? perPageCard ?? image ?? OG_DEFAULT_IMAGE, Astro.site || 'http://localhost:4321').href;
// Explicit image hints. Both the generated cards and the default are 1200×630;
// declaring type/dimensions/alt helps stricter crawlers (X especially) render the
// card without a fetch-and-measure step, and clears the "no alt text" warning.
const ogImageType = /\.png$/i.test(ogImageURL) ? 'image/png' : 'image/jpeg';
const ogImageAlt = ogTitleResolved;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Theme initialization - runs before page render to prevent flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (stored === 'light') {
          document.documentElement.classList.remove('dark');
        }
        // If no stored preference, default to light mode (no class needed)
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitleResolved} />
    <meta property="og:description" content={ogDescriptionResolved} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={ogTitleResolved} />
    <meta name="twitter:description" content={ogDescriptionResolved} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cinzel+Decorative:wght@400;700&family=Crimson+Pro:ital,wght@0,400;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@300;400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="flex flex-col min-h-screen">
      <Header />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer />
    </div>
    <SearchModal />
    <!-- Burnt parchment edge vignette — fixed overlay, never blocks clicks -->
    <div id="burnt-edge" aria-hidden="true"></div>
  </body>
</html>
